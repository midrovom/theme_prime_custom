<odoo>
    <record id="settlement_batch_list" model="ir.ui.view">
        <field name="name">commission.settlement.batch.list</field>
        <field name="model">commission.settlement.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="operator_id" readonly="state != 'draft'"/>
                <field name="period"/>
                <field name="line_count"/>
                <field name="reported_total"/>
                <field name="expected_total"/>
                <field name="difference_total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="settlement_batch_form" model="ir.ui.view">
        <field name="name">commission.settlement.batch.form</field>
        <field name="model">commission.settlement.batch</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_recalculate" type="object" string="Recalcular" class="btn-primary" invisible="state == 'closed'"/>
                    <button name="action_close" type="object" string="Cerrar" invisible="state == 'closed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="operator_id"/>
                            <field name="period"/>
                        </group>
                        <group>
                            <field name="line_count"/>
                            <field name="matched_line_count"/>
                            <field name="no_purchase_count"/>
                            <field name="ruled_line_count"/>
                            <field name="rule_coverage_rate"/>
                            <field name="no_rule_count"/>
                            <field name="data_error_count"/>
                            <field name="ok_count"/>
                            <field name="difference_count"/>
                            <field name="reported_total"/>
                            <field name="expected_total"/>
                            <field name="difference_total"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Detalle">
                            <field name="line_ids">
                                <list>
                                    <field name="icc"/>
                                    <field name="sim_id"/>
                                    <field name="compensation_date"/>
                                    <field name="region_text"/>
                                    <field name="region_id"/>
                                    <field name="zone_id"/>
                                    <field name="concept"/>
                                    <field name="evaluated_consumption"/>
                                    <field name="reported_percentage"/>
                                    <field name="reported_value"/>
                                    <field name="expected_percentage"/>
                                    <field name="expected_value"/>
                                    <field name="difference"/>
                                    <field name="reconciliation_state"/>
                                    <field name="source_file"/>
                                </list>
                            </field>
                        </page>
                        <page string="Archivos">
                            <field name="file_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="attachment_id" string="Archivo original" optional="show"/>
                                    <field name="row_count"/>
                                    <field name="sha256"/>
                                    <field name="imported_at"/>
                                    <field name="imported_by"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="settlement_line_list" model="ir.ui.view">
        <field name="name">commission.settlement.line.list</field>
        <field name="model">commission.settlement.line</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="compensation_date"/>
                <field name="icc"/>
                <field name="sim_id"/>
                <field name="region_id"/>
                <field name="zone_id"/>
                <field name="product"/>
                <field name="concept"/>
                <field name="reported_percentage"/>
                <field name="evaluated_consumption"/>
                <field name="reported_value"/>
                <field name="expected_percentage"/>
                <field name="expected_value"/>
                <field name="difference"/>
                <field name="reconciliation_state"/>
                <field name="source_file"/>
            </list>
        </field>
    </record>

    <record id="settlement_line_search" model="ir.ui.view">
        <field name="name">commission.settlement.line.search</field>
        <field name="model">commission.settlement.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="icc"/>
                <field name="service_number"/>
                <field name="concept"/>
                <field name="region_id"/>
                <field name="zone_id"/>
                <field name="source_file"/>
                <filter name="state_difference" string="Con diferencia" domain="[('reconciliation_state','=','difference')]"/>
                <filter name="state_no_rule" string="Sin regla" domain="[('reconciliation_state','=','no_rule')]"/>
                <filter name="state_no_purchase" string="ICC sin compra" domain="[('reconciliation_state','=','no_purchase')]"/>
                <filter name="state_data_error" string="Dato incompleto" domain="[('reconciliation_state','=','data_error')]"/>
                <filter name="state_ok" string="OK" domain="[('reconciliation_state','=','ok')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Región" name="group_region" context="{'group_by':'region_id'}"/>
                    <filter string="Zona" name="group_zone" context="{'group_by':'zone_id'}"/>
                    <filter string="Concepto" name="group_concept" context="{'group_by':'concept'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by':'reconciliation_state'}"/>
                    <filter string="Fecha" name="group_date" context="{'group_by':'compensation_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="settlement_line_pivot" model="ir.ui.view">
        <field name="name">commission.settlement.line.pivot</field>
        <field name="model">commission.settlement.line</field>
        <field name="arch" type="xml">
            <pivot string="Comisiones">
                <field name="region_id" type="row"/>
                <field name="zone_id" type="row"/>
                <field name="concept" type="col"/>
                <field name="reported_value" type="measure"/>
                <field name="expected_value" type="measure"/>
                <field name="difference" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="settlement_line_graph" model="ir.ui.view">
        <field name="name">commission.settlement.line.graph</field>
        <field name="model">commission.settlement.line</field>
        <field name="arch" type="xml">
            <graph string="Comisiones por Región" type="bar">
                <field name="region_id"/>
                <field name="reported_value" type="measure"/>
                <field name="expected_value" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_settlement_batch" model="ir.actions.act_window">
        <field name="name">Liquidaciones</field>
        <field name="res_model">commission.settlement.batch</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_settlement_analysis" model="ir.actions.act_window">
        <field name="name">Análisis de Liquidaciones</field>
        <field name="res_model">commission.settlement.line</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="settlement_line_search"/>
    </record>
</odoo>
