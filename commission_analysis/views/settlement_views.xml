<odoo>
<record id="settlement_batch_list" model="ir.ui.view"><field name="name">commission.settlement.batch.list</field><field name="model">commission.settlement.batch</field><field name="arch" type="xml"><list><field name="name"/><field name="operator_id"/><field name="period"/><field name="line_count"/><field name="reported_total"/><field name="expected_total"/><field name="difference_total"/><field name="state"/></list></field></record>
<record id="settlement_batch_form" model="ir.ui.view"><field name="name">commission.settlement.batch.form</field><field name="model">commission.settlement.batch</field><field name="arch" type="xml"><form><header><button name="action_recalculate" type="object" string="Recalcular" class="btn-primary"/><button name="action_close" type="object" string="Cerrar" invisible="state == 'closed'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="operator_id"/><field name="period"/><field name="state"/><field name="reported_total"/><field name="expected_total"/><field name="difference_total"/></group><notebook><page string="Detalle"><field name="line_ids"><list><field name="icc"/><field name="compensation_date"/><field name="region_text"/><field name="concept"/><field name="evaluated_consumption"/><field name="reported_percentage"/><field name="reported_value"/><field name="expected_percentage"/><field name="expected_value"/><field name="difference"/><field name="reconciliation_state"/><field name="source_file"/></list></field></page><page string="Archivos"><field name="file_ids"><list><field name="name"/><field name="row_count"/><field name="sha256"/><field name="imported_at"/><field name="imported_by"/></list></field></page></notebook></sheet><chatter/></form></field></record>
<record id="settlement_line_pivot" model="ir.ui.view"><field name="name">commission.settlement.line.pivot</field><field name="model">commission.settlement.line</field><field name="arch" type="xml"><pivot string="Comisiones"><field name="region_id" type="row"/><field name="zone_id" type="row"/><field name="concept" type="col"/><field name="reported_value" type="measure"/><field name="expected_value" type="measure"/><field name="difference" type="measure"/></pivot></field></record>
<record id="settlement_line_graph" model="ir.ui.view"><field name="name">commission.settlement.line.graph</field><field name="model">commission.settlement.line</field><field name="arch" type="xml"><graph string="Comisiones por Región" type="bar"><field name="region_id"/><field name="reported_value" type="measure"/><field name="expected_value" type="measure"/></graph></field></record>
<record id="action_settlement_batch" model="ir.actions.act_window"><field name="name">Liquidaciones</field><field name="res_model">commission.settlement.batch</field><field name="view_mode">list,form</field></record>
<record id="action_settlement_analysis" model="ir.actions.act_window"><field name="name">Análisis de Liquidaciones</field><field name="res_model">commission.settlement.line</field><field name="view_mode">pivot,graph,list</field></record>
</odoo>