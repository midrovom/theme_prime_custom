<odoo>
    <record id="dashboard_form" model="ir.ui.view">
        <field name="name">commission.analysis.dashboard.form</field>
        <field name="model">commission.analysis.dashboard</field>
        <field name="arch" type="xml">
            <form string="Dashboard de Comisiones" create="1" edit="1">
                <header>
                    <button string="Actualizar" type="object" name="action_refresh" class="btn-primary"/>
                    <button string="Analizar zonas" type="object" name="action_open_region_analysis" class="btn-secondary"/>
                    <button string="Ver pendiente Claro" type="object" name="action_open_pending_claro" class="btn-secondary"/>
                </header>
                <sheet>
                    <group string="Filtros" col="3">
                        <field name="operator_id"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="commission_date_to"/>
                        <field name="region_id"/>
                        <field name="zone_id"/>
                    </group>

                    <group string="Resumen ejecutivo" col="4">
                        <group>
                            <field name="reported"/>
                            <field name="margin"/>
                            <field name="roi_realized"/>
                            <field name="margin_per_sim"/>
                        </group>
                        <group>
                            <field name="sim_count"/>
                            <field name="monetized_count"/>
                            <field name="monetization_rate"/>
                            <field name="commission_per_sim"/>
                        </group>
                        <group>
                            <field name="expected"/>
                            <field name="pending_claro"/>
                            <field name="difference"/>
                            <field name="roi_expected"/>
                        </group>
                        <group>
                            <field name="purchase_cost"/>
                            <field name="capital_trapped"/>
                            <field name="recovery_rate"/>
                            <field name="avg_recovery_days"/>
                        </group>
                    </group>

                    <group string="Cobertura y control de reglas" col="3">
                        <group>
                            <field name="commission_line_count"/>
                            <field name="ruled_line_count"/>
                            <field name="rule_coverage_rate"/>
                        </group>
                        <group>
                            <field name="difference_line_count"/>
                            <field name="difference_rate"/>
                            <field name="pending_claro"/>
                        </group>
                        <group>
                            <field name="no_rule_reported"/>
                            <field name="expected"/>
                            <field name="difference"/>
                        </group>
                    </group>

                    <group string="Maduración y productividad" col="3">
                        <group>
                            <field name="maturity_days"/>
                            <field name="mature_count"/>
                        </group>
                        <group>
                            <field name="unproductive_count"/>
                            <field name="unproductive_rate"/>
                        </group>
                        <group>
                            <field name="recovered_count"/>
                            <field name="capital_trapped"/>
                        </group>
                    </group>

                    <group string="Rendimiento por zona" col="3">
                        <group string="Mayor generación">
                            <field name="top_zone_id"/>
                            <field name="top_zone_reported"/>
                            <field name="top_zone_margin"/>
                            <field name="top_zone_roi"/>
                            <field name="top_zone_monetization"/>
                            <field name="top_zone_share"/>
                        </group>
                        <group string="Menor generación">
                            <field name="bottom_zone_id"/>
                            <field name="bottom_zone_reported"/>
                            <field name="bottom_zone_margin"/>
                            <field name="bottom_zone_roi"/>
                            <field name="bottom_zone_monetization"/>
                        </group>
                        <group string="Mayor eficiencia">
                            <field name="best_roi_zone_id"/>
                            <field name="best_roi_zone_roi"/>
                            <field name="best_roi_zone_margin"/>
                            <field name="best_roi_zone_monetization"/>
                            <field name="top3_zone_share"/>
                            <field name="zones_analyzed"/>
                            <field name="unmapped_zone_count"/>
                            <field name="zone_coverage_rate"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">commission.analysis.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
