<odoo>
    <record id="scheme_list" model="ir.ui.view">
        <field name="name">commission.scheme.list</field>
        <field name="model">commission.scheme</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="operator_id" readonly="state != 'draft'"/>
                <field name="product" readonly="state != 'draft'"/>
                <field name="product_match_pattern" readonly="state != 'draft'"/>
                <field name="date_from" readonly="state != 'draft'"/>
                <field name="date_to"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="scheme_form" model="ir.ui.view">
        <field name="name">commission.scheme.form</field>
        <field name="model">commission.scheme</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_duplicate_version" type="object" string="Duplicar esquema" class="btn-primary"/>
                    <button name="action_activate" type="object" string="Activar" invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="Cerrar" invisible="state != 'active'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="operator_id"/>
                            <field name="product"/>
                            <field name="product_match_pattern"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Los cambios de porcentajes/rangos deben realizarse en un esquema en borrador.
                        Para una nueva vigencia use <strong>Duplicar esquema</strong>, ajuste los parámetros y actívelo.
                    </div>
                    <notebook>
                        <page string="Reglas">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="priority"/>
                                    <field name="concept_code"/>
                                    <field name="concept_name"/>
                                    <field name="match_pattern"/>
                                    <field name="evaluation_day"/>
                                    <field name="calculation_type"/>
                                    <field name="base_field"/>
                                    <field name="min_amount"/>
                                    <field name="min_inclusive"/>
                                    <field name="max_amount"/>
                                    <field name="max_inclusive"/>
                                    <field name="no_upper_limit"/>
                                    <field name="percentage"/>
                                    <field name="fixed_amount"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas"><field name="notes"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_scheme" model="ir.actions.act_window">
        <field name="name">Esquemas de Comisión</field>
        <field name="res_model">commission.scheme</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
