<odoo>
    <record id="region_analysis_list" model="ir.ui.view">
        <field name="name">commission.region.analysis.list</field>
        <field name="model">commission.region.analysis</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-success="margin &gt; 0" decoration-danger="margin &lt; 0">
                <field name="purchase_month"/>
                <field name="operator_id"/>
                <field name="region_id"/>
                <field name="zone_id"/>
                <field name="sim_count"/>
                <field name="monetized_count"/>
                <field name="monetization_rate"/>
                <field name="purchase_cost"/>
                <field name="reported"/>
                <field name="participation"/>
                <field name="commission_per_sim"/>
                <field name="margin"/>
                <field name="margin_per_sim"/>
                <field name="roi_realized"/>
                <field name="expected" optional="hide"/>
                <field name="difference" optional="hide"/>
                <field name="roi_expected" optional="hide"/>
                <field name="mature_count" optional="hide"/>
                <field name="unproductive_count" optional="hide"/>
                <field name="unproductive_rate" optional="hide"/>
                <field name="capital_trapped" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="region_analysis_pivot" model="ir.ui.view">
        <field name="name">commission.region.analysis.pivot</field>
        <field name="model">commission.region.analysis</field>
        <field name="arch" type="xml">
            <pivot string="Rendimiento por Región / Zona">
                <field name="operator_id" type="row"/>
                <field name="region_id" type="row"/>
                <field name="zone_id" type="row"/>
                <field name="purchase_month" interval="month" type="col"/>
                <field name="sim_count" type="measure"/>
                <field name="purchase_cost" type="measure"/>
                <field name="reported" type="measure"/>
                <field name="margin" type="measure"/>
                <field name="capital_trapped" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="region_analysis_graph" model="ir.ui.view">
        <field name="name">commission.region.analysis.graph</field>
        <field name="model">commission.region.analysis</field>
        <field name="arch" type="xml">
            <graph string="Comisión recibida por Zona" type="bar">
                <field name="zone_id"/>
                <field name="reported" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="region_analysis_search" model="ir.ui.view">
        <field name="name">commission.region.analysis.search</field>
        <field name="model">commission.region.analysis</field>
        <field name="arch" type="xml">
            <search string="Rendimiento por zona">
                <field name="operator_id"/>
                <field name="region_id"/>
                <field name="zone_id"/>
                <field name="purchase_month"/>
                <separator/>
                <filter string="Por Región" name="group_region" context="{'group_by': 'region_id'}"/>
                <filter string="Por Zona" name="group_zone" context="{'group_by': 'zone_id'}"/>
                <filter string="Por Mes de Compra" name="group_month" context="{'group_by': 'purchase_month:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_region_analysis" model="ir.actions.act_window">
        <field name="name">Rendimiento por Región / Zona</field>
        <field name="res_model">commission.region.analysis</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="region_analysis_search"/>
    </record>
</odoo>
