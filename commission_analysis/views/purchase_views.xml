<odoo>
    <record id="purchase_batch_list" model="ir.ui.view">
        <field name="name">commission.purchase.batch.list</field>
        <field name="model">commission.purchase.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="operator_id"/>
                <field name="period"/>
                <field name="line_count"/>
                <field name="total_roi_cost"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="purchase_batch_form" model="ir.ui.view">
        <field name="name">commission.purchase.batch.form</field>
        <field name="model">commission.purchase.batch</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_apply_mappings" type="object" string="Aplicar mapeo Región/Zona" class="btn-primary" invisible="state == 'closed'"/>
                    <button name="action_recalculate_roi_cost" type="object" string="Recalcular costo ROI" class="btn-secondary"/>
                    <button name="action_close" type="object" string="Cerrar" invisible="state == 'closed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="operator_id"/>
                        <field name="period"/>
                        <field name="roi_cost_basis"/>
                        <field name="line_count"/>
                        <field name="total_cost"/>
                        <field name="total_discount"/>
                        <field name="total_tax"/>
                        <field name="total_gross_cost"/>
                        <field name="total_roi_cost"/>
                    </group>
                    <notebook>
                        <page string="Detalle">
                            <field name="line_ids">
                                <list>
                                    <field name="icc"/>
                                    <field name="date"/>
                                    <field name="invoice"/>
                                    <field name="warehouse_code"/>
                                    <field name="warehouse_name"/>
                                    <field name="product_name"/>
                                    <field name="cost"/>
                                    <field name="discount" optional="hide"/>
                                    <field name="tax" optional="show"/>
                                    <field name="region_id"/>
                                    <field name="zone_id"/>
                                    <field name="source_file"/>
                                </list>
                            </field>
                        </page>
                        <page string="Archivos">
                            <field name="file_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="row_count"/>
                                    <field name="sha256"/>
                                    <field name="imported_at"/>
                                    <field name="imported_by"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_purchase_batch" model="ir.actions.act_window">
        <field name="name">Lotes de Compras</field>
        <field name="res_model">commission.purchase.batch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
