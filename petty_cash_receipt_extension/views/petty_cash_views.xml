<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_expense_form_receipt_extension" model="ir.ui.view">
        <field name="name">petty.cash.expense.form.receipt.extension</field>
        <field name="model">petty.cash.expense</field>
        <field name="inherit_id" ref="petty_cash_control.view_expense_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header/field[@name='state']" position="before">
                <button name="action_print_receipt" type="object"
                        string="Imprimir recibido" class="btn-secondary"/>
            </xpath>
            <xpath expr="//field[@name='attachment_ids']" position="attributes">
                <attribute name="string">Comprobantes (opcional)</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_settlement_form_balance_extension" model="ir.ui.view">
        <field name="name">petty.cash.settlement.form.balance.extension</field>
        <field name="model">petty.cash.settlement</field>
        <field name="inherit_id" ref="petty_cash_control.view_settlement_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='expense_total']" position="before">
                <field name="approved_fund_amount" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='return_amount']" position="after">
                <field name="balance_after_settlement" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
