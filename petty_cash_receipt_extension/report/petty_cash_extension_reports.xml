<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_petty_cash_expense_receipt" model="ir.actions.report">
        <field name="name">Recibido del gasto</field>
        <field name="model">petty.cash.expense</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">petty_cash_receipt_extension.report_expense_receipt_document</field>
        <field name="report_file">petty_cash_receipt_extension.report_expense_receipt_document</field>
        <field name="binding_model_id" ref="petty_cash_control.model_petty_cash_expense"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Recibido_%s' % object.name.replace('/', '_')</field>
    </record>

    <template id="report_expense_receipt_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center mb-4">
                            <h2>RECIBO DE CAJA CHICA</h2>
                            <h4><span t-field="o.name"/></h4>
                        </div>
                        <div class="row mb-3">
                            <div class="col-6">
                                <strong>Fecha:</strong> <span t-field="o.date"/><br/>
                                <strong>Caja:</strong> <span t-field="o.box_id"/><br/>
                                <strong>Departamento:</strong> <span t-field="o.department_id"/>
                            </div>
                            <div class="col-6">
                                <strong>Categoría:</strong> <span t-field="o.category_id"/><br/>
                                <strong>Proveedor:</strong>
                                <span t-if="o.supplier_id" t-field="o.supplier_id"/>
                                <span t-else="" t-field="o.supplier_name"/><br/>
                                <strong>RUC/Cédula:</strong> <span t-field="o.supplier_vat"/>
                            </div>
                        </div>
                        <div class="border rounded p-3 mb-3">
                            <p><strong>Recibí de:</strong> <span t-field="o.company_id.name"/></p>
                            <p><strong>Beneficiario:</strong> <span t-field="o.beneficiary_id"/></p>
                            <p><strong>Cédula/RUC del beneficiario:</strong>
                                <span t-field="o.beneficiary_id.vat"/>
                            </p>
                            <p><strong>La cantidad de:</strong>
                                <span t-field="o.amount"
                                      t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </p>
                            <p><strong>Por concepto de:</strong> <span t-field="o.description"/></p>
                            <p><strong>Comprobante:</strong>
                                <span t-field="o.document_type"/>
                                <span t-if="o.document_number"> N.º <span t-field="o.document_number"/></span>
                                <span t-if="not o.document_number">Sin número registrado</span>
                            </p>
                        </div>
                        <div class="row" style="margin-top:90px;">
                            <div class="col-5 text-center">
                                <div style="border-top:1px solid #000; padding-top:6px;">
                                    Entregado por<br/>
                                    <span t-field="o.responsible_id"/>
                                </div>
                            </div>
                            <div class="col-2"/>
                            <div class="col-5 text-center">
                                <div style="border-top:1px solid #000; padding-top:6px;">
                                    Recibí conforme<br/>
                                    <span t-field="o.beneficiary_id"/><br/>
                                    C.I./RUC: <span t-field="o.beneficiary_id.vat"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_expenses_add_note"
              inherit_id="petty_cash_control.report_expenses_document">
        <xpath expr="//table/thead/tr/th[last()]" position="before">
            <th>Nota del gasto</th>
        </xpath>
        <xpath expr="//table/tbody/tr/td[last()]" position="before">
            <td><span t-field="o.description"/></td>
        </xpath>
        <xpath expr="//table/tfoot/tr/th[1]" position="attributes">
            <attribute name="colspan">8</attribute>
        </xpath>
    </template>

    <template id="report_settlement_add_balances"
              inherit_id="petty_cash_control.report_settlement_document">
        <xpath expr="//table/tfoot/tr[1]" position="before">
            <tr>
                <th colspan="7" class="text-end">Fondo máximo</th>
                <th class="text-end">
                    <span t-field="o.approved_fund_amount"
                          t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                </th>
            </tr>
        </xpath>
        <xpath expr="//table/tfoot/tr[last()]" position="after">
            <tr>
                <th colspan="7" class="text-end">Saldo luego de la liquidación</th>
                <th class="text-end">
                    <span t-field="o.balance_after_settlement"
                          t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                </th>
            </tr>
        </xpath>
    </template>
</odoo>
