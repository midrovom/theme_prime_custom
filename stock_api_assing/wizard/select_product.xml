<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_select_products_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.select.products.form</field>
        <field name="model">sale.order.select.products</field>
        <field name="arch" type="xml">
            <form string="Seleccionar productos">
                <sheet>
                    <group>
                        <field name="order_id" invisible="1"/>
                        <field name="available_product_ids" invisible="1"/>
                        <field name="warehouse_id" options="{'no_create': True, 'no_open': True}"
                               groups="stock_api_assing.group_multi_warehouse"/>
                        <field name="warehouse_id" options="{'no_create': True, 'no_open': True}"
                               readonly="1" groups="!stock_api_assing.group_multi_warehouse"/>
                        <field name="product_ids" widget="many2many_tags"
                               domain="[('id', 'in', available_product_ids)]"
                               context="{'list_view_ref': 'stock_api_assing.custom_product_tree_view', 'warehouse_id': warehouse_id}"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="add_products_to_order" string="Agregar" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="custom_product_tree_view" model="ir.ui.view">
        <field name="name">product.product.list.custom.radis</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <list string="Productos en bodega" create="0">
                <field name="name"/>
                <field name="default_code"/>
                <field name="lst_price" string="Precio"/>
                <field name="location_qty" string="Stock en bodega"/>
            </list>
        </field>
    </record>

    <record id="custom_product_view_kanban" model="ir.ui.view">
        <field name="name">product.product.kanban.custom.radis</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="lst_price"/>
                <field name="location_qty"/>
                <templates>
                    <t t-name="card">
                        <div class="p-2">
                            <strong><field name="name"/></strong>
                            <div>Precio: <field name="lst_price"/></div>
                            <div>Stock: <field name="location_qty"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
