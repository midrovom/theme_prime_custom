<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_stock_api_assing_view_form" model="ir.ui.view">
        <field name="name">stock.api.assing.form.view.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-flex"><field name="check_manage_sync"/><label for="check_manage_sync"/></span>
            </xpath>
            <xpath expr="//group[@name='group_general']" position="inside">
                <field name="peso"/>
            </xpath>
        </field>
    </record>
</odoo>
