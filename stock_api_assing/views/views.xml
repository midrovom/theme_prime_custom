<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_api_assing_form" model="ir.ui.view">
        <field name="name">stock.api.assing.form</field>
        <field name="model">stock.api.assing</field>
        <field name="arch" type="xml">
            <form string="Sincronización stock API">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="date"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_stock_api_assing_visit_tree" model="ir.ui.view">
        <field name="name">stock.api.assing.list</field>
        <field name="model">stock.api.assing</field>
        <field name="arch" type="xml">
            <list string="Stock">
                <field name="name"/>
                <field name="company_id"/>
                <field name="date"/>
                <field name="description" widget="text"/>
            </list>
        </field>
    </record>
    <record id="custom_crm_action_window" model="ir.actions.act_window">
        <field name="name">Control Stock APIs</field>
        <field name="res_model">stock.api.assing</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem name="Control de Stock API" id="stock_api_assing_menu_root"
              web_icon="stock_api_assing,static/description/icon.png" sequence="5"
              groups="stock_api_assing.group_stock_api_assing_basic"/>
    <menuitem name="Operaciones" id="stock_api_assing_data_menu"
              parent="stock_api_assing_menu_root" sequence="0"/>
    <menuitem name="Historial de stock" id="checked_stock_option"
              parent="stock_api_assing_data_menu" sequence="1" action="custom_crm_action_window"/>
    <menuitem name="Exportaciones de cotizaciones" id="update_quotes_option"
              parent="stock_api_assing_data_menu" sequence="2" action="update_quotes_action_window"/>
</odoo>
