<odoo>
  <record id="view_category_list" model="ir.ui.view"><field name="name">petty.cash.category.list</field><field name="model">petty.cash.category</field><field name="arch" type="xml"><list><field name="name"/><field name="code"/><field name="expense_limit"/><field name="currency_id" column_invisible="True"/><field name="active"/></list></field></record>
  <record id="view_category_form" model="ir.ui.view"><field name="name">petty.cash.category.form</field><field name="model">petty.cash.category</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="code"/><field name="expense_limit"/><field name="currency_id" invisible="1"/><field name="active"/></group><field name="description"/></sheet></form></field></record>
  <record id="action_category" model="ir.actions.act_window"><field name="name">Categorías</field><field name="res_model">petty.cash.category</field><field name="view_mode">list,form</field></record>
