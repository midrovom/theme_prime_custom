<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_applicant_view_form_portal_history" model="ir.ui.view">
        <field name="name">hr.applicant.form.portal.history</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_allow_portal_update"
                        type="object"
                        string="Permitir actualización"
                        class="btn-primary"
                        invisible="not portal_user_id or portal_update_allowed"
                        groups="hr_recruitment.group_hr_recruitment_user"/>
                <button name="action_revoke_portal_update"
                        type="object"
                        string="Revocar actualización"
                        class="btn-secondary"
                        invisible="not portal_update_allowed"
                        groups="hr_recruitment.group_hr_recruitment_user"/>
            </xpath>


            <xpath expr="//notebook" position="inside">
                <page string="Documentación de ingreso" name="portal_documentation_page">
                    <group>
                        <field name="documentation_required" readonly="1"/>
                        <field name="documentation_complete" readonly="1"/>
                        <field name="applicant_documentation_ids" readonly="1">
                            <list>
                                <field name="create_date"/>
                                <field name="is_complete"/>
                                <field name="fotografia_filename"/>
                                <field name="cedula_votacion_filename"/>
                                <field name="historia_iess_filename"/>
                                <field name="acta_matrimonio_filename"/>
                                <field name="documentos_hijos_filename"/>
                                <field name="estudios_titulo_filename"/>
                                <field name="cursos_realizados_filename"/>
                                <field name="recomendaciones_filename"/>
                                <field name="certificados_trabajo_filename"/>
                                <field name="planilla_servicios_filename"/>
                                <field name="croquis_domicilio_filename"/>
                                <field name="formulario_107_filename"/>
                                <field name="cuenta_banco_internacional_filename"/>
                                <field name="certificado_salud_filename"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>

            <xpath expr="//field[@name='partner_phone']" position="after">
                <field name="portal_user_id" invisible="1"/>
                <field name="portal_update_allowed"/>
                <field name="portal_update_allowed_at" readonly="1"/>
                <field name="portal_update_allowed_by" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
