<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="portal_home_application_cards" inherit_id="portal.portal_my_home" name="Historial y documentación de postulaciones">
        <xpath expr="//div[@id='portal_common_category']" position="inside">
            <t t-set="portal_applications_custom"
               t-value="request.env['hr.applicant'].sudo().search([('portal_user_id', '=', request.env.user.id)])"/>
            <t t-set="documentation_applicant_custom"
               t-value="request.env['hr.applicant'].sudo().search([('portal_user_id', '=', request.env.user.id), ('stage_id.sequence', '>=', 3)], limit=1)"/>

            <div class="o_portal_index_card col-md-6 order-3">
                <a href="/my/application-history"
                   title="Historial de postulación"
                   class="d-flex gap-2 gap-md-3 py-3 pe-2 px-md-3 h-100 rounded text-decoration-none bg-100">
                    <div class="o_portal_icon d-flex align-items-center justify-content-center align-self-start portal-card-icon">
                        <i class="fa fa-history fa-2x" aria-hidden="true"/>
                    </div>
                    <div>
                        <div class="mt-0 mb-1 fs-5 fw-normal lh-1">
                            <span>Historial de postulación</span>
                        </div>
                        <div class="opacity-75">
                            Consulte sus postulaciones, estados y permisos de actualización.
                        </div>
                    </div>
                </a>
            </div>

            <t t-if="documentation_applicant_custom">
                <div class="o_portal_index_card col-md-6 order-4">
                    <a href="/my/application-documentation"
                       title="Ingreso de documentación"
                       class="d-flex gap-2 gap-md-3 py-3 pe-2 px-md-3 h-100 rounded text-decoration-none bg-100">
                        <div class="o_portal_icon d-flex align-items-center justify-content-center align-self-start portal-card-icon">
                            <i class="fa fa-folder-open fa-2x" aria-hidden="true"/>
                        </div>
                        <div>
                            <div class="mt-0 mb-1 fs-5 fw-normal lh-1">
                                <span>Ingreso de documentación</span>
                            </div>
                            <div class="opacity-75">
                                Cargue la documentación requerida para sus postulaciones habilitadas.
                            </div>
                        </div>
                    </a>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
