<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="job_detail_apply" name="Job Detail Apply Button" inherit_id="website_hr_recruitment.detail">
        <xpath expr="//section[@class='pb32']//div[@class='text-center']/a" position="replace">
            <t t-if="request.env.user.id != request.website.user_id.id">
                <a role="button" class="btn btn-primary btn-lg" t-attf-href="/jobs/recruitment/#{ slug(job) }">
                    ¡Solicitar ahora!
                </a>
            </t>
            <t t-else="">
                <a role="button" class="btn btn-primary btn-lg" t-attf-href="/web/login?redirect=/jobs/recruitment/#{ slug(job) }">
                    ¡Solicitar ahora!
                </a>
            </t>
        </xpath>
    </template>

</odoo>
