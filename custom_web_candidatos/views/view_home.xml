<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_home_custom" inherit_id="portal.portal_home" name="Portal Home Custom">
        <xpath expr="//a[@href='/my/orders']" position="replace"/>
        <xpath expr="//a[@href='/my/invoices?filterby=invoices']" position="replace"/>
        <xpath expr="//a[@href='/my/security']" position="replace"/>

        <xpath expr="//div[contains(@class,'o_portal_home_content')]" position="inside">
            <a t-attf-href="/jobs/recruitment/#{ slug(job) }"
            title="Reclutamiento"
            class="d-flex gap-2 gap-md-3 py-3 pe-2 px-md-3 h-100 rounded text-decoration-none bg-100">
                <div class="o_portal_icon d-block align-self-start">
                    <img src="/hr_recruitment/static/src/img/recruitment.svg" loading="lazy"/>
                </div>
                <div>
                    <div class="mt-0 mb-1 fs-5 fw-normal lh-1">
                        <span>Reclutamiento</span>
                    </div>
                    <div class="opacity-75">
                        Postule a las vacantes disponibles
                    </div>
                </div>
            </a>
        </xpath>
    </template>


</odoo>
