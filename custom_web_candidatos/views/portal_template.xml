<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_home_custom" inherit_id="portal.portal_my_home" name="Portal Home Custom">
        <xpath expr="//div[@id='portal_common_category']" position="inside">
            <div class="o_portal_index_card col-md-6 order-2">
                <a href="/jobs" title="Reclutamiento" class="d-flex gap-2 gap-md-3 py-3 pe-2 px-md-3 h-100 rounded text-decoration-none bg-100">
                    <div class="o_portal_icon d-block align-self-start">
                        <img src="/hr_recruitment/static/src/img/recruitment.svg" loading="lazy"/>
                    </div>

                    <div>
                        <div class="mt-0 mb-1 fs-5 fw-normal lh-1">
                            <span>Reclutamiento</span>
                        </div>

                        <div class="opacity-75">
                            Postule a las vacantes disponibles
                        </div>
                    </div>
                </a>
            </div>
        </xpath>
    </template>

    <template id="portal_home_remove_orders_invoices" inherit_id="portal.portal_my_home" name="Portal Home Remove Orders">
        <xpath expr="//div[@id='portal_client_category']/t[t-call='portal.portal_docs_entry'][t-set='title'][.='Your Orders']" position="replace"/>
        <xpath expr="//div[@id='portal_client_category']/t[t-call='portal.portal_docs_entry'][t-set='title'][.='Your Invoices']" position="replace"/>
    </template>

</odoo>


