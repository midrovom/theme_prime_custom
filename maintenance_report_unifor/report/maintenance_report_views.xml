<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Reporte Acta de Entrega de Uniforme -->
    <record id="maintenance_equipment_uniform_report" model="ir.actions.report">
        <field name="name">Acta Entrega Uniforme</field>
        <field name="model">maintenance.equipment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">maintenance_report_unifor.report_equipment_uniform</field>
        <field name="report_file">maintenance_report_unifor.report_equipment_uniform</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <!-- Acción Wizard para Uniforme -->
    <record id="action_open_uniform_wizard" model="ir.actions.server">
        <field name="name">Generar Acta de Entrega de Uniforme</field>
        <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
        <field name="binding_model_id" ref="maintenance.model_maintenance_equipment"/>
        <field name="binding_type">action</field>

        <field name="state">code</field>
        <field name="code">
action = {
    'type': 'ir.actions.act_window',
    'res_model': 'maintenance.report.wizard',
    'view_mode': 'form',
    'target': 'new',
    'context': {
        'default_equipment_ids': [(6, 0, records.ids)],
        'default_report_type': 'uniform',
    }
}
        </field>
    </record>

</odoo>
