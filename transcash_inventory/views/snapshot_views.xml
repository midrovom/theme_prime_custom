<odoo>
  <record id="view_snapshot_list" model="ir.ui.view">
    <field name="name">transcash.inventory.snapshot.list</field>
    <field name="model">transcash.inventory.snapshot</field>
    <field name="arch" type="xml">
      <list create="false" edit="false" delete="false">
        <field name="name"/>
        <field name="company_id" groups="base.group_multi_company"/>
        <field name="period_start"/>
        <field name="period_end"/>
        <field name="product_count"/>
        <field name="revenue_12"/>
        <field name="profit_12"/>
        <field name="stock_value"/>
        <field name="imported_by"/>
        <field name="create_date"/>
      </list>
    </field>
  </record>
  <record id="view_snapshot_form" model="ir.ui.view">
    <field name="name">transcash.inventory.snapshot.form</field>
    <field name="model">transcash.inventory.snapshot</field>
    <field name="arch" type="xml">
      <form create="false" edit="false" delete="false">
        <header><button name="action_view_dashboard" type="object" string="Ver dashboard de esta versión" class="btn-primary"/></header>
        <sheet>
          <div class="oe_title"><h1><field name="name"/></h1></div>
          <group>
            <group><field name="company_id"/><field name="original_filename"/><field name="imported_by"/><field name="create_date"/></group>
            <group><field name="period_start"/><field name="period_end"/><field name="product_count"/><field name="file_size"/></group>
          </group>
          <group>
            <group><field name="revenue_12"/><field name="profit_12"/><field name="stock_value"/></group>
          </group>
          <field name="note"/>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_snapshots" model="ir.actions.act_window">
    <field name="name">Historial de importaciones</field>
    <field name="res_model">transcash.inventory.snapshot</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'create': False}</field>
  </record>
</odoo>
