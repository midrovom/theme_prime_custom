<odoo>
  <record id="view_transcash_photos_list" model="ir.ui.view">
    <field name="name">transcash.inventory.photo.list</field>
    <field name="model">transcash.inventory.photo</field>
    <field name="arch" type="xml">
      <list string="Imágenes de productos" create="1" editable="bottom">
        <field name="sku"/>
        <field name="description" readonly="1"/>
        <field name="match_type"/>
        <field name="status" widget="badge" decoration-success="status == 'verified'" decoration-warning="status in ('queued', 'unchecked')" decoration-danger="status in ('broken', 'error')"/>
        <field name="image_thumbnail" widget="image" optional="show"/>
        <field name="image_url" widget="url"/>
        <field name="website_url" widget="url"/>
        <field name="enabled"/>
        <field name="checked_on" readonly="1"/>
        <field name="last_error" readonly="1" optional="show"/>
        <field name="company_id" groups="base.group_multi_company"/>
      </list>
    </field>
  </record>
  <record id="view_transcash_photos_form" model="ir.ui.view">
    <field name="name">transcash.inventory.photo.form</field>
    <field name="model">transcash.inventory.photo</field>
    <field name="arch" type="xml">
      <form string="Imagen vinculada al SKU">
        <header>
          <button name="action_repair_thumbnail" type="object" string="Reparar miniatura"
                  class="btn-primary" groups="transcash_inventory.group_transcash_manager,base.group_system"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="company_id" groups="base.group_multi_company"/>
              <field name="sku"/>
              <field name="description" readonly="1"/>
              <field name="match_type"/>
              <field name="status" readonly="1"/>
              <field name="image_thumbnail" widget="image" readonly="1"/>
              <field name="enabled"/>
            </group>
            <group>
              <field name="website_url" widget="url"/>
              <field name="image_url" widget="url"/>
              <field name="checked_on" readonly="1"/>
              <field name="last_error" readonly="1"/>
              <field name="next_retry" readonly="1"/>
        <field name="last_error" readonly="1" optional="show"/>
              <field name="template_id_remote" readonly="1"/>
            </group>
          </group>
          <field name="note" placeholder="Validación manual, diferencias de descripción, etc."/>
          <div class="alert alert-info" role="status">
            Las fotografías se obtienen de la tienda configurada para la empresa activa. Confirme visualmente que corresponden al SKU.
          </div>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_transcash_product_photos" model="ir.actions.act_window">
    <field name="name">Imágenes vinculadas</field>
    <field name="res_model">transcash.inventory.photo</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
