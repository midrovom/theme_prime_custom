<odoo>
  <record id="view_transcash_ai_request_list" model="ir.ui.view">
    <field name="name">transcash.inventory.ai.request.list</field>
    <field name="model">transcash.inventory.ai.request</field>
    <field name="arch" type="xml">
      <list string="Bitácora de consultas IA" create="0" edit="0" delete="0" default_order="create_date desc">
        <field name="create_date" string="Fecha y hora"/>
        <field name="user_id"/>
        <field name="company_id" groups="base.group_system"/>
        <field name="state" decoration-success="state == 'done'" decoration-danger="state == 'failed'"/>
        <field name="metrics"/>
        <field name="dimension"/>
        <field name="row_count"/>
        <field name="duration_ms"/>
        <field name="export_count"/>
      </list>
    </field>
  </record>
  <record id="view_transcash_ai_request_form" model="ir.ui.view">
    <field name="name">transcash.inventory.ai.request.form</field>
    <field name="model">transcash.inventory.ai.request</field>
    <field name="arch" type="xml">
      <form string="Consulta IA · Auditoría" create="0" edit="0" delete="0">
        <sheet>
          <group>
            <group><field name="create_date"/><field name="user_id"/><field name="company_id"/><field name="snapshot_id"/></group>
            <group><field name="state"/><field name="duration_ms"/><field name="row_count"/><field name="export_count"/><field name="last_export_at"/></group>
          </group>
          <group string="Solicitud y resultado">
            <field name="question" readonly="1"/>
            <field name="metrics"/><field name="dimension"/>
            <field name="error_detail" readonly="1"/>
          </group>
          <notebook>
            <page string="Sentencia ejecutada"><field name="sql_query" readonly="1" nolabel="1" widget="text"/><field name="sql_parameters" readonly="1" nolabel="1" widget="text"/></page>
            <page string="Plan validado"><field name="plan_json" readonly="1" nolabel="1" widget="text"/></page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_transcash_ai_request_log" model="ir.actions.act_window">
    <field name="name">Bitácora de consultas IA</field>
    <field name="res_model">transcash.inventory.ai.request</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_transcash_ai_request_list"/>
  </record>
  <menuitem id="menu_transcash_ai_audit" name="Bitácora de consultas IA" parent="menu_transcash_root" action="action_transcash_ai_request_log" sequence="17" groups="base.group_system"/>
</odoo>
