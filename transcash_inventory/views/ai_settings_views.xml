<odoo>
    <record id="view_transcash_ai_settings" model="ir.ui.view">
        <field name="name">transcash.ai.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="arch" type="xml">
            <form string="Transcash · Configuración de ChatGPT">
                <sheet>
                    <group string="Consultas inteligentes de inventario">
                        <field name="transcash_ai_enabled"/>
                        <field name="transcash_ai_model" placeholder="gpt-5-mini"/>
                        <field name="transcash_ai_api_key" password="True" placeholder="sk-..."/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        La API Key se almacena como parámetro privado del servidor Odoo. Solo el administrador puede consultarla.
                        El navegador nunca recibe la clave. Únicamente se envían la pregunta y los resultados
                        agregados necesarios para generar la respuesta, no el catálogo completo.
                        La facturación de la API de OpenAI es independiente de ChatGPT.
                    </div>
                </sheet>
                <footer>
                    <button name="action_save_transcash_ai" string="Guardar configuración" type="object" class="btn-primary"/>
                    <button name="action_test_transcash_ai" string="Probar conexión" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_transcash_ai_settings" model="ir.actions.act_window">
        <field name="name">Configurar ChatGPT</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_transcash_ai_settings"/>
        <field name="target">current</field>
    </record>
</odoo>
