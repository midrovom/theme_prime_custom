<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_company" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.company</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='mobile']" position="inside">
                <field name="representante_legal" invisible="company_type != 'company'"/>
                <field name="ruc_representante" invisible="company_type != 'company'"/>
                <field name="correo_representante" invisible="company_type != 'company'"/>
            </xpath>
        </field>
    </record>
</odoo>

