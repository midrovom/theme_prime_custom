<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_ec_benefit_request_list" model="ir.ui.view">
        <field name="name">hr.ec.benefit.request.list</field>
        <field name="model">hr.ec.benefit.request</field>
        <field name="arch" type="xml">
            <list string="Solicitudes de décimos">
                <field name="name"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="benefit_type"/>
                <field name="year"/>
                <field name="request_date"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'signed'" decoration-danger="state == 'cancel'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_hr_ec_benefit_request_form" model="ir.ui.view">
        <field name="name">hr.ec.benefit.request.form</field>
        <field name="model">hr.ec.benefit.request</field>
        <field name="arch" type="xml">
            <form string="Solicitud de décimos">
                <header>
                    <button name="action_print_request" type="object" string="Imprimir PDF" class="btn-primary"/>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="benefit_type"/>
                            <field name="year"/>
                            <field name="request_date"/>
                        </group>
                        <group>
                            <field name="accumulate"/>
                            <field name="template_id"/>
                            <field name="package_id" readonly="1"/>
                            <field name="attachment_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Texto generado">
                            <field name="rendered_text" widget="html" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_hr_ec_benefit_request" model="ir.actions.act_window">
        <field name="name">Solicitudes de décimos</field>
        <field name="res_model">hr.ec.benefit.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
