<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_contract_form_ec_document" model="ir.ui.view">
        <field name="name">hr.contract.form.ec.document</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_print_ec_contract" type="object" class="oe_stat_button" icon="fa-file-pdf-o" invisible="not ec_rendered_text">
                    <div class="o_stat_info"><span class="o_stat_text">Contrato PDF</span></div>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Documento EC" name="ec_document" invisible="not ec_applicant_id">
                    <group>
                        <field name="ec_applicant_id" readonly="1"/>
                        <field name="ec_package_id" readonly="1"/>
                        <field name="ec_document_template_id"/>
                        <field name="ec_attachment_id" readonly="1"/>
                    </group>
                    <field name="ec_rendered_text" widget="html" nolabel="1"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_employee_form_inherit_company_config" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.company.config</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group//field[@name='category_ids']" position="after">
                <field name="company_config_id"/>
            </xpath>
        </field>
    </record>

</odoo>
