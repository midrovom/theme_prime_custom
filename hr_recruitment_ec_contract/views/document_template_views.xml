<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_ec_document_template_list" model="ir.ui.view">
        <field name="name">hr.ec.document.template.list</field>
        <field name="model">hr.ec.document.template</field>
        <field name="arch" type="xml">
            <list string="Plantillas de contratación">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="document_type"/>
                <field name="contract_type_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="is_default"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_hr_ec_document_template_form" model="ir.ui.view">
        <field name="name">hr.ec.document.template.form</field>
        <field name="model">hr.ec.document.template</field>
        <field name="arch" type="xml">
            <form string="Plantilla de contratación">
                <sheet>
                    <widget name="web_ribbon" title="Archivada" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="document_type"/>
                            <field name="contract_type_id" invisible="document_type != 'contract'" required="document_type == 'contract'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="is_default"/>
                        </group>
                        <group invisible="document_type != 'contract'">
                            <field name="default_wage"/>
                            <field name="duration_months"/>
                            <field name="trial_days"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Documento">
                            <div class="alert alert-info" role="alert">
                                Use expresiones simples como <code>&lt;t t-out="object.employee_id.name"/&gt;</code>. El modelo disponible depende del tipo de documento.
                            </div>
                            <field name="body_html" widget="html" nolabel="1"/>
                            <group>
                                <separator string="Variables disponibles"/>
                                <field name="available_variables" nolabel="1" readonly="1"/>
                            </group>
                        </page>
                        <page string="Correo" invisible="document_type != 'contract'">
                            <group>
                                <field name="email_subject"/>
                            </group>
                            <field name="email_body_html" widget="html" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_ec_document_template" model="ir.actions.act_window">
        <field name="name">Plantillas</field>
        <field name="res_model">hr.ec.document.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
