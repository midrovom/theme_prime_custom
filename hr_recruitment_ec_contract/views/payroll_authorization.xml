<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista tipo lista -->
    <record id="view_hr_ec_payroll_authorization_list" model="ir.ui.view">
        <field name="name">hr.ec.payroll.authorization.list</field>
        <field name="model">hr.ec.payroll.authorization</field>
        <field name="arch" type="xml">
            <list string="Autorizaciones de rol de pago">
                <field name="name"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="request_date"/>
                <field name="attachment_id"/>
            </list>
        </field>
    </record>

    <!-- Vista tipo formulario -->
    <record id="view_hr_ec_payroll_authorization_form" model="ir.ui.view">
        <field name="name">hr.ec.payroll.authorization.form</field>
        <field name="model">hr.ec.payroll.authorization</field>
        <field name="arch" type="xml">
            <form string="Autorización de rol de pago">
                <header>
                    <button name="action_print_request" type="object" string="Imprimir PDF" class="btn-primary"/>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="request_date"/>
                            <field name="company_config_id"/>
                        </group>
                        <group>
                            <field name="template_id"/>
                            <field name="package_id" readonly="1"/>
                            <field name="attachment_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Texto generado">
                            <field name="rendered_text" widget="html" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Acción para menú -->
    <record id="action_hr_ec_payroll_authorization" model="ir.actions.act_window">
        <field name="name">Autorizaciones de rol de pago</field>
        <field name="res_model">hr.ec.payroll.authorization</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
