<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista List -->
    <record id="view_company_config_list" model="ir.ui.view">
        <field name="name">company.config.list</field>
        <field name="model">empresa.empresa</field>
        <field name="arch" type="xml">
            <list string="Empresa">
                <field name="name"/>
                <field name="ruc"/>
                <field name="correo"/>
                <field name="direccion" />
                <field name="representante_legal"/>
                <field name="ruc_representante"/>
                <field name="correo_representante"/>
            </list> 
        </field> 
    </record>

    <!-- Vista Form -->
    <record id="view_company_config_form" model="ir.ui.view">
        <field name="name">company.config.form</field>
        <field name="model">empresa.empresa</field>
        <field name="arch" type="xml">
            <form string="Empresa">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="ruc"/>
                        <field name="correo"/>
                        <field name="direccion"/>
                        <field name="representante_legal"/>
                        <field name="ruc_representante"/>
                        <field name="correo_representante"/>
                    </group> 
                    <notebook>
                        <page string="Sucursales">
                            <field name="sucursal_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="direccion"/>
                                    <field name="ciudad"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="name"/>
                                        <field name="direccion"/>
                                        <field name="ciudad"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_company_config" model="ir.actions.act_window">
        <field name="name">Configuración de Empresas</field>
        <field name="res_model">empresa.empresa</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

