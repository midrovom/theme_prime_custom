<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista de búsqueda -->
    <record id="view_hr_ec_onboarding_package_search" model="ir.ui.view">
        <field name="name">hr.ec.onboarding.package.search</field>
        <field name="model">hr.ec.onboarding.package</field>
        <field name="arch" type="xml">
            <search string="Buscar paquetes de contratación">

                <field name="name"/>
                <field name="applicant_id"/>
                <field name="employee_id"/>
                <field name="contract_id"/>

                <separator/>

                <filter
                    name="filter_generate_date"
                    string="Filtrar generado"
                    date="generated_at"
                />

                <separator/>

                <filter
                    name="generated_yesterday"
                    string="Ayer"
                    domain="[
                        ('generated_at', '&gt;=', (context_today() - relativedelta(days=1)).strftime('%Y-%m-%d 00:00:00')),
                        ('generated_at', '&lt;', context_today().strftime('%Y-%m-%d 00:00:00'))
                    ]"
                />

                <filter
                    name="generated_today"
                    string="Hoy"
                    domain="[
                        ('generated_at', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')),
                        ('generated_at', '&lt;', (context_today() + relativedelta(days=1)).strftime('%Y-%m-%d 00:00:00'))
                    ]"
                />

                <filter
                    name="generated_last_7_days"
                    string="Últimos 7 días"
                    domain="[
                        ('generated_at', '&gt;=', (context_today() - relativedelta(days=6)).strftime('%Y-%m-%d 00:00:00')),
                        ('generated_at', '&lt;', (context_today() + relativedelta(days=1)).strftime('%Y-%m-%d 00:00:00'))
                    ]"
                />

                <filter
                    name="generated_last_30_days"
                    string="Últimos 30 días"
                    domain="[
                        ('generated_at', '&gt;=', (context_today() - relativedelta(days=29)).strftime('%Y-%m-%d 00:00:00')),
                        ('generated_at', '&lt;', (context_today() + relativedelta(days=1)).strftime('%Y-%m-%d 00:00:00'))
                    ]"
                />

            </search>
        </field>
    </record>

    <!-- Vista lista -->
    <record id="view_hr_ec_onboarding_package_list" model="ir.ui.view">
        <field name="name">hr.ec.onboarding.package.list</field>
        <field name="model">hr.ec.onboarding.package</field>
        <field name="arch" type="xml">
            <list
                string="Paquetes de contratación"
                decoration-danger="state == 'error'"
                decoration-success="state == 'ready'">

                <field name="name"/>
                <field name="applicant_id"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="contract_id"/>
                <field name="email_to" optional="show"/>
                <field name="document_count"/>
                <field name="generated_at"/>
                <field name="state"
                       widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'ready'"
                       decoration-primary="state == 'sent'"
                       decoration-danger="state == 'error'"/>
                <field name="company_id"
                       groups="base.group_multi_company"
                       optional="hide"/>

            </list>
        </field>
    </record>

    <!-- Vista formulario -->
    <record id="view_hr_ec_onboarding_package_form" model="ir.ui.view">
        <field name="name">hr.ec.onboarding.package.form</field>
        <field name="model">hr.ec.onboarding.package</field>
        <field name="arch" type="xml">
            <form string="Paquete de contratación">

                <header>
                    <button name="action_generate_documents"
                            type="object"
                            string="Generar / regenerar documentos"
                            class="btn-secondary"/>

                    <button name="action_send_email"
                            type="object"
                            string="Enviar correo"
                            class="btn-primary"
                            invisible="state != 'ready'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,ready,sent,error"/>
                </header>

                <sheet>

                    <div class="oe_button_box" name="button_box">

                        <button name="action_open_employee"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-id-card">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Empleado</span>
                            </div>
                        </button>

                        <button name="action_open_contract"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                invisible="not contract_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Contrato</span>
                            </div>
                        </button>

                        <button name="action_open_requests"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-files-o">
                            <field name="document_count"
                                   widget="statinfo"
                                   string="Archivos"/>
                        </button>

                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="applicant_id"/>
                            <field name="employee_id"/>
                            <field name="company_config_id" readonly="1"/>
                            <field name="sucursal_id" readonly="1"/>
                            <field name="contract_id" readonly="1"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>

                        <group>
                            <field name="contract_template_id"/>
                            <field name="employee_file_template_id"/>
                            <field name="generated_at" readonly="1"/>
                        </group>
                    </group>

                    <div class="alert alert-danger"
                         role="alert"
                         invisible="state != 'error'">
                        <field name="generation_message"
                               nolabel="1"
                               readonly="1"/>
                    </div>

                    <notebook>

                        <page string="Borrador de correo">
                            <group>
                                <field name="email_to" widget="email"/>
                                <field name="email_subject"/>
                            </group>

                            <field name="email_body_html"
                                   widget="html"
                                   nolabel="1"/>

                            <group>
                                <field name="attachment_ids"
                                       widget="many2many_binary"
                                       readonly="1"/>
                            </group>
                        </page>

                        <page string="Borrador de correo empleado">
                            <group>
                                <field name="employee_email_to"
                                       widget="email"/>
                                <field name="employee_email_subject"/>
                            </group>

                            <field name="employee_email_body_html"
                                   widget="html"
                                   nolabel="1"/>

                            <group>
                                <field name="employee_attachment_ids"
                                       widget="many2many_binary"
                                       readonly="1"/>
                            </group>
                        </page>

                        <page string="Solicitud de décimo Tercer y Cuarto Sueldo">
                            <field name="benefit_request_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="benefit_type"/>
                                    <field name="year"/>
                                    <field name="request_date"/>
                                    <field name="state" widget="badge"/>
                                    <field name="attachment_id"/>
                                </list>
                            </field>
                        </page>

                        <page string="Autorizaciòn rol de pago">
                            <field name="payroll_authorization_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="request_date"/>
                                    <field name="attachment_id"/>
                                </list>
                            </field>
                        </page>

                        <page string="Reglamento Interno">
                            <field name="reglamento_interno_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="request_date"/>
                                    <field name="attachment_id"/>
                                </list>
                            </field>
                        </page>

                    </notebook>

                </sheet>

                <chatter/>

            </form>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_hr_ec_onboarding_package" model="ir.actions.act_window">
        <field name="name">Paquetes de contratación</field>
        <field name="res_model">hr.ec.onboarding.package</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hr_ec_onboarding_package_search"/>
    </record>

</odoo>