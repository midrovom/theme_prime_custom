<t t-name="hr_ec_document.VariableDragWidget" owl="1">
    <div class="o_variable_drag_list">
        <t t-foreach="variables" t-as="variable">
            <span class="badge bg-info m-1"
                  draggable="true"
                  t-on-dragstart="(ev) => onDragStart(ev, variable)">
                <t t-esc="variable.data.name"/>
            </span>
        </t>
    </div>
</t>
