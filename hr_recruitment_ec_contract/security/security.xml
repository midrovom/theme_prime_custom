<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_hr_ec_document_template_company" model="ir.rule">
        <field name="name">Plantillas EC por compañía</field>
        <field name="model_id" ref="model_hr_ec_document_template"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="rule_hr_ec_config_company" model="ir.rule">
        <field name="name">Configuración EC por compañía</field>
        <field name="model_id" ref="model_hr_ec_onboarding_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
    </record>

    <record id="rule_hr_ec_package_company" model="ir.rule">
        <field name="name">Paquetes EC por compañía</field>
        <field name="model_id" ref="model_hr_ec_onboarding_package"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="rule_hr_ec_benefit_request_company" model="ir.rule">
        <field name="name">Solicitudes de décimos por compañía</field>
        <field name="model_id" ref="model_hr_ec_benefit_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>
</odoo>
