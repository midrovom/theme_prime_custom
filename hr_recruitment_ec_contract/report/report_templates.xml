        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div t-field="o.ec_rendered_text"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_ec_benefit_request">
