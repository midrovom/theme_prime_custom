<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_hr_ec_onboarding_package" model="ir.sequence">
        <field name="name">Paquete de contratación EC</field>
        <field name="code">hr.ec.onboarding.package</field>
        <field name="prefix">CONT-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_hr_ec_benefit_request" model="ir.sequence">
        <field name="name">Solicitud de décimos EC</field>
        <field name="code">hr.ec.benefit.request</field>
        <field name="prefix">DEC-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_hr_ec_payroll_authorization" model="ir.sequence">
        <field name="name">Autorización rol de pago</field>
        <field name="code">hr.ec.payroll.authorization</field>
        <field name="prefix">AUT-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_hr_ec_reglamento_interno" model="ir.sequence">
        <field name="name">Acta Reglamento Interno</field>
        <field name="code">hr.ec.reglamento.interno</field>
        <field name="prefix">REG-</field>
        <field name="padding">5</field>
    </record>


</odoo>
