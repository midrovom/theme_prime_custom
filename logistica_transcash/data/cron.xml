<odoo>
  <data noupdate="1">
    <record id="cron_transcash_sync_erp" model="ir.cron">
      <field name="name">Transcash: sincronizar guías con ERP</field>
      <field name="model_id" ref="model_transcash_guia"/>
      <field name="state">code</field>
      <field name="code">model.cron_sync_erp()</field>
      <field name="user_id" ref="base.user_root"/>
      <field name="interval_number">15</field>
      <field name="interval_type">minutes</field>
      <field name="active" eval="True"/>
    </record>
  </data>
  <record id="ir_cron_transcash_upload_cleanup" model="ir.cron">
    <field name="name">Transcash: limpiar bloques incompletos (7 días)</field>
    <field name="user_id" ref="base.user_root"/>
    <field name="model_id" ref="model_transcash_upload_sesion"/>
    <field name="state">code</field>
    <field name="code">model.cron_cleanup_chunks()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
  </record>
</odoo>
