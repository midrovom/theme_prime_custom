<odoo>
  <template id="portal_embarques" name="Transcash WebApp - Embarques">
    <html lang="es"><head><title>Mis embarques · Transcash</title>
      <t t-call="logistica_transcash.mobile_head"/>
    </head><body class="tc-app" t-att-data-tc-user-id="request.env.user.id">
      <div class="tc-shell"><t t-call="logistica_transcash.portal_desktop_sidebar"/>
        <header class="tc-top tc-top-list"><t t-call="logistica_transcash.mobile_brand"/>
          <div class="tc-avatar">T</div></header>
        <main class="tc-main tc-home">
          <div class="tc-eyebrow">🚚 OPERACIÓN DE TRANSPORTE</div>
          <a t-if="request.env.user.has_group('logistica_transcash.group_transcash_transportista') and not request.env.user.has_group('logistica_transcash.group_transcash_chofer') and not request.env.user.has_group('logistica_transcash.group_transcash_cliente')" href="/transcash/proveedor" class="tc-button tc-button-primary">💼 Ver valores y liquidaciones del proveedor →</a>
          <h1 class="tc-heading"><t t-esc="'Embarques en operación' if es_operador else 'Mis embarques' if es_chofer else 'Viajes en consulta'"/><span class="tc-title-dot">.</span></h1>
          <div t-if="es_operador" class="tc-ops-shortcuts">
            <a class="tc-button tc-button-primary" href="/transcash/operacion/rutas/nueva">＋ Crear hoja de ruta</a>
            <a class="tc-button tc-button-outline" href="/transcash/operacion/embarques/nuevo">🚚 Armar embarque</a>
          </div>
          <p t-if="es_chofer" class="tc-muted">Revisa los videos de cada ruta, acepta la carga y realiza tus entregas desde el celular.</p>
          <p t-elif="es_operador" class="tc-muted">Crea hojas de ruta, agrega guías, agrupa rutas en un viaje, valida los videos y libera el embarque al chofer.</p>
          <p t-else="" class="tc-muted">Consulta el estado de los viajes. Las acciones de planificación corresponden únicamente a Logística.</p>
          <div t-if="error" class="tc-alert tc-alert-error" role="alert"><strong>Revisa tu selección</strong><span t-esc="error"/></div>
          <div t-if="es_chofer and embarque_activo" class="tc-next-card" role="status">
            <div class="tc-next-icon">🚚</div>
            <div>
              <strong>Ya tienes un traslado en curso: <t t-esc="embarque_activo.name"/></strong>
              <p>Solo Logística arma hojas de ruta y embarques. Abre tu viaje y revisa el video de carga cuando esté listo para aceptación.</p>
              <a class="tc-button tc-button-primary" t-att-href="'/transcash/embarques/%s' % embarque_activo.id">Continuar mi embarque →</a>
            </div>
          </div>
          <div class="tc-embark-layout">
            <section class="tc-embark-section">
              <div class="tc-section-heading"><h2>Viajes</h2><span class="tc-count" t-esc="len(embarques)"/></div>
              <div class="tc-embark-list">
                <t t-foreach="embarques" t-as="e">
                  <a t-attf-class="tc-guide-card tc-embark-card #{'tc-trip-objected' if (e.objecion_pendiente or e.observacion_rechazo) and es_operador else ''}" t-att-href="('/transcash/operacion/embarques/%s' if es_operador else '/transcash/embarques/%s') % e.id">
                    <div class="tc-guide-top"><span class="tc-guide-number" t-esc="e.name"/>
                      <span t-att-class="'tc-status tc-s-' + e.state" t-esc="dict(e._fields['state'].selection).get(e.state)"/></div>
                    <strong t-esc="e.proveedor_id.name"/>
                    <div t-if="es_operador and (e.objecion_pendiente or e.observacion_rechazo)" class="tc-trip-alert-label">⛔ EMBARQUE OBJETADO · REQUIERE CORRECCIÓN</div>
                    <div class="tc-embark-meta">
                      <span>🚚 <t t-esc="e.placa or 'Sin placa'"/></span>
                      <span>📦 <t t-esc="e.cantidad_guias"/> guías</span>
                      <span>✓ <t t-esc="e.guias_cerradas_chofer"/> cerradas · <t t-esc="e.guias_entregadas"/> confirmadas</span></div>
                    <div class="tc-guide-bottom"><span t-esc="e.origen or 'Origen sin indicar'"/><span class="tc-guide-go">→</span></div>
                  </a>
                </t>
                <div t-if="not embarques" class="tc-empty-inline">No hay embarques todavía.</div>
              </div>
            </section>
            </div>
        </main>
        <nav class="tc-bottom" aria-label="Navegación">
          <a t-if="es_operador" class="tc-bottom-item" href="/transcash/operacion">▦ Operación</a>
          <a t-if="es_operador" class="tc-bottom-item" href="/transcash/operacion/rutas">▤ Rutas</a>
          <a class="tc-bottom-item active" href="/transcash/embarques">🚚 Viajes</a>
          <a class="tc-bottom-item" t-att-href="'/transcash/guias?vista=consulta' if es_operador else '/transcash/guias'">▤ Guías</a>
          <a t-if="es_chofer" class="tc-bottom-item" href="/transcash/offline" data-tc-pending-link="1">⇅ Pendientes</a></nav>
      </div>
    </body></html>
  </template>
  <template id="portal_embarque_detalle" name="Transcash WebApp - Detalle de embarque">
    <html lang="es"><head><title><t t-esc="embarque.name"/> · Transcash</title>
      <t t-call="logistica_transcash.mobile_head"/>
    </head><body class="tc-app" t-att-data-tc-user-id="request.env.user.id">
      <div class="tc-shell"><t t-call="logistica_transcash.portal_desktop_sidebar"/>
        <header class="tc-top tc-top-detail"><a class="tc-back" href="/transcash/embarques">←</a>
          <div class="tc-top-center"><small>EMBARQUE / VIAJE</small><strong t-esc="embarque.name"/></div><div class="tc-avatar">T</div></header>
        <main class="tc-main tc-detail tc-embark-detail">
          <div t-if="error" class="tc-alert tc-alert-error" role="alert"><strong>No se pudo completar</strong><span t-esc="error"/></div>
          <div t-if="request.params.get('ok')" class="tc-alert tc-alert-ok" role="status">✓ Información actualizada</div>
          <div t-if="es_chofer and (embarque.objecion_pendiente or embarque.observacion_rechazo) and embarque.state in ('embarcado','preparacion')" class="tc-embarque-critical" role="alert">⛔ VIAJE OBJETADO. Tu salida está bloqueada hasta que Logística corrija la carga y la libere nuevamente.</div>
        <section t-if="embarque.ruta_ids" class="tc-embark-section" id="tc-videos-rutas">
 <div class="tc-section-heading"><h2>📷 Ver evidencias del embarque</h2><span class="tc-count" t-esc="len(embarque.ruta_ids)"/></div>
 <div class="tc-embark-list"><t t-foreach="embarque.ruta_ids" t-as="ruta">
  <article class="tc-guide-card" style="display:block;padding:18px">
   <strong t-esc="ruta.name"/><p>📍 <t t-esc="ruta.destino_nombre"/> · <t t-esc="len(ruta.guia_ids)"/> guías</p>
   <div t-if="ruta.evidencia_carga_ids" class="tc-ops-evidence-grid">
     <t t-foreach="ruta.evidencia_carga_ids" t-as="ev"><div class="tc-ops-evidence-card">
       <img t-if="ev.tipo == 'foto'" loading="lazy" alt="Fotografía de carga" t-att-src="'/transcash/rutas/evidencia/%d' % ev.id"/>
       <video t-if="ev.tipo == 'video'" controls="controls" playsinline="playsinline" preload="metadata" t-att-src="'/transcash/rutas/evidencia/%d' % ev.id"/>
       <small>Logística: <t t-esc="ev.usuario_id.name"/> · <t t-esc="ev.fecha"/></small>
     </div></t>
   </div>
   <video t-if="ruta.video_carga and ruta.state in ('cargada','aceptada')" controls="controls" playsinline="playsinline" preload="metadata" style="max-width:100%;width:100%;border-radius:12px;background:#111" t-att-src="'/transcash/rutas/%s/video' % ruta.id"/>
   <p t-if="not ruta._has_carga_evidence()" class="tc-panel-hint">Logística todavía no ha registrado evidencia de carga.</p>
   <p t-if="ruta.observaciones" class="tc-panel-hint" t-esc="ruta.observaciones"/>
  </article>
 </t></div>
</section>
          <section t-if="es_chofer" class="tc-guided-flow tc-embark-flow">
 <div class="tc-guided-heading"><span>🚚 MI TRASLADO</span><h2>Revisar, aceptar y entregar</h2>
  <small>1. Ver fotos y videos aquí mismo → 2. Aceptar u objetar → 3. Entregar con foto y firma</small></div>
 <div class="tc-guided-buttons">
  <form t-if="embarque.state == 'embarcado' and embarque.ruta_ids and not (embarque.objecion_pendiente or embarque.observacion_rechazo)" t-att-action="'/transcash/embarques/%s/aceptar-salir' % embarque.id" method="post">
   <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
   <button type="submit" class="tc-action-tile tc-action-tile-primary"><b>✓</b><span>ACEPTAR CARGA E INICIAR TRASLADO</span><small>Confirma que revisaste todas las rutas y sus evidencias</small></button>
  </form>
  <details t-if="embarque.state == 'embarcado' and not (embarque.objecion_pendiente or embarque.observacion_rechazo)" class="tc-driver-dispute">
   <summary role="button" class="tc-action-tile tc-action-tile-danger"><b>⚠</b><span>OBJETAR ESTE EMBARQUE</span><small>Notificar una diferencia y detener la salida</small></summary>
   <form t-att-action="'/transcash/embarques/%s/observar' % embarque.id" method="post" class="tc-driver-dispute-form">
    <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
    <label class="tc-label" for="tc-dispute-reason">¿Por qué no estás conforme con la carga? *</label>
    <textarea class="tc-textarea" id="tc-dispute-reason" name="motivo" required="required" minlength="12" maxlength="2000" rows="4" placeholder="Indica la ruta, guía y qué diferencia encontraste…"/>
    <p class="tc-panel-hint">La objeción quedará en la bitácora interna y Logística deberá corregir antes de enviarte nuevamente el viaje. El cliente no verá este reporte.</p>
    <button type="submit" class="tc-button tc-button-danger">Enviar objeción a Logística</button>
   </form>
  </details>
  <div t-if="(embarque.objecion_pendiente or embarque.observacion_rechazo) and embarque.state in ('embarcado','preparacion')" class="tc-alert tc-alert-error">Objeción registrada. Logística debe revisarla y corregirla. Motivo: <span t-esc="embarque.observacion_rechazo"/></div>
  <div t-if="embarque.state == 'preparacion'" class="tc-guided-wait">⏳ Logística está preparando las rutas y grabando los videos de carga. Aún no debes salir.</div>
  <a t-if="embarque.state == 'ruta' and embarque.guia_ids.filtered(lambda g: g.state in ('ruta','destino') and not g.fecha_cierre_chofer)" t-att-href="'/transcash/guias/%d' % embarque.guia_ids.filtered(lambda g: g.state in ('ruta','destino') and not g.fecha_cierre_chofer)[0].id" class="tc-action-tile tc-action-tile-primary"><b>📍</b><span>Continuar mi siguiente entrega</span><small>Nombre, evidencia y firma del receptor</small></a>
  <div t-if="embarque.state == 'entregado'" class="tc-guided-done">✓ Finalizaste todas tus entregas. Logística podrá asignarte otro embarque.</div>
 </div>
</section><section class="tc-hero">
            <div class="tc-hero-top"><span class="tc-hero-label">ESTADO DEL EMBARQUE</span>
              <span t-att-class="'tc-status tc-s-' + embarque.state" t-esc="dict(embarque._fields['state'].selection).get(embarque.state)"/></div>
            <div class="tc-hero-route"><span class="tc-hero-pin">🚚</span><div class="tc-hero-stops">
              <div><small>PLACA</small><h1 t-esc="embarque.placa or 'Sin placa'"/></div>
              <div><small>EMPRESA DE TRANSPORTE</small><h2 t-esc="embarque.proveedor_id.name"/></div>
            </div></div>
            <div class="tc-hero-pills"><span>📦 <t t-esc="embarque.cantidad_guias"/> guías</span>
              <span>✓ <t t-esc="embarque.guias_cerradas_chofer"/> cerradas por chofer · <t t-esc="embarque.guias_entregadas"/> confirmadas por cliente</span></div>
          </section>
          <div class="tc-info-strip"><span><b>Chofer</b><t t-esc="embarque.chofer_usuario_id.name"/></span>
            <span><b>Origen</b><t t-esc="embarque.origen or 'Pendiente'"/></span></div>
          <div t-if="not request.env.user.share and embarque.observacion_general" class="tc-next-card"><div class="tc-next-icon">✎</div>
            <div><strong>Observación del embarque</strong><p t-esc="embarque.observacion_general"/></div></div>
          <div class="tc-section-heading"><h2>Guías del embarque</h2><span class="tc-count" t-esc="embarque.cantidad_guias"/></div>
          <div class="tc-embark-guides">
            <t t-foreach="embarque.guia_ids.sorted('id')" t-as="g">
              <article class="tc-embark-guide">
                <div t-if="g.fecha_cierre_chofer" class="tc-guided-done">✓ Chofer finalizó esta entrega · <t t-esc="'Cliente confirmó recepción' if g.fecha_entrega else 'Cliente por confirmar'"/></div>
                <div class="tc-guide-top"><a t-att-href="'/transcash/guias/%s' % g.id" class="tc-embark-guide-link">GUÍA <t t-esc="g.name"/> ↗</a>
                  <span t-att-class="'tc-status tc-s-' + g.state" t-esc="dict(g._fields['state'].selection).get(g.state)"/></div>
                <p><strong t-esc="g.destinatario_id.name or 'Por asignar'"/><span> · </span><t t-esc="g.destino or 'Destino por confirmar'"/></p>
                <p class="tc-muted">Documento: <t t-esc="g.tipo_documento or '—'"/> <t t-esc="g.numero_documento or ''"/></p>
                <p t-if="g.observacion_inicio_carga" class="tc-panel-hint">Inicio de carga: <t t-esc="g.observacion_inicio_carga"/></p>
                <p t-if="g.observacion_fin_carga" class="tc-panel-hint">Fin de carga: <t t-esc="g.observacion_fin_carga"/></p>
                <a class="tc-inline-action" t-att-href="'/transcash/guias/%s' % g.id">Ver productos, evidencia, roturas y recepción →</a>
              </article>
            </t>
          </div>
          <div t-if="not es_chofer">        <section t-if="embarque.ruta_ids" class="tc-embark-section" id="tc-videos-rutas">
 <div class="tc-section-heading"><h2>📹 Hojas de ruta y evidencias de carga</h2><span class="tc-count" t-esc="len(embarque.ruta_ids)"/></div>
 <div class="tc-embark-list"><t t-foreach="embarque.ruta_ids" t-as="ruta">
  <article class="tc-guide-card" style="display:block;padding:18px">
   <strong t-esc="ruta.name"/><p>📍 <t t-esc="ruta.destino_nombre"/> · <t t-esc="len(ruta.guia_ids)"/> guías</p>
   <div t-if="ruta.evidencia_carga_ids" class="tc-ops-evidence-grid">
     <t t-foreach="ruta.evidencia_carga_ids" t-as="ev"><div class="tc-ops-evidence-card">
       <img t-if="ev.tipo == 'foto'" loading="lazy" alt="Fotografía de carga" t-att-src="'/transcash/rutas/evidencia/%d' % ev.id"/>
       <video t-if="ev.tipo == 'video'" controls="controls" playsinline="playsinline" preload="metadata" t-att-src="'/transcash/rutas/evidencia/%d' % ev.id"/>
       <small>Logística: <t t-esc="ev.usuario_id.name"/> · <t t-esc="ev.fecha"/></small>
     </div></t>
   </div>
   <video t-if="ruta.video_carga and ruta.state in ('cargada','aceptada')" controls="controls" playsinline="playsinline" preload="metadata" style="max-width:100%;width:100%;border-radius:12px;background:#111" t-att-src="'/transcash/rutas/%s/video' % ruta.id"/>
   <p t-if="not ruta._has_carga_evidence()" class="tc-panel-hint">Logística todavía no ha registrado evidencia de carga.</p>
   <p t-if="ruta.observaciones" class="tc-panel-hint" t-esc="ruta.observaciones"/>
  </article>
 </t></div>
</section></div>
          <div t-if="embarque.state == 'entregado'" class="tc-delivered">✓ El chofer finalizó todas sus entregas. Puede iniciar otro embarque. Contabilidad procesa el pago según la aprobación de Logística; las novedades se revisan por separado.</div>
</main>
        <nav class="tc-bottom"><a class="tc-bottom-item active" href="/transcash/embarques">🚚 Embarques</a>
          <a class="tc-bottom-item" t-att-href="'/transcash/guias?vista=consulta' if not request.env.user.share and request.env.user.has_group('logistica_transcash.group_transcash_operador_rutas') else '/transcash/guias'">▤ Guías</a>
          <a class="tc-bottom-item" href="/transcash/offline" data-tc-pending-link="1">⇅ Pendientes</a></nav>
      </div>
    </body></html>
  </template>
</odoo>