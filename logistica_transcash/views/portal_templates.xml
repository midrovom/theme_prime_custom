<odoo>
  <template id="mobile_head" name="Transcash Mobile Head">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
    <meta name="theme-color" content="#111f35"/>
    <meta name="apple-mobile-web-app-capable" content="yes"/>
    <meta name="apple-mobile-web-app-status-bar-style" content="default"/>
    <link rel="manifest" href="/transcash/manifest.webmanifest"/>
    <link rel="apple-touch-icon" href="/logistica_transcash/static/src/img/icon-192.png"/>
    <link rel="stylesheet" href="/logistica_transcash/static/src/css/mobile.css?v=519"/>
    <script defer="defer" src="/logistica_transcash/static/src/js/offline-core.js?v=4"/>
    <script defer="defer" src="/logistica_transcash/static/src/js/mobile.js?v=550"/>
  <script defer="defer" src="/logistica_transcash/static/src/js/signature.js?v=590"/><link rel="stylesheet" href="/logistica_transcash/static/src/css/signature.css?v=590"/></template>

  <template id="mobile_brand" name="Transcash Mobile Brand">
    <div class="tc-brand"><div class="tc-logo">T<span>↗</span></div>
      <div><strong>TRANSCASH</strong><small>LOGÍSTICA EN MOVIMIENTO</small></div></div>
  </template>

  <template id="portal_desktop_sidebar" name="Transcash: navegación según rol">
    <aside class="tc-desktop-sidebar" aria-label="Navegación de Transcash según permisos">
      <div class="tc-sidebar-brand"><t t-call="logistica_transcash.mobile_brand"/><small>MI ESPACIO DE TRABAJO</small></div>
      <t t-set="ops" t-value="not request.env.user.share and (request.env.user.has_group('logistica_transcash.group_transcash_operador_rutas') or request.env.user.has_group('logistica_transcash.group_logistica_manager'))"/>
      <t t-set="driver" t-value="request.env.user.share and request.env.user.has_group('logistica_transcash.group_transcash_chofer')"/>
      <t t-set="supplier" t-value="request.env.user.share and request.env.user.has_group('logistica_transcash.group_transcash_transportista') and not driver"/>
      <t t-set="client" t-value="request.env.user.share and request.env.user.has_group('logistica_transcash.group_transcash_cliente') and not driver and not supplier"/>
      <t t-set="staff" t-value="not request.env.user.share and not ops"/>
      <t t-if="ops">
        <div class="tc-sidebar-caption">PLANIFICACIÓN LOGÍSTICA</div>
        <a href="/transcash/operacion" class="tc-sidebar-link"><span>▦</span> Centro de operaciones</a>
        <a href="/transcash/operacion/rutas/nueva" class="tc-sidebar-link"><span>＋</span> Crear hoja de ruta</a>
        <a href="/transcash/operacion/rutas" class="tc-sidebar-link"><span>▤</span> Hojas de ruta y videos</a>
        <a href="/transcash/operacion/embarques/nuevo" class="tc-sidebar-link"><span>🚚</span> Armar embarque</a>
        <a href="/transcash/embarques" class="tc-sidebar-link"><span>◎</span> Embarques y viajes</a>
        <a href="/transcash/guias?vista=consulta" class="tc-sidebar-link"><span>▤</span> Consultar guías</a>
        <a t-if="request.env.user.has_group('logistica_transcash.group_logistica_manager')" href="/web" class="tc-sidebar-link"><span>⚙</span> Tarifas · aprobaciones · ERP</a>
      </t>
      <t t-elif="driver">
        <div class="tc-sidebar-caption">MIS ENTREGAS</div>
        <a href="/transcash/embarques" class="tc-sidebar-link"><span>🚚</span> Mis embarques</a>
        <a href="/transcash/guias" class="tc-sidebar-link"><span>▤</span> Mis guías</a>
        <a href="/transcash/guias?estado=ruta" class="tc-sidebar-link"><span>↗</span> Entregas en ruta</a>
        <a href="/transcash/offline" class="tc-sidebar-link" data-tc-pending-link="1"><span>⇅</span> Evidencias pendientes</a>
      </t>
      <t t-elif="supplier">
        <div class="tc-sidebar-caption">EMPRESA TRANSPORTISTA</div>
        <a href="/transcash/proveedor" class="tc-sidebar-link"><span>💼</span> Mis viajes y liquidaciones</a>
        <a href="/transcash/embarques" class="tc-sidebar-link"><span>🚚</span> Consultar mis viajes</a>
      </t>
      <t t-elif="client">
        <div class="tc-sidebar-caption">MI RECEPCIÓN</div>
        <a href="/transcash/guias" class="tc-sidebar-link"><span>▤</span> Mis guías</a>
        <a href="/transcash/guias?estado=revision" class="tc-sidebar-link"><span>✓</span> Recepciones pendientes</a>
        <a href="/transcash/guias?estado=entregada" class="tc-sidebar-link"><span>▣</span> Entregas revisadas</a>
        <a href="/transcash/offline" class="tc-sidebar-link" data-tc-pending-link="1"><span>⇅</span> Evidencias pendientes</a>
      </t>
      <t t-elif="staff">
        <div class="tc-sidebar-caption">CONSULTA DE OPERACIONES</div>
        <a href="/transcash/guias" class="tc-sidebar-link"><span>▤</span> Guías y evidencias</a>
        <a href="/transcash/embarques" class="tc-sidebar-link"><span>🚚</span> Viajes (consulta)</a>
        <a href="/transcash/guias?estado=revision" class="tc-sidebar-link"><span>⚑</span> Consultar entregas y novedades</a>
        <a t-if="request.env.user.has_group('logistica_transcash.group_transcash_contabilidad')" href="/web" class="tc-sidebar-link"><span>💼</span> Revisar liquidaciones / registrar pagos</a>
        <a t-if="request.env.user.has_group('logistica_transcash.group_transcash_vendedor') or request.env.user.has_group('logistica_transcash.group_transcash_ventas_admin')" href="/web" class="tc-sidebar-link"><span>⚑</span> Ventas · roturas / notas de crédito</a>
        <a t-if="request.env.user.has_group('logistica_transcash.group_transcash_cobranzas') or request.env.user.has_group('logistica_transcash.group_transcash_nc_aprobador')" href="/web" class="tc-sidebar-link"><span>▣</span> Crédito · revisión de solicitudes</a>
        <a href="/web" class="tc-sidebar-link"><span>⚙</span> Mi escritorio Odoo</a>
      </t>
      <div class="tc-sidebar-bottom"><div class="tc-sidebar-user"><span class="tc-sidebar-user-avatar">●</span>
        <div><strong t-esc="request.env.user.name"/>
          <small t-if="ops">Logística · Planificación y control</small>
          <small t-elif="driver">Chofer · Aceptar y entregar</small>
          <small t-elif="supplier">Transportista · Liquidación</small>
          <small t-elif="client">Destinatario · Recepción</small>
          <small t-else="">Consulta · Usuario interno</small>
        </div></div><p>Transcash · Acceso por función</p></div>
    </aside>
  </template>

  <template id="portal_guias" name="Transcash Mobile: Mis Guías">
    <html lang="es"><head>
      <title>Mis guías · Transcash</title><t t-call="logistica_transcash.mobile_head"/>
    </head><body class="tc-app" t-att-data-tc-user-id="request.env.user.id">
      <div class="tc-shell">
        <t t-call="logistica_transcash.portal_desktop_sidebar"/>
        <header class="tc-top tc-top-list"><t t-call="logistica_transcash.mobile_brand"/>
          <div class="tc-avatar" t-att-title="request.env.user.name">●</div>
        </header>
        <main class="tc-main tc-home">
          <div class="tc-eyebrow"><span class="tc-live-dot"/> PANEL DE OPERACIONES · ACCESO SEGURO</div>
          <h1 class="tc-heading">Mis guías<span class="tc-title-dot">.</span></h1>
          <p class="tc-muted tc-home-intro">Controla tus entregas desde aquí, con toda la evidencia en un solo lugar.</p>
          <div class="tc-stat-row">
            <div class="tc-stat"><div class="tc-stat-icon">▤</div><strong t-esc="len(guias)"/><small>Guías visibles</small></div>
            <div class="tc-stat"><div class="tc-stat-icon tc-stat-icon-alt">↗</div><strong t-esc="len(guias.filtered(lambda g: g.state == 'ruta'))"/><small>En ruta</small></div>
            <div class="tc-stat"><div class="tc-stat-icon tc-stat-icon-gold">!</div><strong t-esc="len(guias.filtered(lambda g: g.incidencia_estado == 'abierta'))"/><small>Con novedades</small></div>
          </div>
          <a t-if="request.env.user.has_group('logistica_transcash.group_transcash_chofer') or request.env.user.has_group('logistica_transcash.group_transcash_transportista')" class="tc-button tc-button-primary tc-journeys-link" href="/transcash/embarques">🚚 Mis viajes asignados →</a>
          <div class="tc-section-heading"><h2>Guías asignadas</h2><span class="tc-count" t-esc="len(guias)"/></div>
          <div class="tc-desktop-list-tools">
            <label for="tc-guide-search">Buscar por número de guía, origen o destino</label>
            <div class="tc-searchbox"><span aria-hidden="true">⌕</span>
              <input type="search" id="tc-guide-search" placeholder="Ej. G-2034, Quito, Guayaquil…" autocomplete="off"/>
            </div>
          </div>
          <nav class="tc-filters" aria-label="Filtrar por estado">
            <t t-foreach="[('todas','Todas'),('embarque','En carga'),('embarcada','Cargada'),('ruta','En ruta'),('destino','En destino'),('revision','Recepción'),('entregada','Entregadas')]" t-as="filtro_guia">
              <a t-att-href="'/transcash/guias?estado=%s' % filtro_guia[0]" t-att-class="'tc-filter' + (' is-current' if estado_filtro == filtro_guia[0] else '')" t-esc="filtro_guia[1]"/>
            </t>
          </nav>
          <div class="tc-cards">
            <t t-foreach="guias" t-as="g">
              <a class="tc-guide-card" t-att-href="'/transcash/guias/%d' % g.id" t-att-data-tc-card-id="g.id" t-att-data-tc-card-name="g.name" t-att-data-tc-card-origin="g.origen or ''" t-att-data-tc-card-destination="g.destino or ''" t-att-data-tc-card-state="g.state">
                <div class="tc-guide-top"><span class="tc-guide-number">GUÍA <strong t-esc="g.name"/></span>
                  <span t-att-class="'tc-status tc-s-' + g.state" t-esc="dict(g._fields['state'].selection).get(g.state)"/></div>
                <div class="tc-guide-route"><span class="tc-route-node"/><div>
                    <div class="tc-route-city" t-esc="g.origen or 'Origen pendiente'"/>
                    <div class="tc-route-line"><span class="tc-route-arrow">↓</span> DESTINO</div>
                    <div class="tc-route-city" t-esc="g.destino or 'Destino pendiente'"/>
                  </div></div>
                <div class="tc-guide-bottom"><div class="tc-mini-meta">
                  <span>◧ <t t-esc="g.total_productos"/> productos</span>
                  <span t-if="g.fecha_cierre_chofer and not g.fecha_entrega">✓ Chofer finalizó · pendiente cliente</span>
                  <span t-if="g.roturas_pendientes" class="tc-red">! <t t-esc="g.roturas_pendientes"/> rotura(s) por revisar</span>
                  <span t-elif="g.incidencia_estado == 'abierta'" class="tc-red">! Con incidencia</span>
                  <span t-else="">✓ Registro disponible</span>
                  </div><span class="tc-guide-go">→</span></div>
              </a>
            </t>
            <div t-if="not guias" class="tc-empty"><div class="tc-empty-emoji">▤</div>
              <h3>Sin guías por ahora</h3><p>Cuando te asignen una guía, aparecerá aquí.</p>
              <a href="/transcash/guias" class="tc-link">Ver todas</a></div>
          </div>
        </main>
        <nav class="tc-bottom" aria-label="Navegación inferior">
          <a class="tc-bottom-item active" href="/transcash/guias"><span class="tc-nav-icon">▤</span>Mis guías</a>
          <span class="tc-bottom-divider"/>
          <a t-if="request.env.user.share and request.env.user.has_group('logistica_transcash.group_transcash_chofer')" class="tc-bottom-item" href="/transcash/embarques"><span class="tc-nav-icon">🚚</span>Mi viaje</a>
          <a t-elif="request.env.user.share" class="tc-bottom-item" href="/transcash/guias?estado=revision"><span class="tc-nav-icon">✓</span>Recepción</a>
          <a t-elif="request.env.user.has_group('logistica_transcash.group_transcash_operador_rutas')" class="tc-bottom-item" href="/transcash/operacion"><span class="tc-nav-icon">▦</span>Operación</a>
          <a t-else="" class="tc-bottom-item" href="/transcash/embarques"><span class="tc-nav-icon">🚚</span>Viajes</a>
          <span class="tc-bottom-divider"/>
          <a class="tc-bottom-item" href="/transcash/offline" data-tc-pending-link="1"><span class="tc-nav-icon">⇅</span>Pendientes</a>
        </nav>
      </div>
    </body></html>
  </template>

  <template id="portal_guia_detalle" name="Transcash Mobile: Detalle de guía">
    <html lang="es"><head>
      <title><t t-esc="guia.name"/> · Transcash</title><t t-call="logistica_transcash.mobile_head"/>
    </head><body class="tc-app" t-att-data-tc-user-id="request.env.user.id" t-att-data-tc-guide-id="guia.id" t-att-data-tc-guide-name="guia.name" t-att-data-tc-guide-origin="guia.origen or ''" t-att-data-tc-guide-destination="guia.destino or ''" t-att-data-tc-guide-state="guia.state">
      <div class="tc-shell">
        <t t-call="logistica_transcash.portal_desktop_sidebar"/>
        <header class="tc-top tc-top-detail"><a class="tc-back" t-att-href="'/transcash/guias?vista=consulta' if not request.env.user.share and request.env.user.has_group('logistica_transcash.group_transcash_operador_rutas') else '/transcash/guias'" aria-label="Volver">←</a>
          <div class="tc-top-center"><small>DETALLE DE GUÍA</small><strong t-esc="guia.name"/></div>
          <div class="tc-avatar">T</div>
        </header>
        <main class="tc-main tc-detail">
          <div t-if="error" class="tc-alert tc-alert-error" role="alert"><strong>Revisa los datos</strong><span t-esc="error"/></div>
          <div t-if="request.params.get('ok')" class="tc-alert tc-alert-ok" role="status">✓ Información registrada correctamente</div>
          <!-- Ruta guiada: acciones siempre visibles, sin navegar por múltiples pestañas. -->
          <section t-if="es_chofer" class="tc-guided-flow" aria-label="Mi siguiente acción">
            <div class="tc-guided-heading"><span>⚡ MODO CHOFER</span><h2>¿Qué hacemos ahora?</h2>
              <small>Guía <t t-esc="guia.name"/> · Sigue estos pasos</small></div>
            <div class="tc-guided-rail"><span t-att-class="'is-done' if guia.state != 'registrada' else 'is-current'">1. Carga</span>
              <span t-att-class="'is-done' if guia.state in ('destino','revision','entregada','lista_pago','facturada','pagada') else 'is-current' if guia.state in ('embarcada','ruta') else ''">2. Viaje</span>
              <span t-att-class="'is-done' if guia.fecha_cierre_chofer or guia.state in ('entregada','lista_pago','facturada','pagada') else 'is-current' if guia.state in ('destino','revision') else ''">3. Entrega</span></div>
            <div class="tc-guided-buttons">
              <a t-if="guia.hoja_ruta_id and guia.state in ('registrada','embarcada') and guia.embarque_id" class="tc-action-tile tc-action-tile-primary" t-att-href="'/transcash/embarques/%s' % guia.embarque_id.id"><b>▶</b><span>Revisar y aceptar carga</span><small>Desde tu embarque, con videos por ruta</small></a><form t-if="guia.state == 'ruta'" t-att-action="'/transcash/guias/%d/llegada' % guia.id" method="post">
                <input name="csrf_token" type="hidden" t-att-value="csrf_token"/>
                <button class="tc-action-tile tc-action-tile-primary" type="submit"><b>05</b><span>📍 Llegué al destino</span><small>Registrar arribo</small></button></form>
              <button t-if="guia.state == 'destino' or (guia.state == 'revision' and not guia.fecha_cierre_chofer)" class="tc-action-tile tc-action-tile-primary" type="button" data-quick-modal="evidencia" data-quick-evidence-type="llegada"><b>06</b><span>📸 Foto / video de descarga</span><small>Subir evidencia al servidor</small></button>
              <div t-if="guia.state in ('destino','revision') and not guia.fecha_cierre_chofer and not guia.evidencia_ids.filtered(lambda e: e.tipo == 'llegada' and e.archivo)" class="tc-guided-wait">📷 Primero sube una foto o video de descarga. Después podrás indicar quién recibió y finalizar.</div>
              <form t-if="guia.state in ('destino','revision') and not guia.fecha_cierre_chofer and guia.evidencia_ids.filtered(lambda e: e.tipo == 'llegada' and e.archivo)" t-att-action="'/transcash/guias/%d/finalizar-entrega' % guia.id" method="post" class="tc-driver-close-form">
                <input name="csrf_token" type="hidden" t-att-value="csrf_token"/>
                <div class="tc-receiver-required">
                  <label for="tc-persona-presente">👤 ¿Quién recibió la mercancía? <strong>Obligatorio</strong></label>
                  <input id="tc-persona-presente" class="tc-input" name="persona_presente" type="text" required="required" minlength="3" maxlength="160" autocomplete="name" placeholder="Nombre y apellido de quien recibe"/>
                  <small>El chofer registra quién recibió. El cliente podrá revisar y responder después.</small>
                </div>
                <details class="tc-quick-note"><summary>＋ ¿Alguna observación? (opcional)</summary>
                  <label class="tc-label" for="tc-cierre-observacion">Observación de entrega</label>
                  <textarea id="tc-cierre-observacion" class="tc-textarea" name="observacion" rows="2" maxlength="4000" placeholder="Deja vacío si no hubo novedades"/>
                </details>
                <div t-if="guia.hoja_ruta_id" class="tc-sign-box">
 <label>✍ Firma de quien recibe <strong>Obligatoria</strong></label>
 <p>Solicita al receptor firmar con el dedo o el mouse.</p>
 <canvas class="tc-sign-canvas" width="600" height="230" aria-label="Área para firmar"/>
 <input type="hidden" name="firma_png" class="tc-sign-value"/>
 <button type="button" class="tc-sign-clear">↶ Borrar firma</button>
 </div><button class="tc-action-tile tc-action-tile-primary tc-driver-close-btn" type="submit"><b>✓</b><span>Terminar entrega y continuar</span><small>Se requiere evidencia sincronizada y nombre del receptor. El cliente revisará después.</small></button>
              </form>
              <div t-if="guia.fecha_cierre_chofer" class="tc-guided-done">✓ Tu entrega está finalizada. El cliente podrá comentar y confirmar después. Ya puedes continuar tu viaje.</div>
              <div t-if="guia.state in ('entregada','lista_pago','facturada','pagada')" class="tc-guided-done">✓ Guía entregada. Puedes consultar todas las evidencias.</div>
            </div>
            <a t-if="guia.embarque_id" t-att-href="'/transcash/embarques/%d' % guia.embarque_id.id" class="tc-guided-return">↗ Ver todas las guías de mi embarque</a>
          </section>
          <!-- Cliente consulta solo sus guías; nunca ve el resto del embarque. -->
          <section t-if="es_receptor and not es_chofer" class="tc-guided-flow tc-customer-flow" aria-label="Revisar recepción de mi guía">
            <div class="tc-guided-heading"><span>📦 MI RECEPCIÓN</span>
              <h2 t-if="guia.state == 'revision'">Tu entrega está lista para revisar</h2>
              <h2 t-else="">Seguimiento de mi guía</h2>
              <small t-if="guia.state == 'revision'">Revisa la descarga y elige una opción. Puedes registrar daños con fotos sin detener al chofer.</small>
              <small t-else="">Consulta estados, fotos y videos. Tu recepción se habilita cuando el chofer finaliza.</small>
            </div>
            <div t-if="guia.fecha_cierre_chofer" class="tc-customer-received-by">
              <span>Persona que indicó el chofer</span><strong t-esc="guia.persona_presente_chofer or 'No registrada'"/>
              <small>Dato declarado por el chofer, pendiente de validación del cliente.</small>
            </div>
            <div class="tc-guided-buttons">
              <button class="tc-action-tile" type="button" data-go-tab="evidencias"><b>👁</b><span>1. Revisar fotos y videos</span><small>Carga y descarga · solo lectura</small></button>
              <button class="tc-action-tile" type="button" data-go-tab="productos"><b>▦</b><span>Ver productos</span><small>Cantidades enviadas y SKU</small></button>
              <a t-if="guia.state == 'revision'" href="#recepcion-cliente" class="tc-action-tile tc-action-tile-primary"><b>✓</b><span>2. Responder recepción</span><small>Todo conforme o con novedades</small></a>
              <button t-if="guia.state in ('revision','entregada') and guia.aprobacion_global != 'aprobada'" class="tc-action-tile" type="button" data-quick-modal="rotura"><b>⚠</b><span>Reportar rotura</span><small>Producto + cantidad + foto/video</small></button>
              <button t-if="guia.state in ('revision','entregada') and guia.aprobacion_global != 'aprobada'" class="tc-action-tile" type="button" data-quick-modal="evidencia" data-quick-evidence-type="cliente"><b>📷</b><span>Foto o comentario</span><small>Evidencia de recepción y novedades</small></button>
              <button class="tc-action-tile" type="button" data-go-tab="historial"><b>↗</b><span>Seguimiento completo</span><small>Historial de la guía</small></button>
            </div>
          </section>
          <section class="tc-hero">
            <div class="tc-hero-top"><span class="tc-hero-label">ESTADO DEL TRANSPORTE</span>
              <span t-att-class="'tc-status tc-s-' + guia.state" t-esc="dict(guia._fields['state'].selection).get(guia.state)"/></div>
            <div class="tc-hero-route"><span class="tc-hero-pin">●</span><div class="tc-hero-stops">
              <div><small>ORIGEN</small><h1 t-esc="guia.origen or 'Sin origen'"/></div>
              <div class="tc-hero-travel"><span class="tc-dashline"/><span>↘</span></div>
              <div><small>DESTINO</small><h2 t-esc="guia.destino or 'Sin destino'"/></div>
            </div></div>
            <div class="tc-hero-pills"><span>🚚 <t t-esc="guia.placa or 'Sin placa'"/></span>
              <span>▤ <t t-esc="guia.total_productos"/> productos</span>
              <span t-if="guia.incidencia_estado == 'abierta'" class="tc-hero-alert">⚠ Novedades</span></div>
          </section>
          <div class="tc-progress" aria-label="Progreso de guía">
            <div t-att-class="'tc-progress-step ' + ('done' if guia.state != 'registrada' else 'current')"><b>1</b><span>Carga</span></div>
            <div t-att-class="'tc-progress-step ' + ('done' if guia.state in ('destino','revision','entregada','lista_pago','facturada','pagada') else 'current' if guia.state == 'ruta' else '')"><b>2</b><span>Ruta</span></div>
            <div t-att-class="'tc-progress-step ' + ('done' if guia.state in ('entregada','lista_pago','facturada','pagada') else 'current' if guia.state in ('destino','revision') else '')"><b>3</b><span>Recepción</span></div>
            <div t-att-class="'tc-progress-step ' + ('done' if guia.aprobacion_global == 'aprobada' else 'current' if guia.state == 'entregada' else '')"><b>4</b><span>Validación</span></div>
          </div>
          <div class="tc-info-strip"><span><b>Documento</b><t t-esc="guia.tipo_documento or '—'"/> <t t-esc="guia.numero_documento or ''"/></span>
            <span><b>RUC chofer</b><t t-esc="guia.ruc_chofer or '—'"/></span>
            <span><b>Traslado previsto</b><t t-esc="guia.fecha_inicio_traslado or '—'"/> → <t t-esc="guia.fecha_fin_traslado or '—'"/></span></div>
          <div class="tc-info-strip"><span><b>Chofer</b><t t-esc="guia.chofer_usuario_id.name or 'Por asignar'"/></span>
            <span><b>Empresa de transporte</b><t t-esc="guia.proveedor_id.name or 'Por asignar'"/></span></div>

          <a t-if="es_chofer and guia.embarque_id" class="tc-button tc-button-outline tc-journeys-link" t-att-href="'/transcash/embarques/%s' % guia.embarque_id.id">🚚 Volver a mi embarque</a>

          <nav class="tc-tabs" data-tabs="1" aria-label="Secciones de la guía">
            <button type="button" class="tc-tab active" data-tab="resumen">Resumen</button>
            <button type="button" class="tc-tab" data-tab="productos">Productos</button>
            <button type="button" class="tc-tab" data-tab="evidencias">Evidencias</button>
            <button type="button" class="tc-tab" data-tab="roturas">Roturas <span t-if="guia.roturas_pendientes" class="tc-tab-alert" t-esc="guia.roturas_pendientes"/></button>
            <button type="button" class="tc-tab" data-tab="historial">Historial</button>
          </nav>
          <section class="tc-panel" data-panel="resumen" id="resumen">
            <div class="tc-section-heading"><h2>Resumen de la operación</h2></div>
            <div class="tc-summary-grid">
              <div><span class="tc-small-icon">▣</span><small>BULTOS DECLARADOS</small><strong t-esc="guia.numero_bultos"/></div>
              <div><span class="tc-small-icon">⚖</span><small>PESO DECLARADO</small><strong><t t-esc="guia.peso_kg"/> kg</strong></div>
              <div><span class="tc-small-icon">✓</span><small>APROBACIÓN GLOBAL</small><strong t-esc="'Aprobada' if guia.aprobacion_global == 'aprobada' else 'Pendiente'"/></div>
              <div><span class="tc-small-icon">!</span><small>ROTURAS POR REVISAR</small><strong t-esc="guia.roturas_pendientes"/></div>
            </div>
            <div class="tc-section-heading"><h2>Qué hacer ahora</h2></div>
            <div class="tc-next-card">
              <div class="tc-next-icon">✦</div>
              <div>
                <strong t-if="es_chofer and guia.state == 'embarque'">Logística prepara la carga</strong>
                <strong t-elif="es_chofer and guia.state == 'embarcada'">Revisa videos, acepta la carga y sal</strong>
                <strong t-elif="es_chofer and guia.state == 'ruta'">Sigue tu recorrido</strong>
                <strong t-elif="es_chofer and guia.fecha_cierre_chofer">Entrega finalizada, pendiente de cliente</strong>
                <strong t-elif="es_chofer and guia.state in ('destino','revision')">Sube foto y finaliza la entrega</strong>
                <strong t-elif="es_receptor and guia.state == 'revision'">Revisa la recepción</strong>
                <strong t-else="">Consulta el estado de la guía</strong>
                <p t-if="guia.state == 'embarque'">Logística selecciona las guías y graba los videos de carga. El chofer no necesita subir evidencias de embarque.</p>
                <p t-elif="guia.state == 'embarcada'">Abre tu embarque, revisa el video de cada ruta y pulsa aceptar e iniciar traslado.</p>
                <p t-elif="guia.state == 'ruta'">Registra tu llegada; toma foto o video y cierra la entrega. No esperas al cliente.</p>
                <p t-elif="guia.state in ('destino','revision')">Valida las evidencias de llegada y reporta daños por producto.</p>
                <p t-else="">Los documentos, observaciones y aprobaciones quedan en el historial.</p>
              </div>
            </div>
            <div class="tc-section-heading"><h2>Últimas evidencias</h2><button class="tc-text-button" type="button" data-go-tab="evidencias">Ver todas →</button></div>
            <div t-if="not evidencias" class="tc-empty-inline">Aún no hay evidencias registradas.</div>
            <t t-foreach="evidencias[:3]" t-as="ev">
              <div class="tc-feed-mini"><span class="tc-feed-mini-icon">▧</span><div>
                  <strong t-esc="dict(ev._fields['tipo'].selection).get(ev.tipo)"/>
                  <small t-esc="ev.observacion"/></div>
                <span t-att-class="'tc-dot tc-dot-' + ev.estado"/></div>
            </t>
          </section>

          <section class="tc-panel" data-panel="productos" id="productos">
            <div class="tc-section-heading"><h2>Detalle de productos</h2><span class="tc-count"><t t-esc="guia.total_productos"/></span></div>
            <p class="tc-panel-hint">Cantidad embarcada y daños aprobados. Las unidades se respetan por cada producto.</p>
            <t t-foreach="guia.linea_ids.filtered('vigente_erp')" t-as="ln">
              <div class="tc-product-card">
                <div class="tc-product-heading"><div class="tc-box-icon">▦</div><div class="tc-product-name">
                  <small t-esc="ln.codigo"/><h3 t-esc="ln.producto"/></div></div>
                <div class="tc-product-kpis">
                  <div><small>CANTIDAD DE GUÍA</small><strong><t t-esc="ln.cantidad"/> <t t-esc="dict(ln._fields['unidad'].selection).get(ln.unidad)"/></strong></div>
                  <div><small>ROTURA APROBADA</small><strong t-att-class="'tc-red' if ln.cantidad_rota_aprobada else ''"><t t-esc="ln.cantidad_rota_aprobada"/> <t t-esc="dict(ln._fields['unidad'].selection).get(ln.unidad)"/></strong></div>
                </div>
                <p class="tc-panel-hint">Peso: <t t-esc="ln.peso_kg"/> kg · Pallets: <t t-esc="ln.pallets_info"/> · Cajas: <t t-esc="ln.cajas_info"/> (conversiones informativas del ERP)</p>
                <div t-if="ln.cantidad_rota_pendiente" class="tc-product-note">⚠ <t t-esc="ln.cantidad_rota_pendiente"/> pendiente(s) de validar</div>
                <button t-if="(es_chofer and guia.state in ('embarque','embarcada','ruta','destino','revision') and not guia.fecha_cierre_chofer) or (es_receptor and guia.state in ('revision','entregada') and guia.aprobacion_global != 'aprobada') or (es_vendedor and guia.state in ('embarque','embarcada','ruta','destino','revision') and guia.aprobacion_global != 'aprobada')" class="tc-inline-action" type="button" t-att-data-damage-line="ln.id">Reportar rotura ↗</button>
              </div>
            </t>
            <div t-if="not guia.linea_ids.filtered('vigente_erp')" class="tc-empty-inline">El ERP todavía no ha enviado el detalle de productos.</div>
          </section>

          <section class="tc-panel" data-panel="evidencias" id="evidencias">
            <div class="tc-section-heading"><h2>Registro de evidencias</h2><span class="tc-count"><t t-esc="len(evidencias)"/></span></div>
            <p class="tc-panel-hint">Fotos y videos de carga, descarga y observaciones. Cada registro conserva su autor y fecha.</p>
            <t t-foreach="evidencias" t-as="ev"><article class="tc-evidence-card">
              <div class="tc-evidence-header"><div class="tc-evidence-avatar">◈</div>
                <div><strong t-esc="dict(ev._fields['tipo'].selection).get(ev.tipo)"/>
                  <small><t t-esc="ev.autor_usuario_id.name or 'Usuario'"/> · <t t-esc="ev.create_date"/></small></div>
                <span t-att-class="'tc-review tc-review-' + ev.estado" t-esc="dict(ev._fields['estado'].selection).get(ev.estado)"/></div>
              <p t-esc="ev.observacion"/>
              <p t-if="ev.rotura_id" class="tc-evidence-related">Producto: <b t-esc="ev.rotura_id.producto"/> · <t t-esc="ev.rotura_id.cantidad"/> <t t-esc="ev.rotura_id.unidad"/></p>
              <div t-if="ev.archivo" class="tc-media-box">
                <img t-if="ev.archivo_mime and ev.archivo_mime.startswith('image/')" loading="lazy" t-att-src="'/transcash/evidencia/%d/archivo' % ev.id" alt="Evidencia fotográfica"/>
                <video t-elif="ev.archivo_mime and ev.archivo_mime.startswith('video/')" controls="controls" preload="metadata" playsinline="playsinline" t-att-src="'/transcash/evidencia/%d/archivo' % ev.id">Video de evidencia</video>
                <a t-att-href="'/transcash/evidencia/%d/archivo' % ev.id" target="_blank" rel="noopener noreferrer" class="tc-media-link">Abrir archivo ↗</a>
              </div>
              <div t-if="ev.motivo_objecion" class="tc-note tc-note-warning"><b>Objeción del destinatario</b><p t-esc="ev.motivo_objecion"/></div>
              <div t-if="ev.respuesta_chofer" class="tc-note tc-note-info"><b>Respuesta del chofer</b><p t-esc="ev.respuesta_chofer"/></div>
              <div t-if="es_receptor and ev.tipo == 'llegada' and guia.state == 'revision'" class="tc-evidence-actions">
                <form t-if="ev.estado in ('pendiente','objetada')" t-att-action="'/transcash/evidencia/%d/revision/aprobar' % ev.id" method="post">
                  <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
                  <button type="submit" class="tc-button tc-button-green">✓ Aceptar evidencia</button>
                </form>
                <form t-if="ev.estado in ('pendiente','aprobada')" t-att-action="'/transcash/evidencia/%d/revision/objetar' % ev.id" method="post">
                  <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
                  <label class="tc-label">Objetar observación</label>
                  <textarea class="tc-textarea" name="motivo" rows="2" minlength="5" maxlength="4000" required="required" placeholder="Explica el desacuerdo..."/>
                  <button type="submit" class="tc-button tc-button-outline-red">Enviar objeción</button>
                </form>
              </div>
              <form t-if="es_chofer and ev.tipo == 'llegada' and ev.estado == 'objetada' and guia.state == 'revision'" t-att-action="'/transcash/evidencia/%d/respuesta' % ev.id" method="post" class="tc-evidence-actions">
                <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
                <label class="tc-label">Responder al destinatario</label>
                <textarea class="tc-textarea" name="respuesta" rows="2" maxlength="4000" required="required" placeholder="Tu explicación..."/>
                <button type="submit" class="tc-button tc-button-primary">Enviar respuesta</button>
              </form>
            </article></t>
            <div t-if="not evidencias" class="tc-empty-inline">Aún no hay fotos ni videos.</div>
          </section>

          <section class="tc-panel" data-panel="roturas" id="roturas">
            <div class="tc-section-heading"><h2>Roturas por producto</h2><span class="tc-count"><t t-esc="len(roturas)"/></span></div>
            <p class="tc-panel-hint">Cada daño debe identificar el producto, la cantidad y adjuntar evidencia. Administración revisará cada reporte y luego la guía completa.</p>
            <t t-foreach="roturas" t-as="r"><article class="tc-damage-card">
              <div class="tc-damage-top"><div><span class="tc-damage-label">REPORTE #<t t-esc="r.id"/></span>
                <h3 t-esc="r.producto"/><small t-esc="r.codigo"/></div>
                <span t-att-class="'tc-review tc-review-' + r.estado" t-esc="dict(r._fields['estado'].selection).get(r.estado)"/></div>
              <div class="tc-damage-qty"><strong><t t-esc="r.cantidad"/> <t t-esc="dict(r._fields['unidad'].selection).get(r.unidad)"/></strong><span>reportados como dañados</span></div>
              <p t-esc="r.observacion"/>
              <div class="tc-damage-evidence"><span>▧ <t t-esc="len(r.evidencia_ids)"/> archivo(s) de evidencia</span>
                <button type="button" class="tc-text-button" data-go-tab="evidencias">Ver evidencias →</button></div>
              <div t-if="r.motivo_rechazo" class="tc-note tc-note-warning"><b>Motivo de rechazo</b><p t-esc="r.motivo_rechazo"/></div>
            </article></t>
            <div t-if="not roturas" class="tc-empty-inline">No se han registrado roturas en esta guía.</div>
            <div class="tc-approval-card"><span class="tc-approval-icon">✓</span><div><strong>Validación de la guía completa</strong>
              <p t-if="guia.aprobacion_global == 'aprobada'">Aprobada por administración. Los reportes aprobados pasarán al flujo de nota de crédito.</p>
              <p t-else="">Pendiente: después de revisar todas las roturas y aceptar la entrega, administración validará la guía total.</p></div></div>
          </section>

          <section class="tc-panel" data-panel="historial" id="historial">
            <div class="tc-section-heading"><h2>Historial completo de la guía</h2><span class="tc-count" t-esc="len(historial)"/></div>
            <p class="tc-panel-hint">Seguimiento de carga, transporte, recepción, objeciones y decisiones. Esta sección es de solo lectura.</p>
            <div class="tc-timeline">
              <t t-foreach="historial" t-as="event">
                <article class="tc-timeline-event">
                  <span class="tc-timeline-dot"/>
                  <div><strong t-esc="event.accion"/><time t-esc="event.create_date"/>
                    <p t-if="event.detalle" t-esc="event.detalle"/>
                    <small t-if="event.usuario_id" t-esc="event.usuario_id.name"/>
                  </div>
                </article>
              </t>
            </div>
            <p t-if="not historial" class="tc-empty-inline">Aún no hay eventos registrados.</p>
          </section>

          <section t-if="es_receptor and guia.state == 'revision'" class="tc-reception tc-customer-decision" id="recepcion-cliente">
            <div class="tc-section-heading"><h2>¿Cómo recibiste tu mercancía?</h2></div>
            <p>El chofer ya terminó y puede seguir con su próximo viaje. Tu respuesta queda registrada por separado.</p>
            <div class="tc-reception-paths">
              <details class="tc-reception-choice tc-reception-ok" id="tc-cliente-conforme">
                <summary><span>✓</span><strong>Todo llegó conforme</strong><small>Confirmar sin novedades en pocos segundos</small></summary>
                <form t-att-action="'/transcash/guias/%d/confirmar' % guia.id" method="post" class="tc-reception-choice-form">
                  <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
                  <input type="hidden" name="resultado" value="conforme"/>
                  <label class="tc-label">Nombre de quien recibe</label>
                  <input class="tc-input" type="text" name="recibido_por" t-att-value="guia.persona_presente_chofer or ''" required="required" minlength="3" maxlength="160" autocomplete="name" placeholder="Nombre y apellido"/>
                  <label class="tc-confirm-check"><input type="checkbox" required="required"/> Revisé los productos y las evidencias de entrega.</label>
                  <button class="tc-button tc-button-primary tc-submit" type="submit">✓ Confirmar recepción conforme</button>
                </form>
              </details>
              <details class="tc-reception-choice tc-reception-issues" id="tc-cliente-novedades">
                <summary><span>!</span><strong>Tengo novedades</strong><small>Observaciones, faltantes, roturas u objeciones</small></summary>
                <div class="tc-reception-quick-issues">
                  <button type="button" data-quick-modal="rotura">⚠ Reportar rotura + evidencia</button>
                  <button type="button" data-quick-modal="evidencia" data-quick-evidence-type="cliente">📷 Agregar foto/video o novedad</button>
                  <button type="button" data-go-tab="evidencias">👁 Revisar u objetar evidencia</button>
                </div>
                <form t-att-action="'/transcash/guias/%d/confirmar' % guia.id" method="post" class="tc-reception-choice-form">
                  <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
                  <input type="hidden" name="resultado" value="con_novedades"/>
                  <label class="tc-label">Nombre de quien recibe</label>
                  <input class="tc-input" type="text" name="recibido_por" t-att-value="guia.persona_presente_chofer or ''" required="required" minlength="3" maxlength="160" autocomplete="name" placeholder="Nombre y apellido"/>
                  <label class="tc-label">¿Qué novedad encontraste?</label>
                  <textarea class="tc-textarea" name="observacion_recepcion" rows="3" minlength="5" maxlength="4000" required="required" placeholder="Ej.: Faltó una caja. Si hay productos rotos, repórtalos arriba por SKU y cantidad."/>
                  <button class="tc-button tc-button-primary tc-submit" type="submit">⚠ Registrar recepción con novedades</button>
                  <p class="tc-panel-hint">Tu novedad abrirá un seguimiento en Transcash. Para reclamar roturas debes adjuntar evidencia por producto.</p>
                </form>
              </details>
            </div>
          </section>
          <div t-if="guia.fecha_cierre_chofer" class="tc-delivered">✓ Entrega finalizada por chofer el <t t-esc="guia.fecha_cierre_chofer"/>. Recepción del cliente: <b t-esc="('Confirmada (histórico)' if guia.resultado_recepcion == 'pendiente' else dict(guia._fields['resultado_recepcion'].selection).get(guia.resultado_recepcion)) if guia.fecha_entrega else 'Pendiente'"/>.</div>
          <div t-if="guia.firma_receptor and (es_receptor or es_chofer or es_vendedor)" class="tc-sign-saved"><strong>Firma registrada por el chofer en la recepción</strong><img t-att-src="'/transcash/guias/%d/firma' % guia.id" alt="Firma de quien recibe"/></div><div t-if="guia.fecha_entrega" class="tc-delivered">✓ Cliente confirmó recepción a nombre de <b t-esc="guia.recibido_por"/> · <t t-esc="dict(guia._fields['resultado_recepcion'].selection).get(guia.resultado_recepcion)"/></div>
        </main>

        <div t-if="(es_chofer and guia.state in ('embarque','embarcada','ruta','destino','revision') and not guia.fecha_cierre_chofer) or (es_receptor and guia.state in ('revision','entregada') and guia.aprobacion_global != 'aprobada') or (es_vendedor and guia.state in ('embarque','embarcada','ruta','destino','revision') and guia.aprobacion_global != 'aprobada')" class="tc-floating">
          <button class="tc-fab" type="button" data-modal-open="action"><span>＋</span> Registrar evidencia / rotura</button>
        </div>
        <nav class="tc-bottom" aria-label="Navegación inferior">
          <a class="tc-bottom-item" t-att-href="'/transcash/guias?vista=consulta' if not request.env.user.share and request.env.user.has_group('logistica_transcash.group_transcash_operador_rutas') else '/transcash/guias'"><span class="tc-nav-icon">▤</span>Guías</a>
          <button class="tc-bottom-item active" type="button" data-go-tab="resumen"><span class="tc-nav-icon">◉</span>Resumen</button>
          <button class="tc-bottom-item" type="button" data-go-tab="productos"><span class="tc-nav-icon">▦</span>Productos</button>
          <button class="tc-bottom-item" type="button" data-go-tab="roturas"><span class="tc-nav-icon">⚠</span>Roturas</button>
          <a class="tc-bottom-item" href="/transcash/offline" data-tc-pending-link="1"><span class="tc-nav-icon">⇅</span>Pendientes</a>
        </nav>
      </div>

      <div class="tc-modal" id="tc-action-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Registrar evidencia o rotura">
        <div class="tc-modal-backdrop" data-modal-close="1"/><div class="tc-modal-sheet">
          <div class="tc-modal-handle"/><div class="tc-modal-top"><h2>Nuevo registro</h2><button class="tc-modal-close" type="button" data-modal-close="1" aria-label="Cerrar">×</button></div>
          <div class="tc-modal-segment"><button t-if="es_chofer or es_receptor" class="active" data-form-tab="evidencia" type="button">📷 Evidencia</button>
            <button type="button" data-form-tab="rotura" t-if="es_receptor or es_vendedor">⚠ Reportar rotura</button></div>
          <form t-if="es_chofer or es_receptor" class="tc-form-panel" data-form-panel="evidencia" t-att-action="'/transcash/guias/%d/evidencia' % guia.id" method="post" enctype="multipart/form-data">
            <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
            <label class="tc-label">Tipo de evidencia</label><select name="tipo" class="tc-input" required="required">
              <option t-if="es_chofer and guia.state in ('destino','revision') and not guia.fecha_cierre_chofer" value="llegada">Llegada / descarga</option>
              <option t-if="es_receptor and guia.state in ('revision','entregada')" value="cliente">Evidencia del destinatario</option>
            </select>
            <label class="tc-label">¿Hay otra novedad?</label><select class="tc-input" name="tipo_novedad">
              <option value="ninguna">Sin novedad adicional</option>
              <option value="faltante">Faltantes</option><option value="otro">Otra observación</option>
            </select>
            <label class="tc-label" for="tc-evidence-comment">Observaciones <small>(opcionales en descarga)</small></label><textarea id="tc-evidence-comment" class="tc-textarea" rows="2" name="observacion" maxlength="4000" placeholder="Sin novedades durante la descarga"/>
            <div class="tc-upload-grid">
              <label class="tc-upload-option"><span>📷</span><strong>Tomar foto</strong><small>Usar cámara</small>
                <input type="file" name="archivos" accept="image/*" capture="environment" data-media-input="1"/>
              </label>
              <label class="tc-upload-option"><span>🎥</span><strong>Grabar video</strong><small>Cámara del teléfono</small>
                <input type="file" name="archivos" accept="video/*" capture="environment" data-media-input="1"/>
              </label>
            </div>
            <label class="tc-upload-gallery">＋ Seleccionar de la galería
              <input type="file" name="archivos" accept="image/*,video/mp4,video/quicktime,video/webm" multiple="multiple" data-media-input="1"/>
            </label><div class="tc-file-preview" data-file-preview="1">Sin archivos seleccionados</div>
            <button type="submit" class="tc-button tc-button-primary tc-submit">Guardar evidencia →</button>
          </form>
          <form class="tc-form-panel" data-form-panel="rotura" t-att-action="'/transcash/guias/%d/rotura' % guia.id" method="post" enctype="multipart/form-data" t-att-hidden="None if es_vendedor and not es_chofer and not es_receptor else 'hidden'" t-if="es_receptor or es_vendedor">
            <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
            <div class="tc-form-advice">⚠ Registra la cantidad dañada por cada producto. Debes adjuntar por lo menos una foto o video.</div>
            <label class="tc-label">Producto afectado</label><select class="tc-input" name="linea_id" id="tc-damage-product" required="required">
              <option value="">Seleccionar producto…</option>
              <t t-foreach="guia.linea_ids.filtered('vigente_erp')" t-as="ln">
                <option t-att-value="ln.id" t-att-data-max="ln.cantidad" t-att-data-unit="dict(ln._fields['unidad'].selection).get(ln.unidad)">
                  <t t-esc="ln.codigo"/> · <t t-esc="ln.producto"/>
                </option>
              </t>
            </select>
            <div class="tc-quantity-help" id="tc-quantity-help">Selecciona un producto para conocer su cantidad.</div>
            <label class="tc-label">Cantidad con rotura</label>
            <div class="tc-quantity-control"><input class="tc-input" type="number" name="cantidad_rota" min="0.001" step="0.001" inputmode="decimal" required="required" placeholder="0"/>
              <span id="tc-unit-label">UND.</span></div>
            <label class="tc-label">Describe los daños</label><textarea class="tc-textarea" name="observacion" rows="3" maxlength="4000" required="required" placeholder="Ej. 2 cajas con esquinas golpeadas..."/>
            <div class="tc-upload-grid"><label class="tc-upload-option"><span>📷</span><strong>Foto del daño</strong><small>Capturar</small>
                <input type="file" name="archivos" accept="image/*" capture="environment" data-media-input="1"/></label>
              <label class="tc-upload-option"><span>🎥</span><strong>Video del daño</strong><small>Grabar</small>
                <input type="file" name="archivos" accept="video/*" capture="environment" data-media-input="1"/></label></div>
            <label class="tc-upload-gallery">＋ Agregar de la galería
              <input type="file" name="archivos" accept="image/*,video/mp4,video/quicktime,video/webm" multiple="multiple" data-media-input="1"/></label>
            <div class="tc-file-preview" data-file-preview="1">Evidencia obligatoria · máx. 6 archivos</div>
            <button type="submit" class="tc-button tc-button-danger tc-submit">Registrar rotura →</button>
          </form>
          <p class="tc-privacy-note">🔒 Archivos privados · Fotos 12 MB · Videos 75 MB · Guardado offline disponible</p>
        </div>
      </div>
    </body></html>
  </template>
</odoo>