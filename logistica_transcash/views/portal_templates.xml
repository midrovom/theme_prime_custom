<odoo>
  <template id="portal_guias" name="Transcash: Mis guías">
    <t t-call="portal.portal_layout">
      <div class="container my-4">
        <h2>Mis guías de transporte</h2>
        <p class="text-muted">Se muestran únicamente las guías en las que consta como chofer o destinatario.</p>
        <div class="table-responsive">
          <table class="table table-striped table-hover align-middle">
            <thead><tr><th>Guía</th><th>Estado</th><th>Ruta</th><th>Chofer</th><th>Incidencia</th></tr></thead>
            <tbody>
              <t t-foreach="guias" t-as="g">
                <tr>
                  <td><a t-att-href="'/transcash/guias/%d' % g.id"><strong t-esc="g.name"/></a></td>
                  <td><span class="badge bg-secondary" t-esc="dict(g._fields['state'].selection).get(g.state)"/></td>
                  <td><span t-esc="g.origen or '-'"/> → <span t-esc="g.destino or '-'"/></td>
                  <td t-esc="g.chofer_usuario_id.name or '-'"/>
                  <td><span t-if="g.incidencia_estado == 'abierta'" class="badge bg-danger">Abierta</span><span t-else="" t-esc="g.incidencia_estado"/></td>
                </tr>
              </t>
              <tr t-if="not guias"><td colspan="5" class="text-muted">No tiene guías asignadas.</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </t>
  </template>

  <template id="portal_guia_detalle" name="Transcash: Detalle de guía">
    <t t-call="portal.portal_layout">
      <div class="container my-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
          <h2 class="m-0">Guía <span t-esc="guia.name"/></h2>
          <a href="/transcash/guias" class="btn btn-outline-secondary">Volver a mis guías</a>
        </div>
        <div t-if="error" class="alert alert-danger" role="alert"><span t-esc="error"/></div>
        <div t-if="request.params.get('ok')" class="alert alert-success">Acción registrada correctamente.</div>
        <div class="row g-3 mb-4">
          <div class="col-md-6">
            <div class="card h-100"><div class="card-body">
              <h5>Ruta y estado</h5>
              <p><strong>Estado:</strong> <span t-esc="dict(guia._fields['state'].selection).get(guia.state)"/></p>
              <p><strong>Origen:</strong> <span t-esc="guia.origen or '-'"/></p>
              <p><strong>Destino:</strong> <span t-esc="guia.destino or '-'"/></p>
              <p><strong>Placa:</strong> <span t-esc="guia.placa or '-'"/></p>
              <p><strong>Bultos:</strong> <span t-esc="guia.numero_bultos"/></p>
            </div></div>
          </div>
          <div class="col-md-6">
            <div class="card h-100"><div class="card-body">
              <h5>Responsables</h5>
              <p><strong>Chofer:</strong> <span t-esc="guia.chofer_usuario_id.name or '-'"/></p>
              <p><strong>Transportista:</strong> <span t-esc="guia.transportista_id.name or '-'"/></p>
              <p><strong>Proveedor:</strong> <span t-esc="guia.proveedor_id.name or '-'"/></p>
              <p><strong>Destinatario:</strong> <span t-esc="guia.destinatario_id.name or '-'"/></p>
              <p><strong>Incidencia:</strong>
                <span t-att-class="'badge ' + ('bg-danger' if guia.incidencia_estado == 'abierta' else 'bg-secondary')"
                      t-esc="dict(guia._fields['incidencia_estado'].selection).get(guia.incidencia_estado)"/></p>
            </div></div>
          </div>
        </div>

        <div t-if="es_chofer and guia.state == 'ruta'" class="card mb-4 border-primary">
          <div class="card-body">
            <h5>Registro de llegada</h5>
            <p>Cuando esté en el destino, registre primero la llegada y después suba las evidencias de recepción.</p>
            <form t-att-action="'/transcash/guias/%d/llegada' % guia.id" method="post">
              <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
              <button type="submit" class="btn btn-primary">He llegado al destino</button>
            </form>
          </div>
        </div>

        <div t-if="(es_chofer and guia.state in ('embarque','ruta','destino','revision')) or (es_receptor and guia.state in ('destino','revision','entregada'))" class="card mb-4">
          <div class="card-body">
            <h5>Agregar observación y evidencia</h5>
            <form t-att-action="'/transcash/guias/%d/evidencia' % guia.id" method="post" enctype="multipart/form-data">
              <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label" for="evidencia_tipo">Tipo</label>
                  <select name="tipo" id="evidencia_tipo" class="form-select" required="required">
                    <option t-if="es_chofer and guia.state == 'embarque'" value="carga">Fotografía / evidencia de carga</option>
                    <option t-if="es_chofer and guia.state in ('destino','revision')" value="llegada">Fotografía / evidencia de llegada</option>
                    <option t-if="es_chofer and guia.state in ('embarque','ruta','destino','revision')" value="novedad">Novedad durante el transporte</option>
                    <option t-if="es_receptor and guia.state in ('destino','revision','entregada')" value="cliente">Observación del destinatario</option>
                  </select>
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="evidencia_novedad">¿Hay daños o diferencias?</label>
                  <select name="tipo_novedad" id="evidencia_novedad" class="form-select">
                    <option value="ninguna">Sin novedades</option><option value="rotura">Rotura</option>
                    <option value="faltante">Faltante</option><option value="otro">Otra incidencia</option>
                  </select>
                </div>
                <div class="col-12">
                  <label class="form-label" for="evidencia_observacion">Observación</label>
                  <textarea name="observacion" id="evidencia_observacion" class="form-control" rows="3"
                            maxlength="4000" required="required" placeholder="Describe el estado de la carga, precintos, embalajes o daños"/>
                </div>
                <div class="col-12">
                  <label class="form-label" for="evidencia_archivo">Foto o PDF (máximo 10 MB)</label>
                  <input type="file" class="form-control" name="archivo" id="evidencia_archivo"
                         accept="image/jpeg,image/png,image/webp,application/pdf"/>
                </div>
                <div class="col-12"><button type="submit" class="btn btn-primary">Guardar evidencia</button></div>
              </div>
            </form>
          </div>
        </div>

        <div class="card mb-4">
          <div class="card-body">
            <h5>Evidencias, observaciones y objeciones</h5>
            <p t-if="not evidencias" class="text-muted">Todavía no existen evidencias registradas.</p>
            <div t-foreach="evidencias" t-as="ev" class="border rounded p-3 mb-3">
              <div class="d-flex justify-content-between flex-wrap gap-2">
                <strong t-esc="dict(ev._fields['tipo'].selection).get(ev.tipo)"/>
                <span class="badge bg-secondary" t-esc="dict(ev._fields['estado'].selection).get(ev.estado)"/>
              </div>
              <small class="text-muted"><span t-esc="ev.autor_usuario_id.name or 'Usuario'"/> · <span t-esc="ev.create_date"/></small>
              <p class="mt-2 mb-2" t-esc="ev.observacion"/>
              <p t-if="ev.tipo_novedad != 'ninguna'" class="text-danger">Novedad: <span t-esc="ev.tipo_novedad"/></p>
              <a t-if="ev.archivo" t-att-href="'/transcash/evidencia/%d/archivo' % ev.id" target="_blank" rel="noopener noreferrer"
                 class="btn btn-sm btn-outline-secondary mb-2">Ver foto / documento</a>
              <p t-if="ev.motivo_objecion" class="alert alert-warning mb-2"><strong>Objeción:</strong> <span t-esc="ev.motivo_objecion"/></p>
              <p t-if="ev.respuesta_chofer" class="alert alert-info mb-2"><strong>Respuesta del chofer:</strong> <span t-esc="ev.respuesta_chofer"/></p>

              <div t-if="es_receptor and ev.tipo == 'llegada' and guia.state == 'revision'" class="border-top mt-2 pt-2">
                <form t-if="ev.estado in ('pendiente','objetada')"
                      t-att-action="'/transcash/evidencia/%d/revision/aprobar' % ev.id" method="post" class="mb-2">
                  <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
                  <button type="submit" class="btn btn-sm btn-success">Aceptar esta evidencia</button>
                </form>
                <form t-if="ev.estado in ('pendiente','aprobada')"
                      t-att-action="'/transcash/evidencia/%d/revision/objetar' % ev.id" method="post">
                  <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
                  <label class="form-label">Objetar observación / estado de la mercancía</label>
                  <textarea name="motivo" class="form-control mb-2" rows="2" minlength="5" maxlength="4000" required="required"/>
                  <button type="submit" class="btn btn-sm btn-outline-danger">Registrar objeción</button>
                </form>
              </div>
              <form t-if="es_chofer and ev.tipo == 'llegada' and ev.estado == 'objetada' and guia.state == 'revision'"
                    t-att-action="'/transcash/evidencia/%d/respuesta' % ev.id" method="post" class="border-top pt-2 mt-2">
                <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
                <label class="form-label">Responder a la objeción del destinatario</label>
                <textarea name="respuesta" class="form-control mb-2" rows="2" required="required" maxlength="4000"/>
                <button type="submit" class="btn btn-sm btn-outline-primary">Enviar respuesta</button>
              </form>
            </div>
          </div>
        </div>

        <div t-if="es_receptor and guia.state == 'revision'" class="card mb-4 border-success">
          <div class="card-body">
            <h5>Confirmar entrega física</h5>
            <p>Puede confirmar la entrega aunque haya reportado daños. Las incidencias abiertas bloquearán la autorización de pago.</p>
            <form t-att-action="'/transcash/guias/%d/confirmar' % guia.id" method="post">
              <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
              <label class="form-label">Nombre de quien recibe</label>
              <input type="text" class="form-control mb-3" name="recibido_por" maxlength="160" required="required"/>
              <label class="form-label">Comentarios de recepción (opcional)</label>
              <textarea class="form-control mb-3" name="observacion_recepcion" rows="2" maxlength="4000"/>
              <button type="submit" class="btn btn-success">Confirmar entrega</button>
            </form>
          </div>
        </div>
        <div t-if="guia.fecha_entrega" class="alert alert-success">
          Entregada a <strong t-esc="guia.recibido_por"/>. Fecha: <span t-esc="guia.fecha_entrega"/>.
        </div>
      </div>
    </t>
  </template>
</odoo>
