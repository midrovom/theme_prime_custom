<odoo>
  <record id="view_transcash_rotura_list" model="ir.ui.view">
    <field name="name">transcash.rotura.list</field><field name="model">transcash.rotura</field>
    <field name="arch" type="xml"><list create="0" delete="0" decoration-danger="estado == 'pendiente'">
      <field name="guia_id"/><field name="codigo"/><field name="producto"/>
      <field name="cantidad"/><field name="unidad"/><field name="estado" widget="badge"/>
      <field name="reportado_por_id"/><field name="create_date"/>
    </list></field>
  </record>
  <record id="view_transcash_rotura_form" model="ir.ui.view">
    <field name="name">transcash.rotura.form</field><field name="model">transcash.rotura</field>
    <field name="arch" type="xml"><form create="0" delete="0">
      <header><button name="action_approve" type="object" string="Aprobar rotura" class="btn-primary"
                      invisible="estado != 'pendiente'" groups="logistica_transcash.group_transcash_ventas_admin"/>
              <button name="action_reject" type="object" string="Rechazar rotura"
                      invisible="estado != 'pendiente'" groups="logistica_transcash.group_transcash_ventas_admin"/>
              <field name="estado" widget="statusbar" readonly="1"/>
      </header>
      <sheet><group><group><field name="guia_id" readonly="1"/><field name="linea_id" readonly="1"/>
        <field name="codigo"/><field name="producto"/><field name="cantidad" readonly="1"/>
        <field name="unidad"/><field name="observacion" readonly="1"/></group>
        <group><field name="reportado_por_id"/><field name="revisado_por_id"/>
          <field name="fecha_revision"/><field name="motivo_rechazo" readonly="estado != 'pendiente'"/>
          <field name="monto_referencial"/></group></group>
        <notebook><page string="Evidencia del producto"><field name="evidencia_ids" readonly="1">
          <list create="0" delete="0"><field name="tipo"/><field name="archivo_nombre"/>
            <field name="archivo_mime"/><field name="autor_usuario_id"/><field name="create_date"/>
          </list></field></page></notebook>
      </sheet></form></field>
  </record>
  <record id="action_transcash_roturas" model="ir.actions.act_window">
    <field name="name">Roturas por producto</field><field name="res_model">transcash.rotura</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('estado','=','pendiente')]</field>
  </record>
  <menuitem id="menu_transcash_roturas" name="Revisar roturas" parent="menu_transcash_root"
            action="action_transcash_roturas" sequence="33" groups="logistica_transcash.group_transcash_ventas_admin"/>
</odoo>
