<odoo>
  <record id="view_transcash_embarque_list" model="ir.ui.view">
    <field name="name">transcash.embarque.list</field><field name="model">transcash.embarque</field>
    <field name="arch" type="xml"><list string="Embarques" create="0" delete="0" decoration-success="estado_aprobacion == 'aprobado'">
      <field name="name"/><field name="state" widget="badge"/>
      <field name="chofer_usuario_id"/><field name="proveedor_id"/><field name="placa"/>
      <field name="cantidad_guias"/><field name="guias_cerradas_chofer"/><field name="guias_entregadas"/>
      <field name="estado_aprobacion" widget="badge"/>
      <field name="estado_financiero" widget="badge" groups="logistica_transcash.group_logistica_manager,logistica_transcash.group_transcash_contabilidad"/>
      <field name="valor_acordado" groups="logistica_transcash.group_logistica_manager,logistica_transcash.group_transcash_contabilidad"/>
    </list></field>
  </record>
  <record id="view_transcash_embarque_search" model="ir.ui.view">
    <field name="name">transcash.embarque.search</field><field name="model">transcash.embarque</field>
    <field name="arch" type="xml"><search><field name="name"/><field name="chofer_usuario_id"/><field name="proveedor_id"/>
      <field name="placa"/><filter name="activas" string="Operación abierta" domain="[('state','in',['preparacion','embarcado','ruta'])]"/>
      <filter name="entregadas" string="Entregas finalizadas" domain="[('state','=','entregado')]"/>
      <filter name="aprobadas" string="Fletes aprobados" domain="[('estado_aprobacion','=','aprobado')]"/>
      <filter name="por_aprobar" string="Por aprobar Logística" domain="[('state','=','entregado'),('estado_aprobacion','=','pendiente')]"/>
      <group expand="0" string="Agrupar por"><filter name="chofer" string="Chofer" context="{'group_by':'chofer_usuario_id'}"/>
        <filter name="proveedor" string="Proveedor" context="{'group_by':'proveedor_id'}"/>
        <filter name="estado" string="Estado" context="{'group_by':'state'}"/></group>
    </search></field>
  </record>
  <record id="view_transcash_embarque_form" model="ir.ui.view">
    <field name="name">transcash.embarque.form</field><field name="model">transcash.embarque</field>
    <field name="arch" type="xml"><form string="Embarque" create="0" delete="0">
      <header>
        <button name="action_depart" type="object" string="Autorizar salida" class="btn-primary"
          invisible="state != 'embarcado'" groups="logistica_transcash.group_logistica_bodega"/>
        <button name="action_configure_liquidation" type="object" string="Negociar valor del viaje"
          invisible="estado_aprobacion != 'pendiente'" groups="logistica_transcash.group_logistica_manager"/>
        <button name="action_approve_transport" type="object" string="Aprobar flete para pago" class="btn-primary"
          invisible="state != 'entregado' or estado_aprobacion != 'pendiente'"
          groups="logistica_transcash.group_logistica_manager"/>
        <button name="action_open_exception_wizard" type="object" string="Aprobar con novedades" class="btn-secondary"
          invisible="state != 'entregado' or estado_aprobacion != 'pendiente'"
          groups="logistica_transcash.group_transcash_aprobacion_excepcional"/>
        <field name="state" widget="statusbar" statusbar_visible="preparacion,embarcado,ruta,entregado"/>
      </header>
      <sheet><div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
        <group><group string="Transporte"><field name="company_id" groups="base.group_multi_company"/>
          <field name="chofer_usuario_id"/><field name="proveedor_id"/><field name="placa"/><field name="origen"/>
          <field name="fecha_creacion"/><field name="fecha_embarcado"/><field name="fecha_salida"/><field name="fecha_entrega"/>
        </group><group string="Control de entregas"><field name="cantidad_guias"/><field name="guias_cerradas_chofer"/>
          <field name="guias_entregadas"/><field name="observacion_general" readonly="1"/></group></group>
        <group string="Aprobación del transporte y negociación" groups="logistica_transcash.group_logistica_manager,logistica_transcash.group_transcash_contabilidad">
          <field name="moneda_id" invisible="1"/><field name="valor_acordado" readonly="1"/>
          <field name="estado_aprobacion"/><field name="estado_financiero"/><field name="legado_liquidacion_bloqueada"/><field name="aprobado_por_id"/>
          <field name="aprobado_fecha"/><field name="notas_revision_logistica"/>
          <field name="incidencias_pendientes"/>
          <field name="aprobacion_excepcional"/>
          <field name="motivo_excepcion_pago" invisible="not aprobacion_excepcional"/>
          <field name="excepcion_por_id" invisible="not aprobacion_excepcional"/>
          <field name="excepcion_fecha" invisible="not aprobacion_excepcional"/>
        </group>
        <notebook><page string="Guías transportadas"><field name="guia_ids" readonly="1">
          <list create="0" delete="0"><field name="name"/><field name="tipo_documento"/><field name="numero_documento"/>
            <field name="destinatario_id"/><field name="destino"/><field name="state" widget="badge"/>
            <field name="fecha_cierre_chofer"/><field name="fecha_entrega"/><field name="roturas_pendientes"/>
            <field name="incidencia_estado"/></list></field></page>
          <page string="Liquidación documental" groups="logistica_transcash.group_logistica_manager,logistica_transcash.group_transcash_contabilidad">
            <field name="liquidacion_linea_id" readonly="1"><list create="0" delete="0">
              <field name="liquidacion_id"/><field name="monto"/></list></field>
          </page>
        </notebook>
      </sheet><chatter/></form></field>
  </record>
  <record id="view_transcash_tarifa_wizard_form" model="ir.ui.view">
    <field name="name">transcash.tarifa.embarque.wizard.form</field><field name="model">transcash.tarifa.embarque.wizard</field>
    <field name="arch" type="xml"><form string="Negociar tarifa"><group><field name="embarque_id"/>
      <field name="moneda_id" invisible="1"/><field name="valor_acordado"/></group>
      <footer><button name="action_confirm" type="object" string="Guardar valor negociado" class="btn-primary"/>
        <button special="cancel" string="Cancelar"/></footer></form></field>
  </record>
  <record id="view_transcash_excepcion_wizard" model="ir.ui.view">
    <field name="name">transcash.aprobacion.excepcion.wizard.form</field>
    <field name="model">transcash.aprobacion.excepcion.wizard</field>
    <field name="arch" type="xml"><form string="Autorizar flete pese a novedades">
      <group><field name="embarque_id"/><field name="motivo" placeholder="Explique por qué procede el pago, pese a las incidencias abiertas..."/></group>
      <footer><button name="action_confirm" type="object" string="Confirmar aprobación excepcional" class="btn-primary"/>
        <button special="cancel" string="Cancelar"/></footer>
    </form></field>
  </record>
  <record id="action_transcash_embarques" model="ir.actions.act_window">
    <field name="name">Embarques / viajes</field><field name="res_model">transcash.embarque</field><field name="view_mode">list,form</field>
    <field name="context">{'search_default_activas':1}</field>
  </record>
  <record id="action_transcash_embarques_pagos" model="ir.actions.act_window">
    <field name="name">Revisión de fletes</field><field name="res_model">transcash.embarque</field><field name="view_mode">list,form</field>
    <field name="domain">[('state','=','entregado')]</field>
    <field name="context">{'search_default_por_aprobar':1}</field>
  </record>
  <menuitem id="menu_transcash_embarques" name="Embarques / viajes" parent="menu_transcash_root"
    action="action_transcash_embarques" sequence="8" groups="logistica_transcash.group_logistica_bodega,logistica_transcash.group_transcash_consulta"/>
  <menuitem id="menu_transcash_embarques_pagos" name="Aprobar fletes" parent="menu_transcash_root"
    action="action_transcash_embarques_pagos" sequence="41" groups="logistica_transcash.group_logistica_manager"/>
</odoo>
