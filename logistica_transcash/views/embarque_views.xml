<odoo>
  <record id="view_transcash_embarque_list" model="ir.ui.view">
    <field name="name">transcash.embarque.list</field><field name="model">transcash.embarque</field>
    <field name="arch" type="xml"><list string="Embarques" create="0" delete="0" decoration-success="estado_aprobacion == 'aprobado'" decoration-danger="objecion_pendiente or observacion_rechazo">
      <field name="name"/><field name="state" widget="badge"/><field name="objecion_pendiente" widget="boolean_toggle" readonly="1"/>
      <field name="chofer_usuario_id"/><field name="proveedor_id"/><field name="placa"/>
      <field name="fecha_traslado_prevista" optional="hide"/><field name="fecha_salida"/>
      <field name="fecha_entrega_prevista" optional="hide"/><field name="fecha_entrega"/>
      <field name="cantidad_guias"/><field name="guias_cerradas_chofer"/><field name="guias_entregadas"/>
      <field name="estado_aprobacion" widget="badge"/>
      <field name="estado_financiero" widget="badge" groups="logistica_transcash.group_logistica_manager,logistica_transcash.group_transcash_contabilidad"/>
      <field name="tarifa_referencial_total"
        groups="logistica_transcash.group_transcash_operador_rutas,logistica_transcash.group_logistica_manager,logistica_transcash.group_transcash_contabilidad"/>
      <field name="valor_acordado" groups="logistica_transcash.group_logistica_manager,logistica_transcash.group_transcash_contabilidad"/>
    </list></field>
  </record>
  <record id="view_transcash_embarque_search" model="ir.ui.view">
    <field name="name">transcash.embarque.search</field><field name="model">transcash.embarque</field>
    <field name="arch" type="xml"><search><field name="name"/><field name="chofer_usuario_id"/><field name="proveedor_id"/>
      <field name="placa"/><filter name="activas" string="En curso" domain="[('state','in',['preparacion','embarcado','ruta'])]"/>
      <filter name="en_revision" string="En revisión" domain="['|','|',('objecion_pendiente','=',True),'&amp;',('state','=','entregado'),('estado_aprobacion','=','pendiente'),('liquidacion_linea_id','any',[('liquidacion_id.estado','in',['revision','observada'])])]"/>
      <filter name="novedades_cliente" string="Novedades del cliente" domain="[('guia_ids','any',['|',('incidencia_estado','=','abierta'),('resultado_recepcion','=','con_novedades')])]"/>
      <filter name="entregadas" string="Entregados" domain="[('state','=','entregado')]"/>
      <filter name="todos" string="Todos los embarques" domain="[]"/>
      <filter name="aprobadas" string="Fletes aprobados" domain="[('estado_aprobacion','=','aprobado')]"/>
      <filter name="objetados" string="Objetados por chofer" domain="['|',('objecion_pendiente','=',True),('observacion_rechazo','!=',False)]"/>
      <filter name="por_aprobar" string="Por aprobar Logística" domain="[('state','=','entregado'),('estado_aprobacion','=','pendiente')]"/>
      <group expand="0" string="Agrupar por"><filter name="chofer" string="Chofer" context="{'group_by':'chofer_usuario_id'}"/>
        <filter name="proveedor" string="Proveedor" context="{'group_by':'proveedor_id'}"/>
        <filter name="estado" string="Estado" context="{'group_by':'state'}"/></group>
    </search></field>
  </record>
  <record id="view_transcash_embarque_form" model="ir.ui.view">
    <field name="name">transcash.embarque.form</field><field name="model">transcash.embarque</field>
    <field name="arch" type="xml"><form string="Embarque" create="0" delete="0">
      <header>
        <button name="action_open_add_routes" type="object" string="Agregar hojas de ruta"
          invisible="state != 'preparacion'" groups="logistica_transcash.group_transcash_operador_rutas"/>
        <button name="action_ready_for_driver" type="object" string="Liberar carga para aceptación" class="btn-primary"
          invisible="state != 'preparacion'" groups="logistica_transcash.group_transcash_operador_rutas"/>
        <button name="action_reopen_packing" type="object" string="Corregir carga observada"
          invisible="state != 'embarcado' or aceptado_chofer" groups="logistica_transcash.group_transcash_operador_rutas"/>
        <button name="action_open_resolver_objecion" type="object" string="Resolver objeción de carga"
          invisible="state != 'preparacion' or not (objecion_pendiente or observacion_rechazo)" groups="logistica_transcash.group_transcash_operador_rutas"/>
        <button name="action_depart" type="object" string="Autorizar salida" class="btn-primary"
          invisible="state != 'embarcado' or ruta_ids" groups="logistica_transcash.group_logistica_bodega"/>
        <button name="action_configure_liquidation" type="object" string="💰 Registrar precio negociado"
          invisible="estado_aprobacion != 'pendiente'" groups="logistica_transcash.group_logistica_manager"/>
        <button name="action_open_reprice_trip" type="object" string="Revisar tarifa ÚNICA del embarque"
          invisible="estado_aprobacion != 'pendiente'" groups="logistica_transcash.group_logistica_manager"/>
        <button name="action_approve_transport" type="object" string="✓ Aprobar y enviar al proveedor" class="btn-primary"
          invisible="state != 'entregado' or estado_aprobacion != 'pendiente'"
          groups="logistica_transcash.group_logistica_manager"/>
        <field name="state" widget="statusbar" statusbar_visible="preparacion,embarcado,ruta,entregado"/>
      </header>
      <sheet class="tc-ux-form tc-operation-form"><div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
        <group string="Valor del embarque" class="tc-valor-embarque"
          groups="logistica_transcash.group_transcash_operador_rutas,logistica_transcash.group_logistica_manager,logistica_transcash.group_transcash_contabilidad">
          <field name="moneda_id" invisible="1"/>
          <field name="destino_tarifa_id" readonly="1"/>
          <field name="tarifa_referencial_total" readonly="1"/>
          <field name="valor_acordado" readonly="1"
            groups="logistica_transcash.group_logistica_manager,logistica_transcash.group_transcash_contabilidad"/>
        </group>
        <div class="alert alert-warning" role="alert" invisible="not estado_rutas_inconsistente">
          Atención: el viaje figura como entregado, pero alguna hoja de ruta tiene guías sin cerrar.
          Revise las entregas y el historial antes de procesar el flete.
        </div>
        <group><group string="Transporte"><field name="company_id" groups="base.group_multi_company"/>
          <field name="chofer_usuario_id"/><field name="proveedor_id"/><field name="placa"/><field name="tipo_vehiculo"/><field name="origen"/>
          <field name="fecha_creacion"/><field name="fecha_embarcado"/>
          <field name="fecha_traslado_prevista" readonly="1"/><field name="fecha_salida"/>
          <field name="fecha_entrega_prevista" readonly="1"/><field name="fecha_entrega"/>
        </group><group string="Control de entregas"><field name="cantidad_guias"/><field name="guias_cerradas_chofer"/>
          <field name="guias_entregadas"/><field name="rutas_total" readonly="1"/>
          <field name="rutas_entregadas" readonly="1"/>
          <field name="estado_rutas_inconsistente" readonly="1"/>
          <field name="observacion_general" readonly="1"/></group></group>
        <group string="Objeción PRE-SALIDA (uso interno)" groups="logistica_transcash.group_transcash_operador_rutas,logistica_transcash.group_logistica_bodega,logistica_transcash.group_transcash_consulta">
          <field name="objecion_pendiente" readonly="1"/><field name="observacion_rechazo" readonly="1"/>
          <field name="objeciones_count" readonly="1"/>
        </group>
        <group string="2 · Negociación y aprobación (un flete por viaje)" groups="logistica_transcash.group_logistica_manager,logistica_transcash.group_transcash_contabilidad">
          <field name="estado_aprobacion"/><field name="estado_financiero"/><field name="legado_liquidacion_bloqueada"/><field name="aprobado_por_id"/>
          <field name="aprobado_fecha"/><field name="notas_revision_logistica"/>
          <field name="incidencias_pendientes"/>
          <div class="alert alert-info" role="note">
            La aprobación del flete depende únicamente del cierre operativo del chofer y del precio negociado.
            Los reclamos del cliente, roturas y notas de crédito se gestionan por separado y no bloquean al proveedor.
          </div>
          <field name="aprobacion_excepcional"/>
          <field name="motivo_excepcion_pago" invisible="not aprobacion_excepcional"/>
          <field name="excepcion_por_id" invisible="not aprobacion_excepcional"/>
          <field name="excepcion_fecha" invisible="not aprobacion_excepcional"/>
        </group>
        <notebook><page string="1 · Revisar rutas y guías"><group><field name="aceptado_chofer"/>
          <field name="fecha_aceptacion_chofer"/><field name="observacion_rechazo"/></group>
          <field name="objecion_ids" readonly="1" groups="logistica_transcash.group_transcash_operador_rutas,logistica_transcash.group_logistica_bodega,logistica_transcash.group_transcash_consulta"><list create="0" edit="0" delete="0">
            <field name="fecha"/><field name="chofer_id"/><field name="motivo"/>
            <field name="estado" widget="badge"/><field name="responsable_id"/>
            <field name="fecha_resolucion"/><field name="explicacion_resolucion"/>
          </list></field>
          <p>El estado operativo de cada ruta se actualiza con los cierres de sus guías. El estado de aceptación de carga se conserva por separado como historial.</p>
          <div class="alert alert-info" role="note">Abra una hoja de ruta para consultar sus guías, destinatarios y documentación. La galería de carga, descargas y firmas del viaje está disponible al final de esta ficha sin descargar archivos.</div>
          <field name="ruta_ids" readonly="1"><list create="0" delete="0" open_form_view="1">
            <field name="name"/><field name="destino_nombre"/><field name="tipo_vehiculo"/>
            <field name="estado_operativo" widget="badge"/>
            <field name="guias_cerradas_chofer"/><field name="guias_total"/>
            <field name="fecha_cierre_operativo"/>
            <field name="state" string="Carga/aceptación (histórico)" optional="hide"/></list></field></page>
          <page string="Guías históricas (sin hojas de ruta)" invisible="ruta_ids"><field name="guia_ids" readonly="1">
          <list create="0" delete="0"><field name="name"/><field name="tipo_documento"/><field name="numero_documento"/>
            <field name="destinatario_id"/><field name="destino"/><field name="state" widget="badge"/>
            <field name="fecha_cierre_chofer"/><field name="fecha_entrega"/><field name="roturas_pendientes"/>
            <field name="incidencia_estado"/></list></field></page>
          <page string="3 · Facturación y pagos" groups="logistica_transcash.group_logistica_manager,logistica_transcash.group_transcash_contabilidad">
            <field name="liquidacion_linea_id" readonly="1"><list create="0" delete="0">
              <field name="liquidacion_id"/><field name="monto"/></list></field>
          </page>
        </notebook>
        <div class="tc-backoffice-gallery-wrap"
             groups="logistica_transcash.group_transcash_consulta,logistica_transcash.group_logistica_bodega,logistica_transcash.group_transcash_operador_rutas,logistica_transcash.group_logistica_manager">
          <h3>Evidencias agrupadas por hoja de ruta · Carga / Descarga / Firmas</h3>
          <field name="name" widget="transcash_trip_gallery" readonly="1" nolabel="1"/>
        </div>
      </sheet><chatter/></form></field>
  </record>
  <record id="view_transcash_tarifa_wizard_form" model="ir.ui.view">
    <field name="name">transcash.tarifa.embarque.wizard.form</field><field name="model">transcash.tarifa.embarque.wizard</field>
    <field name="arch" type="xml"><form string="Negociar tarifa"><group><field name="embarque_id"/>
      <field name="moneda_id" invisible="1"/><field name="valor_acordado"/><field name="motivo" placeholder="Ej.: valor acordado telefónicamente con el transportista"/></group>
      <footer><button name="action_confirm" type="object" string="Guardar valor negociado" class="btn-primary"/>
        <button special="cancel" string="Cancelar"/></footer></form></field>
  </record>
  <record id="view_transcash_excepcion_wizard" model="ir.ui.view">
    <field name="name">transcash.aprobacion.excepcion.wizard.form</field>
    <field name="model">transcash.aprobacion.excepcion.wizard</field>
    <field name="arch" type="xml"><form string="Autorizar flete pese a novedades">
      <group><field name="embarque_id"/><field name="motivo" placeholder="Explique por qué procede el pago, pese a las incidencias abiertas..."/></group>
      <footer><button name="action_confirm" type="object" string="Confirmar aprobación excepcional" class="btn-primary"/>
        <button special="cancel" string="Cancelar"/></footer>
    </form></field>
  </record>
  <record id="action_transcash_embarques" model="ir.actions.act_window">
    <field name="name">Embarques / viajes</field><field name="res_model">transcash.embarque</field><field name="view_mode">list,form</field>
    <field name="context">{'search_default_activas':1}</field>
  </record>
  <record id="action_transcash_embarques_pagos" model="ir.actions.act_window">
    <field name="name">Revisión de fletes</field><field name="res_model">transcash.embarque</field><field name="view_mode">list,form</field>
    <field name="domain">[('state','=','entregado')]</field>
    <field name="context">{'search_default_por_aprobar':1}</field>
  </record>
  <menuitem id="menu_transcash_embarques" name="Embarques / viajes" parent="menu_transcash_root"
    action="action_transcash_embarques" sequence="8" groups="logistica_transcash.group_logistica_bodega,logistica_transcash.group_transcash_consulta,logistica_transcash.group_transcash_operador_rutas"/>
  <menuitem id="menu_transcash_embarques_pagos" name="Aprobar fletes" parent="menu_transcash_root"
    action="action_transcash_embarques_pagos" sequence="41" groups="logistica_transcash.group_logistica_manager"/>
  <record id="action_transcash_armar_embarque" model="ir.actions.act_window">
    <field name="name">Armar embarque (seleccionar rutas)</field>
    <field name="res_model">transcash.armar.embarque.wizard</field>
    <field name="view_mode">form</field><field name="target">new</field>
  </record>
  <menuitem id="menu_transcash_armar_embarque" name="Armar embarque desde rutas"
    parent="menu_transcash_root" action="action_transcash_armar_embarque" sequence="7"
    groups="logistica_transcash.group_transcash_operador_rutas"/>
</odoo>
