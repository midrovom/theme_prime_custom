<odoo>
  <record id="view_transcash_resolver_objecion_wizard" model="ir.ui.view">
    <field name="name">transcash.resolver.objecion.wizard.form</field>
    <field name="model">transcash.resolver.objecion.wizard</field>
    <field name="arch" type="xml"><form string="Resolver objeción de embarque">
      <group><field name="embarque_id" readonly="1"/><field name="solucion" required="1" placeholder="Explique las correcciones y registre nuevas evidencias antes de confirmar…"/></group>
      <footer><button name="action_confirm" string="Confirmar corrección" type="object" class="btn-primary"/>
        <button string="Cancelar" special="cancel"/></footer>
    </form></field>
  </record>
</odoo>
