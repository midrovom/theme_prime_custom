<odoo>
  <record id="view_transcash_credito_list" model="ir.ui.view">
    <field name="name">transcash.nota.credito.list</field><field name="model">transcash.nota.credito</field>
    <field name="arch" type="xml"><list create="0" delete="0"><field name="guia_id"/>
      <field name="estado" widget="badge"/><field name="monto_estimado"/>
      <field name="referencia_erp"/><field name="numero_erp"/><field name="solicitada_fecha"/>
    </list></field>
  </record>
  <record id="view_transcash_credito_form" model="ir.ui.view">
    <field name="name">transcash.nota.credito.form</field><field name="model">transcash.nota.credito</field>
    <field name="arch" type="xml"><form create="0" delete="0">
      <header>
        <button name="action_propose" type="object" string="Enviar propuesta a aprobación" class="btn-primary"
                groups="logistica_transcash.group_transcash_ventas_admin"
                invisible="estado not in ('borrador','rechazada_aprobacion')"/>
        <button name="action_approve_proposal" type="object" string="Aprobar propuesta" class="btn-primary"
                groups="logistica_transcash.group_transcash_nc_aprobador" invisible="estado != 'propuesta'"/>
        <button name="action_reject_proposal" type="object" string="Devolver propuesta"
                groups="logistica_transcash.group_transcash_nc_aprobador" invisible="estado != 'propuesta'"/>
        <button name="action_send" type="object" string="Enviar solicitud al ERP" class="btn-primary"
                groups="logistica_transcash.group_transcash_cobranzas" invisible="estado != 'aprobada'"/>
        <button name="action_retry" type="object" string="Reenviar tras rechazo ERP"
                groups="logistica_transcash.group_transcash_cobranzas" invisible="estado != 'rechazada'"/>
        <button name="action_mark_issued" type="object" string="Confirmar comprobante emitido" class="btn-primary"
                groups="logistica_transcash.group_transcash_cobranzas"
                invisible="estado not in ('enviada','emitida') or documento_validado_por_id"/>
        <field name="estado" widget="statusbar" readonly="1"/>
      </header><sheet><group><group><field name="guia_id" readonly="1"/>
          <field name="monto_estimado"/><field name="moneda_id"/>
          <field name="referencia_erp" readonly="1"/>
          <field name="numero_erp" groups="logistica_transcash.group_transcash_cobranzas"
                 readonly="estado not in ('enviada','emitida') or documento_validado_por_id"/>
          <field name="numero_erp" groups="!logistica_transcash.group_transcash_cobranzas" readonly="1"/></group>
        <group><field name="solicitada_fecha"/><field name="confirmada_fecha"/>
          <field name="observacion_erp" readonly="1"/>
          <field name="propuesta_por_id" readonly="1"/>
          <field name="aprobada_por_id" readonly="1"/>
          <field name="motivo_rechazo_aprobacion" groups="logistica_transcash.group_transcash_nc_aprobador"
                 readonly="estado != 'propuesta'"/>
          <field name="motivo_rechazo_aprobacion" groups="!logistica_transcash.group_transcash_nc_aprobador" readonly="1"/>
          <field name="archivo_nc_nombre" groups="logistica_transcash.group_transcash_cobranzas"
                 readonly="estado not in ('enviada','emitida') or documento_validado_por_id"/>
          <field name="archivo_nc" filename="archivo_nc_nombre" groups="logistica_transcash.group_transcash_cobranzas"
                 readonly="estado not in ('enviada','emitida') or documento_validado_por_id"/>
          <field name="archivo_nc_nombre" groups="!logistica_transcash.group_transcash_cobranzas" readonly="1"/>
          <field name="documento_validado_por_id" readonly="1"/>
          <field name="documento_validado_fecha" readonly="1"/>
          </group></group>
        <div class="alert alert-info" role="alert">El monto es referencial y depende de los precios enviados por ERP. La solicitud no equivale a un comprobante fiscal emitido.</div>
        <field name="linea_ids" readonly="1"><list create="0" delete="0">
          <field name="codigo"/><field name="producto"/><field name="cantidad"/>
          <field name="unidad"/><field name="precio_unitario"/><field name="subtotal"/>
        </list></field>
      </sheet></form></field>
  </record>
  <record id="action_transcash_credito" model="ir.actions.act_window">
    <field name="name">Solicitudes de nota de crédito</field>
    <field name="res_model">transcash.nota.credito</field><field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_transcash_credito" name="Notas de crédito por roturas" parent="menu_transcash_root"
            action="action_transcash_credito" sequence="37" groups="logistica_transcash.group_transcash_consulta"/>
</odoo>
