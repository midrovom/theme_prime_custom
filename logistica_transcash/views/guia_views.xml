<odoo>
  <record id="view_transcash_guia_list" model="ir.ui.view">
    <field name="name">transcash.guia.list</field>
    <field name="model">transcash.guia</field>
    <field name="arch" type="xml">
      <list string="Guías" decoration-danger="incidencia_estado == 'abierta'" decoration-success="state == 'pagada'">
        <field name="name"/>
        <field name="embarque_id"/><field name="hoja_ruta_id"/>
        <field name="tipo_documento"/><field name="numero_documento"/>
        <field name="state" widget="badge"/>
        <field name="origen"/>
        <field name="destino"/><field name="destino_codigo"/><field name="destino_ciudad"/><field name="destino_provincia"/>
        <field name="chofer_usuario_id"/>
        <field name="proveedor_id"/>
        <field name="destinatario_id"/>
        <field name="incidencia_estado"/>
        <field name="fecha_prevista"/>
      </list>
    </field>
  </record>
  <record id="view_transcash_guia_search" model="ir.ui.view">
    <field name="name">transcash.guia.search</field>
    <field name="model">transcash.guia</field>
    <field name="arch" type="xml">
      <search string="Buscar guías">
        <field name="name"/>
        <field name="external_id_erp"/>
        <field name="chofer_usuario_id"/>
        <field name="embarque_id"/>
        <field name="numero_documento"/>
        <field name="destinatario_id"/>
        <filter string="Carga" name="embarque" domain="[('state','=','embarque')]"/>
        <filter string="Cargadas" name="embarcada" domain="[('state','=','embarcada')]"/>
        <filter string="En ruta" name="ruta" domain="[('state','=','ruta')]"/>
        <filter string="En destino" name="destino" domain="[('state','=','destino')]"/>
        <filter string="Por recibir" name="revision" domain="[('state','=','revision')]"/>
        <filter string="Incidencias abiertas" name="incidentes" domain="[('incidencia_estado','=','abierta')]"/>
        <group expand="0" string="Agrupar por">
          <filter name="por_estado" string="Estado" context="{'group_by':'state'}"/>
          <filter name="por_chofer" string="Chofer" context="{'group_by':'chofer_usuario_id'}"/>
          <filter name="por_proveedor" string="Proveedor" context="{'group_by':'proveedor_id'}"/>
        </group>
      </search>
    </field>
  </record>
  <record id="view_transcash_guia_form" model="ir.ui.view">
    <field name="name">transcash.guia.form</field>
    <field name="model">transcash.guia</field>
    <field name="arch" type="xml">
      <form string="Guía" create="1">
        <header>
          <button name="action_open_evidence_gallery" type="object" string="Ver fotos y videos" icon="fa-picture-o"/>
          <button name="action_resolve_incident" type="object" string="Resolver incidencia"
                  invisible="incidencia_estado != 'abierta'" groups="logistica_transcash.group_logistica_manager"/>
          <button name="action_approve_whole_guide" type="object" string="Validar recepción para daños / NC" class="btn-primary"
                  invisible="state != 'entregada' or aprobacion_global == 'aprobada'" groups="logistica_transcash.group_logistica_manager"/>
          <button name="action_prepare_credit_request" type="object" string="Preparar propuesta NC"
                  invisible="aprobacion_global != 'aprobada' or roturas_aprobadas == 0" groups="logistica_transcash.group_transcash_ventas_admin"/>
          <field name="state" widget="statusbar" statusbar_visible="registrada,embarque,embarcada,ruta,destino,revision,entregada" readonly="1"/>
        </header>
        <sheet class="tc-ux-form tc-operation-form">
          <div class="oe_title"><h1><field name="name" placeholder="Número de guía"/></h1></div>
          <group>
            <group string="Guía y ruta">
              <field name="external_id_erp"/>
              <field name="embarque_id" readonly="1"/><field name="hoja_ruta_id" readonly="1"/>
              <field name="tipo_documento"/>
              <field name="numero_documento"/>
              <field name="ruc_chofer"/>
              <field name="fecha_inicio_traslado"/>
              <field name="fecha_fin_traslado"/>
              <field name="company_id" groups="base.group_multi_company"/>
              <field name="origen"/>
              <field name="destino"/>
              <field name="placa"/>
              <field name="fecha_prevista"/>
              <field name="fecha_salida"/>
              <field name="fecha_llegada"/>
              <field name="fecha_cierre_chofer" readonly="1"/>
              <field name="cierre_entrega_chofer_usuario_id" readonly="1"/>
              <field name="fecha_entrega" readonly="1"/>
            </group>
            <group string="Intervinientes">
              <field name="remitente_id"/>
              <field name="destinatario_id"/>
              <field name="chofer_usuario_id"/>
              <field name="proveedor_id"/>
              <field name="bodega_usuario_id"/>
            </group>
          </group>
          <group string="Carga">
            <field name="numero_bultos"/>
            <field name="peso_kg"/>
            <field name="descripcion_carga"/>
            <field name="observacion_inicio_carga" readonly="1"/><field name="observacion_fin_carga" readonly="1"/>
            <field name="observacion_cierre_chofer" readonly="1"/>
            <field name="persona_presente_chofer" readonly="1"/>
            <field name="firma_receptor" widget="image" readonly="1"/>
            <field name="firma_receptor_fecha" readonly="1"/>
            <field name="cierre_carga_autonomo" readonly="1"/><field name="cierre_carga_usuario_id" readonly="1" invisible="not cierre_carga_autonomo"/>
            <field name="cierre_carga_fecha" readonly="1" invisible="not cierre_carga_autonomo"/>
          </group>
          <group>
            <group string="Revisión de recepción y daños (no flete)">
              <field name="aprobacion_global" readonly="1"/>
              <field name="aprobacion_por_id"/>
              <field name="aprobacion_fecha"/>
            </group>
            <group string="Reporte de daños">
              <field name="total_productos"/>
              <field name="roturas_pendientes"/>
              <field name="roturas_aprobadas"/>
            </group>
          </group>
          <notebook>
            <page string="Productos de guía">
              <field name="linea_ids" readonly="1">
                <list create="0" delete="0"><field name="external_line_id"/>
                  <field name="codigo"/><field name="producto"/>
                  <field name="marca_nombre" groups="logistica_transcash.group_transcash_product_analytics,base.group_system"/><field name="proveedor_producto_nombre" groups="logistica_transcash.group_transcash_product_analytics,base.group_system"/><field name="cantidad"/>
                  <field name="unidad"/><field name="peso_kg"/><field name="pallets_info"/><field name="cajas_info"/>
                  <field name="cantidad_rota_pendiente"/>
                  <field name="cantidad_rota_aprobada"/><field name="vigente_erp"/>
                </list>
              </field>
            </page>
            <page string="Roturas por producto">
              <field name="rotura_ids" readonly="1">
                <list create="0" delete="0"><field name="linea_id"/><field name="cantidad"/>
                  <field name="unidad"/><field name="estado" widget="badge"/>
                  <field name="reportado_por_id"/><field name="create_date"/></list>
              </field>
            </page>
            <page string="Evidencias">
              <field name="evidencia_ids" readonly="1">
                <list create="0" delete="0">
                  <field name="create_date"/>
                  <field name="tipo"/>
                  <field name="observacion"/>
                  <field name="tipo_novedad"/>
                  <field name="estado" widget="badge"/>
                  <field name="autor_usuario_id"/>
                </list>
              </field>
            </page>
            <page string="Recepción">
              <group>
                <field name="fecha_entrega"/>
                <field name="recibido_por"/>
                <field name="resultado_recepcion" readonly="1"/>
                <field name="observacion_recepcion"/>
                <field name="confirmado_por_id"/>
              </group>
            </page>
            <page string="Incidencia">
              <group>
                <field name="incidencia_estado" readonly="1"/>
                <field name="resolucion_incidencia" groups="logistica_transcash.group_logistica_manager"/>
                <field name="resolucion_por_id"/>
              </group>
            </page>
            <page string="Notas de crédito" groups="logistica_transcash.group_logistica_manager">
              <field name="nota_credito_id" readonly="1">
                <list create="0" delete="0"><field name="estado" widget="badge"/>
                  <field name="referencia_erp"/><field name="numero_erp"/><field name="monto_estimado"/>
                </list>
              </field>
            </page>
            <page string="Historial">
              <field name="evento_ids" readonly="1">
                <list create="0" delete="0">
                  <field name="create_date"/>
                  <field name="accion"/>
                  <field name="usuario_id"/>
                  <field name="detalle"/>
                </list>
              </field>
            </page>
            <page string="ERP">
              <group>
                <field name="estado_erp" readonly="1"/>
                <field name="ultima_sync" readonly="1"/>
              </group>
            </page>
          </notebook>
          <div class="tc-backoffice-gallery-wrap"
               groups="logistica_transcash.group_transcash_consulta,logistica_transcash.group_logistica_bodega,logistica_transcash.group_transcash_operador_rutas,logistica_transcash.group_logistica_manager">
            <h3>Evidencias de la guía · Carga / Descarga / Firmas</h3>
            <field name="name" widget="transcash_guide_gallery" readonly="1" nolabel="1"/>
          </div>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="action_transcash_guia" model="ir.actions.act_window">
    <field name="name">Guías</field>
    <field name="res_model">transcash.guia</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_transcash_guia_search"/>
  </record>
  <record id="action_transcash_open" model="ir.actions.act_window">
    <field name="name">Guías activas</field>
    <field name="res_model">transcash.guia</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('state','in',['embarque','ruta','destino','revision'])]</field>
  </record>
  <record id="action_transcash_incidencias" model="ir.actions.act_window">
    <field name="name">Incidencias abiertas</field>
    <field name="res_model">transcash.guia</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('incidencia_estado','=','abierta')]</field>
  </record>
  <record id="action_transcash_payment" model="ir.actions.act_window">
    <field name="name">Liquidaciones de transporte por viaje</field>
    <field name="res_model">transcash.pago.liquidacion</field>
    <field name="view_mode">kanban,list,form</field>
  </record>
  <record id="action_transcash_sync" model="ir.actions.server">
    <field name="name">Sincronizar ahora desde ERP</field>
    <field name="model_id" ref="model_transcash_guia"/>
    <field name="state">code</field>
    <field name="code">action = env['transcash.guia'].action_sync_now()</field>
  </record>
  <!-- Navegación al portal responsive que se instala como PWA; la ruta
       también es válida para usuarios Portal desde el navegador del teléfono. -->
  <record id="action_transcash_mobile" model="ir.actions.act_url">
    <field name="name">Abrir WebApp móvil Transcash</field>
    <field name="url">/transcash</field>
    <field name="target">new</field>
  </record>
  <menuitem id="menu_transcash_root" name="Logística Transcash" action="action_transcash_guia" sequence="35"
            groups="logistica_transcash.group_logistica_bodega,logistica_transcash.group_logistica_manager,logistica_transcash.group_transcash_consulta,logistica_transcash.group_transcash_operador_rutas"/>
  <menuitem id="menu_transcash_mobile" name="Abrir WebApp según mi rol" parent="menu_transcash_root"
            action="action_transcash_mobile" sequence="90"
            groups="logistica_transcash.group_logistica_bodega,logistica_transcash.group_logistica_manager,logistica_transcash.group_transcash_consulta,logistica_transcash.group_transcash_operador_rutas"/>
  <menuitem id="menu_transcash_guias" name="Guías (escritorio Odoo)" parent="menu_transcash_root"
            action="action_transcash_guia" sequence="6" groups="logistica_transcash.group_logistica_bodega,logistica_transcash.group_transcash_consulta,logistica_transcash.group_transcash_operador_rutas"/>
  <!-- Registro histórico: conservar XMLID, desactivar menú legado desde el inicio. -->
  <record id="menu_transcash_activas" model="ir.ui.menu"><field name="name">Menú histórico desactivado</field>
    <field name="active" eval="False"/><field name="parent_id" ref="menu_transcash_root"/></record>
  <!-- Registro histórico: conservar XMLID, desactivar menú legado desde el inicio. -->
  <record id="menu_transcash_incidentes" model="ir.ui.menu"><field name="name">Menú histórico desactivado</field>
    <field name="active" eval="False"/><field name="parent_id" ref="menu_transcash_root"/></record>
  <!-- Registro histórico: conservar XMLID, desactivar menú legado desde el inicio. -->
  <record id="menu_transcash_pagos" model="ir.ui.menu"><field name="name">Menú histórico desactivado</field>
    <field name="active" eval="False"/><field name="parent_id" ref="menu_transcash_root"/></record>
  <menuitem id="menu_transcash_sync" name="Sincronizar ERP" parent="menu_transcash_root"
            action="action_transcash_sync" sequence="50" groups="logistica_transcash.group_logistica_manager"/>
</odoo>
