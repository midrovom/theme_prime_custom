<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="transcash_evidence_hub" name="Transcash: expediente de evidencias por hoja de ruta">
    <section class="tc-evidence-hub" id="tc-galeria-viaje" aria-label="Galería de evidencias por hoja de ruta">
      <div class="tc-evidence-hub-heading">
        <div><span class="tc-hub-eyebrow">EXPEDIENTE DIGITAL · SOLO LECTURA</span>
          <h2><t t-esc="'Evidencias de mi guía' if gallery_is_guide else 'Evidencias por hoja de ruta'"/></h2>
          <p>Consulta fotos, videos y firmas por ruta, manteniendo identificada cada guía y receptor.</p>
        </div><span class="tc-hub-count"><t t-esc="gallery_count"/> archivos</span>
      </div>
      <div class="tc-hub-jump" aria-label="Ir a hoja de ruta">
        <a t-foreach="gallery_routes" t-as="grupo" t-att-href="'#tc-hub-%s' % grupo['id']">
          🗺 <t t-esc="grupo['name']"/> <b t-esc="grupo['count']"/>
        </a>
      </div>
      <t t-foreach="gallery_routes" t-as="grupo">
        <section class="tc-hub-route" t-att-id="'tc-hub-%s' % grupo['id']">
          <div class="tc-hub-route-header">
            <div><h3>🗺 <t t-esc="grupo['name']"/></h3>
              <p t-if="grupo['destination']" t-esc="grupo['destination']"/>
              <small><t t-esc="grupo['closed_count']"/> / <t t-esc="grupo['guide_count']"/> guías entregadas por chofer</small>
            </div>
            <span t-att-class="'tc-hub-route-state tc-hub-route-' + grupo['state']" t-esc="grupo['state_label']"/>
          </div>
          <div class="tc-hub-route-stage">
            <div class="tc-section-heading"><h4>📦 Carga</h4><span class="tc-count" t-esc="len(grupo['carga'])"/></div>
            <div t-if="grupo['carga']" class="tc-hub-grid"><t t-foreach="grupo['carga']" t-as="media"><t t-call="logistica_transcash.transcash_evidence_hub_item"/></t></div>
            <p t-else="" class="tc-hub-empty">Sin evidencias de carga visibles.</p>
          </div>
          <div class="tc-hub-route-stage">
            <div class="tc-section-heading"><h4>🚚 Descarga / entrega</h4><span class="tc-count" t-esc="len(grupo['descarga'])"/></div>
            <div t-if="grupo['descarga']" class="tc-hub-grid"><t t-foreach="grupo['descarga']" t-as="media"><t t-call="logistica_transcash.transcash_evidence_hub_item"/></t></div>
            <p t-else="" class="tc-hub-empty">Aún no hay fotos o videos de descarga.</p>
          </div>
          <div class="tc-hub-route-stage">
            <div class="tc-section-heading"><h4>✍️ Firma de recepción</h4><span class="tc-count" t-esc="len(grupo['firmas'])"/></div>
            <div t-if="grupo['firmas']" class="tc-hub-grid"><t t-foreach="grupo['firmas']" t-as="media"><t t-call="logistica_transcash.transcash_evidence_hub_item"/></t></div>
            <p t-else="" class="tc-hub-empty">La ruta todavía no tiene firmas registradas.</p>
          </div>
        </section>
      </t>
      <p t-if="not gallery_routes" class="tc-hub-empty">No existen guías o rutas con evidencias para este registro.</p>
      <p class="tc-hub-private">🔒 El chofer y las áreas internas ven sus rutas autorizadas. Cada destinatario ve solamente su guía, sin datos de otros clientes ni precios del transporte.</p>
    </section>
  </template>
  <template id="transcash_evidence_hub_item" name="Transcash: tarjeta de evidencia">
    <article class="tc-hub-card">
      <a t-att-href="media['url']" target="_blank" rel="noopener noreferrer"
        class="tc-hub-open" data-tc-hub-open="1" t-att-data-hub-kind="media['kind']"
        t-att-aria-label="'Abrir %s: %s' % (media['kind'], media['title'])">
        <img t-if="media['kind'] != 'video'" loading="lazy" t-att-src="media['url']" alt="Vista previa de evidencia"/>
        <div t-else="" class="tc-hub-video-thumb"><span>▶</span><small>TOCAR PARA REPRODUCIR VIDEO</small></div>
        <span class="tc-hub-open-label">⛶ Abrir</span>
      </a>
      <div class="tc-hub-card-detail"><strong t-esc="media['title']"/>
        <small t-esc="media['subtitle']"/>
        <span>👤 <t t-esc="media['author']"/> · <t t-esc="media['date']"/></span>
      </div>
    </article>
  </template>
  <template id="transcash_evidence_hub_page" name="Transcash: galería privada de un embarque">
    <html lang="es"><head><title>Evidencias · <t t-esc="gallery_page_title"/></title>
      <t t-call="logistica_transcash.mobile_head"/>
    </head><body class="tc-app tc-hub-standalone" t-att-data-tc-user-id="request.env.user.id">
      <main class="tc-hub-page-main">
        <div class="tc-hub-page-top"><strong>TRANSCASH · <t t-esc="gallery_page_title"/></strong>
          <a t-if="not embedded" t-att-href="gallery_back_url">← Volver al viaje</a></div>
        <t t-call="logistica_transcash.transcash_evidence_hub"/>
      </main>
    </body></html>
  </template>
</odoo>
