<odoo>
  <record id="view_transcash_pago_liq_list" model="ir.ui.view">
    <field name="name">transcash.pago.liquidacion.list</field><field name="model">transcash.pago.liquidacion</field>
    <field name="arch" type="xml"><list string="Liquidaciones de transporte" create="0" edit="0" delete="0"
      decoration-success="estado == 'pagada'" decoration-warning="estado in ('revision','observada')">
      <field name="name"/><field name="proveedor_id"/><field name="company_id" groups="base.group_multi_company"/>
      <field name="estado" widget="badge"/><field name="total_acordado" sum="Total aprobado"/>
      <field name="factura_numero"/><field name="factura_total"/><field name="total_pagado" sum="Total pagado"/>
      <field name="saldo_pendiente" sum="Saldo"/><field name="create_date"/>
    </list></field>
  </record>
  <record id="view_transcash_pago_liq_form" model="ir.ui.view">
    <field name="name">transcash.pago.liquidacion.form</field><field name="model">transcash.pago.liquidacion</field>
    <field name="arch" type="xml"><form string="Liquidación documental" create="0" edit="0" delete="0">
      <header>
        <button name="action_accounting_approve" type="object" string="Aprobar factura / iniciar pago" class="btn-primary"
          invisible="estado != 'revision'" groups="logistica_transcash.group_transcash_contabilidad"/>
        <button name="action_open_observe_wizard" type="object" string="Observar factura" invisible="estado != 'revision'"
          groups="logistica_transcash.group_transcash_contabilidad"/>
        <button name="action_open_payment_wizard" type="object" string="Registrar pago" class="btn-primary"
          invisible="estado not in ('proceso_pago','parcial')" groups="logistica_transcash.group_transcash_contabilidad"/>
        <button name="action_open_guides" type="object" string="Ver guías y evidencias" icon="fa-folder-open"
          groups="logistica_transcash.group_transcash_contabilidad,logistica_transcash.group_logistica_manager"/>
        <button name="action_print" type="object" string="Imprimir liquidación"/>
        <field name="estado" widget="statusbar" statusbar_visible="borrador,revision,observada,proceso_pago,parcial,pagada"/>
      </header>
      <sheet><div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
        <group><group string="Proveedor y documento"><field name="proveedor_id"/><field name="company_id"/>
          <field name="factura_numero"/><field name="factura_fecha"/><field name="factura_archivo" filename="factura_nombre"/>
          <field name="factura_nombre" invisible="1"/>
          <field name="observacion_proveedor"/></group>
          <group string="Comparación y pagos"><field name="moneda_id" invisible="1"/>
            <field name="total_acordado"/><field name="factura_subtotal"/><field name="factura_impuestos"/>
            <field name="factura_total"/><field name="total_pagado"/><field name="saldo_pendiente"/>
            <field name="revisado_por_id"/><field name="fecha_revision"/><field name="observacion_contabilidad"/>
          </group></group>
        <notebook><page string="Embarques incluidos"><field name="linea_ids"><list create="0" edit="0" delete="0">
          <field name="embarque_id"/><field name="monto"/></list></field></page>
          <page string="Pagos registrados"><field name="pago_ids"><list create="0" edit="0" delete="0">
            <field name="fecha_pago"/><field name="monto"/><field name="referencia"/><field name="medio"/>
            <field name="comprobante" filename="comprobante_nombre"/><field name="anulado"/>
          </list></field></page></notebook>
      </sheet><chatter/></form></field>
  </record>
  <record id="view_transcash_pago_wizard_form" model="ir.ui.view">
    <field name="name">transcash.registrar.pago.wizard.form</field><field name="model">transcash.registrar.pago.wizard</field>
    <field name="arch" type="xml"><form string="Registrar pago efectuado"><group>
      <field name="liquidacion_id"/><field name="moneda_id" invisible="1"/>
      <field name="monto"/><field name="fecha_pago"/><field name="referencia"/><field name="medio"/>
      <field name="comprobante" filename="comprobante_nombre"/><field name="comprobante_nombre" invisible="1"/>
      </group><footer><button name="action_confirm" type="object" string="Guardar pago real" class="btn-primary"/>
      <button special="cancel" string="Cancelar"/></footer></form></field>
  </record>
  <record id="view_transcash_observar_pago_wizard_form" model="ir.ui.view">
    <field name="name">transcash.observar.pago.wizard.form</field><field name="model">transcash.observar.pago.wizard</field>
    <field name="arch" type="xml"><form string="Observar factura del proveedor"><group>
      <field name="liquidacion_id"/><field name="observacion"/></group>
      <footer><button name="action_confirm" type="object" string="Enviar observación" class="btn-primary"/>
      <button special="cancel" string="Cancelar"/></footer></form></field>
  </record>
  <record id="action_transcash_pago_liquidaciones" model="ir.actions.act_window">
    <field name="name">Liquidaciones de transporte</field><field name="res_model">transcash.pago.liquidacion</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_transcash_pago_liquidaciones" name="Liquidaciones y pagos" parent="menu_transcash_root"
    action="action_transcash_pago_liquidaciones" sequence="43"
    groups="logistica_transcash.group_transcash_contabilidad,logistica_transcash.group_logistica_manager"/>
</odoo>
