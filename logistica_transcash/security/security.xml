<odoo>
    <record id="module_category_transcash" model="ir.module.category">
        <field name="name">Logística Transcash</field>
        <field name="sequence">26</field>
    </record>
    <record id="group_logistica_bodega" model="res.groups">
        <field name="name">Responsable de Bodega (control y consulta)</field>
        <field name="category_id" ref="module_category_transcash"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_transcash_operador_rutas" model="res.groups">
        <field name="name">Operador Logística: planificar rutas y registrar carga</field>
        <field name="category_id" ref="module_category_transcash"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_logistica_manager" model="res.groups">
        <field name="name">Jefe / Responsable de Logística (planifica, tarifas y fletes)</field>
        <field name="category_id" ref="module_category_transcash"/>
        <field name="implied_ids" eval="[(4, ref('group_logistica_bodega')),(4, ref('group_transcash_operador_rutas'))]"/>
    </record>
    <!-- Perfil declarativo chofer: se agrega AL usuario tipo Portal. No concede
         usuario interno ni acceso directo a los modelos logísticos. Los permisos
         de captura se verifican en los controladores por guía asignada. -->
    <record id="group_transcash_chofer" model="res.groups">
        <field name="name">Chofer - WebApp móvil</field>
        <field name="category_id" ref="module_category_transcash"/>
        <field name="share" eval="True"/>
        <field name="comment">Perfil chofer: debe ser usuario Portal, estar asignado en Usuario chofer de la guía y acceder a /transcash/guias. No otorga acceso al backend.</field>
    </record>
    <!-- Perfil de identificación: el usuario debe ser Portal y coincidir con el destinatario.
         Este grupo NO confiere permisos de modelos, ni expone otros embarques o guías. -->
    <record id="group_transcash_cliente" model="res.groups">
        <field name="name">Cliente / Destinatario - WebApp (Portal)</field>
        <field name="category_id" ref="module_category_transcash"/>
        <field name="share" eval="True"/>
        <field name="comment">Consulta únicamente sus guías, pruebas de carga, ruta y descarga; solo registra evidencia, objeción, daños y conformidad de su recepción.</field>
    </record>
    <record id="group_transcash_transportista" model="res.groups">
      <field name="name">Empresa transportista: consulta de embarques (Portal)</field>
      <field name="category_id" ref="module_category_transcash"/>
      <field name="share" eval="True"/>
      <field name="comment">Permite consultar los embarques de la empresa asociada a su cuenta Portal, sin editar viajes; puede ver tarifas aprobadas y presentar su propia liquidación con factura.</field>
    </record>
    <!-- Los roles funcionales NO implican entre sí permisos de escritura. -->
    <record id="group_transcash_consulta" model="res.groups">
      <field name="name">Consulta de guías (base)</field>
      <field name="category_id" ref="module_category_transcash"/>
      <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_transcash_vendedor" model="res.groups">
      <field name="name">Vendedor: consulta y registro de roturas</field>
      <field name="category_id" ref="module_category_transcash"/>
      <field name="implied_ids" eval="[(4, ref('group_transcash_consulta'))]"/>
    </record>
    <record id="group_transcash_ventas_admin" model="res.groups">
      <field name="name">Administrador de ventas: revisión de roturas y propuestas</field>
      <field name="category_id" ref="module_category_transcash"/>
      <field name="implied_ids" eval="[(4, ref('group_transcash_consulta'))]"/>
    </record>
    <record id="group_transcash_nc_aprobador" model="res.groups">
      <field name="name">Aprobador: notas de crédito</field>
      <field name="category_id" ref="module_category_transcash"/>
      <field name="implied_ids" eval="[(4, ref('group_transcash_consulta'))]"/>
    </record>
    <record id="group_transcash_cobranzas" model="res.groups">
      <field name="name">Crédito y cobranzas: emitir y adjuntar NC</field>
      <field name="category_id" ref="module_category_transcash"/>
      <field name="implied_ids" eval="[(4, ref('group_transcash_consulta'))]"/>
    </record>
    <record id="group_transcash_contabilidad" model="res.groups">
      <field name="name">Contabilidad: liquidaciones y pagos</field>
      <field name="category_id" ref="module_category_transcash"/>
      <field name="implied_ids" eval="[(4, ref('group_transcash_consulta'))]"/>
    </record>
    <record id="group_transcash_aprobacion_excepcional" model="res.groups">
      <field name="name">Jefe Logística: autorizar flete con incidencias pendientes</field>
      <field name="category_id" ref="module_category_transcash"/>
      <field name="comment">Permiso adicional: exige rol Administrador de logística, entrega cerrada por chofer y motivo auditable. No permite registrar pagos.</field>
    </record>
    <record id="group_transcash_dashboard" model="res.groups">
      <field name="name">Analítica: consultar dashboard logístico</field>
      <field name="category_id" ref="module_category_transcash"/>
      <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
      <field name="comment">Permite consultar solo métricas agregadas de compañías autorizadas, sin acceso a modificación de guías ni pagos.</field>
    </record>
    <record id="group_transcash_product_analytics" model="res.groups">
      <field name="name">Analítica reservada: marcas y proveedores de productos</field>
      <field name="category_id" ref="module_category_transcash"/>
      <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
      <field name="comment">Acceso excepcional a datos comerciales de productos; no se implica desde perfiles logísticos.</field>
    </record>
    <record id="group_logistica_manager" model="res.groups">
      <field name="implied_ids" eval="[(4, ref('group_transcash_dashboard'))]"/>
    </record>
    <record id="group_logistica_bodega" model="res.groups">
      <field name="implied_ids" eval="[(4, ref('group_transcash_dashboard'))]"/>
    </record>
    <record id="group_transcash_operador_rutas" model="res.groups">
      <field name="implied_ids" eval="[(4, ref('group_transcash_dashboard'))]"/>
    </record>
    <record id="group_transcash_consulta" model="res.groups">
      <field name="implied_ids" eval="[(4, ref('group_transcash_dashboard'))]"/>
    </record>

    <record id="rule_transcash_guia_consulta_compania" model="ir.rule">
      <field name="name">Guías visibles solo en compañías autorizadas</field>
      <field name="model_id" ref="model_transcash_guia"/>
      <field name="groups" eval="[(4,ref('group_transcash_consulta'))]"/>
      <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_evidencia_consulta_compania" model="ir.rule">
      <field name="name">Transcash evidencia: lectura por compañía</field>
      <field name="model_id" ref="model_transcash_evidencia"/>
      <field name="groups" eval="[(4,ref('group_transcash_consulta'))]"/>
      <field name="domain_force">[('guia_id.company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_evento_consulta_compania" model="ir.rule">
      <field name="name">Transcash evento: lectura por compañía</field>
      <field name="model_id" ref="model_transcash_evento"/>
      <field name="groups" eval="[(4,ref('group_transcash_consulta'))]"/>
      <field name="domain_force">[('guia_id.company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_guia_linea_consulta_compania" model="ir.rule">
      <field name="name">Transcash guia_linea: lectura por compañía</field>
      <field name="model_id" ref="model_transcash_guia_linea"/>
      <field name="groups" eval="[(4,ref('group_transcash_consulta'))]"/>
      <field name="domain_force">[('guia_id.company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_rotura_consulta_compania" model="ir.rule">
      <field name="name">Transcash rotura: lectura por compañía</field>
      <field name="model_id" ref="model_transcash_rotura"/>
      <field name="groups" eval="[(4,ref('group_transcash_consulta'))]"/>
      <field name="domain_force">[('guia_id.company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_nota_credito_consulta_compania" model="ir.rule">
      <field name="name">Transcash nota_credito: lectura por compañía</field>
      <field name="model_id" ref="model_transcash_nota_credito"/>
      <field name="groups" eval="[(4,ref('group_transcash_consulta'))]"/>
      <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_nota_credito_linea_consulta_compania" model="ir.rule">
      <field name="name">Transcash nota_credito_linea: lectura por compañía</field>
      <field name="model_id" ref="model_transcash_nota_credito_linea"/>
      <field name="groups" eval="[(4,ref('group_transcash_consulta'))]"/>
      <field name="domain_force">[('solicitud_id.company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_liquidacion_company" model="ir.rule">
      <field name="name">Liquidaciones: compañías autorizadas</field>
      <field name="model_id" ref="model_transcash_pago_liquidacion"/>
      <field name="groups" eval="[(4,ref('group_logistica_manager')),(4,ref('group_transcash_contabilidad'))]"/>
      <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_liquidacion_linea_company" model="ir.rule">
      <field name="name">Líneas de liquidación: compañías autorizadas</field>
      <field name="model_id" ref="model_transcash_pago_liquidacion_linea"/>
      <field name="groups" eval="[(4,ref('group_logistica_manager')),(4,ref('group_transcash_contabilidad'))]"/>
      <field name="domain_force">[('liquidacion_id.company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_pago_company" model="ir.rule">
      <field name="name">Pagos a proveedores: compañías autorizadas</field>
      <field name="model_id" ref="model_transcash_pago_registro"/>
      <field name="groups" eval="[(4,ref('group_logistica_manager')),(4,ref('group_transcash_contabilidad'))]"/>
      <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_carga_ruta_company" model="ir.rule">
      <field name="name">Bitácora carga: compañía del operador</field>
      <field name="model_id" ref="model_transcash_carga_evidencia_ruta"/>
      <field name="groups" eval="[(4,ref('group_transcash_operador_rutas'))]"/>
      <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_objecion_company" model="ir.rule">
      <field name="name">Objeciones de embarque: por compañía</field>
      <field name="model_id" ref="model_transcash_embarque_objecion"/>
      <field name="groups" eval="[(4,ref('group_transcash_operador_rutas')),(4,ref('group_logistica_bodega')),(4,ref('group_transcash_consulta'))]"/>
      <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
    <!-- En el backoffice se aíslan las guías y sus hijos por compañías autorizadas. -->
    <record id="rule_transcash_guia_company" model="ir.rule">
      <field name="name">Transcash guías por compañía</field>
      <field name="model_id" ref="model_transcash_guia"/>
      <field name="groups" eval="[(4, ref('group_logistica_bodega'))]"/>
      <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_evidencia_company" model="ir.rule">
      <field name="name">Transcash evidencias por compañía</field>
      <field name="model_id" ref="model_transcash_evidencia"/>
      <field name="groups" eval="[(4, ref('group_logistica_bodega'))]"/>
      <field name="domain_force">[('guia_id.company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_evento_company" model="ir.rule">
      <field name="name">Transcash eventos por compañía</field>
      <field name="model_id" ref="model_transcash_evento"/>
      <field name="groups" eval="[(4, ref('group_logistica_bodega'))]"/>
      <field name="domain_force">[('guia_id.company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_linea_company" model="ir.rule">
      <field name="name">Transcash productos por compañía</field>
      <field name="model_id" ref="model_transcash_guia_linea"/>
      <field name="groups" eval="[(4, ref('group_logistica_bodega'))]"/>
      <field name="domain_force">[('guia_id.company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_rotura_company" model="ir.rule">
      <field name="name">Transcash roturas por compañía</field>
      <field name="model_id" ref="model_transcash_rotura"/>
      <field name="groups" eval="[(4, ref('group_logistica_bodega'))]"/>
      <field name="domain_force">[('guia_id.company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_credito_company" model="ir.rule">
      <field name="name">Transcash solicitudes NC por compañía</field>
      <field name="model_id" ref="model_transcash_nota_credito"/>
      <field name="groups" eval="[(4, ref('group_logistica_manager'))]"/>
      <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_credito_linea_company" model="ir.rule">
      <field name="name">Transcash líneas NC por compañía</field>
      <field name="model_id" ref="model_transcash_nota_credito_linea"/>
      <field name="groups" eval="[(4, ref('group_logistica_manager'))]"/>
      <field name="domain_force">[('solicitud_id.company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_sync_company" model="ir.rule">
      <field name="name">Transcash sincronizaciones por compañía</field>
      <field name="model_id" ref="model_transcash_sync_operacion"/>
      <field name="groups" eval="[(4, ref('group_logistica_manager'))]"/>
      <field name="domain_force">[('guia_id.company_id','in',company_ids)]</field>
    </record>
    <record id="rule_embarque_consulta_company" model="ir.rule">
      <field name="name">Embarques: compañía autorizada</field>
      <field name="model_id" ref="model_transcash_embarque"/>
      <field name="groups" eval="[(4,ref('group_transcash_consulta')),(4,ref('group_logistica_bodega'))]"/>
      <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_novedad_company" model="ir.rule">
      <field name="name">Resumen de novedades por compañías autorizadas</field>
      <field name="model_id" ref="model_transcash_novedad_resumen"/>
      <field name="groups" eval="[(4,ref('group_transcash_consulta')),(4,ref('group_logistica_bodega'))]"/>
      <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
    <!-- Los directorios de accesos se administran por compañía y NUNCA son legibles
         por usuarios Portal. La habilitación se comprueba además en Python. -->
    <record id="rule_transcash_acceso_cliente_compania" model="ir.rule">
      <field name="name">Accesos cliente: compañías de Logística</field>
      <field name="model_id" ref="model_transcash_acceso_cliente"/>
      <field name="groups" eval="[(4,ref('group_logistica_manager'))]"/>
      <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_acceso_proveedor_compania" model="ir.rule">
      <field name="name">Accesos proveedor: compañías de Contabilidad</field>
      <field name="model_id" ref="model_transcash_acceso_proveedor"/>
      <field name="groups" eval="[(4,ref('group_transcash_contabilidad'))]"/>
      <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
    <!-- No se conceden ACL de modelos al portal: todas las vistas móviles
         comprueban expresamente chofer_usuario_id o destinatario_id. -->
    <record id="rule_operator_rutas_company" model="ir.rule">
      <field name="name">Transcash rutas: compañía del operador</field>
      <field name="model_id" ref="model_transcash_hoja_ruta"/>
      <field name="groups" eval="[(4,ref('group_transcash_operador_rutas'))]"/>
      <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
    <record id="rule_operator_tarifa_company" model="ir.rule">
      <field name="name">Transcash tarifario: compañía del operador</field>
      <field name="model_id" ref="model_transcash_tarifa_traslado"/>
      <field name="groups" eval="[(4,ref('group_transcash_operador_rutas'))]"/>
      <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
    <record id="rule_operator_guia_company" model="ir.rule">
      <field name="name">Transcash guías: compañía del operador</field>
      <field name="model_id" ref="model_transcash_guia"/>
      <field name="groups" eval="[(4,ref('group_transcash_operador_rutas'))]"/>
      <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
    <record id="rule_operator_embarque_company" model="ir.rule">
      <field name="name">Transcash embarques: compañía del operador</field>
      <field name="model_id" ref="model_transcash_embarque"/>
      <field name="groups" eval="[(4,ref('group_transcash_operador_rutas'))]"/>
      <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
    <record id="rule_operator_detalle_company" model="ir.rule">
      <field name="name">Transcash productos: compañía del operador</field>
      <field name="model_id" ref="model_transcash_guia_linea"/>
      <field name="groups" eval="[(4,ref('group_transcash_operador_rutas'))]"/>
      <field name="domain_force">[('guia_id.company_id','in',company_ids)]</field>
    </record>
    <record id="rule_destino_company" model="ir.rule">
      <field name="name">Destinos por compañía autorizada</field>
      <field name="model_id" ref="model_transcash_destino"/>
      <field name="groups" eval="[(4,ref('group_logistica_manager')),(4,ref('group_transcash_operador_rutas'))]"/>
      <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>

    <!-- Un operador solo lee registros de las compañías de las que forma parte. -->
    <record id="rule_transcash_operador_company_guia" model="ir.rule">
      <field name="name">Operador logística: guia por compañía</field>
      <field name="model_id" ref="model_transcash_guia"/>
      <field name="groups" eval="[(4,ref('group_transcash_operador_rutas'))]"/>
      <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_operador_company_linea" model="ir.rule">
      <field name="name">Operador logística: linea por compañía</field>
      <field name="model_id" ref="model_transcash_guia_linea"/>
      <field name="groups" eval="[(4,ref('group_transcash_operador_rutas'))]"/>
      <field name="domain_force">[('guia_id.company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_operador_company_evidencia" model="ir.rule">
      <field name="name">Operador logística: evidencia por compañía</field>
      <field name="model_id" ref="model_transcash_evidencia"/>
      <field name="groups" eval="[(4,ref('group_transcash_operador_rutas'))]"/>
      <field name="domain_force">[('guia_id.company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_operador_company_evento" model="ir.rule">
      <field name="name">Operador logística: evento por compañía</field>
      <field name="model_id" ref="model_transcash_evento"/>
      <field name="groups" eval="[(4,ref('group_transcash_operador_rutas'))]"/>
      <field name="domain_force">[('guia_id.company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_operador_company_rotura" model="ir.rule">
      <field name="name">Operador logística: rotura por compañía</field>
      <field name="model_id" ref="model_transcash_rotura"/>
      <field name="groups" eval="[(4,ref('group_transcash_operador_rutas'))]"/>
      <field name="domain_force">[('guia_id.company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_operador_company_ruta" model="ir.rule">
      <field name="name">Operador logística: ruta por compañía</field>
      <field name="model_id" ref="model_transcash_hoja_ruta"/>
      <field name="groups" eval="[(4,ref('group_transcash_operador_rutas'))]"/>
      <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_operador_company_embarque" model="ir.rule">
      <field name="name">Operador logística: embarque por compañía</field>
      <field name="model_id" ref="model_transcash_embarque"/>
      <field name="groups" eval="[(4,ref('group_transcash_operador_rutas'))]"/>
      <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_operador_company_destino" model="ir.rule">
      <field name="name">Operador logística: destino por compañía</field>
      <field name="model_id" ref="model_transcash_destino"/>
      <field name="groups" eval="[(4,ref('group_transcash_operador_rutas'))]"/>
      <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_operador_company_tarifa" model="ir.rule">
      <field name="name">Operador logística: tarifa por compañía</field>
      <field name="model_id" ref="model_transcash_tarifa_traslado"/>
      <field name="groups" eval="[(4,ref('group_transcash_operador_rutas'))]"/>
      <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
</odoo>
