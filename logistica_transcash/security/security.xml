<odoo>
    <record id="module_category_transcash" model="ir.module.category">
        <field name="name">Logística Transcash</field>
        <field name="sequence">26</field>
    </record>
    <record id="group_logistica_bodega" model="res.groups">
        <field name="name">Responsable de bodega</field>
        <field name="category_id" ref="module_category_transcash"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_logistica_manager" model="res.groups">
        <field name="name">Administrador de logística</field>
        <field name="category_id" ref="module_category_transcash"/>
        <field name="implied_ids" eval="[(4, ref('group_logistica_bodega'))]"/>
    </record>
    <!-- Los roles funcionales NO implican entre sí permisos de escritura. -->
    <record id="group_transcash_consulta" model="res.groups">
      <field name="name">Consulta de guías (base)</field>
      <field name="category_id" ref="module_category_transcash"/>
      <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_transcash_vendedor" model="res.groups">
      <field name="name">Vendedor: consulta y registro de roturas</field>
      <field name="category_id" ref="module_category_transcash"/>
      <field name="implied_ids" eval="[(4, ref('group_transcash_consulta'))]"/>
    </record>
    <record id="group_transcash_ventas_admin" model="res.groups">
      <field name="name">Administrador de ventas: revisión de roturas y propuestas</field>
      <field name="category_id" ref="module_category_transcash"/>
      <field name="implied_ids" eval="[(4, ref('group_transcash_consulta'))]"/>
    </record>
    <record id="group_transcash_nc_aprobador" model="res.groups">
      <field name="name">Aprobador: notas de crédito</field>
      <field name="category_id" ref="module_category_transcash"/>
      <field name="implied_ids" eval="[(4, ref('group_transcash_consulta'))]"/>
    </record>
    <record id="group_transcash_cobranzas" model="res.groups">
      <field name="name">Crédito y cobranzas: emitir y adjuntar NC</field>
      <field name="category_id" ref="module_category_transcash"/>
      <field name="implied_ids" eval="[(4, ref('group_transcash_consulta'))]"/>
    </record>
    <record id="group_transcash_contabilidad" model="res.groups">
      <field name="name">Contabilidad: liquidaciones y pagos</field>
      <field name="category_id" ref="module_category_transcash"/>
      <field name="implied_ids" eval="[(4, ref('group_transcash_consulta'))]"/>
    </record>
    <record id="rule_transcash_guia_consulta_compania" model="ir.rule">
      <field name="name">Guías visibles solo en compañías autorizadas</field>
      <field name="model_id" ref="model_transcash_guia"/>
      <field name="groups" eval="[(4,ref('group_transcash_consulta'))]"/>
      <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_evidencia_consulta_compania" model="ir.rule">
      <field name="name">Transcash evidencia: lectura por compañía</field>
      <field name="model_id" ref="model_transcash_evidencia"/>
      <field name="groups" eval="[(4,ref('group_transcash_consulta'))]"/>
      <field name="domain_force">[('guia_id.company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_evento_consulta_compania" model="ir.rule">
      <field name="name">Transcash evento: lectura por compañía</field>
      <field name="model_id" ref="model_transcash_evento"/>
      <field name="groups" eval="[(4,ref('group_transcash_consulta'))]"/>
      <field name="domain_force">[('guia_id.company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_guia_linea_consulta_compania" model="ir.rule">
      <field name="name">Transcash guia_linea: lectura por compañía</field>
      <field name="model_id" ref="model_transcash_guia_linea"/>
      <field name="groups" eval="[(4,ref('group_transcash_consulta'))]"/>
      <field name="domain_force">[('guia_id.company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_rotura_consulta_compania" model="ir.rule">
      <field name="name">Transcash rotura: lectura por compañía</field>
      <field name="model_id" ref="model_transcash_rotura"/>
      <field name="groups" eval="[(4,ref('group_transcash_consulta'))]"/>
      <field name="domain_force">[('guia_id.company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_nota_credito_consulta_compania" model="ir.rule">
      <field name="name">Transcash nota_credito: lectura por compañía</field>
      <field name="model_id" ref="model_transcash_nota_credito"/>
      <field name="groups" eval="[(4,ref('group_transcash_consulta'))]"/>
      <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_nota_credito_linea_consulta_compania" model="ir.rule">
      <field name="name">Transcash nota_credito_linea: lectura por compañía</field>
      <field name="model_id" ref="model_transcash_nota_credito_linea"/>
      <field name="groups" eval="[(4,ref('group_transcash_consulta'))]"/>
      <field name="domain_force">[('solicitud_id.company_id','in',company_ids)]</field>
    </record>
    <!-- En el backoffice se aíslan las guías y sus hijos por compañías autorizadas. -->
    <record id="rule_transcash_guia_company" model="ir.rule">
      <field name="name">Transcash guías por compañía</field>
      <field name="model_id" ref="model_transcash_guia"/>
      <field name="groups" eval="[(4, ref('group_logistica_bodega'))]"/>
      <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_evidencia_company" model="ir.rule">
      <field name="name">Transcash evidencias por compañía</field>
      <field name="model_id" ref="model_transcash_evidencia"/>
      <field name="groups" eval="[(4, ref('group_logistica_bodega'))]"/>
      <field name="domain_force">[('guia_id.company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_evento_company" model="ir.rule">
      <field name="name">Transcash eventos por compañía</field>
      <field name="model_id" ref="model_transcash_evento"/>
      <field name="groups" eval="[(4, ref('group_logistica_bodega'))]"/>
      <field name="domain_force">[('guia_id.company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_linea_company" model="ir.rule">
      <field name="name">Transcash productos por compañía</field>
      <field name="model_id" ref="model_transcash_guia_linea"/>
      <field name="groups" eval="[(4, ref('group_logistica_bodega'))]"/>
      <field name="domain_force">[('guia_id.company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_rotura_company" model="ir.rule">
      <field name="name">Transcash roturas por compañía</field>
      <field name="model_id" ref="model_transcash_rotura"/>
      <field name="groups" eval="[(4, ref('group_logistica_bodega'))]"/>
      <field name="domain_force">[('guia_id.company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_credito_company" model="ir.rule">
      <field name="name">Transcash solicitudes NC por compañía</field>
      <field name="model_id" ref="model_transcash_nota_credito"/>
      <field name="groups" eval="[(4, ref('group_logistica_manager'))]"/>
      <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_credito_linea_company" model="ir.rule">
      <field name="name">Transcash líneas NC por compañía</field>
      <field name="model_id" ref="model_transcash_nota_credito_linea"/>
      <field name="groups" eval="[(4, ref('group_logistica_manager'))]"/>
      <field name="domain_force">[('solicitud_id.company_id','in',company_ids)]</field>
    </record>
    <record id="rule_transcash_sync_company" model="ir.rule">
      <field name="name">Transcash sincronizaciones por compañía</field>
      <field name="model_id" ref="model_transcash_sync_operacion"/>
      <field name="groups" eval="[(4, ref('group_logistica_manager'))]"/>
      <field name="domain_force">[('guia_id.company_id','in',company_ids)]</field>
    </record>
    <!-- No se conceden ACL de modelos al portal: todas las vistas móviles
         comprueban expresamente chofer_usuario_id o destinatario_id. -->
</odoo>
