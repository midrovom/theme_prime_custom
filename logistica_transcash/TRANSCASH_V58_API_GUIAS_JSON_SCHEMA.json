{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transcash.local/schemas/guia-v1.1.json",
  "title": "Transcash ERP → Odoo 18 · Ingreso de guías y atributos analíticos",
  "description": "Contrato recomendado de alta de guías completas. La API V5.7 comprueba un subconjunto; usar este esquema desde el ERP para calidad de datos.",
  "type": "object",
  "required": [
    "guias"
  ],
  "properties": {
    "guias": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "properties": {
          "id_externo": {
            "type": "string"
          },
          "numero_guia": {
            "type": "string"
          },
          "tipo_documento": {
            "type": "string"
          },
          "numero_documento": {
            "type": "string"
          },
          "chofer_login": {
            "type": "string"
          },
          "ruc_chofer": {
            "type": "string"
          },
          "proveedor_codigo": {
            "type": "string"
          },
          "remitente_codigo": {
            "type": "string"
          },
          "destinatario_codigo": {
            "type": "string"
          },
          "placa": {
            "type": "string"
          },
          "direccion_origen": {
            "type": "string"
          },
          "direccion_destino": {
            "type": "string"
          },
          "destino_codigo": {
            "type": "string"
          },
          "destino_ciudad": {
            "type": "string"
          },
          "destino_provincia": {
            "type": "string"
          },
          "descripcion_carga": {
            "type": "string"
          },
          "estado_erp": {
            "type": "string"
          },
          "fecha_inicio_traslado": {
            "type": "string",
            "format": "date-time"
          },
          "fecha_fin_traslado": {
            "type": "string",
            "format": "date-time"
          },
          "fecha_prevista": {
            "type": "string",
            "format": "date-time"
          },
          "bultos": {
            "type": "integer",
            "minimum": 0
          },
          "peso_kg": {
            "type": "number",
            "minimum": 0
          },
          "productos": {
            "type": "array",
            "minItems": 1,
            "maxItems": 300,
            "items": {
              "type": "object",
              "properties": {
                "id_linea": {
                  "type": "string"
                },
                "sku": {
                  "type": "string"
                },
                "descripcion": {
                  "type": "string"
                },
                "unidad": {
                  "type": "string",
                  "enum": [
                    "m2",
                    "metro",
                    "unidad",
                    "kg",
                    "pallet",
                    "caja"
                  ]
                },
                "marca_codigo": {
                  "type": "string"
                },
                "marca_nombre": {
                  "type": "string"
                },
                "proveedor_producto_codigo": {
                  "type": "string"
                },
                "proveedor_producto_nombre": {
                  "type": "string"
                },
                "cantidad": {
                  "type": "number",
                  "minimum": 0,
                  "exclusiveMinimum": 0
                },
                "peso_kg": {
                  "type": "number",
                  "minimum": 0
                },
                "pallets": {
                  "type": "number",
                  "minimum": 0
                },
                "cajas": {
                  "type": "number",
                  "minimum": 0
                },
                "precio_unitario": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "id_linea",
                "sku",
                "descripcion",
                "cantidad",
                "unidad",
                "peso_kg",
                "pallets",
                "cajas",
                "marca_codigo",
                "marca_nombre",
                "proveedor_producto_codigo",
                "proveedor_producto_nombre"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id_externo",
          "numero_guia",
          "tipo_documento",
          "numero_documento",
          "chofer_login",
          "ruc_chofer",
          "proveedor_codigo",
          "remitente_codigo",
          "destinatario_codigo",
          "placa",
          "direccion_origen",
          "direccion_destino",
          "destino_codigo",
          "destino_ciudad",
          "destino_provincia",
          "fecha_inicio_traslado",
          "fecha_fin_traslado",
          "peso_kg",
          "productos"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
