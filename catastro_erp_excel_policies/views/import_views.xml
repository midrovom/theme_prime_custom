<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_catastro_erp_excel_wizard_form" model="ir.ui.view">
        <field name="name">catastro.erp.excel.import.wizard.form</field>
        <field name="model">catastro.erp.excel.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importación masiva ERP / Excel">
                <sheet>
                    <group>
                        <field name="import_kind" widget="radio"/>
                        <field name="company_id" options="{'no_create': True}"/>
                        <field name="update_mode"/>
                    </group>
                    <group string="Loyalty" invisible="import_kind == 'pricelist'">
                        <field name="program_id" invisible="import_kind == 'policy'" options="{'no_create': True}"/>
                        <field name="rule_id" invisible="import_kind != 'rule'" options="{'no_create': True}" domain="[('program_id','=',program_id)]"/>
                        <field name="reward_id" invisible="import_kind != 'reward'" options="{'no_create': True}" domain="[('program_id','=',program_id)]"/>
                        <field name="campaign_name" invisible="import_kind != 'policy'" placeholder="Promociones ERP noviembre"/>
                        <field name="campaign_key" invisible="import_kind != 'policy'" placeholder="PROMO-ERP-2026-11"/>
                    </group>
                    <group string="Lista de precios" invisible="import_kind != 'pricelist'">
                        <field name="new_pricelist"/>
                        <field name="pricelist_id" invisible="new_pricelist" options="{'no_create': True}"/>
                        <field name="pricelist_name" invisible="not new_pricelist" placeholder="Precios tienda mayorista"/>
                        <field name="currency_id" invisible="not new_pricelist"/>
                        <field name="restrict_users"/>
                        <field name="allowed_user_ids" widget="many2many_tags" invisible="not restrict_users"/>
                    </group>
                    <group string="Archivo Excel">
                        <field name="file_data" filename="filename" widget="binary"/>
                        <field name="filename" invisible="1"/>
                        <div colspan="2" class="text-muted">
                            Solo archivos .xlsx con cabecera en la primera hoja. Máximo 8 MB / 10.000 SKU.
                            Use SKU como texto para conservar ceros iniciales.
                            En porcentajes ingrese 15 para 15%, no 0,15.
                        </div>
                    </group>
                    <group string="Plantillas de ejemplo" colspan="2">
                        <div colspan="2">
                            <a href="/catastro_erp_excel_policies/static/templates/Plantilla_Loyalty_Reglas.xlsx" download="Plantilla_Loyalty_Reglas.xlsx">Reglas Loyalty</a>
                            <span> · </span>
                            <a href="/catastro_erp_excel_policies/static/templates/Plantilla_Loyalty_Recompensas.xlsx" download="Plantilla_Loyalty_Recompensas.xlsx">Recompensas Loyalty</a>
                            <span> · </span>
                            <a href="/catastro_erp_excel_policies/static/templates/Plantilla_Politica_ERP.xlsx" download="Plantilla_Politica_ERP.xlsx">Política ERP completa</a>
                            <span> · </span>
                            <a href="/catastro_erp_excel_policies/static/templates/Plantilla_Lista_Precios.xlsx" download="Plantilla_Lista_Precios.xlsx">Listas de precios</a>
                        </div>
                    </group>
                    <field name="preview_ok" invisible="1"/>
                    <field name="preview_hash" invisible="1"/>
                    <field name="preview_html" widget="html" readonly="1" nolabel="1"/>
                </sheet>
                <footer>
                    <button name="action_preview" string="1. Validar Excel" type="object" class="btn-secondary"/>
                    <button name="action_import" string="2. Aplicar importación" type="object" class="btn-primary" invisible="not preview_ok" confirm="Se aplicarán las reglas validadas en Odoo. ¿Continuar?"/>
                    <button special="cancel" string="Cerrar" class="btn-link"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_catastro_erp_excel_wizard" model="ir.actions.act_window">
        <field name="name">Importar Excel ERP: Loyalty y Precios</field>
        <field name="res_model">catastro.erp.excel.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_catastro_erp_excel_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'default_import_kind':'policy'}</field>
    </record>
    <menuitem id="menu_catastro_erp_policy_root" name="Políticas comerciales ERP" sequence="85" groups="sales_team.group_sale_manager"/>
    <menuitem id="menu_catastro_erp_excel_import" name="Importar Excel SKU" parent="menu_catastro_erp_policy_root"
              action="action_catastro_erp_excel_wizard" sequence="10" groups="sales_team.group_sale_manager"/>
    <menuitem id="menu_catastro_erp_pricelists" name="Listas de precios" parent="menu_catastro_erp_policy_root"
              action="product.product_pricelist_action2" sequence="20" groups="sales_team.group_sale_manager"/>
    <menuitem id="menu_catastro_erp_loyalty" name="Promociones Loyalty" parent="menu_catastro_erp_policy_root"
              action="loyalty.loyalty_program_discount_loyalty_action" sequence="30" groups="sales_team.group_sale_manager"/>

    <record id="view_erp_pricelist_extend" model="ir.ui.view">
        <field name="name">product.pricelist.erp.import.form</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="action_catastro_excel_import" type="object" string="Importar Excel SKU"
                        groups="sales_team.group_sale_manager" class="btn-secondary"/>
            </xpath>
            <xpath expr="//group[@name='pricelist_settings']" position="inside">
                <field name="catastro_access_restricted" groups="sales_team.group_sale_manager"/>
                <field name="catastro_allowed_user_ids" widget="many2many_tags"
                       invisible="not catastro_access_restricted" groups="sales_team.group_sale_manager"/>
            </xpath>
        </field>
    </record>
    <record id="view_erp_loyalty_program_extend" model="ir.ui.view">
        <field name="name">loyalty.program.erp.import.form</field>
        <field name="model">loyalty.program</field>
        <field name="inherit_id" ref="loyalty.loyalty_program_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='rules_rewards']" position="after">
                <page name="erp_excel_import" string="Importar Excel ERP" groups="sales_team.group_sale_manager"
                      invisible="program_type in ('gift_card','ewallet')">
                    <group>
                        <button name="action_catastro_excel_policy_import" type="object" string="Política completa: SKU y porcentajes" class="btn-primary"/>
                        <button name="action_catastro_excel_rules_import" type="object" string="Importar SKU a reglas" class="btn-secondary"/>
                        <button name="action_catastro_excel_rewards_import" type="object" string="Importar SKU a recompensas" class="btn-secondary"/>
                        <div class="text-muted" colspan="2">Para porcentajes distintos por SKU use la política completa: se crean programas separados por porcentaje.</div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_erp_loyalty_rule_extend" model="ir.ui.view">
        <field name="name">loyalty.rule.erp.import.form</field>
        <field name="model">loyalty.rule</field>
        <field name="inherit_id" ref="loyalty.loyalty_rule_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <button name="action_catastro_excel_import" string="Importar SKU Excel" type="object"
                        groups="sales_team.group_sale_manager" class="btn-secondary"/>
            </xpath>
        </field>
    </record>
    <record id="view_erp_loyalty_reward_extend" model="ir.ui.view">
        <field name="name">loyalty.reward.erp.import.form</field>
        <field name="model">loyalty.reward</field>
        <field name="inherit_id" ref="loyalty.loyalty_reward_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <button name="action_catastro_excel_import" string="Importar descuentos Excel por SKU" type="object"
                        groups="sales_team.group_sale_manager" class="btn-secondary"
                        invisible="reward_type != 'discount'"/>
            </xpath>
        </field>
    </record>
</odoo>
