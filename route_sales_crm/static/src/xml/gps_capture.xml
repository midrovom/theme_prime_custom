<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="route_sales_crm.GpsCapture">
    <div class="o_action_manager d-flex align-items-center justify-content-center p-3">
      <div class="card shadow-sm w-100" style="max-width: 520px;">
        <div class="card-body text-center py-5">
          <i t-if="state.status === 'requesting'" class="fa fa-location-arrow fa-4x text-primary mb-4"/>
          <i t-if="state.status === 'success'" class="fa fa-check-circle fa-4x text-success mb-4"/>
          <i t-if="state.status === 'error'" class="fa fa-exclamation-circle fa-4x text-danger mb-4"/>
          <h3>Registro GPS</h3><p class="lead" t-esc="state.message"/>
          <button t-if="state.status === 'error'" class="btn btn-primary btn-lg" t-on-click="retry">Reintentar</button>
        </div>
      </div>
    </div>
  </t>
</templates>
