<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_route_plan_list" model="ir.ui.view"><field name="name">route.sale.plan.list</field><field name="model">route.sale.plan</field><field name="arch" type="xml"><list decoration-success="state == 'done'" decoration-info="state == 'in_progress'"><field name="name"/><field name="date"/><field name="salesperson_id"/><field name="zone"/><field name="planned_count"/><field name="completed_count"/><field name="state" widget="badge"/></list></field></record>
  <record id="view_route_plan_form" model="ir.ui.view"><field name="name">route.sale.plan.form</field><field name="model">route.sale.plan</field><field name="arch" type="xml"><form><header><button name="action_plan" type="object" string="Planificar" class="btn-primary" invisible="state != 'draft'"/><button name="action_start" type="object" string="Iniciar ruta" class="btn-primary" invisible="state != 'planned'"/><button name="action_done" type="object" string="Finalizar ruta" class="btn-primary" invisible="state != 'in_progress'"/><button name="action_cancel" type="object" string="Anular" invisible="state in ['done','cancelled']"/><field name="state" widget="statusbar" statusbar_visible="draft,planned,in_progress,done"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="date" readonly="state != 'draft'"/><field name="salesperson_id" readonly="state != 'draft'"/><field name="zone" readonly="state != 'draft'"/></group><group><field name="planned_count"/><field name="completed_count"/></group></group><field name="visit_ids" readonly="state not in ['draft','planned']" context="{'default_salesperson_id': salesperson_id, 'default_planned_at': date}"><list editable="bottom"><field name="sequence" widget="handle"/><field name="planned_at"/><field name="partner_id"/><field name="result"/><field name="state" widget="badge"/></list></field><field name="notes"/></sheet><chatter/></form></field></record>
  <record id="action_route_plan" model="ir.actions.act_window"><field name="name">Planificación de rutas</field><field name="res_model">route.sale.plan</field><field name="view_mode">list,form</field></record>
</odoo>
