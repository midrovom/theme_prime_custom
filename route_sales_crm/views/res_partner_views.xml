<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_partner_form_route" model="ir.ui.view">
    <field name="name">res.partner.form.route.sales</field><field name="model">res.partner</field><field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_open_route_visits" type="object" class="oe_stat_button" icon="fa-map-marker" invisible="not is_route_customer"><field name="route_visit_count" widget="statinfo" string="Visitas"/></button>
      </xpath>
      <xpath expr="//notebook" position="inside">
        <page string="Gestión de ruta" name="route_sales" invisible="not is_route_customer">
          <group><group><field name="establishment_type"/><field name="commercial_sector"/><field name="market_segment"/><field name="customer_potential"/><field name="zone"/></group><group><field name="assigned_salesperson_id"/><field name="visit_frequency"/><field name="preferred_visit_day"/><field name="opening_hours"/><field name="store_count" readonly="1"/><field name="last_route_visit" readonly="1"/></group></group>
          <group string="Geolocalización"><field name="latitude"/><field name="longitude"/><field name="route_reference"/></group><field name="competitor_notes"/>
        </page>
      </xpath>
      <xpath expr="//field[@name='category_id']" position="after"><field name="is_route_customer"/></xpath>
    </field>
  </record>
  <record id="view_partner_route_list" model="ir.ui.view"><field name="name">res.partner.route.list</field><field name="model">res.partner</field><field name="arch" type="xml"><list><field name="name"/><field name="parent_id"/><field name="establishment_type"/><field name="commercial_sector"/><field name="zone"/><field name="assigned_salesperson_id"/><field name="store_count"/><field name="last_route_visit"/><field name="phone"/></list></field></record>
  <record id="action_route_customers" model="ir.actions.act_window"><field name="name">Clientes y tiendas</field><field name="res_model">res.partner</field><field name="view_mode">list,kanban,form</field><field name="domain">[('is_route_customer','=',True)]</field><field name="context">{'default_is_route_customer': True, 'default_company_type': 'company'}</field></record>
</odoo>
