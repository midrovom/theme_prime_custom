<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_route_visit_search" model="ir.ui.view"><field name="name">route.sale.visit.search</field><field name="model">route.sale.visit</field><field name="arch" type="xml"><search><field name="name"/><field name="partner_id"/><field name="salesperson_id"/><field name="route_id"/><filter string="Mis visitas" name="my_visits" domain="[('salesperson_id','=',uid)]"/><filter string="Hoy" name="today" domain="[('planned_at','=',context_today())]"/><filter string="En visita" name="active" domain="[('state','=','checked_in')]"/><group expand="0" string="Agrupar"><filter string="Vendedor" context="{'group_by':'salesperson_id'}"/><filter string="Cliente" context="{'group_by':'commercial_partner_id'}"/><filter string="Resultado" context="{'group_by':'result'}"/><filter string="Mes" context="{'group_by':'planned_at:month'}"/></group></search></field></record>
  <record id="view_route_visit_list" model="ir.ui.view"><field name="name">route.sale.visit.list</field><field name="model">route.sale.visit</field><field name="arch" type="xml"><list decoration-success="state == 'done'" decoration-info="state == 'checked_in'" decoration-muted="state == 'cancelled'"><field name="sequence"/><field name="name"/><field name="planned_at"/><field name="salesperson_id"/><field name="partner_id"/><field name="checkin_at"/><field name="checkout_at"/><field name="duration_minutes"/><field name="result"/><field name="collection_total" sum="Total"/><field name="currency_id" column_invisible="True"/><field name="state" widget="badge"/></list></field></record>
  <record id="view_route_visit_kanban" model="ir.ui.view"><field name="name">route.sale.visit.kanban</field><field name="model">route.sale.visit</field><field name="arch" type="xml"><kanban default_group_by="state" class="o_kanban_mobile"><field name="partner_id"/><field name="planned_at"/><field name="salesperson_id"/><field name="result"/><field name="state"/><templates><t t-name="card"><div class="fw-bold fs-5"><field name="partner_id"/></div><div><i class="fa fa-clock-o me-1"/><field name="planned_at"/></div><div><i class="fa fa-user me-1"/><field name="salesperson_id"/></div><div t-if="record.result.raw_value"><field name="result" widget="badge"/></div></t></templates></kanban></field></record>
  <record id="view_route_visit_form" model="ir.ui.view"><field name="name">route.sale.visit.form</field><field name="model">route.sale.visit</field><field name="arch" type="xml"><form><header><button name="action_capture_checkin" type="object" string="Registrar entrada GPS" class="btn-primary" invisible="state != 'planned'"/><button name="action_capture_checkout" type="object" string="Registrar salida GPS" class="btn-primary" invisible="state != 'checked_in'"/><button name="action_create_quotation" type="object" string="Nueva cotización" class="btn-secondary" invisible="state not in ['checked_in','done']"/><button name="action_cancel" type="object" string="Cancelar" invisible="state in ['done','cancelled']"/><field name="state" widget="statusbar" statusbar_visible="planned,checked_in,done"/></header><sheet><div class="oe_button_box" name="button_box"><button name="action_open_quotations" type="object" class="oe_stat_button" icon="fa-file-text-o"><field name="quotation_count" widget="statinfo" string="Cotizaciones"/></button></div><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="route_id"/><field name="planned_at"/><field name="salesperson_id"/><field name="partner_id"/><field name="commercial_partner_id" readonly="1"/><field name="crm_lead_id"/></group><group><field name="checkin_at"/><field name="checkout_at"/><field name="duration_minutes"/><field name="result"/><field name="next_visit_at"/></group></group>
      <notebook><page string="Resultado"><field name="outcome_notes" placeholder="Detalle del resultado, compromisos y próximos pasos..."/><field name="visit_photo_ids" widget="many2many_binary"/><field name="evidence_ids" widget="many2many_binary"/></page>
      <page string="Ubicaciones GPS"><group><group string="Entrada"><field name="checkin_latitude"/><field name="checkin_longitude"/><field name="checkin_accuracy"/><field name="checkin_map_url" widget="url" string="Abrir mapa"/></group><group string="Salida"><field name="checkout_latitude"/><field name="checkout_longitude"/><field name="checkout_accuracy"/><field name="checkout_map_url" widget="url" string="Abrir mapa"/></group></group></page>
      <page string="Encuesta comercial"><field name="survey_line_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="question"/><field name="answer"/><field name="notes"/></list></field></page>
      <page string="Competencia"><field name="competitor_line_ids"><list editable="bottom"><field name="competitor"/><field name="product"/><field name="price"/><field name="currency_id" column_invisible="True"/><field name="promotion"/><field name="shelf_presence"/><field name="notes"/></list></field></page>
      <page string="Cobranza"><group><field name="collection_total" readonly="1"/></group><field name="collection_ids"><list editable="bottom"><field name="date"/><field name="reference"/><field name="method"/><field name="amount" sum="Total"/><field name="currency_id" column_invisible="True"/><field name="notes"/></list><form><group><field name="date"/><field name="reference"/><field name="method"/><field name="amount"/><field name="currency_id" invisible="1"/><field name="notes"/></group><field name="evidence_ids" widget="many2many_binary"/></form></field></page>
      <page string="Cotizaciones y pedidos"><field name="sale_order_ids" readonly="1"><list><field name="name"/><field name="date_order"/><field name="amount_total"/><field name="currency_id" column_invisible="True"/><field name="state" widget="badge"/></list></field></page></notebook></sheet><chatter/></form></field></record>
  <record id="view_route_visit_pivot" model="ir.ui.view"><field name="name">route.sale.visit.pivot</field><field name="model">route.sale.visit</field><field name="arch" type="xml"><pivot string="Análisis de visitas"><field name="salesperson_id" type="row"/><field name="result" type="row"/><field name="planned_at" interval="month" type="col"/><field name="duration_minutes" type="measure"/><field name="collection_total" type="measure"/></pivot></field></record>
  <record id="view_route_visit_graph" model="ir.ui.view"><field name="name">route.sale.visit.graph</field><field name="model">route.sale.visit</field><field name="arch" type="xml"><graph string="Visitas por vendedor" type="bar"><field name="salesperson_id"/><field name="id" type="measure"/></graph></field></record>
  <record id="action_route_visit" model="ir.actions.act_window"><field name="name">Visitas de ruta</field><field name="res_model">route.sale.visit</field><field name="view_mode">kanban,list,form,pivot,graph</field><field name="search_view_id" ref="view_route_visit_search"/><field name="context">{'search_default_my_visits': 1}</field></record>
  <record id="action_route_visit_analysis" model="ir.actions.act_window"><field name="name">Análisis de visitas</field><field name="res_model">route.sale.visit</field><field name="view_mode">pivot,graph,list</field><field name="domain">[('state','=','done')]</field></record>
</odoo>
