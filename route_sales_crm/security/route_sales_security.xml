<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_route_sales" model="ir.module.category"><field name="name">Ventas en Ruta</field><field name="sequence">31</field></record>
  <record id="group_route_salesperson" model="res.groups"><field name="name">Vendedor rutero</field><field name="category_id" ref="module_category_route_sales"/><field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/></record>
  <record id="group_route_supervisor" model="res.groups"><field name="name">Supervisor de ruta</field><field name="category_id" ref="module_category_route_sales"/><field name="implied_ids" eval="[(4, ref('group_route_salesperson'))]"/></record>
  <record id="group_route_manager" model="res.groups"><field name="name">Administrador de rutas</field><field name="category_id" ref="module_category_route_sales"/><field name="implied_ids" eval="[(4, ref('group_route_supervisor'))]"/></record>

  <record id="rule_route_own" model="ir.rule"><field name="name">Rutas propias</field><field name="model_id" ref="model_route_sale_plan"/><field name="domain_force">[('salesperson_id','=',user.id)]</field><field name="groups" eval="[(4, ref('group_route_salesperson'))]"/></record>
  <record id="rule_visit_own" model="ir.rule"><field name="name">Visitas propias</field><field name="model_id" ref="model_route_sale_visit"/><field name="domain_force">[('salesperson_id','=',user.id)]</field><field name="groups" eval="[(4, ref('group_route_salesperson'))]"/></record>
  <record id="rule_route_all" model="ir.rule"><field name="name">Todas las rutas</field><field name="model_id" ref="model_route_sale_plan"/><field name="domain_force">[(1,'=',1)]</field><field name="groups" eval="[(4, ref('group_route_supervisor'))]"/></record>
  <record id="rule_visit_all" model="ir.rule"><field name="name">Todas las visitas</field><field name="model_id" ref="model_route_sale_visit"/><field name="domain_force">[(1,'=',1)]</field><field name="groups" eval="[(4, ref('group_route_supervisor'))]"/></record>
  <record id="rule_survey_own" model="ir.rule"><field name="name">Encuestas de visitas propias</field><field name="model_id" ref="model_route_visit_survey_line"/><field name="domain_force">[('visit_id.salesperson_id','=',user.id)]</field><field name="groups" eval="[(4, ref('group_route_salesperson'))]"/></record>
  <record id="rule_competitor_own" model="ir.rule"><field name="name">Competencia de visitas propias</field><field name="model_id" ref="model_route_visit_competitor"/><field name="domain_force">[('visit_id.salesperson_id','=',user.id)]</field><field name="groups" eval="[(4, ref('group_route_salesperson'))]"/></record>
  <record id="rule_collection_own" model="ir.rule"><field name="name">Cobranzas de visitas propias</field><field name="model_id" ref="model_route_visit_collection"/><field name="domain_force">[('visit_id.salesperson_id','=',user.id)]</field><field name="groups" eval="[(4, ref('group_route_salesperson'))]"/></record>
  <record id="rule_survey_all" model="ir.rule"><field name="name">Todas las encuestas de visita</field><field name="model_id" ref="model_route_visit_survey_line"/><field name="domain_force">[(1,'=',1)]</field><field name="groups" eval="[(4, ref('group_route_supervisor'))]"/></record>
  <record id="rule_competitor_all" model="ir.rule"><field name="name">Toda la competencia de visita</field><field name="model_id" ref="model_route_visit_competitor"/><field name="domain_force">[(1,'=',1)]</field><field name="groups" eval="[(4, ref('group_route_supervisor'))]"/></record>
  <record id="rule_collection_all" model="ir.rule"><field name="name">Todas las cobranzas de visita</field><field name="model_id" ref="model_route_visit_collection"/><field name="domain_force">[(1,'=',1)]</field><field name="groups" eval="[(4, ref('group_route_supervisor'))]"/></record>
</odoo>
