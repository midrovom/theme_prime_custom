<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_applicant_form_inherit_finalize" model="ir.ui.view">
        <field name="name">hr.applicant.form.inherit.finalize</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment_ec_contract.view_hr_applicant_form_inherit"/>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="process_finalized" invisible="1"/>
                <field name="is_readonly_finalize" invisible="1"/>
                <button name="action_finalize_process"
                        type="object"
                        string="Finalizar Proceso"
                        class="btn-primary"
                        modifiers="{'invisible': [('process_finalized','=',True)]}"/>
            </xpath>

            <xpath expr="//field[@name='wage']" position="attributes">
                <attribute name="modifiers">{"readonly":[('process_finalized','=',True),('is_readonly_finalize','=',True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='resource_calendar_id']" position="attributes">
                <attribute name="modifiers">{"readonly":[('process_finalized','=',True),('is_readonly_finalize','=',True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='date_start']" position="attributes">
                <attribute name="modifiers">{"readonly":[('process_finalized','=',True),('is_readonly_finalize','=',True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='date_end']" position="attributes">
                <attribute name="modifiers">{"readonly":[('process_finalized','=',True),('is_readonly_finalize','=',True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='ec_contract_type_id']" position="attributes">
                <attribute name="modifiers">{"readonly":[('process_finalized','=',True),('is_readonly_finalize','=',True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='company_config_id']" position="attributes">
                <attribute name="modifiers">{"readonly":[('process_finalized','=',True),('is_readonly_finalize','=',True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='sucursal_id']" position="attributes">
                <attribute name="modifiers">{"readonly":[('process_finalized','=',True),('is_readonly_finalize','=',True)]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>



