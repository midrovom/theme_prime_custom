<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_erp_requests" model="ir.module.category">
        <field name="name">Solicitudes ERP</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_erp_request_user" model="res.groups">
        <field name="name">Solicitante</field>
        <field name="category_id" ref="module_category_erp_requests"/>
    </record>
    <record id="group_erp_request_team" model="res.groups">
        <field name="name">Equipo de Sistemas</field>
        <field name="category_id" ref="module_category_erp_requests"/>
        <field name="implied_ids" eval="[(4, ref('group_erp_request_user'))]"/>
    </record>
    <record id="group_erp_request_manager" model="res.groups">
        <field name="name">Administrador de Solicitudes ERP</field>
        <field name="category_id" ref="module_category_erp_requests"/>
        <field name="implied_ids" eval="[(4, ref('group_erp_request_team'))]"/>
    </record>

    <record id="rule_erp_request_multi_company" model="ir.rule">
        <field name="name">Solicitudes ERP: empresas autorizadas</field>
        <field name="model_id" ref="model_erp_change_request"/>
        <field name="domain_force">[('company_id', 'in', user.partner_id.id)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_erp_request_user_own" model="ir.rule">
        <field name="name">Solicitudes ERP: solicitudes propias</field>
        <field name="model_id" ref="model_erp_change_request"/>
        <field name="groups" eval="[(4, ref('group_erp_request_user'))]"/>
        <field name="domain_force">[('requester_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_erp_request_team_all" model="ir.rule">
        <field name="name">Solicitudes ERP: equipo de Sistemas</field>
        <field name="model_id" ref="model_erp_change_request"/>
        <field name="groups" eval="[(4, ref('group_erp_request_team'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_erp_department_multi_company" model="ir.rule">
        <field name="name">Departamentos ERP: empresas autorizadas</field>
        <field name="model_id" ref="model_erp_request_department"/>
        <field name="domain_force">[('company_id', 'in', user.partner_id.id)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>

