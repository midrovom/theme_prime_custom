<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Redirigir la acción antigua, sin duplicar el menú ni tocar el módulo principal. -->
  <record id="logistica_transcash.action_transcash_dashboard" model="ir.actions.client">
    <field name="name">Inteligencia logística · Transcash BI</field>
    <field name="tag">tc_logistica_bi_v22</field>
  </record>
  <!-- El menú original permanece único y apunta a la acción redirigida. -->
  <record id="logistica_transcash.menu_transcash_dashboard" model="ir.ui.menu">
    <field name="name">Inteligencia logística</field>
    <field name="active" eval="True"/>
    <field name="parent_id" ref="logistica_transcash.menu_transcash_root"/>
    <field name="sequence">2</field>
    <field name="groups_id" eval="[(4, ref('logistica_transcash.group_transcash_dashboard')), (4, ref('logistica_transcash.group_logistica_manager')), (4, ref('logistica_transcash.group_transcash_contabilidad'))]"/>
  </record>
</odoo>
