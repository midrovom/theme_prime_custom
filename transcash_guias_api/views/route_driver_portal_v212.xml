<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="tc_pwa_driver_scope_v212"
            inherit_id="transcash_guias_api.tc_pwa_identity_fix_v27"
            priority="170"
            name="PWA: contadores dentro de las tarjetas del chofer, destino y transporte">
    <!-- Mismos tres recuadros originales; sin paneles nuevos ni tablas. -->
    <xpath expr="//t[contains(@t-if, 'ruta_detalle')]//div[contains(concat(' ', normalize-space(@class), ' '), ' tc-ops-summary ')]/span[b[normalize-space(.)='Chofer']]" position="inside">
      <small t-if="tc_guias_chofer and tc_guias_chofer.get('tiene_criterio')"
             class="tc-ops-kpi-inline">
        <t t-if="tc_guias_chofer.get('mas_resultados')">Al menos </t>
        <strong t-esc="tc_guias_chofer.get('total_mostradas', 0)"/>
        <t> guías del chofer</t>
      </small>
    </xpath>
    <xpath expr="//t[contains(@t-if, 'ruta_detalle')]//div[contains(concat(' ', normalize-space(@class), ' '), ' tc-ops-summary ')]/span[b[normalize-space(.)='Destino']]" position="inside">
      <small t-if="tc_filtro_reporte" class="tc-ops-kpi-inline">
        <t t-if="tc_filtro_reporte.get('limite')">Al menos </t>
        <strong t-esc="tc_filtro_reporte.get('coincide_destino', 0)"/>
        <t> guías libres de este destino</t>
      </small>
    </xpath>
    <xpath expr="//t[contains(@t-if, 'ruta_detalle')]//div[contains(concat(' ', normalize-space(@class), ' '), ' tc-ops-summary ')]/span[b[normalize-space(.)='Transportista']]" position="inside">
      <small t-if="tc_filtro_reporte" class="tc-ops-kpi-inline">
        <t t-if="tc_filtro_reporte.get('limite')">Al menos </t>
        <strong t-esc="tc_filtro_reporte.get('coincide_transporte', 0)"/>
        <t> guías libres del transportista</t>
      </small>
    </xpath>
    <xpath expr="//html/head" position="inside">
      <link rel="stylesheet" href="/transcash_guias_api/static/src/css/route_driver_scope_v212.css?v=218"/>
    </xpath>
  </template>
</odoo>
