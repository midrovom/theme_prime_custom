<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="tc_pwa_identity_fix_v27"
            inherit_id="transcash_guias_api.tc_pwa_filter_guides_v26"
            priority="90"
            name="PWA: mostrar guías de chofer y transportista con identidad ERP">
    <xpath expr="//section[contains(@class,'tc-route-guide-filters')]/p" position="replace">
      <p>Se revisan las guías libres de esta empresa y se verifican destino,
        cédula del chofer y RUC del transportista. Si falta un vínculo técnico
        con Portal, se permite la guía únicamente cuando su identidad ERP es
        comprobable. No se admiten asignaciones de otros conductores o empresas.</p>
    </xpath>
    <xpath expr="//div[contains(@class,'tc-ops-checklist')]" position="before">
      <div t-if="tc_filtro_reporte" class="tc-route-guide-filters" role="status">
        <strong>Resultado de filtros para esta ruta</strong>
        <div class="tc-route-guide-filters__grid">
          <div><small>Guías libres en la compañía</small>
            <strong t-esc="tc_filtro_reporte.get('en_compania', 0)"/></div>
          <div><small>Guías compatibles encontradas</small>
            <strong t-esc="tc_filtro_reporte.get('compatible', 0)"/></div>
          <div><small>Guías analizadas</small>
            <strong t-esc="tc_filtro_reporte.get('analizadas', 0)"/></div>
          <div><small>Coinciden con destino</small>
            <strong t-esc="tc_filtro_reporte.get('coincide_destino', 0)"/></div>
          <div><small>Coinciden con chofer</small>
            <strong t-esc="tc_filtro_reporte.get('coincide_chofer', 0)"/></div>
          <div><small>Coinciden con proveedor de transporte</small>
            <strong t-esc="tc_filtro_reporte.get('coincide_transporte', 0)"/></div>
          <div><small>Destino + chofer</small>
            <strong t-esc="tc_filtro_reporte.get('destino_chofer', 0)"/></div>
          <div><small>Destino + transportista</small>
            <strong t-esc="tc_filtro_reporte.get('destino_transporte', 0)"/></div>
          <div><small>Chofer + transportista</small>
            <strong t-esc="tc_filtro_reporte.get('chofer_transporte', 0)"/></div>
        </div>
        <div t-if="not tc_filtro_reporte.get('compatible')" class="tc-route-guide-filters__notice">
          <strong>Sin guías para esta combinación de filtros</strong>
          <p t-if="tc_filtro_reporte.get('coincide_destino') and not tc_filtro_reporte.get('destino_chofer')">
            Hay <t t-esc="tc_filtro_reporte.get('coincide_destino', 0)"/>
            guías libres del destino, pero ninguna coincide con el chofer de esta ruta.
            Las coincidencias individuales de chofer o transportista pueden ser de otros destinos.
            Revise el chofer indicado en la hoja de ruta y en las guías del ERP.
          </p>
          <p t-elif="tc_filtro_reporte.get('destino_chofer') and not tc_filtro_reporte.get('destino_chofer_transporte')">
            Hay guías del destino y chofer, pero el proveedor de transporte es distinto.
            Compare el campo «Proveedor» de esas guías antes de seleccionar.
          </p>
          <p t-else="">
            No se encontraron guías que cumplan simultáneamente estado disponible,
            compañía, destino, chofer y proveedor de transporte.
          </p>
          <p>Rechazos por primera condición fallida:
            destino <t t-esc="tc_filtro_reporte.get('destino', 0)"/>,
            chofer <t t-esc="tc_filtro_reporte.get('chofer', 0)"/>,
            transportista <t t-esc="tc_filtro_reporte.get('transporte', 0)"/>.
            Nunca se permite mezclar guías de otros choferes o transportistas.
          </p>
        </div>
        <div t-if="tc_filtro_reporte.get('resumen_destino')" class="tc-route-guide-breakdown">
          <strong>Guías del destino asignadas a otros choferes</strong>
          <p>Resumen para comprobar la combinación correcta. Estos registros no están seleccionables en la ruta actual.</p>
          <div class="tc-route-guide-breakdown-scroll">
            <table class="tc-route-guide-breakdown-table">
              <thead><tr><th>Chofer de la guía</th><th>Proveedor de transporte</th><th>Guías</th><th>Ejemplos</th></tr></thead>
              <tbody>
                <tr t-foreach="tc_filtro_reporte.get('resumen_destino')" t-as="item">
                  <td t-esc="item['chofer']"/>
                  <td t-esc="item['transportista']"/>
                  <td t-esc="item['cantidad']"/>
                  <td t-esc="', '.join(item['guias'])"/>
                </tr>
              </tbody>
            </table>
          </div>
          <small>Si la ruta debe utilizar otro chofer, modifique la planificación desde el flujo autorizado;
            no se reasignan guías automáticamente.</small>
        </div>
        <p t-if="tc_filtro_reporte.get('limite')" class="tc-route-guide-filters__notice">
          Se alcanzó el límite de exploración. Use la búsqueda por número
          para consultar guías adicionales sin perder los filtros.
        </p>
      </div>
    </xpath>
    <xpath expr="//div[contains(@class,'tc-ops-checklist')]" position="before">
      <section t-if="tc_filtro_reporte and tc_filtro_reporte.get('detalle_busqueda')"
               class="tc-route-guide-filters" aria-label="Diagnóstico de guía buscada">
        <h3>Diagnóstico de la guía buscada</h3>
        <p>Los nombres visibles pueden coincidir aunque los registros internos de Odoo sean diferentes.
           Esta tabla identifica el bloqueo exacto sin permitir asignaciones equivocadas.</p>
        <div class="tc-route-guide-breakdown-scroll">
          <table class="tc-route-guide-breakdown-table">
            <thead><tr>
              <th>Guía / documento</th><th>Resultado</th><th>Destino: guía / ruta</th>
              <th>Chofer: guía / ruta</th><th>Transportista: guía / ruta</th>
            </tr></thead>
            <tbody>
              <tr t-foreach="tc_filtro_reporte.get('detalle_busqueda')" t-as="d">
                <td><strong t-esc="d['guia']"/><small t-esc="d['documento']"/></td>
                <td><span t-if="d['compatible']">Compatible</span>
                  <span t-else="" t-esc="d['motivo']"/></td>
                <td><small t-esc="d['guia_destino']"/><small> / </small><small t-esc="d['ruta_destino']"/></td>
                <td><small t-esc="d['guia_chofer']"/><small> / </small><small t-esc="d['ruta_chofer']"/>
                  <small>Cédula guía: <t t-esc="d['cedula_guia']"/>; contacto: <t t-esc="d['cedula_contacto']"/>; ruta: <t t-esc="d['cedula_ruta']"/></small></td>
                <td><small t-esc="d['guia_proveedor']"/><small> / </small><small t-esc="d['ruta_proveedor']"/>
                  <small>RUC guía: <t t-esc="d['ruc_guia']"/>; ruta: <t t-esc="d['ruc_ruta']"/></small></td>
              </tr>
            </tbody>
          </table>
        </div>
        <small>Los IDs entre paréntesis identifican fichas de Odoo, no códigos fiscales.
          Los datos de marcas y proveedores de productos no se muestran aquí.</small>
      </section>
    </xpath>
    <xpath expr="//p[contains(@class,'tc-empty-inline') and contains(text(),'No hay guías disponibles')]" position="replace">
      <p t-if="not filas" class="tc-empty-inline">
        No hay guías que cumplan simultáneamente los filtros de esta hoja de ruta.
        Revise el diagnóstico superior para identificar cuál asignación difiere.
      </p>
    </xpath>
    <xpath expr="//script[contains(@src, 'select_all_route_guides.js')]" position="attributes">
      <attribute name="src">/transcash_guias_api/static/src/js/select_all_route_guides.js?v=211</attribute>
    </xpath>
  </template>
</odoo>
