msgid "Customer incentive or rebate funded by a supplier."
msgstr "Incentivo o rebate al cliente financiado por un proveedor."
msgid "Incentive request with supplier collection terms/installments."
msgstr "Requerimiento de incentivo con términos o cuotas de cobro al proveedor."
msgid "Upload at least one supporting document or payment evidence before confirming the transaction."
msgstr "Adjunte al menos un documento de soporte o evidencia de pago antes de confirmar la transacción."
msgid "Add at least one product/program line before submitting the request."
msgstr "Agregue al menos una línea de producto/programa antes de enviar el requerimiento."
msgid "The grand total must be greater than zero."
msgstr "El total general debe ser mayor que cero."
msgid "Only draft requests can be submitted."
msgstr "Solo se pueden enviar requerimientos en borrador."
msgid "Only submitted requests can be approved."
msgstr "Solo se pueden aprobar requerimientos enviados."
msgid "Only submitted requests can be rejected."
msgstr "Solo se pueden rechazar requerimientos enviados."
msgid "Only approved requests can move to In Progress."
msgstr "Solo los requerimientos aprobados pueden pasar a En ejecución."
msgid "The beneficiary can only be paid while the request is In Progress."
msgstr "El beneficiario solo puede recibir el pago cuando el requerimiento está En ejecución."
msgid "Select the appropriate bank/cash journal first."
msgstr "Seleccione primero el diario bancario o de caja correspondiente."
msgid "Configure a Sales journal for the selected company first."
msgstr "Configure primero un diario de ventas para la compañía seleccionada."
msgid "Record the beneficiary settlement before creating the supplier collection invoice."
msgstr "Registre la liquidación del beneficiario antes de crear la factura de cobro al proveedor."
msgid "Create the supplier collection invoice first."
msgstr "Primero cree la factura de cobro al proveedor."
msgid "The receipt amount must be greater than zero and cannot exceed the open invoice balance."
msgstr "El valor del cobro debe ser mayor que cero y no puede superar el saldo pendiente de la factura."
msgid "The supplier collection invoice must be fully settled before closing."
msgstr "La factura de cobro al proveedor debe estar totalmente liquidada antes de cerrar el requerimiento."
msgid "To Date cannot be earlier than From Date."
msgstr "La fecha Hasta no puede ser anterior a la fecha Desde."
msgid "Unit cannot be negative."
msgstr "El valor unitario no puede ser negativo."
msgid "Target Qty must be greater than zero."
msgstr "La cantidad objetivo debe ser mayor que cero."
msgid "Request submitted for approval."
msgstr "Requerimiento enviado para aprobación."
msgid "Request approved."
msgstr "Requerimiento aprobado."
msgid "Request rejected."
msgstr "Requerimiento rechazado."
msgid "Execution started."
msgstr "Ejecución iniciada."
msgid "Beneficiary settlement recorded. Method: %s."
msgstr "Liquidación del beneficiario registrada. Método: %s."
msgid "Supplier collection invoice %s was created with payment terms %s."
msgstr "Se creó la factura de cobro al proveedor %s con los términos de pago %s."
msgid "Supplier collection completed."
msgstr "Cobro al proveedor completado."
msgid "Partial supplier receipt registered: %s."
msgstr "Cobro parcial al proveedor registrado: %s."
msgid "Supplier collection fully settled by accounting offset."
msgstr "Cobro al proveedor liquidado totalmente mediante cruce contable."
