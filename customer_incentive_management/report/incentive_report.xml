<odoo>
    <record id="action_report_incentive_request" model="ir.actions.report">
        <field name="name">Customer Incentive Request</field>
        <field name="model">incentive.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">customer_incentive_management.report_incentive_request</field>
        <field name="report_file">customer_incentive_management.report_incentive_request</field>
        <field name="binding_model_id" ref="model_incentive_request"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Incentive - %s' % (object.name)</field>
    </record>

    <template id="report_incentive_request">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="doc" t-value="doc.with_context(lang=doc.language_id.code or 'en_US')"/>
                <t t-call="web.external_layout" t-lang="doc.language_id.code or 'en_US'">
                    <div class="page">
                        <h2>Customer Incentive Request</h2>
                        <div class="row mt-3 mb-3">
                            <div class="col-6">
                                <strong>Request Number:</strong> <span t-field="doc.name"/><br/>
                                <strong>Request Type:</strong> <span t-field="doc.request_type_id"/><br/>
                                <strong>Request Date:</strong> <span t-field="doc.request_date"/><br/>
                                <strong>Requested By:</strong> <span t-field="doc.requester_id"/><br/>
                                <strong>Salesperson:</strong> <span t-field="doc.salesperson_id"/>
                            </div>
                            <div class="col-6">
                                <strong>Beneficiary Customer:</strong> <span t-field="doc.customer_id"/><br/>
                                <strong>Supplier:</strong> <span t-field="doc.supplier_id"/><br/>
                                <strong>Payment Terms:</strong> <span t-field="doc.payment_term_id"/><br/>
                                <strong>Status:</strong> <span t-field="doc.state"/>
                            </div>
                        </div>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Product No.</th><th>Program Type</th><th>From Date</th><th>To Date</th><th class="text-end">Unit</th><th class="text-end">Target Qty</th><th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.line_ids" t-as="line">
                                    <td><span t-field="line.product_code"/></td>
                                    <td><span t-field="line.program_type"/></td>
                                    <td><span t-field="line.date_from"/></td>
                                    <td><span t-field="line.date_to"/></td>
                                    <td class="text-end"><span t-field="line.unit_price"/></td>
                                    <td class="text-end"><span t-field="line.target_qty"/></td>
                                    <td class="text-end"><span t-field="line.total"/></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="5" class="text-end"><strong>Grand Total</strong></td>
                                    <td class="text-end"><strong t-field="doc.total_target_qty"/></td>
                                    <td class="text-end"><strong t-field="doc.amount_total"/></td>
                                </tr>
                            </tfoot>
                        </table>
                        <p><strong>Accounting Amount incl. Taxes:</strong> <span t-field="doc.accounting_amount_total"/></p>
                        <h4>Description</h4>
                        <p t-field="doc.description"/>
                        <div class="mt-3">
                            <strong>Beneficiary Method:</strong> <span t-field="doc.beneficiary_method"/><br/>
                            <strong>Supplier Collection Method:</strong> <span t-field="doc.collection_method"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
