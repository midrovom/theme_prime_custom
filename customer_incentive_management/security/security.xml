<odoo>
    <record id="module_category_customer_incentive" model="ir.module.category">
        <field name="name">Customer Incentive Management</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_incentive_user" model="res.groups">
        <field name="name">Incentive Request User</field>
        <field name="category_id" ref="module_category_customer_incentive"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_incentive_approver" model="res.groups">
        <field name="name">Incentive Approver</field>
        <field name="category_id" ref="module_category_customer_incentive"/>
        <field name="implied_ids" eval="[(4, ref('group_incentive_user'))]"/>
    </record>
    <record id="group_incentive_accounting" model="res.groups">
        <field name="name">Incentive Accounting</field>
        <field name="category_id" ref="module_category_customer_incentive"/>
        <field name="implied_ids" eval="[(4, ref('group_incentive_approver')), (4, ref('account.group_account_user'))]"/>
    </record>
    <record id="group_incentive_manager" model="res.groups">
        <field name="name">Incentive Manager</field>
        <field name="category_id" ref="module_category_customer_incentive"/>
        <field name="implied_ids" eval="[(4, ref('group_incentive_accounting'))]"/>
    </record>

    <record id="rule_incentive_request_company" model="ir.rule">
        <field name="name">Incentive requests limited to allowed companies</field>
        <field name="model_id" ref="model_incentive_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_incentive_request_own" model="ir.rule">
        <field name="name">Users see their requests and salesperson assignments</field>
        <field name="model_id" ref="model_incentive_request"/>
        <field name="domain_force">['|', ('requester_id', '=', user.id), ('salesperson_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_incentive_user'))]"/>
    </record>
    <record id="rule_incentive_request_approver_all" model="ir.rule">
        <field name="name">Approvers see all requests in allowed companies</field>
        <field name="model_id" ref="model_incentive_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_incentive_approver'))]"/>
    </record>
    <record id="rule_incentive_line_company" model="ir.rule">
        <field name="name">Incentive lines limited by parent company</field>
        <field name="model_id" ref="model_incentive_request_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_incentive_line_own" model="ir.rule">
        <field name="name">Users see lines on their requests</field>
        <field name="model_id" ref="model_incentive_request_line"/>
        <field name="domain_force">['|', ('request_id.requester_id', '=', user.id), ('request_id.salesperson_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_incentive_user'))]"/>
    </record>
    <record id="rule_incentive_line_approver_all" model="ir.rule">
        <field name="name">Approvers see lines in allowed companies</field>
        <field name="model_id" ref="model_incentive_request_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_incentive_approver'))]"/>
    </record>
    <record id="rule_incentive_detail_own" model="ir.rule">
        <field name="name">Users see details on their requests</field>
        <field name="model_id" ref="model_incentive_payment_detail"/>
        <field name="domain_force">['|', ('request_id.requester_id', '=', user.id), ('request_id.salesperson_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_incentive_user'))]"/>
    </record>
    <record id="rule_incentive_detail_approver_all" model="ir.rule">
        <field name="name">Approvers see details in allowed companies</field>
        <field name="model_id" ref="model_incentive_payment_detail"/>
        <field name="domain_force">[('request_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_incentive_approver'))]"/>
    </record>

</odoo>
