<odoo>
    <record id="view_incentive_request_type_list" model="ir.ui.view">
        <field name="name">incentive.request.type.list</field>
        <field name="model">incentive.request.type</field>
        <field name="arch" type="xml">
            <list string="Request Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="description" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_incentive_request_type_form" model="ir.ui.view">
        <field name="name">incentive.request.type.form</field>
        <field name="model">incentive.request.type</field>
        <field name="arch" type="xml">
            <form string="Request Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="description" placeholder="Describe when this type should be used..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_incentive_request_type" model="ir.actions.act_window">
        <field name="name">Request Types</field>
        <field name="res_model">incentive.request.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
