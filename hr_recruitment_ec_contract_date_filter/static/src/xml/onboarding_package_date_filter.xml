<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

    <t t-name="hr_recruitment_ec_contract_date_filter.DateFilter">

        <div class="o_ec_date_filter position-relative">

            <button
                type="button"
                class="btn btn-outline-secondary"
                t-on-click="toggle">

                <i class="fa fa-calendar me-1"/>

                <span>Filtrar</span>

            </button>


            <t t-if="state.open">

                <div
                    class="o_ec_date_filter_dropdown bg-white border rounded shadow p-3 position-absolute"
                    style="z-index: 1100; min-width: 300px; right: 0; top: 100%;">

                    <div class="fw-bold mb-3">
                        Filtrar paquetes
                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Generado el
                        </label>

                        <input
                            type="date"
                            class="form-control"
                            t-att-value="state.date || ''"
                            t-on-change="onDateChange"/>

                    </div>


                    <div class="d-flex justify-content-between">

                        <button
                            type="button"
                            class="btn btn-link"
                            t-on-click="clear">

                            Limpiar

                        </button>


                        <button
                            type="button"
                            class="btn btn-primary"
                            t-on-click="close">

                            Aplicar

                        </button>

                    </div>

                </div>

            </t>

        </div>

    </t>

</templates>