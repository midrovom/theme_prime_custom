<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">
    <t t-name="hr_recruitment_ec_contract_date_filter.DateFilter">
        <div class="o_ec_date_filter">
            <button type="button" class="btn btn-outline-secondary o_ec_date_filter_button" t-on-click="toggle" title="Filtrar por fecha">
                <i class="fa fa-calendar me-1"/>
                <span>Filtrar</span>
            </button>

            <!-- =================================================
                 POPUP
                 ================================================= -->

            <t t-if="state.open">
                <div class="o_ec_date_filter_dropdown">
                    <div class="mb-3">
                        <label class="form-label"> Generado el </label>
                        <input type="date" class="form-control" t-att-value="state.date" t-on-change="onDateChange"/>
                    </div>

                    <div class="d-flex justify-content-between">
                        <button type="button" class="btn btn-link" t-on-click="clear">
                            Limpiar
                        </button>

                        <button type="button" class="btn btn-primary" t-on-click="apply">
                            Aplicar
                        </button>

                    </div>
                </div>
            </t>
        </div>
    </t>

    <!-- ========================================================
         CONTROL PANEL
         ======================================================== -->

    <t t-inherit="web.ControlPanel" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_control_panel_actions')]" position="inside">
            <EcOnboardingDateFilter
                t-if="env.searchModel and env.searchModel.resModel === 'hr.ec.onboarding.package'"
                searchModel="env.searchModel"
            />
        </xpath>
    </t>

</templates>