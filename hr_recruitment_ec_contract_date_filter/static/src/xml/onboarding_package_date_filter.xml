<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

    <t t-inherit="web.ControlPanel"
       t-inherit-mode="extension">

        <xpath expr="//div[contains(@class, 'o_cp_searchview')]"
               position="after">

            <div class="o_onboarding_date_filter position-relative">

                <button type="button"
                        class="btn btn-outline-secondary"
                        t-on-click="toggleDateFilter">

                    <i class="fa fa-calendar me-1"/>
                    Filtrar
                </button>

                <t t-if="dateFilterState.open">

                    <div class="position-absolute bg-white border rounded shadow p-3"
                         style="z-index: 1050; min-width: 280px; right: 0;">

                        <div class="fw-bold mb-2">
                            Filtrar paquetes por fecha
                        </div>

                        <label class="form-label">
                            Generado el
                        </label>

                        <input type="date"
                               class="form-control"
                               t-att-value="dateFilterState.date || ''"
                               t-on-change="onDateFilterChange"/>

                        <div class="d-flex justify-content-end mt-2">

                            <button type="button"
                                    class="btn btn-sm btn-link"
                                    t-on-click="clearDateFilter">

                                Limpiar filtro
                            </button>

                        </div>

                    </div>

                </t>

            </div>

        </xpath>

    </t>

</templates>