<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="website_sale_offer_company_rule" model="ir.rule">
        <field name="name">Ofertas web: multi-compañía</field>
        <field name="model_id" ref="model_website_sale_offer"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="website_product_offer_rule_company_rule" model="ir.rule">
        <field name="name">Reglas de ofertas: multi-compañía</field>
        <field name="model_id" ref="model_website_product_offer_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
</odoo>

