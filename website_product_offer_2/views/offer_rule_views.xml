<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_website_product_offer_rule_list" model="ir.ui.view">
        <field name="name">website.product.offer.rule.list</field>
        <field name="model">website.product.offer.rule</field>
        <field name="arch" type="xml">
            <list string="Productos habilitados" editable="bottom" multi_edit="1">
                <field name="active" widget="boolean_toggle"/>
                <field name="website_id"/>
                <field name="product_tmpl_id"/>
                <field name="min_qty"/>
                <field name="max_qty"/>
                <field name="minimum_price_percent"/>
                <field name="note" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_website_product_offer_rule_form" model="ir.ui.view">
        <field name="name">website.product.offer.rule.form</field>
        <field name="model">website.product.offer.rule</field>
        <field name="arch" type="xml">
            <form string="Producto habilitado para ofertas">
                <sheet>
                    <widget name="web_ribbon" title="Inactiva" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="product_tmpl_id"/>
                        <h1><field name="product_tmpl_id"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="website_id"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                        <group string="Condiciones">
                            <field name="min_qty"/>
                            <field name="max_qty"/>
                            <field name="minimum_price_percent"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" placeholder="Ej.: campaña mayorista de agosto"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_website_product_offer_rule_search" model="ir.ui.view">
        <field name="name">website.product.offer.rule.search</field>
        <field name="model">website.product.offer.rule</field>
        <field name="arch" type="xml">
            <search string="Buscar productos habilitados">
                <field name="product_tmpl_id"/>
                <field name="website_id"/>
                <filter name="active" string="Activas" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Inactivas" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_website" string="Sitio web" context="{'group_by': 'website_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_website_product_offer_rule" model="ir.actions.act_window">
        <field name="name">Productos habilitados</field>
        <field name="res_model">website.product.offer.rule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_website_product_offer_rule_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Selecciona los productos que pueden recibir ofertas</p>
            <p>Cada regla pertenece a un sitio web y puede establecer cantidades o un precio mínimo.</p>
        </field>
    </record>
</odoo>
