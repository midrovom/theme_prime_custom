<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        El Historial de Postulación se muestra como una tarjeta del mismo
        bloque visual que la tarjeta nativa de Reclutamiento.
        Se hereda únicamente el template del portal que contiene la tarjeta
        de Reclutamiento; la lógica interna de las postulaciones no cambia.
    -->
    <template id="portal_my_home_applications"
              inherit_id="custom_web_candidatos.portal_home_custom"
              name="Portal Home: Historial de Postulación debajo de Reclutamiento">
        <xpath expr="//div[@id='portal_common_category']/div[contains(@class, 'o_portal_index_card')][.//a[@href='/jobs']]"
               position="after">
            <div class="o_portal_index_card col-md-6 order-3">
                <a href="/my/applications"
                   title="Historial de Postulación"
                   class="d-flex gap-2 gap-md-3 py-3 pe-2 px-md-3 h-100 rounded text-decoration-none bg-100">
                    <div class="o_portal_icon d-block align-self-start">
                        <i class="fa fa-file-text-o fa-3x" aria-hidden="true"></i>
                    </div>
                    <div>
                        <div class="mt-0 mb-1 fs-5 fw-normal lh-1">
                            <span>Historial de Postulación</span>
                        </div>
                        <div class="opacity-75">
                            Consulte el estado de sus postulaciones
                        </div>
                    </div>
                </a>
            </div>
        </xpath>
    </template>

    <template id="portal_my_applications" name="Historial de Postulación">
        <t t-call="portal.portal_layout">
            <div class="container py-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="mb-0">Historial de Postulación</h2>
                    <a href="/my/home" class="btn btn-outline-secondary">Volver al portal</a>
                </div>
                <t t-if="request.params.get('form2_saved')">
                    <div class="alert alert-success">El Formulario 1 fue guardado y la Fase 2 quedó marcada como completada.</div>
                </t>
                <t t-if="applications">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead><tr>
                                <th>Postulación</th><th>Puesto</th><th>Fecha</th><th>estado</th><th class="text-end"></th>
                            </tr></thead>
                            <tbody>
                                <t t-foreach="applications" t-as="application">
                                    <tr>
                                        <td><strong><t t-esc="application.partner_name or application.name or ('Postulación #%s' % application.id)"/></strong></td>
                                        <td><t t-esc="application.job_id.name or ''"/></td>
                                        <td><span t-field="application.create_date"/></td>
                                        <td>
                                            <span t-if="application.phase_2_completed" class="badge text-bg-success">Completado</span>
                                            <span t-else="" class="badge text-bg-warning">Pendiente</span>
                                        </td>
                                        <td class="text-end">
                                            <a t-if="application.form2_portal_enabled and not application.phase_2_completed"
                                               t-att-href="'/my/applications/%s/form2' % application.id"
                                               class="btn btn-primary">
                                                Continuar postulación
                                            </a>
                                            <span t-elif="not application.phase_2_completed" class="text-muted"></span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
                <t t-else="">
                    <div class="alert alert-info">No tienes postulaciones registradas.</div>
                </t>
            </div>
        </t>
    </template>
</odoo>
