<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_loyalty_wallet" model="ir.sequence">
        <field name="name">Billetera de recompensas</field>
        <field name="code">loyalty.wallet</field>
        <field name="prefix">WAL/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_loyalty_wallet_transaction" model="ir.sequence">
        <field name="name">Movimiento de billetera</field>
        <field name="code">loyalty.wallet.transaction</field>
        <field name="prefix">MOV/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
