<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_wallet" model="ir.module.category">
        <field name="name">Billetera de clientes</field>
        <field name="description">Administración de recompensas acumuladas por clientes.</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_wallet_user" model="res.groups">
        <field name="name">Operador de billetera</field>
        <field name="category_id" ref="module_category_customer_wallet"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_wallet_manager" model="res.groups">
        <field name="name">Administrador de billetera</field>
        <field name="category_id" ref="module_category_customer_wallet"/>
        <field name="implied_ids" eval="[(4, ref('group_wallet_user'))]"/>
    </record>

    <record id="wallet_company_rule" model="ir.rule">
        <field name="name">Billeteras por compañía</field>
        <field name="model_id" ref="model_loyalty_wallet"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_wallet_user'))]"/>
    </record>

    <record id="wallet_transaction_company_rule" model="ir.rule">
        <field name="name">Movimientos por compañía</field>
        <field name="model_id" ref="model_loyalty_wallet_transaction"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_wallet_user'))]"/>
    </record>
</odoo>
