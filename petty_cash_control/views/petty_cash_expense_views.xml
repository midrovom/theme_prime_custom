  <record id="view_expense_list" model="ir.ui.view"><field name="name">petty.cash.expense.list</field><field name="model">petty.cash.expense</field><field name="arch" type="xml"><list decoration-success="state == 'approved'" decoration-danger="state == 'rejected'" decoration-warning="state == 'submitted'"><field name="name"/><field name="date"/><field name="box_id"/><field name="category_id"/><field name="supplier_id"/><field name="beneficiary_id"/><field name="department_id"/><field name="document_number"/><field name="amount" sum="Total"/><field name="currency_id" column_invisible="True"/><field name="state" widget="badge"/></list></field></record>
  <record id="view_expense_form" model="ir.ui.view"><field name="name">petty.cash.expense.form</field><field name="model">petty.cash.expense</field><field name="arch" type="xml"><form><header><button name="action_submit" type="object" string="Enviar" class="btn-primary" invisible="state not in ['draft','rejected']"/><button name="action_approve" type="object" string="Aprobar" class="btn-primary" groups="petty_cash_control.group_petty_cash_approver" invisible="state != 'submitted'"/><button name="action_reject" type="object" string="Rechazar" groups="petty_cash_control.group_petty_cash_approver" invisible="state != 'submitted'"/><button name="action_cancel" type="object" string="Anular" groups="petty_cash_control.group_petty_cash_manager" invisible="state not in ['draft','submitted','rejected']"/><button name="action_reset_draft" type="object" string="Volver a borrador" groups="petty_cash_control.group_petty_cash_manager" invisible="state not in ['cancelled','rejected']"/><field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="date" readonly="state not in ['draft','rejected']"/><field name="box_id" readonly="state not in ['draft','rejected']"/><field name="category_id" readonly="state not in ['draft','rejected']"/><field name="department_id" required="1" readonly="state not in ['draft','rejected']"/><field name="beneficiary_id" required="1" readonly="state not in ['draft','rejected']"/><field name="amount" readonly="state not in ['draft','rejected']"/><field name="currency_id" invisible="1"/></group><group><field name="supplier_id" required="1" readonly="state not in ['draft','rejected']"/><field name="supplier_vat" readonly="1"/><field name="document_type" readonly="state not in ['draft','rejected']"/><field name="document_number" readonly="state not in ['draft','rejected']"/><field name="settlement_id" readonly="1"/></group></group><field name="description" readonly="state not in ['draft','rejected']"/><field name="attachment_ids" widget="many2many_binary" readonly="state not in ['draft','rejected']"/><field name="rejection_reason" invisible="not rejection_reason"/></sheet><chatter/></form></field></record>
  <record id="view_expense_pivot" model="ir.ui.view"><field name="name">petty.cash.expense.pivot</field><field name="model">petty.cash.expense</field><field name="arch" type="xml"><pivot string="Gastos por caja y categoría"><field name="box_id" type="row"/><field name="department_id" type="row"/><field name="beneficiary_id" type="row"/><field name="category_id" type="row"/><field name="date" interval="month" type="col"/><field name="amount" type="measure"/></pivot></field></record>
  <record id="view_expense_graph" model="ir.ui.view"><field name="name">petty.cash.expense.graph</field><field name="model">petty.cash.expense</field><field name="arch" type="xml"><graph string="Gastos por categoría" type="bar"><field name="category_id"/><field name="amount" type="measure"/></graph></field></record>
