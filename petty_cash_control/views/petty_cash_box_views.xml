<odoo>
  <record id="view_box_list" model="ir.ui.view"><field name="name">petty.cash.box.list</field><field name="model">petty.cash.box</field><field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="responsible_id"/><field name="maximum_amount"/><field name="available_balance" decoration-danger="available_balance &lt; 0"/><field name="currency_id" column_invisible="True"/><field name="active"/></list></field></record>
  <record id="view_box_form" model="ir.ui.view"><field name="name">petty.cash.box.form</field><field name="model">petty.cash.box</field><field name="arch" type="xml"><form><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="code"/><field name="responsible_id"/><field name="backup_responsible_ids" widget="many2many_tags"/><field name="company_id" groups="base.group_multi_company"/></group><group><field name="maximum_amount"/><field name="approved_fund"/><field name="approved_expense"/><field name="returned_amount"/><field name="available_balance"/><field name="currency_id" invisible="1"/><field name="active"/></group></group><notebook><page string="Fondos"><field name="fund_ids" readonly="1"/></page><page string="Gastos"><field name="expense_ids" readonly="1"/></page><page string="Liquidaciones"><field name="settlement_ids" readonly="1"/></page><page string="Notas"><field name="notes"/></page></notebook></sheet><chatter/></form></field></record>
  <record id="action_box" model="ir.actions.act_window"><field name="name">Cajas</field><field name="res_model">petty.cash.box</field><field name="view_mode">list,form</field></record>
</odoo>
