<odoo>
  <record id="view_settlement_list" model="ir.ui.view"><field name="name">petty.cash.settlement.list</field><field name="model">petty.cash.settlement</field><field name="arch" type="xml"><list><field name="name"/><field name="date"/><field name="box_id"/><field name="responsible_id"/><field name="expense_total"/><field name="return_amount"/><field name="currency_id" column_invisible="True"/><field name="state" widget="badge"/></list></field></record>
  <record id="view_settlement_form" model="ir.ui.view"><field name="name">petty.cash.settlement.form</field><field name="model">petty.cash.settlement</field><field name="arch" type="xml"><form><header><button name="action_load_expenses" type="object" string="Cargar gastos aprobados" invisible="state != 'draft'"/><button name="action_submit" type="object" string="Enviar" class="btn-primary" invisible="state != 'draft'"/><button name="action_approve" type="object" string="Aprobar" class="btn-primary" groups="petty_cash_control.group_petty_cash_approver" invisible="state != 'submitted'"/><button name="action_reject" type="object" string="Rechazar" groups="petty_cash_control.group_petty_cash_approver" invisible="state != 'submitted'"/><button name="action_close" type="object" string="Cerrar liquidación" groups="petty_cash_control.group_petty_cash_approver" invisible="state != 'approved'"/><button name="action_print_settlement" type="object" string="Imprimir PDF"/><button name="action_cancel" type="object" string="Anular" groups="petty_cash_control.group_petty_cash_manager" invisible="state not in ['draft','rejected']"/><button name="action_reset_draft" type="object" string="Volver a borrador" groups="petty_cash_control.group_petty_cash_manager" invisible="state not in ['rejected','cancelled']"/><field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,closed"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="date" readonly="state != 'draft'"/><field name="box_id" readonly="state != 'draft'"/><field name="responsible_id" readonly="1"/></group><group><field name="expense_total"/><field name="return_amount" readonly="state != 'draft'"/><field name="currency_id" invisible="1"/><field name="approved_by" invisible="not approved_by"/><field name="approved_date" invisible="not approved_date"/></group></group><notebook><page string="Gastos"><field name="expense_ids" readonly="1"><list><field name="name"/><field name="date"/><field name="category_id"/><field name="supplier_id"/><field name="beneficiary_id"/><field name="department_id"/><field name="amount" sum="Total"/><field name="currency_id" column_invisible="True"/></list></field></page><page string="Evidencias"><field name="attachment_ids" widget="many2many_binary" readonly="state != 'draft'"/></page><page string="Notas"><field name="notes" readonly="state != 'draft'"/></page></notebook></sheet><chatter/></form></field></record>
  <record id="action_settlement" model="ir.actions.act_window"><field name="name">Liquidaciones</field><field name="res_model">petty.cash.settlement</field><field name="view_mode">list,form</field></record>
</odoo>
