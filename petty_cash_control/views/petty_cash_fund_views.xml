<odoo>
  <record id="view_fund_list" model="ir.ui.view"><field name="name">petty.cash.fund.list</field><field name="model">petty.cash.fund</field><field name="arch" type="xml"><list decoration-success="state == 'approved'" decoration-warning="state == 'submitted'"><field name="name"/><field name="date"/><field name="box_id"/><field name="fund_type"/><field name="amount"/><field name="currency_id" column_invisible="True"/><field name="state" widget="badge"/></list></field></record>
  <record id="view_fund_form" model="ir.ui.view"><field name="name">petty.cash.fund.form</field><field name="model">petty.cash.fund</field><field name="arch" type="xml"><form><header><button name="action_submit" type="object" string="Enviar" class="btn-primary" invisible="state not in ['draft','rejected']"/><button name="action_approve" type="object" string="Aprobar" class="btn-primary" groups="petty_cash_control.group_petty_cash_approver" invisible="state != 'submitted'"/><button name="action_reject" type="object" string="Rechazar" groups="petty_cash_control.group_petty_cash_approver" invisible="state != 'submitted'"/><button name="action_cancel" type="object" string="Anular" groups="petty_cash_control.group_petty_cash_manager" invisible="state not in ['draft','submitted','rejected']"/><button name="action_reset_draft" type="object" string="Volver a borrador" groups="petty_cash_control.group_petty_cash_manager" invisible="state not in ['cancelled','rejected']"/><field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="date" readonly="state not in ['draft','rejected']"/><field name="box_id" readonly="state not in ['draft','rejected']"/><field name="fund_type" readonly="state not in ['draft','rejected']"/><field name="amount" readonly="state not in ['draft','rejected']"/><field name="currency_id" invisible="1"/></group><group><field name="responsible_id" readonly="1"/><field name="approved_by" invisible="not approved_by"/><field name="approved_date" invisible="not approved_date"/></group></group><field name="description" readonly="state not in ['draft','rejected']"/><field name="attachment_ids" widget="many2many_binary" readonly="state not in ['draft','rejected']"/><field name="rejection_reason" invisible="not rejection_reason"/></sheet><chatter/></form></field></record>
  <record id="action_fund" model="ir.actions.act_window"><field name="name">Fondos y reposiciones</field><field name="res_model">petty.cash.fund</field><field name="view_mode">list,form</field></record>
</odoo>
