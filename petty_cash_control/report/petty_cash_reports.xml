<odoo>
  <record id="action_report_petty_cash_expenses" model="ir.actions.report"><field name="name">Reporte de gastos de caja chica</field><field name="model">petty.cash.expense</field><field name="report_type">qweb-pdf</field><field name="report_name">petty_cash_control.report_expenses_document</field><field name="report_file">petty_cash_control.report_expenses_document</field><field name="print_report_name">'Caja_chica_%s' % (time.strftime('%Y%m%d'))</field></record>
  <template id="report_expenses_document"><t t-call="web.html_container"><div class="page"><h2>Reporte de gastos de caja chica</h2><p t-if="data"><strong>Período:</strong> <span t-esc="data.get('date_from')"/> al <span t-esc="data.get('date_to')"/></p><p t-if="not docs">No existen gastos para los filtros seleccionados.</p><table class="table table-sm" t-if="docs"><thead><tr><th>Fecha</th><th>Caja</th><th>Categoría</th><th>Proveedor</th><th>Comprobante</th><th class="text-end">Valor</th></tr></thead><tbody><t t-set="total" t-value="0"/><tr t-foreach="docs" t-as="o"><td><span t-field="o.date"/></td><td><span t-field="o.box_id"/></td><td><span t-field="o.category_id"/></td><td><span t-field="o.supplier_name"/></td><td><span t-field="o.document_number"/></td><td class="text-end"><span t-field="o.amount" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td><t t-set="total" t-value="total + o.amount"/></tr></tbody><tfoot><tr><th colspan="5" class="text-end">TOTAL</th><th class="text-end"><span t-esc="total" t-options="{'widget':'monetary','display_currency':docs[0].currency_id}"/></th></tr></tfoot></table></div></t></template>
</odoo>
