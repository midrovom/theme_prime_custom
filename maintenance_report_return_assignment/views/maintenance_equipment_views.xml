<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_maintenance_equipment_form_bodega_assignment" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.bodega.assignment</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_bodega_assignment"
                        type="object"
                        string="Asignar a bodega"
                        class="oe_stat_button"
                        icon="fa-exchange"/>
            </xpath>
            <!-- Pestaña posterior a Mantenimiento, con último movimiento e historial. -->
            <xpath expr="//page[@name='maintenance']" position="after">
                <page string="Última asignación a bodega" name="last_bodega_assignment">
                    <group string="Último movimiento a bodega">
                        <group>
                            <field name="empleado_devolucion_anterior_id" readonly="1"/>
                            <field name="bodega_destino_ultima_id" readonly="1"/>
                            <field name="bodega_receptor_ultimo_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="bodega_asignado_por_id" readonly="1" widget="many2one_avatar_user"/>
                            <field name="bodega_asignacion_fecha" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Historial de movimientos a bodega"/>
                    <field name="bodega_historial_ids" nolabel="1" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="movement_date"/>
                            <field name="previous_employee_name"/>
                            <field name="warehouse_name"/>
                            <field name="receiver_name"/>
                            <field name="previous_receiver_name" optional="hide"/>
                            <field name="registered_by_name"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
