<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_maintenance_equipment_form_bodega_assignment" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.bodega.assignment</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <!-- Pestaña posterior a Mantenimiento: únicamente historial de movimientos. -->
            <xpath expr="//page[@name='maintenance']" position="after">
                <page string="Historial de movimiento" name="last_bodega_assignment">
                    <separator string="Historial de movimientos"/>
                    <field name="bodega_historial_ids" nolabel="1" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="movement_date"/>
                            <field name="movement_type"/>
                            <field name="previous_employee_name"/>
                            <field name="previous_department_name" optional="show"/>
                            <field name="destination_department_id" optional="show"/>
                            <field name="warehouse_name" optional="show"/>
                            <field name="receiver_name"/>
                            <field name="previous_receiver_name" optional="hide"/>
                            <field name="registered_by_name"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
