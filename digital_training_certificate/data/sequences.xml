<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="sequence_digital_training_event" model="ir.sequence">
        <field name="name">Capacitación</field>
        <field name="code">digital.training.event</field>
        <field name="prefix">CAP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="sequence_digital_training_certificate" model="ir.sequence">
        <field name="name">Certificado de capacitación</field>
        <field name="code">digital.training.certificate</field>
        <field name="prefix">CERT/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>

