<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="default_certificate_template" model="digital.training.certificate.template">
        <field name="name">Certificado corporativo</field>
        <field name="certificate_title">CERTIFICADO DE PARTICIPACIÓN</field>
        <field name="primary_color">#123B5D</field>
        <field name="accent_color">#D6A84B</field>
        <field name="show_organization_logo">True</field>
        <field name="body_html" type="html">
            <div style="text-align: center;">
                <p style="font-size: 18px; margin-bottom: 8px;">Se certifica que</p>
                <p style="font-size: 34px; font-weight: 700; margin: 8px 0;">[NOMBRE]</p>
                <p style="font-size: 17px; margin: 8px 0;">perteneciente a <strong>[EMPRESA]</strong>, participó en la capacitación</p>
                <p style="font-size: 25px; font-weight: 700; margin: 10px 0;">“[CURSO]”</p>
                <p style="font-size: 16px; margin-top: 8px;">realizada el [FECHA], con una duración de [DURACION].</p>
            </div>
        </field>
        <field name="footer_html" type="html">
            <p style="text-align: center;">Este certificado acredita la participación en la actividad indicada.</p>
        </field>
        <field name="email_subject">Su certificado de [CURSO]</field>
        <field name="email_body_html" type="html">
            <div>
                <p>Estimado/a <strong>[NOMBRE]</strong>:</p>
                <p>Gracias por participar en la capacitación <strong>[CURSO]</strong>.</p>
                <p>Adjuntamos su certificado de participación número <strong>[CERTIFICADO]</strong>.</p>
                <p>Saludos cordiales.</p>
            </div>
        </field>
    </record>
</odoo>

