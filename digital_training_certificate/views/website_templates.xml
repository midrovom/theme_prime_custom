<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="training_registration_page" name="Registro de capacitación">
        <t t-call="website.layout">
            <t t-set="additional_title" t-value="event.form_title"/>
            <div id="wrap" class="oe_structure bg-light">
                <section class="py-5">
                    <div class="container" style="max-width: 680px;">
                        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                            <div t-att-style="'height: 8px; background: %s;' % (event.certificate_template_id.accent_color or '#D6A84B')"/>
                            <div class="card-body p-4 p-md-5">
                                <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
                                    <img t-if="event.certificate_template_id.logo_primary"
                                         t-att-src="image_data_uri(event.certificate_template_id.logo_primary)"
                                         alt="Logo"
                                         style="max-height: 64px; max-width: 210px;"/>
                                    <span class="badge rounded-pill text-bg-light px-3 py-2" t-out="event.code"/>
                                </div>
                                <h1 class="h2 fw-bold mb-2" t-out="event.form_title"/>
                                <h2 class="h5 text-muted mb-3" t-out="event.course_id.name"/>
                                <div class="mb-4" t-field="event.form_intro"/>

                                <t t-if="errors">
                                    <div class="alert alert-danger" role="alert">
                                        <ul class="mb-0">
                                            <li t-foreach="errors" t-as="error" t-out="error"/>
                                        </ul>
                                    </div>
                                </t>

                                <t t-if="not available">
                                    <div class="alert alert-warning mb-0" role="alert" t-out="availability_message"/>
                                </t>
                                <form t-else="" method="post" t-att-action="'/capacitacion/%s/registrar' % event.access_token" class="needs-validation">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="mb-3">
                                        <label for="full_name" class="form-label fw-semibold">Nombres completos</label>
                                        <input id="full_name" name="full_name" type="text" class="form-control form-control-lg"
                                               minlength="3" maxlength="150" autocomplete="name" required="required"
                                               placeholder="Ingrese nombres y apellidos"
                                               t-att-value="form_data.get('full_name', '')"/>
                                    </div>
                                    <div class="mb-3">
                                        <label for="email" class="form-label fw-semibold">Correo electrónico</label>
                                        <input id="email" name="email" type="email" class="form-control form-control-lg"
                                               maxlength="254" autocomplete="email" required="required"
                                               placeholder="nombre@empresa.com"
                                               t-att-value="form_data.get('email', '')"/>
                                        <div class="form-text">El certificado será enviado a este correo.</div>
                                    </div>
                                    <div class="mb-4">
                                        <label for="organization_id" class="form-label fw-semibold">Empresa</label>
                                        <select id="organization_id" name="organization_id" class="form-select form-select-lg" required="required">
                                            <option value="">Seleccione una empresa</option>
                                            <option t-foreach="organizations" t-as="organization"
                                                    t-att-value="organization.id"
                                                    t-att-selected="str(organization.id) == str(form_data.get('organization_id', ''))"
                                                    t-out="organization.name"/>
                                        </select>
                                    </div>
                                    <button type="submit" class="btn btn-primary btn-lg w-100 py-3 fw-semibold"
                                            t-att-style="'background-color: %s; border-color: %s;' % (event.certificate_template_id.primary_color or '#123B5D', event.certificate_template_id.primary_color or '#123B5D')">
                                        Registrar participación
                                    </button>
                                    <div class="small text-muted mt-4" t-field="event.privacy_notice"/>
                                </form>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="training_registration_success" name="Registro completado">
        <t t-call="website.layout">
            <t t-set="additional_title">Registro completado</t>
            <div id="wrap" class="oe_structure bg-light">
                <section class="py-5">
                    <div class="container text-center" style="max-width: 680px;">
                        <div class="card border-0 shadow-sm rounded-4">
                            <div class="card-body p-4 p-md-5">
                                <div class="mx-auto mb-4 d-flex align-items-center justify-content-center rounded-circle bg-success text-white"
                                     style="width: 72px; height: 72px; font-size: 36px;">✓</div>
                                <h1 class="h2 fw-bold">Registro completado</h1>
                                <t t-if="already_registered">
                                    <p class="lead text-muted mt-3">Este correo ya se encuentra registrado en la capacitación.</p>
                                </t>
                                <t t-else="">
                                    <div class="mt-3" t-field="event.success_message"/>
                                    <p t-if="attendee.email_state == 'sent'" class="lead text-muted">
                                        El certificado fue enviado a <strong t-out="attendee.email"/>.
                                    </p>
                                    <p t-elif="attendee.certificate_attachment_id" class="lead text-muted">
                                        Su certificado fue generado. Si el correo tarda en llegar, puede descargarlo ahora.
                                    </p>
                                    <p t-else="" class="lead text-muted">
                                        Su participación quedó registrada. El administrador podrá reenviar el certificado.
                                    </p>
                                    <a t-if="attendee.certificate_attachment_id"
                                       t-att-href="'/capacitacion/certificado/%s/descargar' % attendee.download_token"
                                       class="btn btn-primary btn-lg mt-3 px-4">
                                        Descargar certificado
                                    </a>
                                </t>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="registration_unavailable" name="Registro no disponible">
        <t t-call="website.layout">
            <t t-set="additional_title">Registro no disponible</t>
            <div id="wrap" class="oe_structure bg-light">
                <section class="py-5">
                    <div class="container text-center" style="max-width: 680px;">
                        <div class="alert alert-warning shadow-sm p-4" role="alert">
                            <h1 class="h3">Registro no disponible</h1>
                            <p class="mb-0" t-out="message"/>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="training_event_qr_page" name="QR de capacitación">
        <t t-call="website.layout">
            <t t-set="additional_title">QR de capacitación</t>
            <div id="wrap" class="oe_structure">
                <style>
                    @media print {
                        header, footer, .o_header_standard, .o_footer, .qr-actions { display: none !important; }
                        .qr-sheet { box-shadow: none !important; border: 0 !important; }
                    }
                </style>
                <section class="py-4 py-md-5">
                    <div class="container text-center" style="max-width: 820px;">
                        <div class="qr-sheet card shadow-sm border-0 rounded-4">
                            <div class="card-body p-4 p-md-5">
                                <img t-if="event.certificate_template_id.logo_primary"
                                     t-att-src="image_data_uri(event.certificate_template_id.logo_primary)"
                                     alt="Logo" class="mb-4" style="max-height: 78px; max-width: 260px;"/>
                                <h1 class="display-6 fw-bold" t-out="event.course_id.name"/>
                                <p class="lead text-muted">Escanee el código para registrar su participación</p>
                                <img t-att-src="event.qr_image_url" alt="Código QR" class="img-fluid my-3" style="width: 420px; max-width: 90%;"/>
                                <p class="small text-muted mb-0" t-out="event.public_url"/>
                                <div class="qr-actions mt-4">
                                    <button type="button" class="btn btn-primary btn-lg" onclick="window.print();">Imprimir</button>
                                    <a t-att-href="event.public_url" target="_blank" class="btn btn-outline-secondary btn-lg ms-2">Probar formulario</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>

