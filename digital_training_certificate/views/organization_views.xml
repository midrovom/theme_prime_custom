<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_digital_training_organization_list" model="ir.ui.view">
        <field name="name">digital.training.organization.list</field>
        <field name="model">digital.training.organization</field>
        <field name="arch" type="xml">
            <list string="Empresas participantes">
                <field name="name"/>
                <field name="logo" widget="image" options="{'size': [40, 40]}"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_digital_training_organization_form" model="ir.ui.view">
        <field name="name">digital.training.organization.form</field>
        <field name="model">digital.training.organization</field>
        <field name="arch" type="xml">
            <form string="Empresa participante">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archivada" bg_color="text-bg-danger" invisible="active"/>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nombre de la empresa"/></h1>
                    </div>
                    <group>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_digital_training_organization" model="ir.actions.act_window">
        <field name="name">Empresas participantes</field>
        <field name="res_model">digital.training.organization</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

