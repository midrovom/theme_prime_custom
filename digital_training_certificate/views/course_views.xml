<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_digital_training_course_list" model="ir.ui.view">
        <field name="name">digital.training.course.list</field>
        <field name="model">digital.training.course</field>
        <field name="arch" type="xml">
            <list string="Cursos">
                <field name="name"/>
                <field name="code"/>
                <field name="default_duration_hours"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_digital_training_course_form" model="ir.ui.view">
        <field name="name">digital.training.course.form</field>
        <field name="model">digital.training.course</field>
        <field name="arch" type="xml">
            <form string="Curso">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nombre del curso"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="default_duration_hours"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descripción">
                            <field name="description" placeholder="Descripción del curso..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_digital_training_course" model="ir.actions.act_window">
        <field name="name">Cursos</field>
        <field name="res_model">digital.training.course</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

