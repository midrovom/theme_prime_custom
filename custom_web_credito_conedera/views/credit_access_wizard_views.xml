<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_conedera_credit_access_wizard_form" model="ir.ui.view">
        <field name="name">conedera.credit.access.wizard.form</field>
        <field name="model">conedera.credit.access.wizard</field>
        <field name="arch" type="xml">
            <form string="Habilitar permiso del portal">
                <sheet>
                    <div class="alert alert-info mb-3">
                        <strong>Seleccione qué podrá actualizar el solicitante.</strong>
                        <div class="mt-1">Este permiso se aplica solo a la solicitud seleccionada, como en el módulo de postulaciones.</div>
                    </div>
                    <group>
                        <field name="application_id" readonly="1"/>
                        <field name="allow_history"/>
                        <field name="allow_documentation"/>
                        <field name="allow_sketch"/>
                        <field name="document_access_allowed" invisible="1"/>
                        <field name="sketch_stage_enabled" invisible="1"/>
                    </group>
                    <div class="alert alert-warning" invisible="not allow_documentation or document_access_allowed">
                        La documentación no se podrá cargar hasta la aprobación del crédito, aunque se habilite su actualización.
                    </div>
                    <div class="alert alert-warning" invisible="not allow_sketch or sketch_stage_enabled">
                        El croquis solo se podrá completar o corregir cuando la solicitud esté en una etapa de revisión habilitada para cargar croquis.
                    </div>
                    <div class="text-muted small mt-2">
                        Las autorizaciones son independientes: si el cliente guarda una corrección de croquis, solo se consume ese permiso; los demás permanecen vigentes.
                    </div>
                </sheet>
                <footer>
                    <button name="action_apply" type="object" string="Habilitar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
