<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_conedera_credit_housing_type_list" model="ir.ui.view">
    <field name="name">conedera.credit.housing.type.list</field>
    <field name="model">conedera.credit.housing.type</field>
    <field name="arch" type="xml"><list editable="bottom" default_order="sequence,id">
      <field name="sequence" widget="handle"/>
      <field name="name"/>
      <field name="code" string="ID único" readonly="1"/>
      <field name="active"/>
    </list></field>
  </record>
  <record id="view_conedera_credit_housing_type_form" model="ir.ui.view">
    <field name="name">conedera.credit.housing.type.form</field>
    <field name="model">conedera.credit.housing.type</field>
    <field name="arch" type="xml"><form string="Tipo de vivienda"><sheet><group>
      <field name="name"/><field name="code" readonly="1"/>
      <field name="sequence"/><field name="active"/>
    </group></sheet></form></field>
  </record>
  <record id="action_conedera_credit_housing_types" model="ir.actions.act_window">
    <field name="name">Tipos de vivienda</field>
    <field name="res_model">conedera.credit.housing.type</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_conedera_credit_housing_types" name="Tipo de vivienda"
      parent="menu_conedera_credit_configuration" sequence="40"
      action="action_conedera_credit_housing_types"
      groups="custom_web_credito_conedera.group_credit_administrator"/>
</odoo>
