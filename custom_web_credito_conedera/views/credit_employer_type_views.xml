<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_credit_employer_type_list" model="ir.ui.view">
        <field name="name">conedera.credit.employer.type.list</field>
        <field name="model">conedera.credit.employer.type</field>
        <field name="arch" type="xml"><list string="Tipos de empleador" default_order="sequence,name,id">
            <field name="sequence" widget="handle"/><field name="name"/><field name="code" readonly="1"/><field name="active"/>
        </list></field>
    </record>
    <record id="view_credit_employer_type_form" model="ir.ui.view">
        <field name="name">conedera.credit.employer.type.form</field>
        <field name="model">conedera.credit.employer.type</field>
        <field name="arch" type="xml"><form string="Tipo de empleador"><sheet><group>
            <field name="name"/><field name="code" readonly="1"/><field name="sequence"/><field name="active"/>
        </group></sheet></form></field>
    </record>
    <record id="action_credit_employer_types" model="ir.actions.act_window">
        <field name="name">Tipos de empleador</field>
        <field name="res_model">conedera.credit.employer.type</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_credit_employer_types"
        parent="menu_conedera_credit_configuration" name="Tipos de empleador"
        sequence="88" action="action_credit_employer_types"
        groups="custom_web_credito_conedera.group_credit_administrator"/>
</odoo>
