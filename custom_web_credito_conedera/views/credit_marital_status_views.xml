<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_conedera_credit_marital_status_list" model="ir.ui.view">
        <field name="name">conedera.credit.marital.status.list</field>
        <field name="model">conedera.credit.marital.status</field>
        <field name="arch" type="xml">
            <list editable="bottom" default_order="sequence,id">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" string="ID único" readonly="1"/>
                <field name="requires_spouse"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_conedera_credit_marital_status_form" model="ir.ui.view">
        <field name="name">conedera.credit.marital.status.form</field>
        <field name="model">conedera.credit.marital.status</field>
        <field name="arch" type="xml">
            <form string="Estado civil">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code" readonly="1"/>
                        <field name="sequence"/>
                        <field name="requires_spouse"/>
                <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_conedera_credit_marital_statuses" model="ir.actions.act_window">
        <field name="name">Estados civiles</field>
        <field name="res_model">conedera.credit.marital.status</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_conedera_credit_marital_statuses" name="Estado civil"
        parent="menu_conedera_credit_configuration" sequence="30"
        action="action_conedera_credit_marital_statuses"
        groups="custom_web_credito_conedera.group_credit_administrator"/>
</odoo>
