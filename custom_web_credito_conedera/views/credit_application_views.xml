<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_conedera_credit_application_search" model="ir.ui.view">
        <field name="name">conedera.credit.application.search</field><field name="model">conedera.credit.application</field>
        <field name="arch" type="xml"><search string="Buscar solicitudes de crédito"><field name="name"/><field name="applicant_name"/><field name="identification"/><field name="business_name"/><field name="business_ruc"/><field name="person_type"/><field name="stage_id"/><filter string="Persona natural" name="natural" domain="[('person_type','=','natural')]"/><filter string="Persona jurídica" name="juridical" domain="[('person_type','=','juridical')]"/><filter string="Documentos habilitados" name="docs_unlocked" domain="[('documents_unlocked','=',True)]"/><group expand="0" string="Agrupar por"><filter string="Etapa" name="group_stage" context="{'group_by':'stage_id'}"/><filter string="Tipo de solicitante" name="group_person" context="{'group_by':'person_type'}"/><filter string="Fecha de solicitud" name="group_date" context="{'group_by':'application_date:month'}"/></group></search></field>
    </record>
    <record id="view_conedera_credit_application_list" model="ir.ui.view">
        <field name="name">conedera.credit.application.list</field><field name="model">conedera.credit.application</field>
        <field name="arch" type="xml"><list string="Solicitudes de crédito" default_order="create_date desc"><field name="name"/><field name="application_date"/><field name="applicant_name"/><field name="identification"/><field name="business_name"/><field name="person_type"/><field name="stage_id"/><field name="documents_unlocked" optional="show"/><field name="document_complete" optional="show"/><field name="portal_user_id" optional="hide"/></list></field>
    </record>
    <record id="view_conedera_credit_application_kanban" model="ir.ui.view">
        <field name="name">conedera.credit.application.kanban</field><field name="model">conedera.credit.application</field>
        <field name="arch" type="xml"><kanban default_group_by="stage_id" class="o_kanban_small_column" quick_create="false" records_draggable="true"><field name="name"/><field name="applicant_name"/><field name="business_name"/><field name="person_type"/><field name="identification"/><field name="application_date"/><field name="stage_id"/><field name="documents_unlocked"/><field name="document_complete"/><templates><t t-name="card"><div class="oe_kanban_global_click o_kanban_record"><div class="d-flex justify-content-between align-items-start"><strong><field name="name"/></strong><field name="person_type" widget="badge"/></div><div class="mt-2 fw-bold"><field name="business_name"/></div><div class="text-muted"><field name="applicant_name"/></div><div class="small mt-2">Identificación: <field name="identification"/></div><div class="small">Fecha: <field name="application_date"/></div><div class="mt-2"><field name="documents_unlocked" widget="boolean"/> <span class="text-muted">Carga documental habilitada</span></div><div t-if="record.document_complete.raw_value" class="mt-2"><span class="badge text-bg-success">Documentación completa</span></div><div t-else="" class="mt-2"><span class="badge text-bg-secondary">Documentación pendiente</span></div></div></t></templates></kanban></field>
    </record>
    <record id="view_conedera_credit_application_form" model="ir.ui.view">
        <field name="name">conedera.credit.application.form</field><field name="model">conedera.credit.application</field>
        <field name="arch" type="xml"><form string="Solicitud de crédito CONEDERA">
            <header><field name="document_complete" invisible="1"/><field name="stage_id" widget="statusbar" statusbar_visible="Recibida,En revisión,Aprobada,Documentación recibida,Verificación,Finalizada,Denegada" options="{'clickable': 1}"/><button name="action_mark_documentation_received" type="object" string="Marcar documentación recibida" class="btn-primary" invisible="not documents_unlocked or document_complete == False"/></header>
            <sheet>
                <div class="oe_button_box" name="button_box"><button name="action_open_portal" type="object" class="oe_stat_button" icon="fa-external-link"><div class="o_stat_info"><span class="o_stat_text">Ver en portal</span></div></button></div>
                <div class="oe_title"><label for="name"/><h1><field name="name"/></h1><div class="text-muted">Solicitud enviada desde el portal CONEDERA</div></div>
                <group><group><field name="application_date"/><field name="portal_user_id"/><field name="person_type"/><field name="identification"/><field name="declaration_accepted"/><field name="prior_commercial_relationship_accepted"/><field name="electronic_service_accepted"/><field name="credit_bureau_authorized"/><field name="company_signature_stamp_acknowledged"/><field name="additional_financial_documents_accepted"/><field name="declaration_date"/></group><group><field name="applicant_name"/><field name="applicant_email"/><field name="mobile"/><field name="phone_fixed"/><field name="documents_unlocked"/><field name="currency_id" groups="base.group_system"/></group></group>
                <notebook>
                    <page string="Propietario o representante">
                        <group><group><field name="profession"/><field name="marital_status"/><field name="foreign_residence_time"/><field name="foreign_work_visa"/><field name="spouse_name"/><field name="spouse_identification"/><field name="spouse_profession"/><field name="dependents_count"/></group><group><field name="home_address"/><field name="housing_type"/><separator string="Vehículo 1"/><field name="vehicle1_brand"/><field name="vehicle1_model"/><field name="vehicle1_year"/><field name="vehicle1_value"/><separator string="Vehículo 2"/><field name="vehicle2_brand"/><field name="vehicle2_model"/><field name="vehicle2_year"/><field name="vehicle2_value"/></group></group>
                    </page>
                    <page string="Negocio o empresa">
                        <group><group><field name="business_name"/><field name="legal_representative"/><field name="business_ruc"/><field name="province"/><field name="canton"/><field name="city"/><field name="business_address"/></group><group><field name="business_phone"/><field name="representative_email"/><field name="activity_start_date"/><field name="business_local_type"/><field name="maps_url" widget="url"/><field name="invoice_email"/></group></group>
                        <group string="Información económica"><group><field name="monthly_sales"/><field name="social_capital"/><field name="assets_amount"/><field name="liabilities_amount"/></group><group><field name="monthly_income"/><field name="monthly_expenses"/><field name="authorized_buyer_name"/><field name="authorized_buyer_identification"/><field name="authorized_buyer_email"/><field name="authorized_pickup_name"/><field name="authorized_pickup_identification"/></group></group>
                    </page>
                    <page string="Relación de dependencia"><group><group><field name="employment_company"/><field name="employment_activity"/><field name="employment_address"/><field name="employment_phone"/></group><group><field name="employment_start_date"/><field name="employment_position"/><field name="employment_salary"/></group></group></page>
                    <page string="Referencias"><field name="reference_ids" context="{'default_application_id': id}"><list editable="bottom"><field name="sequence" widget="handle"/><field name="reference_type"/><field name="provider" optional="show"/><field name="customer_since" optional="hide"/><field name="credit_limit" optional="hide"/><field name="term" optional="hide"/><field name="phone" optional="show"/><field name="contact" optional="hide"/><field name="person_name" optional="show"/><field name="address" optional="hide"/><field name="home_phone" optional="hide"/><field name="relationship" optional="hide"/><field name="bank_name" optional="show"/><field name="account_number" optional="hide"/><field name="opening_date" optional="hide"/><field name="account_type" optional="hide"/></list><form><group><field name="reference_type"/><field name="sequence"/><group string="Referencia comercial" invisible="reference_type != 'commercial'"><field name="provider"/><field name="customer_since"/><field name="credit_limit"/><field name="term"/><field name="phone"/><field name="contact"/></group><group string="Referencia personal" invisible="reference_type != 'personal'"><field name="person_name"/><field name="address"/><field name="home_phone"/><field name="relationship"/></group><group string="Referencia bancaria" invisible="reference_type != 'bank'"><field name="bank_name"/><field name="account_number"/><field name="opening_date"/><field name="account_type"/></group></group></form></field></page>
                    <page string="Ingreso de documentos" invisible="not documents_unlocked"><field name="document_ids" context="{'default_application_id': id}"><list create="0" delete="0"><field name="state"/><field name="required_document_uploaded"/><field name="required_document_total"/><field name="required_document_missing"/><field name="is_complete"/><field name="last_portal_upload"/></list><form><header><button name="action_mark_submitted" type="object" string="Enviar a revisión" class="btn-primary" invisible="state == 'submitted' or state == 'accepted'"/><button name="action_mark_accepted" type="object" string="Aceptar documentación" class="btn-primary" invisible="state == 'accepted'"/><button name="action_request_correction" type="object" string="Solicitar correcciones" invisible="state == 'correction'"/><field name="state" widget="statusbar" statusbar_visible="pending,submitted,accepted,correction"/></header><sheet><group><field name="application_id"/><field name="person_type"/><field name="required_document_total"/><field name="required_document_uploaded"/><field name="required_document_missing"/><field name="is_complete"/><field name="review_notes"/></group><notebook><page string="Generales"><group><field name="application_signed" filename="application_signed_filename"/><field name="application_signed_filename"/><field name="ruc_updated" filename="ruc_updated_filename"/><field name="ruc_updated_filename"/><field name="utility_business" filename="utility_business_filename"/><field name="utility_business_filename"/><field name="utility_residence" filename="utility_residence_filename"/><field name="utility_residence_filename"/><field name="local_photo_inside" filename="local_photo_inside_filename"/><field name="local_photo_inside_filename"/><field name="local_photo_outside" filename="local_photo_outside_filename"/><field name="local_photo_outside_filename"/><field name="applicant_signing_photo" filename="applicant_signing_photo_filename"/><field name="applicant_signing_photo_filename"/><field name="vat_declarations" filename="vat_declarations_filename"/><field name="vat_declarations_filename"/><field name="income_tax_return" filename="income_tax_return_filename"/><field name="income_tax_return_filename"/><field name="bank_certificate" filename="bank_certificate_filename"/><field name="bank_certificate_filename"/></group></page><page string="Persona natural" invisible="person_type != 'natural'"><group><field name="id_client" filename="id_client_filename"/><field name="id_client_filename"/><field name="id_spouse" filename="id_spouse_filename"/><field name="id_spouse_filename"/><field name="voting_certificate" filename="voting_certificate_filename"/><field name="voting_certificate_filename"/></group></page><page string="Persona jurídica" invisible="person_type != 'juridical'"><group><field name="id_legal_representative" filename="id_legal_representative_filename"/><field name="id_legal_representative_filename"/><field name="voting_legal_representative" filename="voting_legal_representative_filename"/><field name="voting_legal_representative_filename"/><field name="legal_appointment" filename="legal_appointment_filename"/><field name="legal_appointment_filename"/></group></page></notebook><group><field name="last_portal_upload"/></group></sheet></form></field></page>
                    <page string="Verificación de ubicación (uso interno)" groups="custom_web_credito_conedera.group_credit_manager"><group><group><field name="verification_province"/><field name="verification_city_canton_parish"/><field name="verification_neighborhood"/><field name="verification_address"/><field name="verification_house_number"/><field name="verification_reference"/><field name="verification_sketch" filename="verification_sketch_filename"/><field name="verification_sketch_filename"/></group><group><field name="verification_zone"/><field name="verification_local_state"/><field name="interviewed_person"/><field name="interviewed_relationship"/><field name="inspection_done"/><field name="address_found"/><field name="client_lives_there"/><field name="sketch_needed"/><field name="verifier_name"/><field name="verifier_signature" filename="verifier_signature_filename"/><field name="verifier_signature_filename"/></group></group></page>
                    <page string="Historial de etapas"><field name="history_ids" readonly="1"><list create="0" edit="0" delete="0"><field name="date"/><field name="stage_id"/><field name="user_id"/><field name="notes"/><field name="visible_to_portal"/></list></field></page>
                </notebook>
            </sheet><chatter/>
        </form></field>
    </record>
    <record id="action_conedera_credit_applications" model="ir.actions.act_window"><field name="name">Solicitudes de crédito</field><field name="res_model">conedera.credit.application</field><field name="view_mode">kanban,list,form</field><field name="search_view_id" ref="view_conedera_credit_application_search"/><field name="context">{'search_default_group_stage': 1}</field></record>
    <menuitem id="menu_conedera_credit_root" name="Crédito CONEDERA" sequence="45" groups="custom_web_credito_conedera.group_credit_manager"/>
    <menuitem id="menu_conedera_credit_applications" name="Solicitudes" parent="menu_conedera_credit_root" action="action_conedera_credit_applications" sequence="10" groups="custom_web_credito_conedera.group_credit_manager"/>
    <menuitem id="menu_conedera_credit_stages" name="Etapas del flujo" parent="menu_conedera_credit_root" action="action_conedera_credit_stages" sequence="30" groups="custom_web_credito_conedera.group_credit_manager"/>
</odoo>
