<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mail_server_form_inherit_conedera_credit" model="ir.ui.view">
        <field name="name">ir.mail.server.form.inherit.conedera.credit</field>
        <field name="model">ir.mail_server</field>
        <field name="inherit_id" ref="base.ir_mail_server_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='smtp_authentication']" position="after">
                <field name="is_credit_server"/>
            </xpath>
        </field>
    </record>
</odoo>
