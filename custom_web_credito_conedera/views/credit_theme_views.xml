<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_credit_theme_wizard_form" model="ir.ui.view">
        <field name="name">conedera.credit.theme.wizard.form</field>
        <field name="model">conedera.credit.theme.wizard</field>
        <field name="arch" type="xml">
            <form string="Colores del portal de crédito">
                <group>
                    <div class="alert alert-info" role="alert">Elija el sitio web de la empresa. Deje un color vacío para usar automáticamente la paleta configurada en el editor de ese sitio web. Si desea un color distinto solo para crédito, escríbalo en hexadecimal (#8F2F2F).</div>
                    <field name="website_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="color_primary" placeholder="#8F2F2F"/>
                    <field name="color_hover" placeholder="#702121"/>
                    <field name="color_soft" placeholder="#F8EDED"/>
                    <field name="color_border" placeholder="#E7E1DF"/>
                    <field name="color_text" placeholder="#702121"/>
                </group>
                <footer>
                    <button string="Guardar colores" name="action_save" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_credit_theme_wizard" model="ir.actions.act_window">
        <field name="name">Colores del portal</field>
        <field name="res_model">conedera.credit.theme.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_conedera_credit_theme" name="Colores del portal" parent="menu_conedera_credit_configuration" action="action_credit_theme_wizard" sequence="70" groups="custom_web_credito_conedera.group_credit_administrator"/>
</odoo>
