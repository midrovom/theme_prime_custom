<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_conedera_credit_print_wizard_form" model="ir.ui.view">
    <field name="name">conedera.credit.print.wizard.form</field>
    <field name="model">conedera.credit.print.wizard</field>
    <field name="arch" type="xml">
      <form string="Descargar documentos de crédito">
        <group>
          <field name="application_id" readonly="1"/>
          <field name="report_choice" widget="radio"/>
        </group>
        <footer>
          <button type="object" name="action_download" string="Descargar PDF" class="btn-primary"/>
          <button string="Cancelar" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
