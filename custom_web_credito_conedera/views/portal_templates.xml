<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="portal_home_credit_cards" inherit_id="portal.portal_my_home" name="Portal de crédito CONEDERA">
        <xpath expr="//div[@id='portal_common_category']" position="inside">
            <div class="o_portal_index_card col-md-6 order-2">
                <a href="/my/credito/nueva" title="Solicitud de crédito CONEDERA" class="d-flex gap-2 gap-md-3 py-3 pe-2 px-md-3 h-100 rounded text-decoration-none bg-100">
                    <div class="o_portal_icon d-flex align-items-center justify-content-center align-self-start credit-portal-icon"><i class="fa fa-file-text-o fa-2x" aria-hidden="true"/></div>
                    <div>
                        <div class="mt-0 mb-1 fs-5 fw-normal lh-1">Solicitud de crédito</div>
                        <div class="opacity-75">Registre una nueva solicitud para CONEDERA S.A.</div>
                    </div>
                </a>
            </div>
            <div class="o_portal_index_card col-md-6 order-3">
                <a href="/my/credito/historial" title="Historial de solicitudes" class="d-flex gap-2 gap-md-3 py-3 pe-2 px-md-3 h-100 rounded text-decoration-none bg-100">
                    <div class="o_portal_icon d-flex align-items-center justify-content-center align-self-start credit-portal-icon"><i class="fa fa-history fa-2x" aria-hidden="true"/></div>
                    <div>
                        <div class="mt-0 mb-1 fs-5 fw-normal lh-1">Historial de solicitudes</div>
                        <div class="opacity-75">Consulte etapas y novedades de sus solicitudes.</div>
                    </div>
                </a>
            </div>
            <t t-set="credit_documents_ready" t-value="request.env['conedera.credit.application'].sudo().search([('portal_user_id', '=', request.env.user.id), ('documents_unlocked', '=', True)], limit=1)"/>
            <t t-if="credit_documents_ready and not credit_documents_ready.stage_id.is_rejected">
                <div class="o_portal_index_card col-md-6 order-4">
                    <a href="/my/credito/documentos" title="Ingreso de documentos solicitados para el crédito" class="d-flex gap-2 gap-md-3 py-3 pe-2 px-md-3 h-100 rounded text-decoration-none bg-100">
                        <div class="o_portal_icon d-flex align-items-center justify-content-center align-self-start credit-portal-icon"><i class="fa fa-folder-open fa-2x" aria-hidden="true"/></div>
                        <div>
                            <div class="mt-0 mb-1 fs-5 fw-normal lh-1">Ingreso de documentos solicitados para el crédito</div>
                            <div class="opacity-75">Cargue los requisitos habilitados tras la aprobación.</div>
                        </div>
                    </a>
                </div>
            </t>
        </xpath>
    </template>

    <template id="portal_credit_signup" name="Registro para solicitud de crédito CONEDERA">
        <t t-call="website.layout">
            <div class="container py-5 credit-auth-container">
                <div class="row justify-content-center">
                    <div class="col-12 col-md-8 col-lg-6">
                        <div class="card border-0 shadow-sm rounded-4">
                            <div class="card-body p-4 p-lg-5">
                                <div class="credit-brand-line mb-3"/>
                                <h1 class="h3 mb-2">Crear cuenta para solicitar crédito</h1>
                                <p class="text-muted mb-4">Primero verificaremos su correo electrónico. Luego podrá ingresar la solicitud y consultar su historial.</p>
                                <t t-if="errors">
                                    <div class="alert alert-danger rounded-3"><ul class="mb-0"><t t-foreach="errors" t-as="error"><li t-esc="error"/></t></ul></div>
                                </t>
                                <form action="/credito/registro" method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="mb-3">
                                        <label class="form-label" for="signup_name">Nombres y apellidos</label>
                                        <input id="signup_name" class="form-control" type="text" name="name" required="required" autocomplete="name" t-att-value="name or ''"/>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label" for="signup_email">Correo electrónico</label>
                                        <input id="signup_email" class="form-control" type="email" name="email" required="required" autocomplete="email" t-att-value="email or ''"/>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label" for="signup_password">Contraseña</label>
                                        <input id="signup_password" class="form-control" type="password" name="password" minlength="8" required="required" autocomplete="new-password"/>
                                        <div class="form-text">Use al menos 8 caracteres.</div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label" for="signup_confirm_password">Confirmar contraseña</label>
                                        <input id="signup_confirm_password" class="form-control" type="password" name="confirm_password" minlength="8" required="required" autocomplete="new-password"/>
                                    </div>
                                    <div class="form-check mb-4">
                                        <input class="form-check-input" id="accept_terms" name="accept_terms" type="checkbox" required="required"/>
                                        <label class="form-check-label" for="accept_terms">Acepto que CONEDERA trate los datos ingresados para gestionar y evaluar mi solicitud de crédito.</label>
                                    </div>
                                    <button class="btn btn-credit-primary w-100" type="submit">Enviar código al correo</button>
                                </form>
                                <p class="text-center mt-4 mb-0">¿Ya tiene una cuenta? <a href="/web/login?redirect=%2Fmy%2Fcredito%2Fnueva">Iniciar sesión</a></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_credit_verify" name="Verificar correo CONEDERA">
        <t t-call="website.layout">
            <div class="container py-5 credit-auth-container">
                <div class="row justify-content-center">
                    <div class="col-12 col-md-7 col-lg-5">
                        <div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4 p-lg-5">
                            <div class="credit-brand-line mb-3"/>
                            <h1 class="h3 mb-2">Verificar correo electrónico</h1>
                            <p class="text-muted">Ingrese el código de seis dígitos enviado a <strong t-esc="signup_email or 'su correo'"/>. Cada código tiene una vigencia de 3 minutos.</p>
                            <t t-if="error"><div class="alert alert-danger rounded-3" t-esc="error"/></t>
                            <div id="credit-otp-countdown" class="alert alert-light border text-center mb-3" t-att-data-remaining-seconds="remaining_seconds">
                                <span id="credit-otp-waiting">Puede solicitar un código nuevo en <strong id="credit-otp-time">03:00</strong>.</span>
                                <span id="credit-otp-expired" class="d-none">El código venció. Puede solicitar uno nuevo.</span>
                            </div>
                            <form action="/credito/registro/verificar" method="post" id="credit-otp-verify-form">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="mb-4"><label class="form-label" for="verify_code">Código de verificación</label><input id="verify_code" class="form-control form-control-lg text-center credit-otp-input" name="code" type="text" inputmode="numeric" pattern="[0-9]{6}" minlength="6" maxlength="6" required="required" autocomplete="one-time-code"/></div>
                                <button class="btn btn-credit-primary w-100" type="submit">Verificar y crear cuenta</button>
                            </form>
                            <form action="/credito/registro/verificar" method="post" id="credit-otp-resend-form" t-att-class="'mt-3' if remaining_seconds &lt;= 0 else 'mt-3 d-none'">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="action" value="resend"/>
                                <button class="btn btn-outline-primary w-100" type="submit">Enviar código</button>
                            </form>
                            <p class="text-center mt-4 mb-0"><a href="/credito/registro">Volver al registro</a></p>
                        </div></div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_credit_application_form" name="Formulario de solicitud de crédito CONEDERA">
        <t t-call="portal.portal_layout">
            <div class="container py-4 credit-application-container">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
                    <div><span class="credit-kicker">CONEDERA S.A.</span><h1 class="h2 mb-1">Solicitud de crédito</h1><p class="text-muted mb-0">Solicitud sujeta a aprobación. Complete la información con datos correctos y actualizados.</p></div>
                    <a class="btn btn-outline-secondary rounded-pill" href="/my/credito/historial">Ver historial</a>
                </div>
                <t t-if="errors"><div class="alert alert-danger rounded-3"><strong>Revise la información:</strong><ul class="mb-0 mt-2"><t t-foreach="errors" t-as="error"><li t-esc="error"/></t></ul></div></t>
                <form action="/my/credito/solicitud/enviar" method="post" class="credit-form">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <section class="card credit-section-card mb-4"><div class="card-header">Datos del propietario o representante</div><div class="card-body"><div class="row g-3">
                        <div class="col-12 col-md-4"><label class="form-label">Tipo de solicitante *</label><select name="person_type" class="form-select" required="required"><option value="">Seleccione...</option><option value="natural" t-att-selected="form_values.get('person_type') == 'natural'">Persona natural</option><option value="juridical" t-att-selected="form_values.get('person_type') == 'juridical'">Persona jurídica</option></select><div class="form-text">Este tipo determina los documentos solicitados si el crédito es aprobado.</div></div>
                        <div class="col-12 col-md-4"><label class="form-label">Cédula o RUC del solicitante *</label><input class="form-control" name="identification" required="required" t-att-value="form_values.get('identification') or ''"/></div>
                        <div class="col-12 col-md-4"><label class="form-label">Lugar y fecha</label><input class="form-control" type="date" name="application_date" t-att-value="form_values.get('application_date') or ''"/></div>
                        <div class="col-12 col-md-6"><label class="form-label">Nombres y apellidos *</label><input class="form-control" name="applicant_name" required="required" t-att-value="form_values.get('applicant_name') or ''"/></div>
                        <div class="col-12 col-md-6"><label class="form-label">Correo electrónico *</label><input class="form-control" type="email" name="applicant_email" required="required" t-att-value="form_values.get('applicant_email') or ''"/></div>
                        <div class="col-12 col-md-4"><label class="form-label">Teléfono fijo</label><input class="form-control" name="phone_fixed" t-att-value="form_values.get('phone_fixed') or ''"/></div>
                        <div class="col-12 col-md-4"><label class="form-label">Celular *</label><input class="form-control" name="mobile" required="required" t-att-value="form_values.get('mobile') or ''"/></div>
                        <div class="col-12 col-md-4"><label class="form-label">Profesión</label><input class="form-control" name="profession" t-att-value="form_values.get('profession') or ''"/></div>
                        <div class="col-12 col-md-4"><label class="form-label">Estado civil</label><select class="form-select" name="marital_status"><option value="">Seleccione...</option><t t-foreach="marital_statuses" t-as="option"><option t-att-value="option[0]" t-att-selected="form_values.get('marital_status') == option[0]" t-esc="option[1]"/></t></select></div>
                        <div class="col-12 col-md-4"><label class="form-label">Tiempo de residencia (extranjero)</label><input class="form-control" name="foreign_residence_time" t-att-value="form_values.get('foreign_residence_time') or ''"/></div>
                        <div class="col-12 col-md-4"><label class="form-label">Visa de trabajo (extranjero)</label><select class="form-select" name="foreign_work_visa"><option value="">Seleccione...</option><option value="yes" t-att-selected="form_values.get('foreign_work_visa') == 'yes'">Sí</option><option value="no" t-att-selected="form_values.get('foreign_work_visa') == 'no'">No</option></select></div>
                        <div class="col-12 col-md-4"><label class="form-label">Nombres y apellidos del cónyuge</label><input class="form-control" name="spouse_name" t-att-value="form_values.get('spouse_name') or ''"/></div>
                        <div class="col-12 col-md-4"><label class="form-label">Cédula del cónyuge</label><input class="form-control" name="spouse_identification" t-att-value="form_values.get('spouse_identification') or ''"/></div>
                        <div class="col-12 col-md-4"><label class="form-label">Profesión del cónyuge</label><input class="form-control" name="spouse_profession" t-att-value="form_values.get('spouse_profession') or ''"/></div>
                        <div class="col-12 col-md-3"><label class="form-label">Número de cargas</label><input class="form-control" type="number" min="0" step="1" name="dependents_count" t-att-value="form_values.get('dependents_count') or '0'"/></div>
                        <div class="col-12 col-md-6"><label class="form-label">Dirección domiciliaria</label><input class="form-control" name="home_address" t-att-value="form_values.get('home_address') or ''"/></div>
                        <div class="col-12 col-md-3"><label class="form-label">Vivienda</label><select class="form-select" name="housing_type"><option value="">Seleccione...</option><t t-foreach="housing_types" t-as="option"><option t-att-value="option[0]" t-att-selected="form_values.get('housing_type') == option[0]" t-esc="option[1]"/></t></select></div>
                    </div>
                    <div class="credit-subheading mt-4">Vehículos del solicitante (si corresponde)</div><div class="row g-3">
                        <t t-foreach="[1,2]" t-as="number"><div class="col-12 col-lg-6"><div class="credit-repeat-card"><h3 class="h6">Vehículo <t t-esc="number"/></h3><div class="row g-2"><div class="col-6"><label class="form-label">Marca</label><input class="form-control" t-att-name="'vehicle%s_brand' % number" t-att-value="form_values.get('vehicle%s_brand' % number) or ''"/></div><div class="col-6"><label class="form-label">Modelo</label><input class="form-control" t-att-name="'vehicle%s_model' % number" t-att-value="form_values.get('vehicle%s_model' % number) or ''"/></div><div class="col-6"><label class="form-label">Año</label><input class="form-control" t-att-name="'vehicle%s_year' % number" t-att-value="form_values.get('vehicle%s_year' % number) or ''"/></div><div class="col-6"><label class="form-label">Avalúo comercial US$</label><input class="form-control" type="number" min="0" step="0.01" t-att-name="'vehicle%s_value' % number" t-att-value="form_values.get('vehicle%s_value' % number) or ''"/></div></div></div></div></t>
                    </div></div></section>

                    <section class="card credit-section-card mb-4"><div class="card-header">Datos del negocio o empresa</div><div class="card-body"><div class="row g-3">
                        <div class="col-12 col-md-6"><label class="form-label">Nombre o razón social *</label><input class="form-control" name="business_name" required="required" t-att-value="form_values.get('business_name') or ''"/></div>
                        <div class="col-12 col-md-6"><label class="form-label">Nombre del representante legal</label><input class="form-control" name="legal_representative" t-att-value="form_values.get('legal_representative') or ''"/></div>
                        <div class="col-12 col-md-3"><label class="form-label">RUC del negocio *</label><input class="form-control" name="business_ruc" required="required" t-att-value="form_values.get('business_ruc') or ''"/></div>
                        <div class="col-12 col-md-3"><label class="form-label">Provincia</label><input class="form-control" name="province" t-att-value="form_values.get('province') or ''"/></div>
                        <div class="col-12 col-md-3"><label class="form-label">Cantón</label><input class="form-control" name="canton" t-att-value="form_values.get('canton') or ''"/></div>
                        <div class="col-12 col-md-3"><label class="form-label">Ciudad</label><input class="form-control" name="city" t-att-value="form_values.get('city') or ''"/></div>
                        <div class="col-12 col-md-6"><label class="form-label">Dirección de la empresa *</label><input class="form-control" name="business_address" required="required" t-att-value="form_values.get('business_address') or ''"/></div>
                        <div class="col-12 col-md-3"><label class="form-label">Teléfono de la empresa</label><input class="form-control" name="business_phone" t-att-value="form_values.get('business_phone') or ''"/></div>
                        <div class="col-12 col-md-3"><label class="form-label">Email del representante legal</label><input class="form-control" type="email" name="representative_email" t-att-value="form_values.get('representative_email') or ''"/></div>
                        <div class="col-12 col-md-3"><label class="form-label">Fecha de inicio de actividades</label><input class="form-control" type="date" name="activity_start_date" t-att-value="form_values.get('activity_start_date') or ''"/></div>
                        <div class="col-12 col-md-3"><label class="form-label">Local</label><select class="form-select" name="business_local_type"><option value="">Seleccione...</option><t t-foreach="local_types" t-as="option"><option t-att-value="option[0]" t-att-selected="form_values.get('business_local_type') == option[0]" t-esc="option[1]"/></t></select></div>
                        <div class="col-12 col-md-3"><label class="form-label">Ventas mensuales US$</label><input class="form-control" type="number" min="0" step="0.01" name="monthly_sales" t-att-value="form_values.get('monthly_sales') or ''"/></div>
                        <div class="col-12 col-md-3"><label class="form-label">Capital social US$</label><input class="form-control" type="number" min="0" step="0.01" name="social_capital" t-att-value="form_values.get('social_capital') or ''"/></div>
                        <div class="col-12 col-md-4"><label class="form-label">Email para facturas</label><input class="form-control" type="email" name="invoice_email" t-att-value="form_values.get('invoice_email') or ''"/></div>
                        <div class="col-12 col-md-4"><label class="form-label">Activos (monto aproximado) US$</label><input class="form-control" type="number" min="0" step="0.01" name="assets_amount" t-att-value="form_values.get('assets_amount') or ''"/></div>
                        <div class="col-12 col-md-4"><label class="form-label">Ingresos mensuales US$</label><input class="form-control" type="number" min="0" step="0.01" name="monthly_income" t-att-value="form_values.get('monthly_income') or ''"/></div>
                        <div class="col-12 col-md-4"><label class="form-label">Pasivos (monto aproximado) US$</label><input class="form-control" type="number" min="0" step="0.01" name="liabilities_amount" t-att-value="form_values.get('liabilities_amount') or ''"/></div>
                        <div class="col-12 col-md-4"><label class="form-label">Gastos mensuales US$</label><input class="form-control" type="number" min="0" step="0.01" name="monthly_expenses" t-att-value="form_values.get('monthly_expenses') or ''"/></div>
                        <div class="col-12 col-md-4"><label class="form-label">Enlace de ubicación de Google Maps</label><input class="form-control" type="url" name="maps_url" placeholder="https://maps.google.com/..." t-att-value="form_values.get('maps_url') or ''"/><div class="form-text">Se remitirá a cobranzas@viteltek.com, tal como indica el formulario de referencia.</div></div>
                    </div>
                    <div class="credit-subheading mt-4">Personas autorizadas</div><div class="row g-3">
                        <div class="col-12 col-md-4"><label class="form-label">Persona autorizada a comprar</label><input class="form-control" name="authorized_buyer_name" t-att-value="form_values.get('authorized_buyer_name') or ''"/></div><div class="col-12 col-md-4"><label class="form-label">Cédula</label><input class="form-control" name="authorized_buyer_identification" t-att-value="form_values.get('authorized_buyer_identification') or ''"/></div><div class="col-12 col-md-4"><label class="form-label">Email</label><input class="form-control" type="email" name="authorized_buyer_email" t-att-value="form_values.get('authorized_buyer_email') or ''"/></div>
                        <div class="col-12 col-md-8"><label class="form-label">Persona autorizada a retirar mercadería</label><input class="form-control" name="authorized_pickup_name" t-att-value="form_values.get('authorized_pickup_name') or ''"/></div><div class="col-12 col-md-4"><label class="form-label">Cédula</label><input class="form-control" name="authorized_pickup_identification" t-att-value="form_values.get('authorized_pickup_identification') or ''"/></div>
                    </div></div></section>

                    <section class="card credit-section-card mb-4"><div class="card-header">Actividad económica en relación de dependencia</div><div class="card-body"><p class="text-muted small">Complete esta sección si trabaja como empleado en una empresa privada o pública.</p><div class="row g-3">
                        <div class="col-12 col-md-6"><label class="form-label">Nombre de la empresa</label><input class="form-control" name="employment_company" t-att-value="form_values.get('employment_company') or ''"/></div><div class="col-12 col-md-6"><label class="form-label">Actividad de la empresa</label><input class="form-control" name="employment_activity" t-att-value="form_values.get('employment_activity') or ''"/></div><div class="col-12 col-md-6"><label class="form-label">Dirección de la empresa</label><input class="form-control" name="employment_address" t-att-value="form_values.get('employment_address') or ''"/></div><div class="col-12 col-md-6"><label class="form-label">Teléfono de empresa</label><input class="form-control" name="employment_phone" t-att-value="form_values.get('employment_phone') or ''"/></div><div class="col-12 col-md-4"><label class="form-label">Fecha de ingreso</label><input class="form-control" type="date" name="employment_start_date" t-att-value="form_values.get('employment_start_date') or ''"/></div><div class="col-12 col-md-4"><label class="form-label">Cargo</label><input class="form-control" name="employment_position" t-att-value="form_values.get('employment_position') or ''"/></div><div class="col-12 col-md-4"><label class="form-label">Sueldo US$</label><input class="form-control" type="number" min="0" step="0.01" name="employment_salary" t-att-value="form_values.get('employment_salary') or ''"/></div>
                    </div></div></section>

                    <section class="card credit-section-card mb-4"><div class="card-header">Referencias comerciales</div><div class="card-body"><div class="credit-table-note">Puede ingresar hasta tres proveedores o referencias comerciales.</div><div class="table-responsive"><table class="table credit-reference-table"><thead><tr><th>Proveedor</th><th>Cliente desde</th><th>Cupo US$</th><th>Plazo</th><th>Teléfonos</th><th>Contacto</th></tr></thead><tbody><t t-foreach="[1,2,3]" t-as="n"><tr><td><input class="form-control" t-att-name="'commercial_provider_%s' % n" t-att-value="form_values.get('commercial_provider_%s' % n) or ''"/></td><td><input class="form-control" t-att-name="'commercial_since_%s' % n" t-att-value="form_values.get('commercial_since_%s' % n) or ''"/></td><td><input class="form-control" type="number" min="0" step="0.01" t-att-name="'commercial_limit_%s' % n" t-att-value="form_values.get('commercial_limit_%s' % n) or ''"/></td><td><input class="form-control" t-att-name="'commercial_term_%s' % n" t-att-value="form_values.get('commercial_term_%s' % n) or ''"/></td><td><input class="form-control" t-att-name="'commercial_phone_%s' % n" t-att-value="form_values.get('commercial_phone_%s' % n) or ''"/></td><td><input class="form-control" t-att-name="'commercial_contact_%s' % n" t-att-value="form_values.get('commercial_contact_%s' % n) or ''"/></td></tr></t></tbody></table></div></div></section>

                    <section class="card credit-section-card mb-4"><div class="card-header">Referencias personales (familiares que no vivan con usted)</div><div class="card-body"><div class="table-responsive"><table class="table credit-reference-table"><thead><tr><th>Nombres</th><th>Dirección</th><th>Teléfono domicilio</th><th>Parentesco</th></tr></thead><tbody><t t-foreach="[1,2,3]" t-as="n"><tr><td><input class="form-control" t-att-name="'personal_name_%s' % n" t-att-value="form_values.get('personal_name_%s' % n) or ''"/></td><td><input class="form-control" t-att-name="'personal_address_%s' % n" t-att-value="form_values.get('personal_address_%s' % n) or ''"/></td><td><input class="form-control" t-att-name="'personal_phone_%s' % n" t-att-value="form_values.get('personal_phone_%s' % n) or ''"/></td><td><input class="form-control" t-att-name="'personal_relationship_%s' % n" t-att-value="form_values.get('personal_relationship_%s' % n) or ''"/></td></tr></t></tbody></table></div></div></section>

                    <section class="card credit-section-card mb-4"><div class="card-header">Referencias bancarias del negocio y/o personales</div><div class="card-body"><div class="table-responsive"><table class="table credit-reference-table"><thead><tr><th>Banco / tarjeta de crédito</th><th>Número de cuenta</th><th>Fecha de apertura</th><th>Cuenta corriente o ahorros</th></tr></thead><tbody><t t-foreach="[1,2,3]" t-as="n"><tr><td><input class="form-control" t-att-name="'bank_name_%s' % n" t-att-value="form_values.get('bank_name_%s' % n) or ''"/></td><td><input class="form-control" t-att-name="'bank_account_%s' % n" t-att-value="form_values.get('bank_account_%s' % n) or ''"/></td><td><input class="form-control" type="date" t-att-name="'bank_opening_%s' % n" t-att-value="form_values.get('bank_opening_%s' % n) or ''"/></td><td><select class="form-select" t-att-name="'bank_type_%s' % n"><option value="">Seleccione...</option><option value="current" t-att-selected="form_values.get('bank_type_%s' % n) == 'current'">Corriente</option><option value="savings" t-att-selected="form_values.get('bank_type_%s' % n) == 'savings'">Ahorros</option></select></td></tr></t></tbody></table></div></div></section>

                    <section class="card credit-declaration-card mb-4"><div class="card-body">
                        <h2 class="h5">Declaración y autorización general</h2>
                        <p class="small">AUTORIZO EXPRESA E IRREVOCABLEMENTE A CONEDERA S.A. PARA QUE OBTENGA CUANTAS VECES LO REQUIERA Y DE CUALQUIER FUENTE DE INFORMACIÓN, INFORMACIÓN HISTÓRICA CREDITICIA RELACIONADA CON EL COMPORTAMIENTO DE MIS CUENTAS, OPERACIONES, ETC., Y EN GENERAL SOBRE EL CUMPLIMIENTO DE LAS OBLIGACIONES E INFORMACIÓN REFERENTE A LOS ACTIVOS, PASIVOS Y CONTINGENTES. ASIMISMO, DECLARO QUE CONEDERA S.A. QUEDA EXPRESAMENTE AUTORIZADA PARA QUE EN CUALQUIER MOMENTO PUEDA UTILIZAR, TRANSFERIR O ENTREGAR AQUELLA INFORMACIÓN A AUTORIDADES COMPETENTES, ORGANISMOS DE CONTROL U OTRAS ENTIDADES AUTORIZADAS. DECLARO BAJO JURAMENTO QUE TODA LA INFORMACIÓN PROPORCIONADA EN LA SOLICITUD ES VERDADERA Y EXACTA. CONEDERA S.A. PODRÁ REALIZAR LAS VERIFICACIONES QUE ESTIME OPORTUNAS SOBRE LA INFORMACIÓN AQUÍ DETALLADA. ASIMISMO, ACEPTO CONOCER QUE EL DOMICILIO FISCAL PRINCIPAL DE CONEDERA S.A. ES LA CIUDAD DE GUAYAQUIL, POR LO CUAL ME COMPROMETO AL PAGO EN DICHA CIUDAD PARA CUALQUIER EFECTO LEGAL QUE SE LLEGARA A REALIZAR EN CASO DEL NO CUMPLIMIENTO DE LA DEUDA. DECLARACIÓN Y AUTORIZACIÓN: EL SOLICITANTE DECLARA QUE TODA LA INFORMACIÓN SUMINISTRADA ES VERDADERA Y, EN CASO DE INCUMPLIMIENTO DE LA OBLIGACIÓN SOLICITADA, AUTORIZA A CONEDERA S.A. A TOMAR BIENES DE PROPIEDAD DEL FIRMANTE COMO ELEMENTO DE RECUPERACIÓN HASTA OBTENER LA CANCELACIÓN TOTAL DE LA OPERACIÓN, QUE PODRÁ SER DECLARADA DE PLAZO VENCIDO POR EL INCUMPLIMIENTO DE UNA SOLA CUOTA, DE ACUERDO CON LAS NORMAS LEGALES VIGENTES.</p>
                        <div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="declaration_accepted" name="declaration_accepted" required="required" t-att-checked="form_values.get('declaration_accepted') in ('on','1','true','yes')"/><label class="form-check-label" for="declaration_accepted">Declaro que he leído y acepto la declaración y autorización general anterior. *</label></div>
                        <div class="form-text">La aceptación de cada condición se registra con su cuenta y fecha de envío. La solicitud queda sujeta a evaluación y aprobación de CONEDERA S.A.</div>
                    </div></section>

                    <section class="card credit-declaration-card mb-4"><div class="card-body">
                        <h2 class="h5">Condiciones adicionales de la solicitud</h2>
                        <p class="text-muted small">Las siguientes cláusulas provienen de las sugerencias de reforma del documento de solicitud. Marque cada casilla para confirmar su aceptación antes de enviar el formulario.</p>
                        <div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="prior_commercial_relationship_accepted" name="prior_commercial_relationship_accepted" required="required" t-att-checked="form_values.get('prior_commercial_relationship_accepted') in ('on','1','true','yes')"/><label class="form-check-label" for="prior_commercial_relationship_accepted">Reconozco que, en caso de demanda o controversia, esta solicitud de crédito podrá presentarse como prueba de la existencia de una relación comercial previa entre CONEDERA S.A., en calidad de acreedora, y el solicitante, en calidad de deudor/a. *</label></div>
                        <div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="electronic_service_accepted" name="electronic_service_accepted" required="required" t-att-checked="form_values.get('electronic_service_accepted') in ('on','1','true','yes')"/><label class="form-check-label" for="electronic_service_accepted">Acepto que, en controversias judiciales relacionadas con el crédito solicitado y otorgado mediante este documento, el titular de la obligación y su garante, de existir, puedan ser citados telemáticamente a los correos electrónicos registrados, conforme a la referencia del Art. 55.1 del COGEP indicada en las sugerencias. *</label></div>
                        <div class="form-check border rounded-3 p-3 mb-3 credit-bureau-authorization"><strong class="d-block mb-2">Autorización independiente para consulta de score e historial crediticio</strong><input class="form-check-input" type="checkbox" id="credit_bureau_authorized" name="credit_bureau_authorized" required="required" t-att-checked="form_values.get('credit_bureau_authorized') in ('on','1','true','yes')"/><label class="form-check-label" for="credit_bureau_authorized">Autorizo expresa y separadamente a CONEDERA S.A. a consultar mi score e historial crediticio mediante cualquier plataforma o buró de crédito autorizado, sin limitarse a una empresa específica. *</label></div>
                        <div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="company_signature_stamp_acknowledged" name="company_signature_stamp_acknowledged" required="required" t-att-checked="form_values.get('company_signature_stamp_acknowledged') in ('on','1','true','yes')"/><label class="form-check-label" for="company_signature_stamp_acknowledged">Declaro conocer que el documento final de la solicitud deberá contemplar la firma y sello del representante legal de CONEDERA S.A. o de quien haga sus veces. *</label></div>
                        <div class="form-check mb-1"><input class="form-check-input" type="checkbox" id="additional_financial_documents_accepted" name="additional_financial_documents_accepted" required="required" t-att-checked="form_values.get('additional_financial_documents_accepted') in ('on','1','true','yes')"/><label class="form-check-label" for="additional_financial_documents_accepted">Me comprometo a entregar, cuando se habilite la etapa documental, las últimas seis declaraciones del IVA, la declaración del Impuesto a la Renta del año anterior y un certificado bancario correspondiente a los últimos seis meses. *</label></div>
                    </div></section>
                    <div class="d-flex flex-wrap gap-2 justify-content-end mb-5"><a href="/my/credito/historial" class="btn btn-outline-secondary rounded-pill px-4">Cancelar</a><button class="btn btn-credit-primary px-5" type="submit">Enviar solicitud de crédito</button></div>
                </form>
            </div>
        </t>
    </template>

    <template id="portal_credit_history" name="Historial de solicitudes de crédito">
        <t t-call="portal.portal_layout"><div class="container py-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4"><div><span class="credit-kicker">CONEDERA S.A.</span><h1 class="h2 mb-1">Historial de solicitudes</h1><p class="text-muted mb-0">Consulte el estado actual y las novedades de cada solicitud enviada.</p></div><a href="/my/credito/nueva" class="btn btn-credit-primary rounded-pill">Nueva solicitud</a></div>
            <t t-if="not applications"><div class="alert alert-info rounded-3">Todavía no registra solicitudes de crédito. Puede iniciar una con el botón “Nueva solicitud”.</div></t>
            <t t-else=""><div class="table-responsive"><table class="table table-hover align-middle credit-history-table"><thead><tr><th>Número</th><th>Solicitante / negocio</th><th>Fecha</th><th>Tipo</th><th>Estado actual</th><th>Documentos</th><th></th></tr></thead><tbody><t t-foreach="applications" t-as="application"><tr><td class="fw-semibold" t-esc="application.name"/><td><div t-esc="application.applicant_name"/><small class="text-muted" t-esc="application.business_name"/></td><td t-esc="application.application_date.strftime('%d/%m/%Y') if application.application_date else '-'"/><td t-esc="'Persona natural' if application.person_type == 'natural' else 'Persona jurídica'"/><td><span class="badge rounded-pill credit-stage-badge" t-esc="application.stage_id.name or 'Sin etapa'"/></td><td><t t-if="application.documents_unlocked and not application.stage_id.is_rejected"><span t-if="application.document_complete" class="text-success small">Completa</span><span t-else="" class="text-warning-emphasis small">Habilitada</span></t><span t-else="" class="text-muted small">No habilitados</span></td><td class="text-end"><a t-att-href="'/my/credito/%s' % application.id" class="btn btn-sm btn-outline-primary rounded-pill">Ver detalle</a></td></tr></t></tbody></table></div></t>
        </div></t>
    </template>

    <template id="portal_credit_detail" name="Detalle de solicitud de crédito">
        <t t-call="portal.portal_layout"><div class="container py-4 credit-application-container">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4"><div><span class="credit-kicker">CONEDERA S.A.</span><h1 class="h2 mb-1">Solicitud <t t-esc="application.name"/></h1><p class="text-muted mb-0">Envío: <t t-esc="application.application_date.strftime('%d/%m/%Y') if application.application_date else '-'"/></p></div><a href="/my/credito/historial" class="btn btn-outline-secondary rounded-pill">Volver al historial</a></div>
            <t t-if="request.params.get('sent')"><div class="alert alert-success rounded-3">Su solicitud fue enviada correctamente. Puede consultar aquí los cambios de etapa.</div></t>
            <div class="card credit-section-card mb-4"><div class="card-header">Estado de la solicitud</div><div class="card-body"><div class="d-flex flex-wrap justify-content-between gap-3 align-items-center"><div><div class="text-muted small">Etapa actual</div><div class="h4 mb-0" t-esc="application.stage_id.name or 'Sin etapa'"/></div><span t-attf-class="badge rounded-pill px-3 py-2 #{'text-bg-success' if application.stage_id.is_approved else ('text-bg-danger' if application.stage_id.is_rejected else 'text-bg-secondary')}" t-esc="'Aprobada' if application.stage_id.is_approved else ('No aprobada' if application.stage_id.is_rejected else 'En proceso')"/></div><p class="text-muted mt-3 mb-0">Cuando la solicitud alcance la etapa de aprobación, se habilitará el apartado para cargar los documentos solicitados.</p><t t-if="application.documents_unlocked and not application.stage_id.is_rejected"><a t-att-href="'/my/credito/%s/documentos' % application.id" class="btn btn-credit-primary rounded-pill mt-3">Ingresar documentos solicitados para el crédito</a></t></div></div>
            <div class="row g-4"><div class="col-12 col-lg-7"><div class="card credit-section-card h-100"><div class="card-header">Resumen de la solicitud</div><div class="card-body"><dl class="row mb-0"><dt class="col-sm-5">Tipo de solicitante</dt><dd class="col-sm-7" t-esc="'Persona natural' if application.person_type == 'natural' else 'Persona jurídica'"/><dt class="col-sm-5">Cédula / RUC solicitante</dt><dd class="col-sm-7" t-esc="application.identification or '-'"/><dt class="col-sm-5">Nombre del solicitante</dt><dd class="col-sm-7" t-esc="application.applicant_name or '-'"/><dt class="col-sm-5">Correo</dt><dd class="col-sm-7" t-esc="application.applicant_email or '-'"/><dt class="col-sm-5">Negocio / razón social</dt><dd class="col-sm-7" t-esc="application.business_name or '-'"/><dt class="col-sm-5">RUC del negocio</dt><dd class="col-sm-7" t-esc="application.business_ruc or '-'"/><dt class="col-sm-5">Dirección del negocio</dt><dd class="col-sm-7" t-esc="application.business_address or '-'"/><dt class="col-sm-5">Celular</dt><dd class="col-sm-7" t-esc="application.mobile or '-'"/><dt class="col-sm-5">Ubicación Google Maps</dt><dd class="col-sm-7"><a t-if="application.maps_url" t-att-href="application.maps_url" target="_blank" rel="noopener">Abrir ubicación</a><span t-else="">-</span></dd></dl></div></div></div>
                <div class="col-12 col-lg-5"><div class="card credit-section-card h-100"><div class="card-header">Seguimiento por etapas</div><div class="card-body"><t t-if="not history"><p class="text-muted mb-0">No existen novedades registradas.</p></t><ol class="credit-timeline"><t t-foreach="history" t-as="item"><li><div class="credit-timeline-title" t-esc="item.stage_id.name"/><div class="small text-muted" t-esc="item.date.strftime('%d/%m/%Y %H:%M') if item.date else ''"/><div class="small" t-if="item.notes" t-esc="item.notes"/></li></t></ol></div></div></div>
            </div>
            <t t-if="documents"><div class="card credit-section-card mt-4"><div class="card-header">Documentación posterior a la aprobación</div><div class="card-body"><div class="d-flex flex-wrap align-items-center justify-content-between gap-3"><div><strong t-esc="'%s de %s documentos requeridos cargados' % (documents.required_document_uploaded, documents.required_document_total)"/><div class="small text-muted" t-esc="'Expediente completo' if documents.is_complete else 'Expediente con documentos pendientes'"/></div><a t-if="application.documents_unlocked and not application.stage_id.is_rejected" t-att-href="'/my/credito/%s/documentos' % application.id" class="btn btn-outline-primary rounded-pill">Ver / actualizar documentos</a></div></div></div></t>
        </div></t>
    </template>

    <template id="portal_credit_documents_index" name="Ingreso de documentos solicitados para crédito">
        <t t-call="portal.portal_layout"><div class="container py-4">
            <div class="mb-4"><span class="credit-kicker">CONEDERA S.A.</span><h1 class="h2 mb-1">Ingreso de documentos solicitados para el crédito</h1><p class="text-muted mb-0">Esta sección se habilita cuando la solicitud es aprobada. Los documentos requeridos dependen del tipo de solicitante.</p></div>
            <t t-if="not applications"><div class="alert alert-info rounded-3">No tiene solicitudes aprobadas con carga documental habilitada.</div></t>
            <div class="row g-3"><t t-foreach="applications" t-as="application"><div class="col-12 col-lg-6"><div class="card credit-section-card h-100"><div class="card-body"><div class="d-flex justify-content-between align-items-start gap-3"><div><h2 class="h5 mb-1" t-esc="application.name"/><div t-esc="application.business_name"/><div class="small text-muted" t-esc="'Persona natural' if application.person_type == 'natural' else 'Persona jurídica'"/></div><span t-if="application.document_complete" class="badge text-bg-success">Completa</span><span t-else="" class="badge text-bg-warning">Pendiente</span></div><p class="mt-3 mb-3"><strong>Etapa:</strong> <span t-esc="application.stage_id.name"/></p><t t-set="doc" t-value="application.document_ids[:1]"/><t t-if="doc"><div class="small text-muted mb-3" t-esc="'%s de %s requisitos cargados' % (doc.required_document_uploaded, doc.required_document_total)"/></t><a t-att-href="'/my/credito/%s/documentos' % application.id" class="btn btn-credit-primary rounded-pill">Ingresar / actualizar documentos</a></div></div></div></t></div>
        </div></t>
    </template>

    <template id="portal_credit_documents_form" name="Carga de documentos de crédito">
        <t t-call="portal.portal_layout"><div class="container py-4 credit-application-container">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4"><div><span class="credit-kicker">CONEDERA S.A.</span><h1 class="h2 mb-1">Documentos solicitados para el crédito</h1><p class="text-muted mb-0">Solicitud <strong t-esc="application.name"/> · <t t-esc="application.business_name"/></p></div><a t-att-href="'/my/credito/%s' % application.id" class="btn btn-outline-secondary rounded-pill">Volver al detalle</a></div>
            <div class="alert alert-info rounded-3">Suba archivos legibles. Documentos administrativos: PDF, JPG o PNG. Fotografías del local y del solicitante: JPG o PNG. Tamaño máximo por archivo: 12 MB. Si una solicitud incluye cónyuge, también se solicitará su cédula.</div>
            <t t-if="errors"><div class="alert alert-warning rounded-3"><ul class="mb-0"><t t-foreach="errors" t-as="error"><li t-esc="error"/></t></ul></div></t>
            <form method="post" enctype="multipart/form-data" t-attf-action="/my/credito/#{application.id}/documentos" class="credit-form">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <div class="card credit-section-card mb-4"><div class="card-header">Documentos requeridos · <t t-esc="'Persona natural' if application.person_type == 'natural' else 'Persona jurídica'"/></div><div class="card-body"><div class="row g-4">
                    <t t-foreach="document_fields" t-as="item"><t t-set="field_name" t-value="item[0]"/><t t-set="label" t-value="item[1]"/>
                        <t t-set="is_common" t-value="field_name in ('application_signed','ruc_updated','utility_business','utility_residence','local_photo_inside','local_photo_outside','applicant_signing_photo','vat_declarations','income_tax_return','bank_certificate')"/>
                        <t t-set="is_natural" t-value="field_name in ('id_client','id_spouse','voting_certificate')"/>
                        <t t-set="is_juridical" t-value="field_name in ('id_legal_representative','voting_legal_representative','legal_appointment')"/>
                        <t t-if="is_common or (application.person_type == 'natural' and is_natural and (field_name != 'id_spouse' or application.spouse_name)) or (application.person_type == 'juridical' and is_juridical)">
                            <div class="col-12 col-md-6"><div class="credit-upload-field"><label class="form-label fw-semibold" t-att-for="field_name" t-esc="label"/><input class="form-control" type="file" t-att-id="field_name" t-att-name="field_name" t-att-accept="'image/jpeg,image/png' if field_name in photo_fields else '.pdf,.jpg,.jpeg,.png'"/><t t-if="document and document[field_name + '_filename']"><div class="small text-success mt-2">Archivo cargado: <span t-esc="document[field_name + '_filename']"/></div></t><div class="form-text">Deje el campo vacío para conservar el archivo anterior.</div></div></div>
                        </t>
                    </t>
                </div></div></div>
                <div class="d-flex justify-content-between flex-wrap gap-2 mb-5"><a t-att-href="'/my/credito/%s' % application.id" class="btn btn-outline-secondary rounded-pill px-4">Cancelar</a><button class="btn btn-credit-primary px-5" type="submit">Guardar documentos</button></div>
            </form>
        </div></t>
    </template>
</odoo>
