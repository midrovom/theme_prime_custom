<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_users_credit_correction_inherit" model="ir.ui.view">
        <field name="name">res.users.form.credit.portal.permissions</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Administración de permisos - Solicitud de crédito" groups="base.group_system">
                    <field name="credit_portal_permission_manager_enabled"/>
                    <div class="text-muted">El responsable habilita cada solicitud desde su botón Permiso portal; no necesita asignar un grupo al solicitante.</div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
