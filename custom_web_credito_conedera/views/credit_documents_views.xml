<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="view_conedera_credit_documents_list" model="ir.ui.view">
        <field name="name">conedera.credit.documents.list</field>
        <field name="model">conedera.credit.documents</field>
        <field name="arch" type="xml">
            <list string="Documentación de crédito" default_order="create_date desc" create="0" edit="0" delete="0">
                <field name="application_id"/><field name="applicant_name"/>
                <field name="applicant_type_id"/><field name="required_document_uploaded"/><field name="required_document_total"/>
                <field name="required_document_missing"/><field name="is_complete"/>
                <field name="last_portal_upload"/>
            </list>
        </field>
    </record>
    <record id="view_conedera_credit_documents_form" model="ir.ui.view">
        <field name="name">conedera.credit.documents.form</field>
        <field name="model">conedera.credit.documents</field>
        <field name="arch" type="xml">
            <form string="Documentación para crédito" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title"><h1>Expediente de documentos</h1></div>
                    <group>
                        <group><field name="application_id"/><field name="applicant_name"/><field name="applicant_type_id"/><field name="last_portal_upload"/></group>
                        <group><field name="required_document_total"/><field name="required_document_uploaded"/><field name="required_document_missing"/><field name="is_complete"/></group>
                    </group>
                    <notebook>
                        <page string="Archivos por requisito">
                            <field name="document_line_ids" context="{'default_document_id': id}" readonly="1">
                                <list editable="bottom" create="0" edit="0" delete="0">
                                    <field name="requirement_id" domain="[('applicant_type_id', '=', parent.applicant_type_id)]"/>
                                    <field name="file" filename="filename"/>
                                    <field name="filename"/>
                                    <field name="uploaded_at" readonly="1"/>
                                </list>
                                <form string="Documento" edit="0" create="0" delete="0"><sheet><group>
                                    <field name="requirement_id" domain="[('applicant_type_id', '=', parent.applicant_type_id)]"/>
                                    <field name="file" filename="filename"/>
                                    <field name="filename"/>
                                    <field name="uploaded_at" readonly="1"/>
                                </group></sheet></form>
                            </field>
                        </page>
                        <page string="Archivos de versiones anteriores">
                            <div class="alert alert-info" role="alert">Archivos históricos conservados para consulta. Las cargas nuevas deben realizarse en “Archivos por requisito”.</div>
                            <group>
                                <group>
                                    <field name="application_signed" filename="application_signed_filename" readonly="1"/>
                                    <field name="ruc_updated" filename="ruc_updated_filename" readonly="1"/>
                                    <field name="id_client" filename="id_client_filename" readonly="1"/>
                                    <field name="id_spouse" filename="id_spouse_filename" readonly="1"/>
                                    <field name="voting_certificate" filename="voting_certificate_filename" readonly="1"/>
                                    <field name="id_legal_representative" filename="id_legal_representative_filename" readonly="1"/>
                                    <field name="voting_legal_representative" filename="voting_legal_representative_filename" readonly="1"/>
                                    <field name="legal_appointment" filename="legal_appointment_filename" readonly="1"/>
                                </group>
                                <group>
                                    <field name="utility_business" filename="utility_business_filename" readonly="1"/>
                                    <field name="utility_residence" filename="utility_residence_filename" readonly="1"/>
                                    <field name="local_photo_inside" filename="local_photo_inside_filename" readonly="1"/>
                                    <field name="local_photo_outside" filename="local_photo_outside_filename" readonly="1"/>
                                    <field name="applicant_signing_photo" filename="applicant_signing_photo_filename" readonly="1"/>
                                    <field name="vat_declarations" filename="vat_declarations_filename" readonly="1"/>
                                    <field name="income_tax_return" filename="income_tax_return_filename" readonly="1"/>
                                    <field name="bank_certificate" filename="bank_certificate_filename" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_conedera_credit_documents_uploaded_search" model="ir.ui.view">
        <field name="name">conedera.credit.document.line.uploaded.search</field>
        <field name="model">conedera.credit.document.line</field>
        <field name="arch" type="xml">
            <search string="Buscar documentos recibidos">
                <field name="application_id"/>
                <field name="applicant_type_id"/>
                <field name="requirement_id"/>
                <field name="filename"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_applicant_type" string="Tipo de solicitante" context="{'group_by':'applicant_type_id'}"/>
                    <filter name="group_requirement" string="Documento solicitado" context="{'group_by':'requirement_id'}"/>
                    <filter name="group_application" string="Solicitud" context="{'group_by':'application_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_conedera_credit_document_line_uploaded_list" model="ir.ui.view">
        <field name="name">conedera.credit.document.line.uploaded.list</field>
        <field name="model">conedera.credit.document.line</field>
        <field name="arch" type="xml">
            <list string="Archivos recibidos por tipo y requisito" create="0" edit="0" delete="0" default_order="uploaded_at desc, id desc">
                <field name="application_id"/>
                <field name="applicant_type_id" string="Tipo de solicitante"/>
                <field name="requirement_id" string="Documento solicitado"/>
                <field name="filename" string="Archivo"/>
                <field name="uploaded_at"/>
                <field name="file" filename="filename" string="Descargar"/>
            </list>
        </field>
    </record>
    <record id="view_conedera_credit_document_line_uploaded_form" model="ir.ui.view">
        <field name="name">conedera.credit.document.line.uploaded.form</field>
        <field name="model">conedera.credit.document.line</field>
        <field name="arch" type="xml">
            <form string="Archivo enviado por el solicitante" create="0" edit="0" delete="0">
                <sheet><group>
                    <field name="application_id"/>
                    <field name="applicant_type_id"/>
                    <field name="requirement_id"/>
                    <field name="filename"/>
                    <field name="uploaded_at"/>
                    <field name="file" filename="filename"/>
                </group></sheet>
            </form>
        </field>
    </record>
    <record id="action_conedera_credit_documents" model="ir.actions.act_window">
        <field name="name">Documentos recibidos por tipo de solicitante</field>
        <field name="res_model">conedera.credit.document.line</field>
        <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_conedera_credit_document_line_uploaded_list"/><field name="search_view_id" ref="view_conedera_credit_documents_uploaded_search"/><field name="context">{'search_default_group_applicant_type': 1, 'search_default_group_requirement': 1}</field></record>
    <menuitem id="menu_conedera_credit_documents" name="Documentación recibida" parent="menu_conedera_credit_root" action="action_conedera_credit_documents" sequence="20" groups="custom_web_credito_conedera.group_credit_manager,custom_web_credito_conedera.group_credit_administrator"/>
</odoo>
