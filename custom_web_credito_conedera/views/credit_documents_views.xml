<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_conedera_credit_documents_list" model="ir.ui.view">
        <field name="name">conedera.credit.documents.list</field><field name="model">conedera.credit.documents</field>
        <field name="arch" type="xml"><list string="Documentación de crédito" default_order="create_date desc"><field name="application_id"/><field name="applicant_name"/><field name="person_type"/><field name="state"/><field name="required_document_uploaded"/><field name="required_document_total"/><field name="required_document_missing"/><field name="is_complete"/><field name="last_portal_upload"/></list></field>
    </record>
    <record id="view_conedera_credit_documents_form" model="ir.ui.view">
        <field name="name">conedera.credit.documents.form</field><field name="model">conedera.credit.documents</field>
        <field name="arch" type="xml"><form string="Documentación para crédito"><header><button name="action_mark_submitted" type="object" string="Enviar a revisión" class="btn-primary" invisible="state == 'submitted' or state == 'accepted'"/><button name="action_mark_accepted" type="object" string="Aceptar documentación" class="btn-primary" invisible="state == 'accepted'"/><button name="action_request_correction" type="object" string="Solicitar correcciones" invisible="state == 'correction'"/><field name="state" widget="statusbar" statusbar_visible="pending,submitted,accepted,correction"/></header><sheet><div class="oe_title"><h1>Expediente de documentos</h1></div><group><group><field name="application_id"/><field name="applicant_name"/><field name="person_type"/><field name="last_portal_upload"/></group><group><field name="required_document_total"/><field name="required_document_uploaded"/><field name="required_document_missing"/><field name="is_complete"/></group></group><field name="review_notes" placeholder="Indique qué documento debe corregirse o cualquier observación de revisión."/><notebook><page string="Documentos generales"><group><field name="application_signed" filename="application_signed_filename"/><field name="ruc_updated" filename="ruc_updated_filename"/><field name="utility_business" filename="utility_business_filename"/><field name="utility_residence" filename="utility_residence_filename"/><field name="local_photo_inside" filename="local_photo_inside_filename"/><field name="local_photo_outside" filename="local_photo_outside_filename"/><field name="applicant_signing_photo" filename="applicant_signing_photo_filename"/></group></page><page string="Persona natural" invisible="person_type != 'natural'"><group><field name="id_client" filename="id_client_filename"/><field name="id_spouse" filename="id_spouse_filename"/><field name="voting_certificate" filename="voting_certificate_filename"/></group></page><page string="Persona jurídica" invisible="person_type != 'juridical'"><group><field name="id_legal_representative" filename="id_legal_representative_filename"/><field name="voting_legal_representative" filename="voting_legal_representative_filename"/><field name="legal_appointment" filename="legal_appointment_filename"/></group></page></notebook></sheet><chatter/></form></field>
    </record>
    <record id="action_conedera_credit_documents" model="ir.actions.act_window"><field name="name">Documentación de crédito</field><field name="res_model">conedera.credit.documents</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_conedera_credit_documents" name="Documentación recibida" parent="menu_conedera_credit_root" action="action_conedera_credit_documents" sequence="20" groups="custom_web_credito_conedera.group_credit_manager"/>
</odoo>
