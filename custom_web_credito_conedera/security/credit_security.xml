<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_conedera_credit" model="ir.module.category">
        <field name="name">Solicitud de crédito</field>
        <field name="description">Administración de solicitudes de crédito y verificación documental.</field>
        <field name="sequence">65</field>
    </record>
    <record id="group_credit_manager" model="res.groups">
        <field name="name">Usuario de crédito (revisión y verificación)</field>
        <field name="category_id" ref="module_category_conedera_credit"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <!-- Rol independiente. NO implica Usuario de crédito: el administrador ya tiene sus propias ACL. -->
    <record id="group_credit_administrator" model="res.groups">
        <field name="name">Administrador de crédito (edición completa)</field>
        <field name="category_id" ref="module_category_conedera_credit"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="comment">Puede modificar solicitudes, referencias, documentos y catálogos de crédito, así como configurar los colores del portal.</field>
    </record>
    <!-- Igual que el módulo de postulaciones: el responsable concede permiso por solicitud,
         no por usuario de portal. Este grupo es para el empleado que otorga permisos. -->
    <!-- Permiso adicional e independiente para habilitar correcciones del portal.
         Un administrador posee este derecho por su propio grupo. -->
    <record id="group_credit_portal_update_manager" model="res.groups">
        <field name="name">Gestionar permisos de actualización del portal de crédito</field>
        <field name="category_id" ref="module_category_conedera_credit"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="comment">Permite habilitar por solicitud la corrección de datos, documentos y croquis del cliente desde el portal.</field>
    </record>
    <!-- Multiempresa: funcionarios solo acceden a expedientes de sus compañías autorizadas. -->
    <record id="rule_credit_application_multi_company" model="ir.rule">
        <field name="name">Crédito: solicitudes de empresas permitidas</field>
        <field name="model_id" ref="model_conedera_credit_application"/>
        <field name="groups" eval="[(4, ref('custom_web_credito_conedera.group_credit_manager')), (4, ref('custom_web_credito_conedera.group_credit_administrator'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_credit_vehicle_multi_company" model="ir.rule">
        <field name="name">Crédito: vehículos de empresas permitidas</field>
        <field name="model_id" ref="model_conedera_credit_vehicle"/>
        <field name="groups" eval="[(4, ref('custom_web_credito_conedera.group_credit_manager')), (4, ref('custom_web_credito_conedera.group_credit_administrator'))]"/>
        <field name="domain_force">[('application_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_credit_reference_multi_company" model="ir.rule">
        <field name="name">Crédito: referencias de empresas permitidas</field>
        <field name="model_id" ref="model_conedera_credit_reference"/>
        <field name="groups" eval="[(4, ref('custom_web_credito_conedera.group_credit_manager')), (4, ref('custom_web_credito_conedera.group_credit_administrator'))]"/>
        <field name="domain_force">[('application_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_credit_documents_multi_company" model="ir.rule">
        <field name="name">Crédito: documentos de empresas permitidas</field>
        <field name="model_id" ref="model_conedera_credit_documents"/>
        <field name="groups" eval="[(4, ref('custom_web_credito_conedera.group_credit_manager')), (4, ref('custom_web_credito_conedera.group_credit_administrator'))]"/>
        <field name="domain_force">[('application_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_credit_document_line_multi_company" model="ir.rule">
        <field name="name">Crédito: archivos de empresas permitidas</field>
        <field name="model_id" ref="model_conedera_credit_document_line"/>
        <field name="groups" eval="[(4, ref('custom_web_credito_conedera.group_credit_manager')), (4, ref('custom_web_credito_conedera.group_credit_administrator'))]"/>
        <field name="domain_force">[('document_id.application_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_credit_stage_history_multi_company" model="ir.rule">
        <field name="name">Crédito: historial de empresas permitidas</field>
        <field name="model_id" ref="model_conedera_credit_stage_history"/>
        <field name="groups" eval="[(4, ref('custom_web_credito_conedera.group_credit_manager')), (4, ref('custom_web_credito_conedera.group_credit_administrator'))]"/>
        <field name="domain_force">[('application_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
