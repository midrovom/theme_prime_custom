<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_census_visit_salesman" model="ir.rule">
        <field name="name">Visitas: vendedor ve las propias</field>
        <field name="model_id" ref="model_conedera_census_visit"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('user_id', '=', user.id)]</field>
    </record>

    <record id="rule_census_visit_manager" model="ir.rule">
        <field name="name">Visitas: gerente ve todas</field>
        <field name="model_id" ref="model_conedera_census_visit"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
