<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_census_visit_salesman" model="ir.rule">
        <field name="name">Visitas: vendedor ve las propias</field>
        <field name="model_id" ref="model_conedera_census_visit"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('user_id', '=', user.id)]</field>
    </record>

    <record id="rule_census_visit_manager" model="ir.rule">
        <field name="name">Visitas: gerente ve todas</field>
        <field name="model_id" ref="model_conedera_census_visit"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_partner_opening_hour_company" model="ir.rule">
        <field name="name">Horarios: compañías permitidas</field>
        <field name="model_id" ref="model_conedera_partner_opening_hour"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="domain_force">['|', ('partner_id.company_id', '=', False), ('partner_id.company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_census_timeline_salesman" model="ir.rule">
        <field name="name">Bitácora: vendedor ve movimientos propios</field>
        <field name="model_id" ref="model_conedera_census_commercial_timeline"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('user_id', '=', user.id)]</field>
    </record>

    <record id="rule_census_timeline_manager" model="ir.rule">
        <field name="name">Bitácora: gerente ve movimientos de compañías permitidas</field>
        <field name="model_id" ref="model_conedera_census_commercial_timeline"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_census_product_summary_salesman" model="ir.rule">
        <field name="name">Resumen productos: vendedor ve clientes asignados</field>
        <field name="model_id" ref="model_conedera_census_product_quote_summary"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('partner_id.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_census_product_summary_manager" model="ir.rule">
        <field name="name">Resumen productos: gerente ve compañías permitidas</field>
        <field name="model_id" ref="model_conedera_census_product_quote_summary"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_census_product_quote_line_salesman" model="ir.rule">
        <field name="name">Detalle proformado: vendedor ve líneas propias</field>
        <field name="model_id" ref="model_conedera_census_product_quote_line"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('user_id', '=', user.id)]</field>
    </record>

    <record id="rule_census_product_quote_line_manager" model="ir.rule">
        <field name="name">Detalle proformado: gerente ve compañías permitidas</field>
        <field name="model_id" ref="model_conedera_census_product_quote_line"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
