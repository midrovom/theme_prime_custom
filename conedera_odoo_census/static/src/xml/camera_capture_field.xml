<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="conedera_odoo_census.CameraCaptureField">
        <div class="o_conedera_camera_capture">
            <input t-ref="fileInput" type="file" accept="image/*" capture="environment"
                   class="d-none" t-on-change="onFileChange" t-att-disabled="props.readonly"/>

            <div t-if="imageSrc" class="o_conedera_camera_frame mb-3" t-on-click="openPreview" role="button" tabindex="0">
                <img t-att-src="imageSrc" class="o_conedera_camera_preview" alt="Foto de la visita"/>
                <div class="o_conedera_camera_zoom_hint">
                    <i class="fa fa-search-plus me-1"/>Tocar para ampliar
                </div>
            </div>
            <div t-else="" class="o_conedera_camera_empty mb-3">
                <i class="fa fa-camera fa-2x mb-2"/>
                <strong>Sin fotografía</strong>
                <span>Capture una evidencia del local o de la visita.</span>
            </div>

            <div t-if="!props.readonly" class="o_conedera_camera_actions">
                <button type="button" class="btn btn-primary o_conedera_camera_button"
                        t-on-click="openCamera" t-att-disabled="state.loading">
                    <i t-att-class="state.loading ? 'fa fa-spinner fa-spin me-2' : 'fa fa-camera me-2'"/>
                    <t t-if="state.loading">Procesando foto...</t>
                    <t t-else=""><t t-esc="captureLabel"/></t>
                </button>
                <button t-if="hasValue" type="button" class="btn btn-outline-danger o_conedera_camera_remove"
                        t-on-click="clearPhoto" t-att-disabled="state.loading">
                    <i class="fa fa-trash-o me-1"/>Eliminar
                </button>
            </div>
            <div t-else="" class="text-muted small">
                <i class="fa fa-check-circle me-1"/>Evidencia guardada en la visita
            </div>

            <div t-if="state.fullscreen" class="o_conedera_camera_lightbox" t-on-click="closePreview">
                <button type="button" class="o_conedera_camera_lightbox_close" t-on-click.stop="closePreview" aria-label="Cerrar">
                    <i class="fa fa-times"/>
                </button>
                <img t-att-src="imageSrc" class="o_conedera_camera_lightbox_image" alt="Foto ampliada"/>
            </div>
        </div>
    </t>
</templates>
