<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="conedera_odoo_census.CensusCustomerLookupField">
        <div class="o_conedera_lookup_field position-relative">
            <div class="input-group input-group-lg">
                <span class="input-group-text"><i class="fa fa-search"/></span>
                <input type="text"
                       class="form-control o_conedera_lookup_input"
                       autocomplete="off"
                       t-att-value="state.query"
                       t-att-readonly="props.readonly"
                       placeholder="RUC, cédula o nombre..."
                       t-on-input="onInput"
                       t-on-focus="onFocus"/>
                <button t-if="state.query" type="button" class="btn btn-outline-secondary"
                        title="Limpiar" t-on-click="clearSelection">
                    <i class="fa fa-times"/>
                </button>
            </div>

            <div t-if="state.open" class="o_conedera_lookup_dropdown shadow">
                <div t-if="state.loading" class="p-3 text-center text-muted">
                    <i class="fa fa-spinner fa-spin me-2"/>Buscando en todos los clientes...
                </div>
                <t t-foreach="state.results" t-as="candidate" t-key="candidate.id">
                    <button type="button" class="o_conedera_lookup_result"
                            t-on-click="() => this.selectCandidate(candidate)">
                        <div class="d-flex justify-content-between gap-2 align-items-start">
                            <div class="text-start flex-grow-1 overflow-hidden">
                                <div class="fw-bold text-truncate"><t t-esc="candidate.name"/></div>
                                <div class="small text-muted">
                                    <span t-if="candidate.vat"><i class="fa fa-id-card-o me-1"/><t t-esc="candidate.vat"/></span>
                                    <span t-if="candidate.city" class="ms-2"><i class="fa fa-map-marker me-1"/><t t-esc="candidate.city"/></span>
                                </div>
                                <div t-if="candidate.commercial_name" class="small text-muted text-truncate">
                                    <t t-esc="candidate.commercial_name"/>
                                </div>
                            </div>
                            <span t-att-class="'badge rounded-pill ' + statusClass(candidate.status)">
                                <t t-esc="candidate.status_label"/>
                            </span>
                        </div>
                        <div class="small mt-1 text-start">
                            <i class="fa fa-user-o me-1"/><t t-esc="candidate.owner_label"/>
                            <span class="mx-1">·</span><t t-esc="candidate.team_label"/>
                        </div>
                    </button>
                </t>
                <div t-if="state.searched and !state.loading and !state.results.length" class="p-3 text-center">
                    <i class="fa fa-check-circle text-success me-1"/>No encontramos coincidencias con lo escrito.
                </div>
            </div>
        </div>
    </t>
</templates>
