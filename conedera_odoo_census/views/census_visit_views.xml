<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_census_visit_kanban" model="ir.ui.view">
        <field name="name">conedera.census.visit.kanban</field>
        <field name="model">conedera.census.visit</field>
        <field name="arch" type="xml">
            <kanban sample="1" quick_create="false">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="visit_datetime"/>
                <field name="user_id"/>
                <field name="state"/>
                <field name="location_status"/>
                <field name="purchase_made"/>
                <field name="quotation_count"/>
                <field name="photo"/>
                <templates>
                    <t t-name="card">
                        <main>
                            <div class="d-flex justify-content-between gap-2 mb-2">
                                <div>
                                    <field name="partner_id" class="fw-bold fs-5"/>
                                    <div class="text-muted small"><field name="name"/> · <field name="visit_datetime"/></div>
                                </div>
                                <field name="state" widget="badge"/>
                            </div>
                            <div t-if="record.photo.raw_value" class="o_conedera_visit_kanban_photo mb-2">
                                <field name="photo" widget="image"/>
                            </div>
                            <div class="mb-1">
                                <i class="fa fa-user fa-fw me-1 text-muted"/> <field name="user_id"/>
                            </div>
                            <div class="mb-1">
                                <i class="fa fa-map-marker fa-fw me-1 text-muted"/> <field name="location_status" widget="badge"/>
                            </div>
                            <div t-if="record.purchase_made.raw_value" class="mb-1">
                                <i class="fa fa-shopping-cart fa-fw me-1 text-muted"/> Compra: <field name="purchase_made"/>
                            </div>
                            <footer class="mt-2" t-if="record.quotation_count.raw_value">
                                <span class="text-muted small"><field name="quotation_count"/> proforma(s)</span>
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_census_visit_list" model="ir.ui.view">
        <field name="name">conedera.census.visit.list</field>
        <field name="model">conedera.census.visit</field>
        <field name="arch" type="xml">
            <list string="Visitas comerciales"
                  decoration-danger="location_status == 'out_of_range'"
                  decoration-success="location_status == 'in_range'">
                <field name="visit_datetime"/>
                <field name="partner_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="purchase_made" string="Compra"/>
                <field name="location_status" widget="badge"/>
                <field name="quotation_count" string="Proformas"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_census_visit_form" model="ir.ui.view">
        <field name="name">conedera.census.visit.form</field>
        <field name="model">conedera.census.visit</field>
        <field name="arch" type="xml">
            <form string="Visita comercial">
                <header>
                    <button name="action_mark_done" type="object" string="Finalizar visita"
                            class="btn-primary d-none d-md-inline-block" invisible="state != 'draft'"/>
                    <button name="action_set_draft" type="object" string="Reabrir"
                            invisible="state != 'done'" groups="sales_team.group_sale_manager"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done,cancel"/>
                </header>
                <sheet class="o_conedera_visit_form">
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_quotations" type="object" class="oe_stat_button"
                                icon="fa-file-text-o" invisible="quotation_count == 0">
                            <field name="quotation_count" widget="statinfo" string="Proformas"/>
                        </button>
                    </div>

                    <div class="o_conedera_hero">
                        <div class="d-flex flex-wrap align-items-start justify-content-between gap-2">
                            <div class="flex-grow-1">
                                <div class="text-muted small text-uppercase fw-semibold mb-1">
                                    <i class="fa fa-map-marker me-1"/> Visita comercial
                                </div>
                                <h1 class="mb-1"><field name="partner_id" nolabel="1" options="{'no_create': True, 'no_create_edit': True}"/></h1>
                                <div class="text-muted"><field name="visit_datetime" nolabel="1" readonly="state != 'draft'"/></div>
                            </div>
                            <div class="text-end">
                                <field name="location_status" widget="badge" nolabel="1"/>
                            </div>
                        </div>
                    </div>

                    <div class="o_conedera_card">
                        <div class="o_conedera_card_title">
                            <i class="fa fa-location-arrow"/> 1. Verificar ubicación
                        </div>
                        <div class="o_conedera_hint">GPS opcional por ahora. Si dispone de HTTPS, puede capturarlo desde el local para validar la ubicación.</div>
                        <field name="gps_capture_payload" widget="gps_capture" nolabel="1" readonly="state != 'draft'"/>
                        <group invisible="not gps_captured_at">
                            <group>
                                <field name="gps_captured_at" readonly="1"/>
                                <field name="gps_accuracy" readonly="1"/>
                            </group>
                            <group>
                                <field name="distance_to_customer_m" readonly="1"/>
                                <button name="action_open_visit_location" type="object"
                                        string="Ver GPS en mapa" icon="fa-external-link"
                                        class="btn-secondary"/>
                            </group>
                        </group>
                    </div>

                    <div class="o_conedera_card">
                        <div class="o_conedera_card_title">
                            <i class="fa fa-check-square-o"/> 2. Resultado de la visita
                        </div>
                        <group>
                            <group>
                                <field name="purchase_made" string="¿Realizó compra?" widget="radio"
                                       options="{'horizontal': true}" readonly="state != 'draft'"/>
                                <field name="has_stock" string="¿Tiene stock actualmente?" widget="radio"
                                       options="{'horizontal': true}" readonly="state != 'draft'"/>
                                <field name="not_creditworthy" string="¿Sin crédito autorizado?" widget="radio"
                                       options="{'horizontal': true}" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="reschedule_visit" string="¿Programar próxima visita?" widget="radio"
                                       options="{'horizontal': true}" readonly="state != 'draft'"/>
                                <field name="next_visit_datetime" string="Próxima visita"
                                       invisible="reschedule_visit != 'yes'"
                                       required="reschedule_visit == 'yes'" readonly="state != 'draft'"/>
                                <field name="other_result" string="¿Hay otro resultado?" widget="radio"
                                       options="{'horizontal': true}" readonly="state != 'draft'"/>
                                <field name="other_result_detail" string="Detalle"
                                       invisible="other_result != 'yes'"
                                       required="other_result == 'yes'" readonly="state != 'draft'"/>
                            </group>
                        </group>
                        <field name="notes" placeholder="Observaciones importantes de la visita..." readonly="state != 'draft'"/>
                    </div>

                    <div class="o_conedera_card o_conedera_photo_card">
                        <div class="o_conedera_card_title">
                            <i class="fa fa-camera"/> 3. Evidencia de la visita
                        </div>
                        <div class="o_conedera_hint">La fotografía queda guardada en esta visita y puede ampliarse tanto en móvil como en PC.</div>
                        <field name="photo" widget="camera_capture" nolabel="1" readonly="state != 'draft'"/>
                        <div class="o_conedera_actionbar mt-3" invisible="not photo">
                            <button name="action_open_photo" type="object" string="Ver foto en una ventana"
                                    class="btn-secondary" icon="fa-external-link"/>
                        </div>
                    </div>

                    <div class="o_conedera_card">
                        <div class="o_conedera_card_title">
                            <i class="fa fa-file-text-o"/> 4. Venta y responsable
                        </div>
                        <group>
                            <group>
                                <field name="user_id" string="Vendedor" widget="many2one_avatar_user" readonly="1"/>
                                <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            </group>
                            <group>
                                <field name="location_tolerance_m" groups="sales_team.group_sale_manager" readonly="state != 'draft'"/>
                                <div class="o_conedera_actionbar">
                                    <button name="action_create_quotation" type="object" string="Crear proforma"
                                            class="btn-primary" icon="fa-file-text-o" invisible="state == 'cancel'"/>
                                </div>
                            </group>
                        </group>
                    </div>

                    <div class="o_conedera_visit_primary_actions" invisible="state != 'draft'">
                        <button name="action_save_progress" type="object" string="Guardar visita"
                                class="btn btn-outline-primary o_conedera_big_save" icon="fa-save"/>
                        <button name="action_mark_done" type="object" string="Finalizar visita"
                                class="btn btn-success o_conedera_big_finish" icon="fa-check-circle"/>
                    </div>

                    <div class="o_conedera_visit_done_banner" invisible="state != 'done'">
                        <i class="fa fa-check-circle me-2"/>
                        <strong>Visita finalizada</strong>
                        <span>La encuesta y la evidencia quedaron bloqueadas para preservar la bitácora.</span>
                    </div>

                    <group string="Coordenadas" groups="sales_team.group_sale_manager">
                        <field name="gps_latitude" readonly="1"/>
                        <field name="gps_longitude" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_census_visit_search" model="ir.ui.view">
        <field name="name">conedera.census.visit.search</field>
        <field name="model">conedera.census.visit</field>
        <field name="arch" type="xml">
            <search string="Buscar visitas">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter name="today" string="Hoy"
                        domain="[('visit_datetime', '&gt;=', datetime.datetime.combine(context_today(), datetime.time.min)), ('visit_datetime', '&lt;=', datetime.datetime.combine(context_today(), datetime.time.max))]"/>
                <filter name="out_of_range" string="Fuera de ubicación"
                        domain="[('location_status', '=', 'out_of_range')]"/>
                <filter name="rescheduled" string="Reagendadas"
                        domain="[('reschedule_visit', '=', 'yes')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_user" string="Vendedor" context="{'group_by': 'user_id'}"/>
                    <filter name="group_partner" string="Cliente" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_day" string="Día" context="{'group_by': 'visit_datetime:day'}"/>
                    <filter name="group_location" string="Ubicación" context="{'group_by': 'location_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_census_visit_pivot" model="ir.ui.view">
        <field name="name">conedera.census.visit.pivot</field>
        <field name="model">conedera.census.visit</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de visitas">
                <field name="user_id" type="row"/>
                <field name="visit_datetime" interval="month" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_census_visit_graph" model="ir.ui.view">
        <field name="name">conedera.census.visit.graph</field>
        <field name="model">conedera.census.visit</field>
        <field name="arch" type="xml">
            <graph string="Visitas por vendedor" type="bar">
                <field name="user_id"/>
            </graph>
        </field>
    </record>

    <record id="action_census_visit" model="ir.actions.act_window">
        <field name="name">Visitas comerciales</field>
        <field name="res_model">conedera.census.visit</field>
        <field name="view_mode">kanban,list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_census_visit_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registre la primera visita comercial.</p>
            <p>Complete la mini encuesta y genere la proforma desde la visita. El GPS es opcional temporalmente.</p>
        </field>
    </record>

    <record id="action_census_visit_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_census_visit_kanban"/>
        <field name="act_window_id" ref="action_census_visit"/>
    </record>
    <record id="action_census_visit_view_list" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_census_visit_list"/>
        <field name="act_window_id" ref="action_census_visit"/>
    </record>
    <record id="action_census_visit_view_form" model="ir.actions.act_window.view">
        <field name="sequence">3</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_census_visit_form"/>
        <field name="act_window_id" ref="action_census_visit"/>
    </record>

    <record id="action_census_visit_analysis" model="ir.actions.act_window">
        <field name="name">Análisis de visitas</field>
        <field name="res_model">conedera.census.visit</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_census_visit_search"/>
    </record>
</odoo>
