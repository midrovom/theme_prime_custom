<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_census_mobile_brand_list" model="ir.ui.view">
        <field name="name">conedera.census.mobile.brand.list</field>
        <field name="model">conedera.census.mobile.brand</field>
        <field name="arch" type="xml">
            <list editable="bottom" string="Marcas de celulares">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_census_mobile_brand_form" model="ir.ui.view">
        <field name="name">conedera.census.mobile.brand.form</field>
        <field name="model">conedera.census.mobile.brand</field>
        <field name="arch" type="xml">
            <form string="Marca de celular">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="color" widget="color_picker"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_census_mobile_brands" model="ir.actions.act_window">
        <field name="name">Marcas de celulares</field>
        <field name="res_model">conedera.census.mobile.brand</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
