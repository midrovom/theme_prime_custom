<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_census_unlock_wizard_form" model="ir.ui.view">
        <field name="name">conedera.census.unlock.wizard.form</field>
        <field name="model">conedera.census.unlock.wizard</field>
        <field name="arch" type="xml">
            <form string="Solicitar habilitación">
                <sheet>
                    <div class="o_conedera_hero mb-3">
                        <div class="text-muted small text-uppercase fw-semibold mb-1">Control de cambios</div>
                        <h2 class="mb-1">Solicitar edición del catastro</h2>
                        <div class="text-muted">El supervisor podrá habilitar la ficha temporalmente para corregir los datos maestros.</div>
                    </div>
                    <group>
                        <field name="partner_id" readonly="1"/>
                        <field name="reason" placeholder="Indique qué dato necesita corregir y por qué..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_submit" type="object" string="Enviar solicitud" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_census_unlock_request_list" model="ir.ui.view">
        <field name="name">conedera.census.unlock.request.list</field>
        <field name="model">conedera.census.unlock.request</field>
        <field name="arch" type="xml">
            <list string="Solicitudes de edición" create="false" default_order="request_date desc">
                <field name="request_date"/>
                <field name="partner_id"/>
                <field name="requested_by_id" widget="many2one_avatar_user"/>
                <field name="supervisor_id" widget="many2one_avatar_user" optional="show"/>
                <field name="reason" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="valid_until" optional="show"/>
                <field name="can_review" column_invisible="1"/>
                <button name="action_approve" type="object" string="Aprobar 2 h" class="btn-primary"
                        invisible="state != 'pending' or not can_review"/>
                <button name="action_reject" type="object" string="Rechazar" class="btn-secondary"
                        invisible="state != 'pending' or not can_review"/>
            </list>
        </field>
    </record>

    <record id="view_census_unlock_request_form" model="ir.ui.view">
        <field name="name">conedera.census.unlock.request.form</field>
        <field name="model">conedera.census.unlock.request</field>
        <field name="arch" type="xml">
            <form string="Solicitud de edición" create="false" edit="false">
                <header>
                    <button name="action_approve" type="object" string="Aprobar por 2 horas" class="btn-primary"
                            invisible="state != 'pending' or not can_review"/>
                    <button name="action_reject" type="object" string="Rechazar" class="btn-secondary"
                            invisible="state != 'pending' or not can_review"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved,rejected,expired"/>
                    <field name="can_review" invisible="1"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="requested_by_id" widget="many2one_avatar_user"/>
                            <field name="request_date"/>
                            <field name="supervisor_id" widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <field name="reviewed_by_id" widget="many2one_avatar_user"/>
                            <field name="reviewed_at"/>
                            <field name="valid_until"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Motivo">
                        <field name="reason" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_census_unlock_request_search" model="ir.ui.view">
        <field name="name">conedera.census.unlock.request.search</field>
        <field name="model">conedera.census.unlock.request</field>
        <field name="arch" type="xml">
            <search string="Solicitudes de edición">
                <field name="partner_id"/>
                <field name="requested_by_id"/>
                <field name="supervisor_id"/>
                <filter name="pending" string="Pendientes" domain="[('state','=','pending')]"/>
                <filter name="approved" string="Aprobadas" domain="[('state','=','approved')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_state" string="Estado" context="{'group_by':'state'}"/>
                    <filter name="group_salesperson" string="Comercial" context="{'group_by':'requested_by_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_census_unlock_requests" model="ir.actions.act_window">
        <field name="name">Solicitudes de edición</field>
        <field name="res_model">conedera.census.unlock.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_census_unlock_request_search"/>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
