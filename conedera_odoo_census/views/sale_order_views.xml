<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_census_visit" model="ir.ui.view">
        <field name="name">sale.order.form.conedera.census.visit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="census_originated" invisible="1"/>
                <field name="census_visit_id" readonly="state not in ('draft', 'sent')"
                       invisible="not census_visit_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_quotation_list_census_visit" model="ir.ui.view">
        <field name="name">sale.order.list.census.visit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="census_visit_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
