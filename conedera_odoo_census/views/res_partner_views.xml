<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        La antigua extensión de base.view_partner_form queda desactivada.
        El Catastro usa una vista propia para aislarse de campos de otros módulos
        y evitar duplicaciones visuales como RUC/identificación o Caja Chica.
    -->
    <record id="view_partner_form_census" model="ir.ui.view">
        <field name="name">res.partner.form.conedera.census.legacy.disabled</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="census_active" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_census_mobile" model="ir.ui.view">
        <field name="name">res.partner.form.conedera.census.mobile</field>
        <field name="model">res.partner</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <form string="Catastro de cliente">
                <header>
                    <button name="action_new_census_visit" type="object" string="Registrar visita"
                            class="btn-primary" icon="fa-map-marker"
                            invisible="not id or not census_active"
                            groups="sales_team.group_sale_salesman"/>
                    <button name="action_new_census_quotation" type="object" string="Crear proforma"
                            class="btn-secondary" icon="fa-file-text-o"
                            invisible="not id or not census_active"
                            groups="sales_team.group_sale_salesman"/>
                </header>
                <sheet class="o_conedera_census_form">
                    <!-- Campos técnicos/legado: presentes para expresiones y compatibilidad, no para el usuario. -->
                    <field name="census_active" invisible="1"/>
                    <field name="business_type" invisible="1"/>
                    <field name="customer_census_type" invisible="1"/>
                    <field name="capa" invisible="1"/>
                    <field name="company_type" invisible="1"/>
                    <field name="is_company" invisible="1"/>
                    <field name="partner_latitude" invisible="1"/>
                    <field name="partner_longitude" invisible="1"/>

                    <div class="o_conedera_hero">
                        <div class="d-flex flex-wrap align-items-start justify-content-between gap-2">
                            <div class="flex-grow-1">
                                <div class="text-muted small text-uppercase fw-semibold mb-1">
                                    <i class="fa fa-building-o me-1"/> Catastro comercial
                                </div>
                                <h1 class="mb-1">
                                    <field name="commercial_name" nolabel="1"
                                           placeholder="Nombre comercial / local"
                                           required="census_active"/>
                                </h1>
                                <div class="text-muted small">Ficha única para catastro, visitas y proformas.</div>
                            </div>
                            <div class="text-end">
                                <field name="census_completion_state" widget="badge" nolabel="1"/>
                                <div class="small text-muted mt-1">
                                    <field name="census_completion_pct" nolabel="1"/>% completo
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="oe_button_box" name="button_box" invisible="not id">
                        <button name="action_view_census_visits" type="object" class="oe_stat_button"
                                icon="fa-map-marker" groups="sales_team.group_sale_salesman">
                            <field name="census_visit_count" widget="statinfo" string="Visitas"/>
                        </button>
                        <button name="action_view_census_quotations" type="object" class="oe_stat_button"
                                icon="fa-file-text-o" groups="sales_team.group_sale_salesman">
                            <field name="census_quotation_count" widget="statinfo" string="Proformas"/>
                        </button>
                    </div>

                    <notebook>
                        <page string="Cliente" name="census_customer">
                            <div class="o_conedera_card">
                                <div class="o_conedera_card_title">
                                    <i class="fa fa-id-card-o"/> Identificación comercial
                                </div>
                                <group>
                                    <group>
                                        <field name="name" string="Razón social / cliente" required="1"/>
                                        <field name="vat" string="RUC" required="census_active"
                                               placeholder="RUC del cliente"/>
                                        <field name="store_count" string="Número de locales" required="census_active"
                                               help="Total de locales que pertenecen a este negocio."/>
                                    </group>
                                    <group>
                                        <field name="business_type_ids" widget="many2many_tags"
                                               required="census_active"
                                               options="{'color_field': 'color', 'no_quick_create': True, 'no_create_edit': True}"
                                               placeholder="Seleccione uno o varios tipos"/>
                                        <field name="business_description" placeholder="Ej. gaming, reparación, línea blanca..."/>
                                        <field name="customer_segment" string="Canal comercial"/>
                                        <field name="user_id" string="Vendedor responsable" widget="many2one_avatar_user"/>
                                    </group>
                                </group>
                            </div>

                            <div class="o_conedera_card">
                                <div class="o_conedera_card_title">
                                    <i class="fa fa-users"/> Contactos
                                </div>
                                <group>
                                    <group string="Dueño / propietario">
                                        <field name="owner_contact_name" placeholder="Nombre y apellido"/>
                                        <field name="owner_phone" widget="phone" placeholder="Teléfono / WhatsApp"/>
                                    </group>
                                    <group string="Contacto comercial">
                                        <field name="commercial_contact_name" placeholder="Nombre y apellido"/>
                                        <field name="phone" string="Teléfono principal" widget="phone" placeholder="Teléfono comercial"/>
                                        <field name="mobile" string="Móvil / WhatsApp" widget="phone" placeholder="Celular / WhatsApp"/>
                                        <field name="email" widget="email" placeholder="Correo electrónico"/>
                                    </group>
                                </group>
                            </div>
                        </page>

                        <page string="Ubicación y horario" name="census_location_schedule">
                            <div class="o_conedera_card">
                                <div class="o_conedera_card_title">
                                    <i class="fa fa-map-marker"/> Dirección del local
                                </div>
                                <group>
                                    <group>
                                        <field name="street" string="Dirección" placeholder="Calle principal y numeración"/>
                                        <field name="street2" string="Referencia" placeholder="Referencia, local, piso..."/>
                                        <field name="city" string="Ciudad"/>
                                    </group>
                                    <group>
                                        <field name="country_id" string="País"/>
                                        <field name="state_id" string="Provincia / estado"/>
                                        <field name="zip" string="Código postal"/>
                                    </group>
                                </group>
                            </div>

                            <div class="o_conedera_card">
                                <div class="o_conedera_card_title">
                                    <i class="fa fa-location-arrow"/> Ubicación GPS verificada
                                </div>
                                <div class="o_conedera_hint">
                                    Capture la ubicación estando físicamente en el local. Se guardará la precisión y la fecha de captura.
                                </div>
                                <field name="census_gps_payload" widget="gps_capture" nolabel="1"/>
                                <group invisible="not census_gps_captured_at">
                                    <group>
                                        <field name="census_gps_captured_at" readonly="1"/>
                                        <field name="census_gps_accuracy" readonly="1"/>
                                    </group>
                                    <group>
                                        <button name="action_open_census_location" type="object"
                                                string="Ver ubicación en mapa" icon="fa-external-link"
                                                class="btn-secondary"/>
                                    </group>
                                </group>
                            </div>

                            <div class="o_conedera_card">
                                <div class="o_conedera_card_title">
                                    <i class="fa fa-clock-o"/> Horario de atención
                                </div>
                                <div class="o_conedera_hint">
                                    Agregue una fila por franja de atención. Si un día no tiene filas, se considera cerrado. Puede agregar dos franjas el mismo día.
                                </div>
                                <field name="opening_hour_ids" nolabel="1" mode="list,form">
                                    <list editable="bottom" string="Horario de atención">
                                        <field name="day_of_week" string="Día"/>
                                        <field name="opening_time" string="Desde" widget="float_time"/>
                                        <field name="closing_time" string="Hasta" widget="float_time"/>
                                    </list>
                                    <form string="Franja de atención">
                                        <group>
                                            <field name="day_of_week"/>
                                            <field name="opening_time" widget="float_time"/>
                                            <field name="closing_time" widget="float_time"/>
                                        </group>
                                    </form>
                                </field>
                            </div>
                        </page>

                        <page string="Actividad" name="census_activity">
                            <div class="o_conedera_card">
                                <div class="o_conedera_card_title">
                                    <i class="fa fa-history"/> Seguimiento
                                </div>
                                <group>
                                    <group>
                                        <field name="census_last_visit_datetime" readonly="1"/>
                                        <field name="census_date" readonly="1"/>
                                        <field name="census_user_id" readonly="1"/>
                                    </group>
                                    <group>
                                        <div class="o_conedera_actionbar">
                                            <button name="action_new_census_visit" type="object" string="Registrar nueva visita"
                                                    class="btn-primary" icon="fa-map-marker" invisible="not id"/>
                                            <button name="action_new_census_quotation" type="object" string="Crear proforma"
                                                    class="btn-secondary" icon="fa-file-text-o" invisible="not id"/>
                                        </div>
                                    </group>
                                </group>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_partner_kanban_census" model="ir.ui.view">
        <field name="name">res.partner.kanban.conedera.census</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban sample="1" quick_create="false">
                <field name="commercial_name"/>
                <field name="name"/>
                <field name="vat"/>
                <field name="city"/>
                <field name="store_count"/>
                <field name="business_type_ids"/>
                <field name="customer_segment"/>
                <field name="census_completion_state"/>
                <field name="census_last_visit_datetime"/>
                <templates>
                    <t t-name="card">
                        <main>
                            <div class="d-flex justify-content-between gap-2 mb-2">
                                <div>
                                    <field name="commercial_name" class="fw-bold fs-5"/>
                                    <div class="text-muted small"><field name="name"/></div>
                                </div>
                                <field name="census_completion_state" widget="badge"/>
                            </div>
                            <div class="mb-1" t-if="record.vat.raw_value">
                                <i class="fa fa-id-card-o fa-fw me-1 text-muted"/> RUC: <field name="vat"/>
                            </div>
                            <div class="mb-1" t-if="record.city.raw_value">
                                <i class="fa fa-map-marker fa-fw me-1 text-muted"/> <field name="city"/>
                            </div>
                            <div class="mb-2">
                                <i class="fa fa-building fa-fw me-1 text-muted"/> <field name="store_count"/> local(es)
                            </div>
                            <field name="business_type_ids" widget="many2many_tags"
                                   options="{'color_field': 'color'}"/>
                            <footer class="mt-2" t-if="record.census_last_visit_datetime.raw_value">
                                <span class="text-muted small">Última visita: </span>
                                <field name="census_last_visit_datetime"/>
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_partner_list_census" model="ir.ui.view">
        <field name="name">res.partner.list.conedera.census</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Clientes catastrados" default_order="write_date desc, id desc">
                <field name="commercial_name" string="Local"/>
                <field name="name" string="Razón social" optional="show"/>
                <field name="vat" string="RUC"/>
                <field name="city"/>
                <field name="store_count" string="Locales"/>
                <field name="business_type_ids" widget="many2many_tags" optional="show"/>
                <field name="customer_segment" optional="hide"/>
                <field name="user_id" string="Vendedor" widget="many2one_avatar_user" optional="show"/>
                <field name="census_completion_state" widget="badge" string="Estado"/>
                <field name="census_last_visit_datetime" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_partner_search_census" model="ir.ui.view">
        <field name="name">res.partner.search.conedera.census</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Buscar clientes catastrados">
                <field name="commercial_name" string="Local"/>
                <field name="name" string="Razón social"/>
                <field name="vat" string="RUC"/>
                <field name="city"/>
                <field name="business_type_ids"/>
                <field name="user_id" string="Vendedor"/>
                <separator/>
                <filter name="pending_gps" string="Pendiente GPS" domain="[('census_gps_captured_at', '=', False)]"/>
                <filter name="with_gps" string="Con GPS" domain="[('census_gps_captured_at', '!=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_city" string="Ciudad" context="{'group_by': 'city'}"/>
                    <filter name="group_user" string="Vendedor" context="{'group_by': 'user_id'}"/>
                    <filter name="group_segment" string="Canal comercial" context="{'group_by': 'customer_segment'}"/>
                </group>
                <searchpanel>
                    <field name="business_type_ids" string="Tipo de negocio" select="multi"/>
                    <field name="customer_segment" string="Canal comercial" select="multi"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_census_partners" model="ir.actions.act_window">
        <field name="name">Catastro de clientes</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" eval="False"/>
        <field name="search_view_id" ref="view_partner_search_census"/>
        <field name="domain">[('census_active', '=', True)]</field>
        <field name="context">{'default_census_active': True, 'default_company_type': 'company', 'default_user_id': uid}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cree el primer cliente catastrado.</p>
            <p>Registre los datos esenciales, tipos de negocio, horario y ubicación GPS del local.</p>
        </field>
    </record>

    <record id="action_census_partners_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_partner_kanban_census"/>
        <field name="act_window_id" ref="action_census_partners"/>
    </record>
    <record id="action_census_partners_view_list" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_partner_list_census"/>
        <field name="act_window_id" ref="action_census_partners"/>
    </record>
    <record id="action_census_partners_view_form" model="ir.actions.act_window.view">
        <field name="sequence">3</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_partner_form_census_mobile"/>
        <field name="act_window_id" ref="action_census_partners"/>
    </record>

    <!-- Configuración de tipos de negocio: editable solo por gerentes de ventas. -->
    <record id="view_census_business_type_list" model="ir.ui.view">
        <field name="name">conedera.census.business.type.list</field>
        <field name="model">conedera.census.business.type</field>
        <field name="arch" type="xml">
            <list editable="bottom" string="Tipos de negocio">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_census_business_type_form" model="ir.ui.view">
        <field name="name">conedera.census.business.type.form</field>
        <field name="model">conedera.census.business.type</field>
        <field name="arch" type="xml">
            <form string="Tipo de negocio">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="color" widget="color_picker"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_census_business_types" model="ir.actions.act_window">
        <field name="name">Tipos de negocio</field>
        <field name="res_model">conedera.census.business.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
