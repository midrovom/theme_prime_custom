<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        La antigua extensión de base.view_partner_form queda desactivada.
        El Catastro usa una vista propia para aislarse de campos de otros módulos
        y evitar duplicaciones visuales como RUC/identificación o Caja Chica.
    -->
    <record id="view_partner_form_census" model="ir.ui.view">
        <field name="name">res.partner.form.conedera.census.legacy.disabled</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="census_active" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_census_mobile" model="ir.ui.view">
        <field name="name">res.partner.form.conedera.census.mobile</field>
        <field name="model">res.partner</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <form string="Catastro de cliente" create="false" delete="false" duplicate="false">
                <header>
                    <button name="action_new_census_visit" type="object" string="Registrar visita"
                            class="btn-primary" icon="fa-map-marker"
                            invisible="not id or not census_active or not census_ready_for_activity or not census_locked"
                            groups="conedera_odoo_census.group_census_user"/>
                    <button name="action_new_census_quotation" type="object" string="Crear proforma"
                            class="btn-secondary" icon="fa-file-text-o"
                            invisible="not id or not census_active or not census_ready_for_activity or not census_locked"
                            groups="conedera_odoo_census.group_census_user"/>
                </header>
                <sheet class="o_conedera_census_form">
                    <!-- Campos técnicos/legado: presentes para expresiones y compatibilidad, no para el usuario. -->
                    <field name="census_active" invisible="1"/>
                    <field name="business_type" invisible="1"/>
                    <field name="customer_census_type" invisible="1"/>
                    <field name="company_type" invisible="1"/>
                    <field name="is_company" invisible="1"/>
                    <field name="partner_latitude" invisible="1"/>
                    <field name="partner_longitude" invisible="1"/>
                    <field name="census_ready_for_activity" invisible="1"/>
                    <field name="census_missing_requirements" invisible="1"/>
                    <field name="census_locked" invisible="1"/>
                    <field name="census_can_edit_master" invisible="1"/>
                    <field name="census_edit_state" invisible="1"/>
                    <field name="census_unlock_user_id" invisible="1"/>
                    <field name="census_unlock_until" invisible="1"/>
                    <field name="census_allowed_team_ids" invisible="1"/>
                    <field name="census_latest_unlock_state" invisible="1"/>
                    <field name="census_latest_unlock_request_date" invisible="1"/>
                    <field name="census_latest_unlock_reviewed_at" invisible="1"/>
                    <field name="census_latest_unlock_valid_until" invisible="1"/>
                    <field name="census_latest_unlock_reason" invisible="1"/>
                    <field name="census_latest_unlock_review_note" invisible="1"/>

                    <div class="o_conedera_hero">
                        <div class="d-flex flex-wrap align-items-start justify-content-between gap-2">
                            <div class="flex-grow-1">
                                <div class="text-muted small text-uppercase fw-semibold mb-1">
                                    <i class="fa fa-building-o me-1"/> Catastro comercial
                                </div>
                                <h1 class="mb-1">
                                    <field name="commercial_name" readonly="census_locked and not census_can_edit_master" nolabel="1" required="1"
                                           placeholder="Nombre comercial / local"
/>
                                </h1>
                                <div class="text-muted small">Ficha única para catastro, visitas y proformas.</div>
                            </div>
                            <div class="text-end">
                                <field name="census_completion_state" widget="badge" nolabel="1"/>
                                <field name="census_edit_state" widget="badge" nolabel="1" class="ms-1"/>
                                <div class="small text-muted mt-1">
                                    <field name="census_completion_pct" nolabel="1"/>% completo
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-warning d-flex align-items-start gap-2" role="alert"
                         invisible="census_ready_for_activity">
                        <i class="fa fa-exclamation-triangle mt-1"/>
                        <div>
                            <strong>Complete el catastro antes de registrar visitas o crear proformas.</strong>
                            <div class="small mt-1">
                                Pendiente: <field name="census_missing_requirements" readonly="1" nolabel="1"/>.
                            </div>
                            <div class="small mt-1">La ubicación GPS es opcional temporalmente mientras no tenga HTTPS.</div>
                        </div>
                    </div>
                    <div class="alert alert-info d-flex align-items-center justify-content-between gap-2" role="alert"
                         invisible="not census_ready_for_activity or census_locked">
                        <div><i class="fa fa-shield me-1"/><strong>Datos completos.</strong> Registre el catastro para proteger la ficha y habilitar visitas/proformas.</div>
                        <button name="action_register_census" type="object" string="Registrar y proteger" class="btn-primary" icon="fa-lock"/>
                    </div>
                    <div class="alert alert-success d-flex align-items-center justify-content-between gap-2" role="alert"
                         invisible="not census_locked">
                        <div>
                            <i class="fa fa-lock me-1"/>
                            <strong>Catastro protegido.</strong>
                            <span invisible="census_can_edit_master"> Para modificar datos maestros solicite habilitación al supervisor.</span>
                            <span invisible="not census_can_edit_master or not census_unlock_until"> Edición temporal habilitada hasta <field name="census_unlock_until" readonly="1" nolabel="1"/>.</span>
                        </div>
                        <div class="d-flex gap-2">
                            <button name="action_request_census_unlock" type="object" string="Solicitar edición" class="btn-outline-secondary" icon="fa-unlock-alt"
                                    invisible="census_can_edit_master"/>
                            <button name="action_finish_census_edit" type="object" string="Terminar edición" class="btn-outline-secondary" icon="fa-lock"
                                    invisible="census_edit_state != 'enabled'"/>
                        </div>
                    </div>

                    <div class="o_conedera_card o_conedera_request_status" invisible="not census_locked">
                        <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                            <div class="o_conedera_card_title mb-0"><i class="fa fa-refresh"/> Estado de solicitud de edición</div>
                            <button name="action_refresh_census_unlock_status" type="object" string="Refrescar estado"
                                    class="btn btn-outline-primary" icon="fa-refresh"/>
                        </div>
                        <div class="text-muted" invisible="census_latest_unlock_state">
                            No hay una solicitud de edición registrada para su usuario.
                        </div>
                        <div invisible="not census_latest_unlock_state">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                <strong>Estado:</strong>
                                <field name="census_latest_unlock_state" widget="badge" nolabel="1"/>
                            </div>
                            <div class="small mb-1" invisible="not census_latest_unlock_request_date">
                                <strong>Solicitada:</strong> <field name="census_latest_unlock_request_date" readonly="1" nolabel="1"/>
                            </div>
                            <div class="small mb-1" invisible="not census_latest_unlock_reason">
                                <strong>Motivo:</strong> <field name="census_latest_unlock_reason" readonly="1" nolabel="1"/>
                            </div>
                            <div class="alert alert-success mt-2 mb-0" invisible="census_latest_unlock_state != 'approved'">
                                <strong>Solicitud aprobada.</strong>
                                <span invisible="not census_latest_unlock_valid_until"> Puede editar hasta <field name="census_latest_unlock_valid_until" readonly="1" nolabel="1"/>.</span>
                            </div>
                            <div class="alert alert-danger mt-2 mb-0" invisible="census_latest_unlock_state != 'rejected'">
                                <strong>Solicitud rechazada.</strong>
                                <div class="mt-1" invisible="not census_latest_unlock_review_note">
                                    Motivo: <field name="census_latest_unlock_review_note" readonly="1" nolabel="1"/>
                                </div>
                            </div>
                            <div class="small text-muted mt-2" invisible="not census_latest_unlock_reviewed_at">
                                Respondida: <field name="census_latest_unlock_reviewed_at" readonly="1" nolabel="1"/>
                            </div>
                        </div>
                    </div>

                    <div class="o_conedera_card o_conedera_mobile_quick_actions" invisible="not id">
                        <div class="o_conedera_card_title"><i class="fa fa-bolt"/> Acciones rápidas</div>
                        <div class="o_conedera_app_actions">
                            <button name="action_new_census_visit" type="object" string="Nueva visita"
                                    class="btn btn-primary" icon="fa-map-marker"
                                    invisible="not census_ready_for_activity or not census_locked"/>
                            <button name="action_new_census_quotation" type="object" string="Nueva proforma"
                                    class="btn btn-primary" icon="fa-file-text-o"
                                    invisible="not census_ready_for_activity or not census_locked"/>
                            <button name="action_view_census_timeline" type="object" string="Bitácora"
                                    class="btn btn-outline-secondary" icon="fa-history"/>
                            <button name="action_view_census_product_summary" type="object" string="Productos cotizados"
                                    class="btn btn-outline-secondary" icon="fa-cubes"/>
                        </div>
                    </div>

                    <div class="oe_button_box" name="button_box" invisible="not id">
                        <button name="action_view_census_visits" type="object" class="oe_stat_button"
                                icon="fa-map-marker" groups="conedera_odoo_census.group_census_user">
                            <field name="census_visit_count" widget="statinfo" string="Visitas"/>
                        </button>
                        <button name="action_view_census_quotations" type="object" class="oe_stat_button"
                                icon="fa-file-text-o" groups="conedera_odoo_census.group_census_user">
                            <field name="census_quotation_count" widget="statinfo" string="Proformas"/>
                        </button>
                        <button name="action_view_census_reassignments" type="object" class="oe_stat_button"
                                icon="fa-exchange" groups="conedera_odoo_census.group_census_user"
                                invisible="not census_reassignment_count">
                            <field name="census_reassignment_count" widget="statinfo" string="Reasignaciones"/>
                        </button>
                    </div>

                    <notebook>
                        <page string="Cliente" name="census_customer">
                            <div class="o_conedera_card">
                                <div class="o_conedera_card_title">
                                    <i class="fa fa-id-card-o"/> Identificación comercial
                                </div>
                                <group>
                                    <group>
                                        <field name="name" string="Razón social / cliente" required="1" readonly="census_locked and not census_can_edit_master"/>
                                        <field name="vat" readonly="census_locked and not census_can_edit_master" string="RUC" required="1"
                                               placeholder="RUC del cliente"/>
                                        <field name="census_store_count" readonly="census_locked and not census_can_edit_master" string="Número de tiendas / locales"
                                               class="o_conedera_store_count"
                                               placeholder="Ej. 3"
                                               help="Ingrese la cantidad total de tiendas o locales. Debe ser mayor que cero para habilitar visitas y proformas."/>
                                        <div class="text-muted small">Digite la cantidad real de locales. Puede actualizarla cuando el cliente abra o cierre tiendas.</div>
                                        <field name="capa" readonly="census_locked and not census_can_edit_master" string="CAPA / Capacidad de compra"
                                               placeholder="Ej. 5000.00"
                                               help="Monto estimado de capacidad de compra. Debe ser mayor que cero para habilitar visitas y proformas."/>
                                    </group>
                                    <group>
                                        <field name="business_type_ids" readonly="census_locked and not census_can_edit_master" widget="many2many_tags"
                                               options="{'color_field': 'color', 'no_quick_create': True, 'no_create_edit': True}"
                                               placeholder="Seleccione uno o varios tipos"/>
                                        <field name="mobile_brand_ids" readonly="census_locked and not census_can_edit_master" widget="many2many_tags"
                                               options="{'color_field': 'color', 'no_quick_create': True, 'no_create_edit': True}"
                                               placeholder="Marcas de celulares (opcional)"/>
                                        <div class="text-muted small">Opcional: seleccione las marcas de celulares que maneja el cliente.</div>
                                        <field name="business_description" readonly="census_locked and not census_can_edit_master" placeholder="Ej. gaming, reparación, línea blanca..."/>
                                        <field name="customer_segment" readonly="census_locked and not census_can_edit_master" string="Canal comercial"/>
                                        <field name="user_id" string="Vendedor responsable" widget="many2one_avatar_user" readonly="1"/>
                                        <field name="census_company_id" string="Empresa del Catastro"
                                               readonly="census_locked"
                                               options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                                        <field name="census_team_id" string="Equipo comercial" widget="selection"
                                               readonly="census_locked"
                                               domain="[('id', 'in', census_allowed_team_ids)]"
                                               options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"
                                               placeholder="Seleccione un equipo comercial"/>
                                        <div class="text-muted small" colspan="2">
                                            El equipo se propone desde el usuario y puede cambiarse en borrador mediante una lista simple. Solo aparecen equipos habilitados de la misma Empresa del Catastro. Al registrar, empresa y equipo quedan protegidos.
                                        </div>
                                    </group>
                                </group>
                            </div>

                            <div class="o_conedera_card">
                                <div class="o_conedera_card_title">
                                    <i class="fa fa-users"/> Contactos
                                </div>
                                <group>
                                    <group string="Dueño / propietario">
                                        <field name="owner_contact_name" readonly="census_locked and not census_can_edit_master" placeholder="Nombre y apellido"/>
                                        <field name="owner_phone" readonly="census_locked and not census_can_edit_master" widget="phone" placeholder="Teléfono / WhatsApp"/>
                                    </group>
                                    <group string="Contacto comercial">
                                        <field name="commercial_contact_name" readonly="census_locked and not census_can_edit_master" placeholder="Nombre y apellido"/>
                                        <field name="phone" readonly="census_locked and not census_can_edit_master" string="Teléfono principal" widget="phone" placeholder="Teléfono comercial"/>
                                        <field name="mobile" readonly="census_locked and not census_can_edit_master" string="Móvil / WhatsApp" widget="phone" placeholder="Celular / WhatsApp"/>
                                        <field name="email" readonly="census_locked and not census_can_edit_master" widget="email" placeholder="Correo electrónico"/>
                                    </group>
                                </group>
                            </div>
                        </page>

                        <page string="Ubicación y horario" name="census_location_schedule">
                            <div class="o_conedera_card">
                                <div class="o_conedera_card_title">
                                    <i class="fa fa-map-marker"/> Dirección del local
                                </div>
                                <group>
                                    <group>
                                        <field name="street" readonly="census_locked and not census_can_edit_master" string="Dirección" placeholder="Calle principal y numeración"/>
                                        <field name="street2" readonly="census_locked and not census_can_edit_master" string="Referencia" placeholder="Referencia, local, piso..."/>
                                        <field name="city" readonly="census_locked and not census_can_edit_master" string="Ciudad"/>
                                    </group>
                                    <group>
                                        <field name="country_id" readonly="census_locked and not census_can_edit_master" string="País"/>
                                        <field name="state_id" readonly="census_locked and not census_can_edit_master" string="Provincia / estado"/>
                                        <field name="zip" readonly="census_locked and not census_can_edit_master" string="Código postal"/>
                                    </group>
                                </group>
                            </div>

                            <div class="o_conedera_card">
                                <div class="o_conedera_card_title">
                                    <i class="fa fa-location-arrow"/> Ubicación GPS verificada
                                </div>
                                <div class="o_conedera_hint">
                                    Opcional por ahora: la captura GPS requiere HTTPS. Puede completar el catastro, registrar visitas y crear proformas sin GPS.
                                </div>
                                <field name="census_gps_payload" readonly="census_locked and not census_can_edit_master" widget="gps_capture" nolabel="1"/>
                                <group invisible="not census_gps_captured_at">
                                    <group>
                                        <field name="census_gps_captured_at" readonly="1"/>
                                        <field name="census_gps_accuracy" readonly="1"/>
                                    </group>
                                    <group>
                                        <button name="action_open_census_location" type="object"
                                                string="Ver ubicación en mapa" icon="fa-external-link"
                                                class="btn-secondary"/>
                                    </group>
                                </group>
                            </div>

                            <div class="o_conedera_card">
                                <div class="o_conedera_card_title">
                                    <i class="fa fa-clock-o"/> Horario de atención
                                </div>
                                <div class="o_conedera_hint">
                                    Agregue una fila por franja de atención. Si un día no tiene filas, se considera cerrado. Puede agregar dos franjas el mismo día.
                                </div>
                                <field name="opening_hours_summary_html" nolabel="1" readonly="1" widget="html"/>
                                <div class="o_conedera_hint" invisible="census_locked and not census_can_edit_master">
                                    Edite las franjas aquí. Al guardar, el resumen superior permanecerá visible también en móvil.
                                </div>
                                <field name="opening_hour_ids"
                                       invisible="census_locked and not census_can_edit_master"
                                       nolabel="1" mode="list,form">
                                    <list editable="bottom" string="Horario de atención">
                                        <field name="day_of_week" string="Día"/>
                                        <field name="opening_time" string="Desde" widget="float_time"/>
                                        <field name="closing_time" string="Hasta" widget="float_time"/>
                                    </list>
                                    <form string="Franja de atención">
                                        <group>
                                            <field name="day_of_week"/>
                                            <field name="opening_time" widget="float_time"/>
                                            <field name="closing_time" widget="float_time"/>
                                        </group>
                                    </form>
                                </field>
                            </div>
                        </page>

                        <page string="Bitácora" name="census_activity">
                            <div class="o_conedera_card">
                                <div class="o_conedera_card_title">
                                    <i class="fa fa-history"/> Bitácora comercial
                                </div>
                                <div class="o_conedera_hint mb-3">
                                    Línea de tiempo única del cliente. Combina visitas y proformas en orden cronológico y usa tarjetas para que el historial sea visible también desde el celular.
                                </div>
                                <div class="o_conedera_actionbar mb-3">
                                    <button name="action_new_census_visit" type="object" string="Registrar nueva visita"
                                            class="btn-primary" icon="fa-map-marker"
                                            invisible="not id or not census_ready_for_activity"/>
                                    <button name="action_new_census_quotation" type="object" string="Crear proforma"
                                            class="btn-secondary" icon="fa-file-text-o"
                                            invisible="not id or not census_ready_for_activity"/>
                                    <button name="action_view_census_timeline" type="object" string="Ver bitácora completa"
                                            class="btn-outline-secondary" icon="fa-history" invisible="not id"/>
                                </div>
                                <group>
                                    <group>
                                        <field name="census_visit_count" readonly="1"/>
                                        <field name="census_last_visit_datetime" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="census_quotation_count" readonly="1"/>
                                        <field name="census_date" readonly="1"/>
                                    </group>
                                </group>
                            </div>

                            <div class="o_conedera_card o_conedera_timeline_card">
                                <div class="o_conedera_card_title">
                                    <i class="fa fa-clock-o"/> Últimos movimientos
                                </div>
                                <field name="census_timeline_ids" nolabel="1" mode="kanban,list">
                                    <kanban create="false" edit="false" delete="false" sample="0">
                                        <field name="event_type"/>
                                        <field name="event_datetime"/>
                                        <field name="title"/>
                                        <field name="event_state_label"/>
                                        <field name="user_id"/>
                                        <field name="purchase_made"/>
                                        <field name="location_status"/>
                                        <field name="amount_total"/>
                                        <field name="currency_id"/>
                                        <templates>
                                            <t t-name="card">
                                                <main>
                                                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                                        <div>
                                                            <div class="text-muted small" t-if="record.event_type.raw_value == 'visit'">
                                                                <i class="fa fa-map-marker me-1"/> VISITA
                                                            </div>
                                                            <div class="text-muted small" t-if="record.event_type.raw_value == 'quotation'">
                                                                <i class="fa fa-file-text-o me-1"/> PROFORMA
                                                            </div>
                                                            <strong><field name="title"/></strong>
                                                        </div>
                                                        <span class="badge text-bg-light"><field name="event_state_label"/></span>
                                                    </div>
                                                    <div class="small mb-1"><field name="event_datetime"/> · <field name="user_id"/></div>
                                                    <div t-if="record.event_type.raw_value == 'visit' and record.purchase_made.raw_value" class="small">Compra: <field name="purchase_made"/></div>
                                                    <div t-if="record.event_type.raw_value == 'quotation'" class="fw-semibold mt-1"><field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}"/></div>
                                                    <footer class="mt-2"><button name="action_open_source" type="object" string="Abrir" class="btn btn-outline-primary btn-sm"/></footer>
                                                </main>
                                            </t>
                                        </templates>
                                    </kanban>
                                    <list create="0" edit="0" delete="0" default_order="event_datetime desc, id desc">
                                        <field name="event_datetime" string="Fecha"/>
                                        <field name="event_type" string="Tipo"/>
                                        <field name="title"/>
                                        <field name="event_state_label" string="Estado"/>
                                        <field name="user_id"/>
                                        <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                        <button name="action_open_source" type="object" string="Abrir" icon="fa-external-link"/>
                                    </list>
                                </field>
                            </div>

                            <div class="o_conedera_card">
                                <div class="o_conedera_card_title">
                                    <i class="fa fa-cubes"/> Resumen de productos proformados
                                </div>
                                <div class="o_conedera_hint">
                                    Cantidades e importes de proformas no canceladas. El precio promedio es neto de descuento y ponderado por cantidad. Toque el producto para revisar cada fecha y precio, de la más reciente a la más antigua.
                                </div>
                                <div class="o_conedera_actionbar mb-2">
                                    <button name="action_view_census_product_summary" type="object" string="Ver todos los productos"
                                            class="btn-outline-secondary" icon="fa-bar-chart" invisible="not id"/>
                                </div>
                                <field name="census_product_summary_ids" nolabel="1" mode="kanban,list">
                                    <kanban create="false" edit="false" delete="false" sample="0">
                                        <field name="product_id"/>
                                        <field name="quoted_qty"/>
                                        <field name="uom_id"/>
                                        <field name="quotation_count"/>
                                        <field name="quoted_amount"/>
                                        <field name="avg_net_unit_price"/>
                                        <field name="last_quote_date"/>
                                        <field name="currency_id"/>
                                        <templates>
                                            <t t-name="card">
                                                <main>
                                                    <button name="action_open_quote_history" type="object" class="btn btn-link p-0 text-start fw-bold mb-2"><field name="product_id"/></button>
                                                    <div class="row g-2 small">
                                                        <div class="col-6"><span class="text-muted">Cantidad</span><div class="fw-semibold"><field name="quoted_qty"/> <field name="uom_id"/></div></div>
                                                        <div class="col-6"><span class="text-muted">Proformas</span><div class="fw-semibold"><field name="quotation_count"/></div></div>
                                                        <div class="col-6"><span class="text-muted">Precio promedio</span><div class="fw-semibold"><field name="avg_net_unit_price" widget="monetary" options="{'currency_field': 'currency_id'}"/></div></div>
                                                        <div class="col-6"><span class="text-muted">Total</span><div class="fw-semibold"><field name="quoted_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/></div></div>
                                                    </div>
                                                    <div class="text-muted small mt-2">Última: <field name="last_quote_date"/></div>
                                                </main>
                                            </t>
                                        </templates>
                                    </kanban>
                                    <list create="0" edit="0" delete="0" default_order="quoted_qty desc, quoted_amount desc, last_quote_date desc">
                                        <field name="product_id"/>
                                        <field name="quoted_qty"/>
                                        <field name="uom_id"/>
                                        <field name="quotation_count"/>
                                        <field name="avg_net_unit_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                        <field name="quoted_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                        <button name="action_open_quote_history" type="object" string="Historial" icon="fa-history"/>
                                    </list>
                                </field>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_partner_kanban_census" model="ir.ui.view">
        <field name="name">res.partner.kanban.conedera.census</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban sample="1" quick_create="false" create="false" delete="false">
                <header>
                    <button type="action" name="%(conedera_odoo_census.action_census_customer_lookup)d"
                            string="Nuevo catastro" icon="fa-plus" class="btn-primary" display="always"/>
                </header>
                <field name="commercial_name"/>
                <field name="name"/>
                <field name="vat"/>
                <field name="city"/>
                <field name="census_store_count"/>
                <field name="capa"/>
                <field name="business_type_ids"/>
                <field name="mobile_brand_ids"/>
                <field name="customer_segment"/>
                <field name="census_completion_state"/>
                <field name="census_last_visit_datetime"/>
                <field name="user_id"/>
                <field name="census_company_id"/>
                <field name="census_team_id"/>
                <templates>
                    <t t-name="card">
                        <main>
                            <div class="d-flex justify-content-between gap-2 mb-2">
                                <div>
                                    <field name="commercial_name" class="fw-bold fs-5"/>
                                    <div class="text-muted small"><field name="name"/></div>
                                </div>
                                <field name="census_completion_state" widget="badge"/>
                            </div>
                            <div class="mb-1" t-if="record.vat.raw_value">
                                <i class="fa fa-id-card-o fa-fw me-1 text-muted"/> RUC: <field name="vat"/>
                            </div>
                            <div class="mb-1" t-if="record.city.raw_value">
                                <i class="fa fa-map-marker fa-fw me-1 text-muted"/> <field name="city"/>
                            </div>
                            <div class="mb-1">
                                <i class="fa fa-building fa-fw me-1 text-muted"/> <field name="census_store_count"/> local(es)
                            </div>
                            <div class="mb-1" t-if="record.user_id.raw_value">
                                <i class="fa fa-user fa-fw me-1 text-muted"/> <field name="user_id"/>
                            </div>
                            <div class="mb-2" t-if="record.census_team_id.raw_value">
                                <i class="fa fa-users fa-fw me-1 text-muted"/> <field name="census_team_id"/>
                            </div>
                            <div class="mb-2" t-if="record.capa.raw_value">
                                <i class="fa fa-line-chart fa-fw me-1 text-muted"/> CAPA: <field name="capa"/>
                            </div>
                            <field name="business_type_ids" widget="many2many_tags"
                                   options="{'color_field': 'color'}"/>
                            <footer class="mt-2" t-if="record.census_last_visit_datetime.raw_value">
                                <span class="text-muted small">Última visita: </span>
                                <field name="census_last_visit_datetime"/>
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_partner_list_census" model="ir.ui.view">
        <field name="name">res.partner.list.conedera.census</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Clientes catastrados" default_order="write_date desc, id desc" create="false" delete="false">
                <header>
                    <button type="action" name="%(conedera_odoo_census.action_census_customer_lookup)d"
                            string="Nuevo catastro" icon="fa-plus" class="btn-primary" display="always"/>
                </header>
                <field name="commercial_name" string="Local"/>
                <field name="name" string="Razón social" optional="show"/>
                <field name="vat" string="RUC"/>
                <field name="city"/>
                <field name="census_store_count" string="Locales"/>
                <field name="capa" string="CAPA" optional="show"/>
                <field name="business_type_ids" widget="many2many_tags" optional="show"/>
                <field name="mobile_brand_ids" widget="many2many_tags" optional="hide"/>
                <field name="customer_segment" optional="hide"/>
                <field name="user_id" string="Vendedor" widget="many2one_avatar_user" optional="show"/>
                <field name="census_company_id" string="Empresa" optional="show" groups="base.group_multi_company"/>
                <field name="census_team_id" string="Equipo" optional="show"/>
                <field name="census_completion_state" widget="badge" string="Estado"/>
                <field name="census_last_visit_datetime" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_partner_search_census" model="ir.ui.view">
        <field name="name">res.partner.search.conedera.census</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Buscar clientes catastrados">
                <field name="commercial_name" string="Local"/>
                <field name="name" string="Razón social"/>
                <field name="vat" string="RUC"/>
                <field name="city"/>
                <field name="business_type_ids"/>
                <field name="mobile_brand_ids" string="Marcas"/>
                <field name="user_id" string="Vendedor"/>
                <field name="census_team_id" string="Equipo"/>
                <separator/>
                <filter name="pending_gps" string="Pendiente GPS" domain="[('census_gps_captured_at', '=', False)]"/>
                <filter name="with_gps" string="Con GPS" domain="[('census_gps_captured_at', '!=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_city" string="Ciudad" context="{'group_by': 'city'}"/>
                    <filter name="group_user" string="Vendedor" context="{'group_by': 'user_id'}"/>
                    <filter name="group_team" string="Equipo" context="{'group_by': 'census_team_id'}"/>
                    <filter name="group_segment" string="Canal comercial" context="{'group_by': 'customer_segment'}"/>
                </group>
                <searchpanel>
                    <field name="business_type_ids" string="Tipo de negocio" select="multi"/>
                    <field name="mobile_brand_ids" string="Marca celular" select="multi"/>
                    <field name="customer_segment" string="Canal comercial" select="multi"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_census_partners" model="ir.actions.act_window">
        <field name="name">Catastro de clientes</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" eval="False"/>
        <field name="search_view_id" ref="view_partner_search_census"/>
        <field name="domain">[('census_active', '=', True)]</field>
        <field name="context">{'default_census_active': True, 'default_company_type': 'company', 'default_user_id': uid, 'form_view_ref': 'conedera_odoo_census.view_partner_form_census_mobile', 'conedera_census_isolated_form': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay catastros todavía.</p>
            <p>Pulse <strong>Nuevo catastro</strong> para validar primero por RUC/cédula o nombre y evitar duplicados.</p>
        </field>
    </record>

    <record id="action_census_partners_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_partner_kanban_census"/>
        <field name="act_window_id" ref="action_census_partners"/>
    </record>
    <record id="action_census_partners_view_list" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_partner_list_census"/>
        <field name="act_window_id" ref="action_census_partners"/>
    </record>
    <record id="action_census_partners_view_form" model="ir.actions.act_window.view">
        <field name="sequence">3</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_partner_form_census_mobile"/>
        <field name="act_window_id" ref="action_census_partners"/>
    </record>

    <!-- Configuración de tipos de negocio: editable solo por gerentes de ventas. -->
    <record id="view_census_business_type_list" model="ir.ui.view">
        <field name="name">conedera.census.business.type.list</field>
        <field name="model">conedera.census.business.type</field>
        <field name="arch" type="xml">
            <list editable="bottom" string="Tipos de negocio">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_census_business_type_form" model="ir.ui.view">
        <field name="name">conedera.census.business.type.form</field>
        <field name="model">conedera.census.business.type</field>
        <field name="arch" type="xml">
            <form string="Tipo de negocio">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="color" widget="color_picker"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_census_business_types" model="ir.actions.act_window">
        <field name="name">Tipos de negocio</field>
        <field name="res_model">conedera.census.business.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
