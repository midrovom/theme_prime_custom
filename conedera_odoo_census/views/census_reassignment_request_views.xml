<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_census_reassignment_request_list" model="ir.ui.view">
        <field name="name">conedera.census.reassignment.request.list</field>
        <field name="model">conedera.census.reassignment.request</field>
        <field name="arch" type="xml">
            <list string="Solicitudes de reasignación" create="0" delete="0" default_order="request_date desc, id desc"
                  decoration-info="state == 'pending'" decoration-success="state == 'approved'" decoration-muted="state in ('rejected','cancelled')">
                <field name="request_date"/>
                <field name="partner_name_snapshot" string="Cliente"/>
                <field name="partner_vat_snapshot" string="RUC / Cédula"/>
                <field name="requested_by_id" widget="many2one_avatar_user"/>
                <field name="request_type"/>
                <field name="state" widget="badge"/>
                <field name="reviewed_by_id" optional="hide"/>
                <field name="reviewed_at" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_census_reassignment_request_form" model="ir.ui.view">
        <field name="name">conedera.census.reassignment.request.form</field>
        <field name="model">conedera.census.reassignment.request</field>
        <field name="arch" type="xml">
            <form string="Solicitud de reasignación" create="0" delete="0">
                <header>
                    <button name="action_approve" type="object" string="Aprobar reasignación" class="btn-primary"
                            invisible="state != 'pending' or not can_review"/>
                    <button name="action_reject" type="object" string="Rechazar" class="btn-secondary"
                            invisible="state != 'pending' or not can_review"/>
                    <button name="action_cancel" type="object" string="Cancelar solicitud" class="btn-secondary"
                            invisible="state != 'pending' or not can_cancel"/>
                    <button name="action_open_customer" type="object" string="Abrir Catastro" class="btn-secondary"
                            invisible="state != 'approved' and not can_review"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved,rejected,cancelled"/>
                </header>
                <sheet>
                    <field name="can_review" invisible="1"/>
                    <field name="can_cancel" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="partner_name_snapshot" readonly="1"/></h1>
                        <h3><field name="partner_vat_snapshot" readonly="1"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="requested_by_id" widget="many2one_avatar_user" readonly="1"/>
                            <field name="request_date" readonly="1"/>
                            <field name="request_type" readonly="1"/>
                            <field name="target_team_id" readonly="1"/>
                        </group>
                        <group invisible="not can_review">
                            <field name="source_user_id" widget="many2one_avatar_user" readonly="1"/>
                            <field name="source_team_id" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="reviewed_by_id" readonly="1"/>
                            <field name="reviewed_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Motivo">
                        <field name="reason" readonly="1" nolabel="1"/>
                    </group>
                    <group string="Resultado" invisible="not review_note">
                        <field name="review_note" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_census_reassignment_request_kanban" model="ir.ui.view">
        <field name="name">conedera.census.reassignment.request.kanban</field>
        <field name="model">conedera.census.reassignment.request</field>
        <field name="arch" type="xml">
            <kanban create="0" class="o_kanban_mobile">
                <field name="partner_name_snapshot"/>
                <field name="partner_vat_snapshot"/>
                <field name="requested_by_id"/>
                <field name="request_date"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="p-2">
                            <div class="fw-bold fs-5"><field name="partner_name_snapshot"/></div>
                            <div class="text-muted"><field name="partner_vat_snapshot"/></div>
                            <div class="mt-2"><i class="fa fa-user me-1"/><field name="requested_by_id"/></div>
                            <div class="small text-muted"><field name="request_date"/></div>
                            <div class="mt-2"><field name="state" widget="badge"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_census_reassignment_requests" model="ir.actions.act_window">
        <field name="name">Solicitudes de reasignación</field>
        <field name="res_model">conedera.census.reassignment.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" eval="False"/>
        <field name="context">{}</field>
    </record>
</odoo>
