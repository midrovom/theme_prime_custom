<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_census_customer_lookup_wizard_form" model="ir.ui.view">
        <field name="name">conedera.census.customer.lookup.wizard.form</field>
        <field name="model">conedera.census.customer.lookup.wizard</field>
        <field name="arch" type="xml">
            <form string="Nuevo catastro" class="o_conedera_lookup_wizard">
                <sheet>
                    <div class="o_conedera_hero mb-3">
                        <div class="text-muted small text-uppercase fw-semibold mb-1">
                            <i class="fa fa-search me-1"/> Paso 1 · Identificar al cliente
                        </div>
                        <h2 class="mb-1">Busque antes de crear</h2>
                        <div class="text-muted">
                            Ingrese el RUC (recomendado) o el nombre. Si el cliente ya existe en Odoo, se reutilizará su ficha y no se creará un duplicado.
                        </div>
                    </div>

                    <group>
                        <field name="vat" string="RUC" placeholder="Ej. 0991234567001"/>
                        <field name="customer_name" string="Nombre / razón social" placeholder="Ej. Comercial XYZ S.A."/>
                        <field name="validation_state" invisible="1"/>
                        <field name="existing_partner_id" invisible="validation_state != 'found'" readonly="1"/>
                    </group>

                    <div class="alert alert-success" role="alert" invisible="validation_state != 'found'">
                        <i class="fa fa-check-circle me-1"/>
                        <field name="validation_message" nolabel="1" readonly="1"/>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="validation_state != 'not_found'">
                        <i class="fa fa-plus-circle me-1"/>
                        <field name="validation_message" nolabel="1" readonly="1"/>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="validation_state != 'multiple'">
                        <i class="fa fa-exclamation-triangle me-1"/>
                        <field name="validation_message" nolabel="1" readonly="1"/>
                    </div>
                </sheet>
                <footer>
                    <button name="action_validate" type="object" string="Validar" class="btn-primary"
                            invisible="validation_state in ('found', 'not_found')"/>
                    <button name="action_open_existing" type="object" string="Abrir ficha existente" class="btn-primary"
                            invisible="validation_state != 'found'"/>
                    <button name="action_create_new" type="object" string="Crear nuevo catastro" class="btn-primary"
                            invisible="validation_state != 'not_found'"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_census_customer_lookup" model="ir.actions.act_window">
        <field name="name">Nuevo catastro</field>
        <field name="res_model">conedera.census.customer.lookup.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_census_customer_lookup_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
