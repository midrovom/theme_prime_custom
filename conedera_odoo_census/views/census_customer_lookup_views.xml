<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_census_customer_lookup_wizard_form" model="ir.ui.view">
        <field name="name">conedera.census.customer.lookup.wizard.form</field>
        <field name="model">conedera.census.customer.lookup.wizard</field>
        <field name="arch" type="xml">
            <form string="Nuevo catastro" class="o_conedera_lookup_wizard">
                <sheet>
                    <div class="o_conedera_hero mb-3">
                        <div class="text-muted small text-uppercase fw-semibold mb-1">
                            <i class="fa fa-search me-1"/> Paso 1 · Buscar antes de crear
                        </div>
                        <h2 class="mb-1">Encuentre primero al cliente</h2>
                        <div class="text-muted">
                            Escriba RUC, cédula o nombre. La búsqueda revisa globalmente los clientes para impedir un segundo Catastro aunque la ficha pertenezca a otro comercial.
                        </div>
                    </div>

                    <div class="o_conedera_card mb-3">
                        <div class="o_conedera_card_title"><i class="fa fa-id-card-o"/> RUC, cédula o nombre</div>
                        <field name="lookup_query" widget="census_customer_lookup" nolabel="1"/>
                        <div class="text-muted small mt-2">
                            Seleccione una coincidencia del desplegable. Si el Catastro pertenece a otro vendedor, verá la opción de solicitar reasignación sin duplicar la ficha.
                        </div>
                    </div>

                    <!-- Loaded for the custom lookup widget / server actions -->
                    <field name="selected_partner_ref_id" invisible="1"/>
                    <field name="selected_candidate_status" invisible="1"/>
                    <field name="selected_can_open" invisible="1"/>
                    <field name="selected_can_use" invisible="1"/>
                    <field name="selected_can_request_reassignment" invisible="1"/>
                    <field name="selected_is_census" invisible="1"/>
                    <field name="existing_partner_id" invisible="1"/>
                    <field name="existing_census_active" invisible="1"/>
                    <field name="validation_state" invisible="1"/>

                    <div class="alert alert-success" role="alert"
                         invisible="validation_state not in ('found','request_sent')">
                        <i class="fa fa-check-circle me-1"/>
                        <field name="validation_message" nolabel="1" readonly="1"/>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="validation_state not in ('multiple','restricted')">
                        <i class="fa fa-exclamation-triangle me-1"/>
                        <field name="validation_message" nolabel="1" readonly="1"/>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="validation_state != 'not_found'">
                        <i class="fa fa-plus-circle me-1"/>
                        <field name="validation_message" nolabel="1" readonly="1"/>
                    </div>

                    <div class="o_conedera_card mb-3" invisible="not selected_partner_ref_id">
                        <div class="o_conedera_card_title">
                            <i class="fa fa-address-card-o"/> Cliente seleccionado
                        </div>
                        <group>
                            <group>
                                <field name="existing_name" readonly="1"/>
                                <field name="existing_vat" readonly="1"/>
                                <field name="existing_commercial_name" readonly="1"/>
                                <field name="existing_owner_label" readonly="1"/>
                                <field name="existing_team_label" readonly="1"/>
                                <field name="existing_user_id" widget="many2one_avatar_user" readonly="1"
                                       invisible="not existing_user_id"/>
                            </group>
                            <group invisible="selected_can_request_reassignment">
                                <field name="existing_phone" readonly="1"/>
                                <field name="existing_mobile" readonly="1"/>
                                <field name="existing_email" readonly="1"/>
                                <field name="existing_street" readonly="1"/>
                                <field name="existing_city" readonly="1"/>
                            </group>
                        </group>

                        <div class="alert alert-warning mt-2" role="alert"
                             invisible="not selected_can_request_reassignment">
                            <strong>No se creará otro Catastro.</strong>
                            Este cliente ya está bajo responsabilidad de otro comercial/equipo. Solicite la reasignación para conservar visitas, proformas, fotos y toda la bitácora en la misma ficha.
                        </div>
                        <div class="mt-3" invisible="not selected_can_request_reassignment">
                            <field name="reassignment_reason" placeholder="Ej. Cliente cambió de zona comercial o ahora será atendido por mi ruta..."/>
                        </div>
                    </div>

                    <div class="o_conedera_card mb-3" invisible="validation_state != 'not_found'">
                        <div class="o_conedera_card_title"><i class="fa fa-plus-circle"/> Cliente realmente nuevo</div>
                        <div class="o_conedera_hint mb-2">
                            Complete los datos mínimos. Antes de crear, el servidor vuelve a validar globalmente el RUC/cédula y el nombre.
                        </div>
                        <group>
                            <field name="vat" string="RUC / Cédula" placeholder="Ej. 0991234567001 o 0912345678"/>
                            <field name="customer_name" string="Nombre / razón social" placeholder="Razón social o nombre del cliente"/>
                        </group>
                    </div>
                </sheet>
                <footer>
                    <button name="action_use_selected" type="object" string="Abrir Catastro"
                            class="btn-primary" invisible="not selected_can_open"/>
                    <button name="action_use_selected" type="object" string="Usar este cliente y completar Catastro"
                            class="btn-primary" invisible="not selected_can_use"/>
                    <button name="action_request_reassignment" type="object" string="Solicitar reasignación"
                            class="btn-warning" invisible="not selected_can_request_reassignment or validation_state == 'request_sent'"/>
                    <button name="action_validate" type="object" string="Buscar / validar"
                            class="btn-primary" invisible="selected_partner_ref_id or validation_state == 'not_found' or validation_state == 'request_sent'"/>
                    <button name="action_create_new" type="object" string="Crear nuevo Catastro"
                            class="btn-primary" invisible="validation_state != 'not_found'"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_census_customer_lookup" model="ir.actions.act_window">
        <field name="name">Nuevo catastro</field>
        <field name="res_model">conedera.census.customer.lookup.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_census_customer_lookup_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
