<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_census_role_wizard_form" model="ir.ui.view">
        <field name="name">conedera.census.role.wizard.form</field>
        <field name="model">conedera.census.role.wizard</field>
        <field name="arch" type="xml">
            <form string="Usuarios y permisos" create="false" edit="true" delete="false">
                <div class="oe_title">
                    <h2>Permisos del Catastro</h2>
                    <p class="text-muted">Asigne únicamente el rol del Catastro. Los demás permisos de Odoo no se modifican.</p>
                </div>
                <group>
                    <field name="user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="current_role" readonly="1"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                        <field name="team_id" widget="selection" domain="[('census_enabled', '=', True), ('active', '=', True), ('company_id', '=', company_id)]" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"
                           invisible="role not in ('user', 'supervisor')"
                           required="role in ('user', 'supervisor')"/>
                    <field name="role" widget="radio"/>
                </group>
                <field name="help_text" widget="html" readonly="1" nolabel="1"/>
                <footer>
                    <button name="action_apply" type="object" string="Guardar permisos" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_census_role_wizard" model="ir.actions.act_window">
        <field name="name">Usuarios y permisos</field>
        <field name="res_model">conedera.census.role.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_census_role_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
