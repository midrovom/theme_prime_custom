<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="offer_cart" name="Carrito de oferta">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container py-5 o_wpo_cart">
                    <div class="row">
                        <div class="col-lg-8">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div>
                                    <span class="o_wpo_eyebrow">NEGOCIACIÓN DIRECTA</span>
                                    <h1 class="mt-2">Mi oferta</h1>
                                    <p class="text-muted">Revisa los productos antes de enviar tu propuesta.</p>
                                </div>
                                <a href="/shop" class="btn btn-outline-primary">
                                    <i class="fa fa-plus me-2"/>
                                    Agregar productos
                                </a>
                            </div>

                            <div class="card border-0 shadow-sm">
                                <div class="card-body p-0">
                                    <t t-if="not offer_cart">
                                        <div class="text-center py-5">
                                            <i class="fa fa-shopping-basket fa-3x text-muted mb-3"/>
                                            <h4>Tu oferta está vacía</h4>
                                            <p class="text-muted">Agrega productos para comenzar tu negociación.</p>
                                            <a href="/shop" class="btn btn-primary">Buscar productos</a>
                                        </div>
                                    </t>

                                    <t t-else="">
                                        <div class="table-responsive">
                                            <table class="table align-middle mb-0">
                                                <thead>
                                                    <tr>
                                                        <th>Producto</th>
                                                        <th class="text-center">Cantidad</th>
                                                        <th class="text-end">Tu precio por unidad</th>
                                                        <th class="text-end">Total propuesto</th>
                                                        <th/>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="offer_cart" t-as="line">
                                                        <tr>
                                                            <td>
                                                                <strong><t t-out="line['product_name']"/></strong>
                                                                <div class="small text-muted">
                                                                    Precio lista: <t t-out="line['list_price']"/>
                                                                </div>
                                                            </td>
                                                            <td class="text-center">
                                                                <t t-out="line['quantity']"/>
                                                            </td>
                                                            <td class="text-end">
                                                                <t t-out="line['offered_price']"/>
                                                            </td>
                                                            <td class="text-end">
                                                                <strong><t t-out="line['total']"/></strong>
                                                            </td>
                                                            <td class="text-end">
                                                                <button type="button" class="btn btn-sm btn-outline-danger o_wpo_remove_line" t-att-data-product-id="line['product_id']">
                                                                    <i class="fa fa-trash"/>
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </div>

                                        <div class="border-top p-4">
                                            <div class="row">
                                                <div class="col-md-8"/>
                                                <div class="col-md-4">
                                                    <div class="d-flex justify-content-between">
                                                        <span>Total general</span>
                                                        <strong><t t-out="offer_cart_summary['total']"/></strong>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="card border-0 shadow-sm">
                                <div class="card-body">
                                    <h4>Datos de contacto</h4>
                                    <form class="o_wpo_submit_form" method="post" action="/shop/offer/submit">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <div class="mb-3">
                                            <label class="form-label">Nombre</label>
                                            <input type="text" name="contact_name" class="form-control" required="required" maxlength="120" t-att-value="contact_name"/>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Empresa (opcional)</label>
                                            <input type="text" name="company_name" class="form-control" maxlength="160" t-att-value="company_name"/>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Correo</label>
                                            <input type="email" name="contact_email" class="form-control" maxlength="160" t-att-value="contact_email"/>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Teléfono</label>
                                            <input type="tel" name="contact_phone" class="form-control" maxlength="60" t-att-value="contact_phone"/>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Mensaje (opcional)</label>
                                            <textarea name="customer_message" class="form-control" rows="4" maxlength="2000"><t t-out="customer_message"/></textarea>
                                        </div>
                                        <button type="submit" class="btn btn-primary btn-lg w-100 o_wpo_submit">
                                            <span class="o_wpo_submit_label">
                                                Enviar mi oferta <i class="fa fa-arrow-right ms-2"/>
                                            </span>
                                            <span class="o_wpo_submit_loading d-none">
                                                <span class="spinner-border spinner-border-sm me-2"/>
                                                Validando…
                                            </span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>


