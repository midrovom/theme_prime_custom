<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- LIST VIEW -->
    <record id="view_website_sale_offer_list" model="ir.ui.view">
        <field name="name">website.sale.offer.list</field>
        <field name="model">website.sale.offer</field>
        <field name="arch" type="xml">
            <list string="Ofertas web"
                  decoration-info="state == 'review'"
                  decoration-warning="state == 'counter'"
                  decoration-success="state == 'converted'"
                  decoration-muted="state in ('rejected', 'cancelled')"
                  sample="1">
                <field name="name"/>
                <field name="create_date"/>
                <field name="contact_name"/>
                <field name="company_name" optional="hide"/>
                <field name="offer_total" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="website_id" optional="show"/>
                <field name="user_id" optional="show" widget="many2one_avatar_user"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'review'"
                       decoration-warning="state == 'counter'"
                       decoration-success="state == 'converted'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_website_sale_offer_form" model="ir.ui.view">
        <field name="name">website.sale.offer.form</field>
        <field name="model">website.sale.offer</field>
        <field name="arch" type="xml">
            <form string="Oferta web">
                <header>
                    <button name="action_set_review" type="object" string="Iniciar revisión"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_accept_offer" type="object" string="Aceptar y crear presupuesto"
                            class="btn-primary" invisible="state not in ('draft', 'review')"/>
                    <button name="action_send_counter" type="object" string="Enviar contraoferta"
                            class="btn-secondary" invisible="state not in ('draft', 'review', 'counter')"/>
                    <button name="action_reject" type="object" string="Rechazar"
                            invisible="state not in ('draft', 'review', 'counter')"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            invisible="state not in ('draft', 'review', 'counter')"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,review,counter,converted,rejected,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_quotation" type="object" class="oe_stat_button"
                                icon="fa-file-text-o" invisible="not sale_order_id">
                            <field name="sale_order_id" widget="statinfo" string="Presupuesto"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Presupuesto creado" bg_color="bg-success"
                            invisible="state != 'converted'"/>
                    <widget name="web_ribbon" title="Rechazada" bg_color="bg-danger"
                            invisible="state != 'rejected'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Cliente">
                            <field name="partner_id" context="{'default_customer_rank': 1}"/>
                            <field name="contact_name"/>
                            <field name="company_name"/>
                            <field name="contact_email" widget="email"/>
                            <field name="contact_phone" widget="phone"/>
                        </group>
                        <group string="Origen">
                            <field name="website_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="create_date"/>
                            <field name="valid_until"/>
                            <field name="source_url" widget="url"/>
                            <field name="pricelist_id"/>
                        </group>
                    </group>
                    <group string="Propuesta comercial">
                        <field name="line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="product_id"/>
                                <field name="quantity"/>
                                <field name="uom_id"/>
                                <field name="available_qty_snapshot"/>
                                <field name="list_price"/>
                                <field name="offered_price"/>
                                <field name="offer_total"/>
                                <field name="counter_price" readonly="state in ('converted','rejected','cancelled')"/>
                                <field name="counter_total" invisible="not counter_price"/>
                            </list>
                        </field>
                    </group>
                    <group string="Totales">
                        <field name="offer_total" readonly="1"/>
                        <field name="counter_total" readonly="1"/>
                        <!-- <field name="counter_total" invisible="not counter_price"/> -->
                        <field name="requested_discount_percent" readonly="1"/>
                        <field name="converted_price" invisible="state != 'converted'"/>
                    </group>
                    <notebook>
                        <page string="Mensaje del cliente" name="customer_message">
                            <field name="customer_message" placeholder="El cliente no agregó comentarios."/>
                        </page>
                        <page string="Contraoferta" name="counteroffer">
                            <field name="counter_message"
                                placeholder="Explica brevemente las condiciones de la contraoferta..."
                                readonly="state in ('converted', 'rejected', 'cancelled')"/>
                        </page>
                        <page string="Notas internas" name="internal_notes">
                            <field name="internal_note" placeholder="Información visible solo para el equipo comercial."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_website_sale_offer_search" model="ir.ui.view">
        <field name="name">website.sale.offer.search</field>
        <field name="model">website.sale.offer</field>
        <field name="arch" type="xml">
            <search string="Buscar ofertas">
                <field name="name"/>
                <field name="contact_name"/>
                <field name="partner_id"/>
                <field name="website_id"/>
                <field name="user_id"/>
                <filter name="to_review" string="Por revisar" domain="[('state', 'in', ('draft', 'review'))]"/>
                <filter name="counter" string="Contraofertas" domain="[('state', '=', 'counter')]"/>
                <filter name="converted" string="Convertidas" domain="[('state', '=', 'converted')]"/>
                <separator/>
                <filter name="my_offers" string="Mis ofertas" domain="[('user_id', '=', uid)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_website" string="Sitio web" context="{'group_by': 'website_id'}"/>
                    <filter name="group_user" string="Vendedor" context="{'group_by': 'user_id'}"/>
                    <filter name="group_month" string="Mes" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_website_sale_offer" model="ir.actions.act_window">
        <field name="name">Ofertas web</field>
        <field name="res_model">website.sale.offer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_website_sale_offer_search"/>
        <field name="context">{'search_default_to_review': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Las ofertas de tus clientes aparecerán aquí</p>
            <p>Revísalas, envía una contraoferta o conviértelas en un presupuesto nativo de Odoo.</p>
        </field>
    </record>

    <!-- MENUS -->
    <menuitem id="menu_website_sale_offer_root"
              name="Ofertas Web"
              sequence="45"
              action="action_website_sale_offer"
              web_icon="website_product_offer,static/description/icon.svg"
              groups="sales_team.group_sale_salesman"/>
    <menuitem id="menu_website_sale_offer"
              name="Ofertas"
              parent="menu_website_sale_offer_root"
              action="action_website_sale_offer"
              sequence="10"
              groups="sales_team.group_sale_salesman"/>
    <menuitem id="menu_website_product_offer_rule"
              name="Productos habilitados"
              parent="menu_website_sale_offer_root"
              action="action_website_product_offer_rule"
              sequence="20"
              groups="sales_team.group_sale_manager"/>
</odoo>
