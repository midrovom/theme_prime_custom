<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_website_offer" model="ir.ui.view">
        <field name="name">sale.order.form.website.offer</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_website_offer" type="object" class="oe_stat_button"
                        icon="fa-handshake-o" invisible="not website_offer_id">
                    <field name="website_offer_id" widget="statinfo" string="Oferta web"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>

