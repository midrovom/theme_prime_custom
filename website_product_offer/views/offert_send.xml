<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="offer_success_page" name="Oferta enviada - Página">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container py-5">
                    <div class="o_wpo_success text-center py-5" aria-live="polite">
                        <div class="o_wpo_success_icon mb-3">
                            <i class="fa fa-check fa-3x text-success" aria-hidden="true"/>
                        </div>
                        <h3 class="mt-2">¡Oferta enviada!</h3>
                        <p class="text-muted"><t t-out="message"/></p>
                        <div class="o_wpo_reference_box mt-2">
                            Referencia: <strong><t t-out="reference"/></strong>
                        </div>
                        <a t-att-href="portal_url" class="btn btn-primary mt-3">Consultar estado</a>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
