    <template id="website_sale_product_offer_button" inherit_id="website_sale.product" name="Botón de oferta comercial multiproducto">
        <xpath expr="//div[@id='add_to_cart_wrap']" position="after">
            <t t-if="product._website_offer_is_enabled(website)">
                <div class="o_wpo_offer_entry mt-3">
                    <a t-if="website.offer_require_login and request.env.user._is_public()"
                       t-att-href="'/web/login?redirect=%s' % product.website_url"
                       class="btn o_wpo_offer_trigger w-100"
                       role="button">

                        <i class="fa fa-handshake-o me-2"
                           aria-hidden="true"/>

                        Inicia sesión para ofertar

                    </a>

                    <button t-else=""
                            type="button"
                            class="btn o_wpo_offer_trigger w-100"
                            data-bs-toggle="modal"
                            data-bs-target="#wpoOfferModal">

                        <span class="o_wpo_trigger_glow"
                              aria-hidden="true"/>

                        <i class="fa fa-handshake-o me-2"
                           aria-hidden="true"/>

                        Haz una oferta

                    </button>

                    <small class="d-block text-center text-muted mt-2">
                        Negocia varios productos en una misma oferta
                    </small>

                </div>

            </t>

        </xpath>

        <xpath expr="//form[@action='/shop/cart/update']"
               position="after">

            <t t-if="
                product._website_offer_is_enabled(website)
                and not (
                    website.offer_require_login
                    and request.env.user._is_public()
                )
            ">

                <div class="modal fade o_wpo_offer_modal"
                     id="wpoOfferModal"
                     tabindex="-1"
                     aria-labelledby="wpoOfferModalLabel"
                     aria-hidden="true">

                    <div class="modal-dialog modal-dialog-centered modal-xl modal-fullscreen-sm-down">

                        <div class="modal-content o_wpo_modal_content">

                            <div class="o_wpo_modal_orb o_wpo_modal_orb_one"
                                 aria-hidden="true"/>

                            <div class="o_wpo_modal_orb o_wpo_modal_orb_two"
                                 aria-hidden="true"/>

                            <div class="modal-header border-0 position-relative">

                                <div>

                                    <span class="o_wpo_eyebrow">
                                        NEGOCIACIÓN DIRECTA
                                    </span>

                                    <h2 class="modal-title h3 mt-1"
                                        id="wpoOfferModalLabel">

                                        Construye tu oferta

                                    </h2>

                                    <p class="text-muted mb-0">

                                        Agrega los productos que necesitas,
                                        define cantidades y propón tu precio.

                                    </p>

                                </div>

                                <button type="button"
                                        class="btn-close"
                                        data-bs-dismiss="modal"
                                        aria-label="Cerrar"/>

                            </div>

                            <div class="modal-body position-relative pt-0">

                                <!-- ERROR -->

                                <div class="alert alert-danger d-none o_wpo_error"
                                     role="alert"/>


                                <form class="o_wpo_offer_form"
                                      novalidate="novalidate">

                                    <input type="hidden"
                                           name="source_url"
                                           t-att-value="product.website_url"/>

                                    <div class="o_wpo_honeypot"
                                         aria-hidden="true">

                                        <label>
                                            No completar

                                            <input type="text"
                                                   name="website_bait"
                                                   tabindex="-1"
                                                   autocomplete="off"/>

                                        </label>

                                    </div>


                                    <!-- ================================= -->
                                    <!-- CONTENIDO -->
                                    <!-- ================================= -->

                                    <div class="o_wpo_form_body">


                                        <!-- ================================= -->
                                        <!-- PRODUCTOS -->
                                        <!-- ================================= -->

                                        <div class="d-flex justify-content-between align-items-center mb-3">

                                            <div>

                                                <h5 class="mb-1">
                                                    Productos de tu oferta
                                                </h5>

                                                <small class="text-muted">
                                                    Puedes negociar varios productos
                                                    en una sola solicitud.
                                                </small>

                                            </div>


                                            <button type="button"
                                                    class="btn btn-outline-primary o_wpo_add_product">

                                                <i class="fa fa-plus me-1"
                                                   aria-hidden="true"/>

                                                Agregar producto

                                            </button>

                                        </div>


                                        <!-- ================================= -->
                                        <!-- CONTENEDOR DE LÍNEAS -->
                                        <!-- ================================= -->

                                        <div class="o_wpo_offer_lines">

                                            <!--
                                                El JS insertará aquí
                                                las líneas dinámicamente.
                                            -->

                                        </div>


                                        <!-- ================================= -->
                                        <!-- TEMPLATE DE UNA LÍNEA -->
                                        <!-- ================================= -->

                                        <template id="o_wpo_offer_line_template">

                                            <div class="o_wpo_offer_line card border-0 shadow-sm mb-3"
                                                 data-line-index="">

                                                <div class="card-body">

                                                    <div class="row g-3 align-items-end">


                                                        <!-- PRODUCTO -->

                                                        <div class="col-12 col-lg-5">

                                                            <label class="form-label">
                                                                Producto
                                                            </label>

                                                            <div class="o_wpo_line_product">

                                                                <div class="d-flex align-items-center">

                                                                    <div class="o_wpo_product_icon me-2">

                                                                        <i class="fa fa-cube"
                                                                           aria-hidden="true"/>

                                                                    </div>

                                                                    <div class="flex-grow-1 min-w-0">

                                                                        <strong class="d-block text-truncate o_wpo_line_product_name">
                                                                            —
                                                                        </strong>

                                                                        <small class="text-muted o_wpo_line_product_stock">
                                                                            Validando existencias…
                                                                        </small>

                                                                    </div>

                                                                </div>

                                                            </div>

                                                            <input type="hidden"
                                                                   class="o_wpo_line_product_id"/>

                                                        </div>


                                                        <!-- CANTIDAD -->

                                                        <div class="col-12 col-md-4 col-lg-2">

                                                            <label class="form-label">
                                                                Cantidad
                                                            </label>

                                                            <div class="input-group">

                                                                <span class="input-group-text">
                                                                    <i class="fa fa-cubes"
                                                                       aria-hidden="true"/>
                                                                </span>

                                                                <input type="number"
                                                                       class="form-control o_wpo_line_quantity"
                                                                       min="1"
                                                                       step="1"
                                                                       required="required"
                                                                       inputmode="decimal"
                                                                       value="1"/>

                                                            </div>

                                                        </div>


                                                        <!-- PRECIO -->

                                                        <div class="col-12 col-md-4 col-lg-2">

                                                            <label class="form-label">
                                                                Precio unitario
                                                            </label>

                                                            <div class="input-group">

                                                                <span class="input-group-text o_wpo_line_currency">
                                                                    $
                                                                </span>

                                                                <input type="number"
                                                                       class="form-control o_wpo_line_price"
                                                                       min="0.01"
                                                                       step="0.01"
                                                                       required="required"
                                                                       inputmode="decimal"
                                                                       placeholder="0.00"/>

                                                            </div>

                                                        </div>


                                                        <!-- TOTAL -->

                                                        <div class="col-12 col-md-4 col-lg-2">

                                                            <label class="form-label">
                                                                Total
                                                            </label>

                                                            <div class="o_wpo_line_total fw-bold fs-5">
                                                                —
                                                            </div>

                                                        </div>


                                                        <!-- ELIMINAR -->

                                                        <div class="col-12 col-lg-1 text-end">

                                                            <button type="button"
                                                                    class="btn btn-outline-danger o_wpo_remove_line"
                                                                    title="Eliminar producto">

                                                                <i class="fa fa-trash"
                                                                   aria-hidden="true"/>

                                                            </button>

                                                        </div>

                                                    </div>


                                                    <!-- ================================= -->
                                                    <!-- INFO DE PRECIO -->
                                                    <!-- ================================= -->

                                                    <div class="row mt-2">

                                                        <div class="col-12">

                                                            <small class="text-muted o_wpo_line_price_help">
                                                                Precio de lista:
                                                                <span class="o_wpo_line_list_price">
                                                                    —
                                                                </span>
                                                            </small>

                                                        </div>

                                                    </div>

                                                </div>

                                            </div>

                                        </template>


                                        <!-- ================================= -->
                                        <!-- BUSCADOR DE PRODUCTOS -->
                                        <!-- ================================= -->

                                        <div class="o_wpo_product_picker d-none mt-3">

                                            <div class="card border-primary">

                                                <div class="card-body">

                                                    <div class="d-flex justify-content-between align-items-center mb-3">

                                                        <div>

                                                            <strong>
                                                                Agregar producto
                                                            </strong>

                                                            <div class="small text-muted">
                                                                Busca el producto que deseas incluir.
                                                            </div>

                                                        </div>

                                                        <button type="button"
                                                                class="btn-close o_wpo_close_picker"
                                                                aria-label="Cerrar"/>

                                                    </div>


                                                    <div class="input-group">

                                                        <span class="input-group-text">

                                                            <i class="fa fa-search"
                                                               aria-hidden="true"/>

                                                        </span>

                                                        <input type="search"
                                                               class="form-control o_wpo_product_search"
                                                               placeholder="Buscar producto..."
                                                               autocomplete="off"/>

                                                    </div>


                                                    <div class="o_wpo_product_search_results mt-2">

                                                        <!-- Resultados generados por JS -->

                                                    </div>

                                                </div>

                                            </div>

                                        </div>


                                        <!-- ================================= -->
                                        <!-- TOTAL GENERAL -->
                                        <!-- ================================= -->

                                        <div class="o_wpo_total_panel my-4">

                                            <div>

                                                <span class="small text-muted">
                                                    Total propuesto
                                                </span>

                                                <div class="small o_wpo_total_hint">
                                                    Suma de todos los productos
                                                </div>

                                            </div>

                                            <strong class="o_wpo_offer_total">
                                                —
                                            </strong>

                                        </div>


                                        <!-- ================================= -->
                                        <!-- DATOS DEL CLIENTE -->
                                        <!-- ================================= -->

                                        <div class="row g-3">


                                            <!-- NOMBRE -->

                                            <div class="col-12 col-md-6">

                                                <label for="wpo_contact_name"
                                                       class="form-label">

                                                    Nombre de contacto

                                                </label>

                                                <input id="wpo_contact_name"
                                                       name="contact_name"
                                                       type="text"
                                                       class="form-control"
                                                       required="required"
                                                       maxlength="120"
                                                       autocomplete="name"
                                                       t-att-value="
                                                           request.env.user.partner_id.name
                                                           if not request.env.user._is_public()
                                                           else ''
                                                       "/>

                                            </div>


                                            <!-- EMPRESA -->

                                            <div class="col-12 col-md-6">

                                                <label for="wpo_company_name"
                                                       class="form-label">

                                                    Empresa

                                                    <span class="text-muted">
                                                        (opcional)
                                                    </span>

                                                </label>

                                                <input id="wpo_company_name"
                                                       name="company_name"
                                                       type="text"
                                                       class="form-control"
                                                       maxlength="160"
                                                       autocomplete="organization"/>

                                            </div>


                                            <!-- EMAIL -->

                                            <div class="col-12 col-md-6">

                                                <label for="wpo_contact_email"
                                                       class="form-label">

                                                    Correo

                                                </label>

                                                <input id="wpo_contact_email"
                                                       name="contact_email"
                                                       type="email"
                                                       class="form-control"
                                                       maxlength="160"
                                                       autocomplete="email"
                                                       t-att-value="
                                                           request.env.user.partner_id.email
                                                           if not request.env.user._is_public()
                                                           else ''
                                                       "/>

                                            </div>


                                            <!-- TELÉFONO -->

                                            <div class="col-12 col-md-6">

                                                <label for="wpo_contact_phone"
                                                       class="form-label">

                                                    Teléfono o WhatsApp

                                                </label>

                                                <input id="wpo_contact_phone"
                                                       name="contact_phone"
                                                       type="tel"
                                                       class="form-control"
                                                       maxlength="60"
                                                       autocomplete="tel"
                                                       t-att-value="
                                                           (
                                                               request.env.user.partner_id.mobile
                                                               or request.env.user.partner_id.phone
                                                           )
                                                           if not request.env.user._is_public()
                                                           else ''
                                                       "/>

                                            </div>


                                            <!-- MENSAJE -->

                                            <div class="col-12">

                                                <label for="wpo_customer_message"
                                                       class="form-label">

                                                    Mensaje

                                                    <span class="text-muted">
                                                        (opcional)
                                                    </span>

                                                </label>

                                                <textarea id="wpo_customer_message"
                                                          name="customer_message"
                                                          rows="3"
                                                          class="form-control"
                                                          maxlength="2000"
                                                          placeholder="Cuéntanos si necesitas entrega en una fecha específica o alguna condición especial."/>

                                            </div>

                                        </div>


                                        <!-- ================================= -->
                                        <!-- TRUST -->
                                        <!-- ================================= -->

                                        <div class="o_wpo_trust_line mt-4">

                                            <i class="fa fa-shield me-2"
                                               aria-hidden="true"/>

                                            Tu propuesta no cambia el precio
                                            del sitio ni genera una compra
                                            automática.

                                        </div>

                                    </div>


                                    <!-- ================================= -->
                                    <!-- SUCCESS -->
                                    <!-- ================================= -->

                                    <div class="o_wpo_success d-none text-center py-4"
                                         aria-live="polite">

                                        <div class="o_wpo_success_icon">

                                            <i class="fa fa-check"
                                               aria-hidden="true"/>

                                        </div>

                                        <h3 class="mt-3">
                                            ¡Oferta enviada!
                                        </h3>

                                        <p class="text-muted o_wpo_success_message"/>

                                        <div class="o_wpo_reference_box">

                                            Referencia:

                                            <strong class="o_wpo_reference"/>

                                        </div>

                                        <a href="#"
                                           class="btn btn-primary mt-3 o_wpo_portal_link">

                                            Consultar estado

                                        </a>

                                    </div>


                                    <!-- ================================= -->
                                    <!-- FOOTER -->
                                    <!-- ================================= -->

                                    <div class="modal-footer border-0 px-0 pb-0 o_wpo_form_footer">

                                        <button type="button"
                                                class="btn btn-light"
                                                data-bs-dismiss="modal">

                                            Ahora no

                                        </button>

                                        <button type="submit"
                                                class="btn btn-primary btn-lg o_wpo_submit">

                                            <span class="o_wpo_submit_label">

                                                Enviar mi oferta

                                                <i class="fa fa-arrow-right ms-2"
                                                   aria-hidden="true"/>

                                            </span>

                                            <span class="o_wpo_submit_loading d-none">

                                                <span class="spinner-border spinner-border-sm me-2"
                                                      aria-hidden="true"/>

