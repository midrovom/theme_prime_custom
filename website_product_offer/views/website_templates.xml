<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="website_sale_product_offer_button"
              inherit_id="website_sale.product"
              name="Botón de oferta comercial">
        <xpath expr="//div[@id='add_to_cart_wrap']" position="after">
            <t t-if="product._website_offer_is_enabled(website)">
                <div class="o_wpo_offer_entry mt-3">
                    <a t-if="website.offer_require_login and request.env.user._is_public()"
                       t-att-href="'/web/login?redirect=%s' % product.website_url"
                       class="btn o_wpo_offer_trigger w-100"
                       role="button">
                        <i class="fa fa-handshake-o me-2" aria-hidden="true"/>
                        Inicia sesión para ofertar
                    </a>
                    <button t-else=""
                            type="button"
                            class="btn o_wpo_offer_trigger w-100"
                            data-bs-toggle="modal"
                            data-bs-target="#wpoOfferModal">
                        <span class="o_wpo_trigger_glow" aria-hidden="true"/>
                        <i class="fa fa-handshake-o me-2" aria-hidden="true"/>
                        Haz una oferta por cantidad
                    </button>
                    <small class="d-block text-center text-muted mt-2">
                        Negocia sin modificar tu carrito
                    </small>
                </div>
            </t>
        </xpath>

        <xpath expr="//*[hasclass('js_main_product')]" position="after">
            <t t-if="product._website_offer_is_enabled(website) and not (website.offer_require_login and request.env.user._is_public())">
                <div class="modal fade o_wpo_offer_modal"
                     id="wpoOfferModal"
                     tabindex="-1"
                     aria-labelledby="wpoOfferModalLabel"
                     aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-lg modal-fullscreen-sm-down">
                        <div class="modal-content o_wpo_modal_content">
                            <div class="o_wpo_modal_orb o_wpo_modal_orb_one" aria-hidden="true"/>
                            <div class="o_wpo_modal_orb o_wpo_modal_orb_two" aria-hidden="true"/>
                            <div class="modal-header border-0 position-relative">
                                <div>
                                    <span class="o_wpo_eyebrow">NEGOCIACIÓN DIRECTA</span>
                                    <h2 class="modal-title h3 mt-1" id="wpoOfferModalLabel">Construye tu oferta</h2>
                                    <p class="text-muted mb-0">Cuéntanos qué cantidad necesitas y cuánto propones por unidad.</p>
                                </div>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"/>
                            </div>
                            <div class="modal-body position-relative pt-0">
                                <div class="alert alert-danger d-none o_wpo_error" role="alert"/>

                                <form class="o_wpo_offer_form" novalidate="novalidate">
                                    <input type="hidden" name="product_id" class="o_wpo_product_id"
                                           t-att-value="product_variant.id"/>
                                    <input type="hidden" name="source_url" t-att-value="product.website_url"/>
                                    <div class="o_wpo_honeypot" aria-hidden="true">
                                        <label>No completar<input type="text" name="website_bait" tabindex="-1" autocomplete="off"/></label>
                                    </div>

                                    <div class="o_wpo_form_body">
                                        <div class="o_wpo_product_strip mb-4">
                                            <div class="o_wpo_product_icon">
                                                <i class="fa fa-mobile" aria-hidden="true"/>
                                            </div>
                                            <div class="flex-grow-1 min-w-0">
                                                <div class="small text-muted">Producto seleccionado</div>
                                                <strong class="d-block text-truncate o_wpo_product_name">
                                                    <t t-out="product.name"/>
                                                </strong>
                                            </div>
                                            <div class="text-end">
                                                <div class="small text-muted">Precio de lista</div>
                                                <strong class="o_wpo_list_price">Cargando…</strong>
                                                <div class="o_wpo_tax_note">sin impuestos</div>
                                            </div>
                                        </div>

                                        <div class="row g-3">
                                            <div class="col-12 col-md-6">
                                                <label for="wpo_quantity" class="form-label">¿Cuántas unidades necesitas?</label>
                                                <div class="input-group input-group-lg o_wpo_input_group">
                                                    <span class="input-group-text"><i class="fa fa-cubes" aria-hidden="true"/></span>
                                                    <input id="wpo_quantity" name="quantity" type="number"
                                                           class="form-control o_wpo_quantity" required="required"
                                                           inputmode="decimal" min="1" step="1" value="1"/>
                                                </div>
                                                <div class="form-text o_wpo_stock_text">Validando existencias…</div>
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <label for="wpo_offered_price" class="form-label">Tu precio por unidad</label>
                                                <div class="input-group input-group-lg o_wpo_input_group">
                                                    <span class="input-group-text o_wpo_currency_symbol">$</span>
                                                    <input id="wpo_offered_price" name="offered_price" type="number"
                                                           class="form-control o_wpo_offered_price" required="required"
                                                           inputmode="decimal" min="0.01" step="0.01"
                                                           placeholder="0.00"/>
                                                </div>
                                                <div class="form-text">Valor unitario antes de impuestos.</div>
                                            </div>
                                        </div>

                                        <div class="o_wpo_total_panel my-4">
                                            <div>
                                                <span class="small text-muted">Total propuesto</span>
                                                <div class="small o_wpo_total_hint">Cantidad × precio ofrecido</div>
                                            </div>
                                            <strong class="o_wpo_offer_total">—</strong>
                                        </div>

                                        <div class="row g-3">
                                            <div class="col-12 col-md-6">
                                                <label for="wpo_contact_name" class="form-label">Nombre de contacto</label>
                                                <input id="wpo_contact_name" name="contact_name" type="text"
                                                       class="form-control" required="required" maxlength="120"
                                                       autocomplete="name"
                                                       t-att-value="request.env.user.partner_id.name if not request.env.user._is_public() else ''"/>
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <label for="wpo_company_name" class="form-label">Empresa <span class="text-muted">(opcional)</span></label>
                                                <input id="wpo_company_name" name="company_name" type="text"
                                                       class="form-control" maxlength="160" autocomplete="organization"/>
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <label for="wpo_contact_email" class="form-label">Correo</label>
                                                <input id="wpo_contact_email" name="contact_email" type="email"
                                                       class="form-control" maxlength="160" autocomplete="email"
                                                       t-att-value="request.env.user.partner_id.email if not request.env.user._is_public() else ''"/>
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <label for="wpo_contact_phone" class="form-label">Teléfono o WhatsApp</label>
                                                <input id="wpo_contact_phone" name="contact_phone" type="tel"
                                                       class="form-control" maxlength="60" autocomplete="tel"
                                                       t-att-value="(request.env.user.partner_id.mobile or request.env.user.partner_id.phone) if not request.env.user._is_public() else ''"/>
                                            </div>
                                            <div class="col-12">
                                                <label for="wpo_customer_message" class="form-label">Mensaje <span class="text-muted">(opcional)</span></label>
                                                <textarea id="wpo_customer_message" name="customer_message" rows="3"
                                                          class="form-control" maxlength="2000"
                                                          placeholder="Cuéntanos si necesitas entrega en una fecha específica o alguna condición especial."/>
                                            </div>
                                        </div>

                                        <div class="o_wpo_trust_line mt-4">
                                            <i class="fa fa-shield me-2" aria-hidden="true"/>
                                            Tu propuesta no cambia el precio del sitio ni genera una compra automática.
                                        </div>
                                    </div>

                                    <div class="o_wpo_success d-none text-center py-4" aria-live="polite">
                                        <div class="o_wpo_success_icon"><i class="fa fa-check" aria-hidden="true"/></div>
                                        <h3 class="mt-3">¡Oferta enviada!</h3>
                                        <p class="text-muted o_wpo_success_message"/>
                                        <div class="o_wpo_reference_box">
                                            Referencia: <strong class="o_wpo_reference"/>
                                        </div>
                                        <a href="#" class="btn btn-primary mt-3 o_wpo_portal_link">Consultar estado</a>
                                    </div>

                                    <div class="modal-footer border-0 px-0 pb-0 o_wpo_form_footer">
                                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Ahora no</button>
                                        <button type="submit" class="btn btn-primary btn-lg o_wpo_submit">
                                            <span class="o_wpo_submit_label">
                                                Enviar mi oferta <i class="fa fa-arrow-right ms-2" aria-hidden="true"/>
                                            </span>
                                            <span class="o_wpo_submit_loading d-none">
                                                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"/> Validando…
                                            </span>
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>

        <xpath expr="//div[@id='add_to_cart_wrap']" position="attributes">
            <attribute name="t-if">not product._website_offer_is_enabled(website)</attribute>
        </xpath>

    </template>
</odoo>
