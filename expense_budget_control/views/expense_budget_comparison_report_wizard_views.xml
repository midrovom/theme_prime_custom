<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_expense_budget_comparison_report_wizard_form" model="ir.ui.view">
        <field name="name">expense.budget.comparison.report.wizard.form</field>
        <field name="model">expense.budget.comparison.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte PDF">
                <group>
                    <field name="company_id" options="{'no_create': True}"/>
                    <field name="period"/>
                    <field name="year"/>
                    <field name="month_ids" widget="many2many_tags" invisible="period != 'month'" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="category_id" options="{'no_create': True}"/>
                    <field name="account_ids" widget="many2many_tags"
                           domain="[('company_id', '=', company_id)] + ([('category_id', '=', category_id)] if category_id else [])"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                </group>
                <footer>
                    <button name="action_print_pdf" type="object" string="Imprimir PDF"
                            class="btn-primary" icon="fa-print"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_expense_budget_comparison_report_wizard" model="ir.actions.act_window">
        <field name="name">Reporte PDF</field>
        <field name="res_model">expense.budget.comparison.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_expense_budget_comparison_report_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
