<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_expense_budget_cost_center_list" model="ir.ui.view">
        <field name="name">expense.budget.cost.center.list</field>
        <field name="model">expense.budget.cost.center</field>
        <field name="arch" type="xml">
            <list string="Centros de costo" decoration-muted="not active">
                <field name="code"/><field name="name"/>
                <field name="company_id"/><field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_expense_budget_cost_center_form" model="ir.ui.view">
        <field name="name">expense.budget.cost.center.form</field>
        <field name="model">expense.budget.cost.center</field>
        <field name="arch" type="xml">
            <form string="Centro de costo">
                <sheet>
                    <group>
                        <field name="company_id"/>
                        <field name="code"/><field name="name"/>
                        <field name="active"/><field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_expense_budget_cost_center" model="ir.actions.act_window">
        <field name="name">Centros de costo</field>
        <field name="res_model">expense.budget.cost.center</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
