<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_expense_budget_import_form" model="ir.ui.view">
        <field name="name">expense.budget.import.wizard.form</field>
        <field name="model">expense.budget.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Excel o CSV">
                <sheet>
                    <group>
                        <field name="import_type"/>
                        <field name="company_id"/>
                        <field name="budget_id" invisible="import_type != 'projections'"
                               required="import_type == 'projections'"/>
                        <field name="upload" filename="filename"/>
                        <field name="filename" invisible="1"/>
                    </group>
                    <group>
                        <div class="text-muted">Para los ejemplos use las hojas Cuentas, Proyecciones o Gastos del Excel incluido.</div>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import" string="Importar" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_expense_budget_import" model="ir.actions.act_window">
        <field name="name">Importar Excel / CSV</field>
        <field name="res_model">expense.budget.import.wizard</field>
        <field name="view_mode">form</field><field name="target">new</field>
    </record>
</odoo>
