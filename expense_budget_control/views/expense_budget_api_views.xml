<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Solo selecciona una API ya creada en el módulo api_administrator. -->
    <record id="view_expense_budget_api_administrator_list" model="ir.ui.view">
        <field name="name">expense.budget.api.config.list</field>
        <field name="model">expense.budget.api.config</field>
        <field name="priority">35</field>
        <field name="arch" type="xml">
            <list string="Configuración API de gastos" delete="false">
                <field name="company_id"/>
                <field name="api_administrator_id"/>
                <field name="catalog_api_administrator_id"/>
                <button name="action_sync" type="object" string="Sincronizar" icon="fa-refresh"/>
            </list>
        </field>
    </record>
    <record id="view_expense_budget_api_administrator_form" model="ir.ui.view">
        <field name="name">expense.budget.api.config.form</field>
        <field name="model">expense.budget.api.config</field>
        <field name="priority">35</field>
        <field name="arch" type="xml">
            <form string="Configuración API de gastos" delete="false">
                <header>
                    <button name="action_sync" type="object" string="Sincronizar API"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="company_id"/>
                        <field name="api_administrator_id"
                               domain="[('company_id', '=', company_id), ('type', '=', 'get'), ('status', '=', 'A')]"
                               options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                        <field name="catalog_api_administrator_id"
                               domain="[('company_id', '=', company_id), ('type', '=', 'get'), ('status', '=', 'A')]"
                               options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_expense_budget_api_administrator" model="ir.actions.act_window">
        <field name="name">Configuración API de gastos</field>
        <field name="res_model">expense.budget.api.config</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
    <record id="action_expense_budget_api_list_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_expense_budget_api_administrator_list"/>
        <field name="act_window_id" ref="action_expense_budget_api_administrator"/>
    </record>
    <record id="action_expense_budget_api_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_expense_budget_api_administrator_form"/>
        <field name="act_window_id" ref="action_expense_budget_api_administrator"/>
    </record>
    <record id="view_expense_budget_sync_log_list" model="ir.ui.view">
        <field name="name">expense.budget.sync.log.list</field>
        <field name="model">expense.budget.sync.log</field>
        <field name="arch" type="xml">
            <list string="Historial de sincronización" create="false" edit="false" delete="false"
                  decoration-danger="status == 'error'">
                <field name="create_date"/><field name="company_id"/>
                <field name="api_administrator_id"/><field name="status" widget="badge"/>
                <field name="created_count"/><field name="updated_count"/>
                <field name="unchanged_count"/><field name="message"/>
            </list>
        </field>
    </record>
    <record id="action_expense_budget_sync_log" model="ir.actions.act_window">
        <field name="name">Historial de sincronización</field>
        <field name="res_model">expense.budget.sync.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
