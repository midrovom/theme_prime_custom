<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- Rubros -->
    <record id="view_expense_budget_category_list" model="ir.ui.view">
        <field name="name">expense.budget.category.list</field>
        <field name="model">expense.budget.category</field>
        <field name="arch" type="xml">
            <list string="Rubros" decoration-muted="not active">
                <field name="code"/>
                <field name="name"/>
                <field name="company_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_expense_budget_category_form" model="ir.ui.view">
        <field name="name">expense.budget.category.form</field>
        <field name="model">expense.budget.category</field>
        <field name="arch" type="xml">
            <form string="Rubro">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="active"/>
                    </group>
                    <group string="Cuentas controladas del rubro">
                        <!-- Selector múltiple de cuentas existentes. category_id NO
                             filtra: también permite elegir cuentas de otro rubro
                             siempre que no tengan histórico presupuestario. -->
                        <field name="account_selection_ids" widget="many2many_tags" domain="[('company_id', '=', company_id)]" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="cost_center_ids" widget="many2many_tags" readonly="1" string="Centros detectados en consumos"/>
                        <div class="text-muted">Una cuenta puede tener consumos en varios centros; seleccione el centro en la proyección.</div>
                        
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_expense_budget_category" model="ir.actions.act_window">
        <field name="name">Rubros</field><field name="res_model">expense.budget.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Catálogo de cuentas -->
    <record id="view_expense_budget_account_list" model="ir.ui.view">
        <field name="name">expense.budget.account.list</field>
        <field name="model">expense.budget.account</field>
        <field name="arch" type="xml">
            <list string="Cuentas controladas" decoration-muted="not active">
                <field name="code"/><field name="name"/><field name="category_id"/>
                <field name="company_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_expense_budget_account_form" model="ir.ui.view">
        <field name="name">expense.budget.account.form</field>
        <field name="model">expense.budget.account</field>
        <field name="arch" type="xml">
            <form string="Cuenta controlada">
                <sheet>
                    <group>
                        <field name="code"/><field name="name"/>
                        <field name="company_id"/>
                        <field name="category_id" domain="[('company_id', '=', company_id)]"/>
                        <field name="cost_center_ids" widget="many2many_tags" readonly="1"/>
                        <field name="active"/>
                    </group>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_expense_budget_account" model="ir.actions.act_window">
        <field name="name">Cuentas controladas</field><field name="res_model">expense.budget.account</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Presupuestos -->
    <record id="view_expense_budget_list" model="ir.ui.view">
        <field name="name">expense.budget.list</field><field name="model">expense.budget</field>
        <field name="arch" type="xml">
            <list string="Presupuestos anuales" decoration-success="state == 'approved'">
                <field name="name" string="Presupuesto"/><field name="year"/><field name="category_id" string="Rubro"/>
                <field name="company_id"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="planned_amount" sum="Total proyectado"/>
                <field name="actual_amount" sum="Total consumido"/>
                <field name="available_to_spend" sum="Disponible"/>
                <field name="approved_through_month" string="Aprobado hasta"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_expense_budget_form" model="ir.ui.view">
        <field name="name">expense.budget.form</field><field name="model">expense.budget</field>
        <field name="arch" type="xml">
            <form string="Presupuesto anual" class="o_ebc_budget_form">
                <header>
                    <button name="action_submit" string="Enviar a aprobar" type="object" class="btn-primary" invisible="state != 'draft'" groups="expense_budget_control.group_expense_budget_registrar,expense_budget_control.group_expense_budget_manager"/>
                    <button name="action_approve" string="Aprobar" type="object" class="btn-primary" invisible="state != 'to_approve'" groups="expense_budget_control.group_expense_budget_approver,expense_budget_control.group_expense_budget_manager"/>
                    <button name="action_reject" string="Rechazar" type="object" class="btn-secondary" invisible="state != 'to_approve'" groups="expense_budget_control.group_expense_budget_approver,expense_budget_control.group_expense_budget_manager"/>
                    <button name="action_sync_api" string="Actualizar costos" type="object" groups="expense_budget_control.group_expense_budget_registrar,expense_budget_control.group_expense_budget_manager"/>
                    <button name="action_print_annual_pdf" string="Imprimir PDF" type="object" icon="fa-print" groups="expense_budget_control.group_expense_budget_read"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,to_approve,approved,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" readonly="state != 'draft'"/>
                            <field name="name" string="Presupuesto" readonly="state != 'draft'"/>
                            <field name="year_selector" string="Año" readonly="state != 'draft'"/>
                            <field name="year" invisible="1"/>
                            <field name="category_id" string="Rubro" required="state == 'draft'" readonly="state != 'draft'" domain="[('company_id', '=', company_id)]" context="{'default_company_id': company_id, 'form_view_ref': 'expense_budget_control.view_expense_budget_category_form'}" options="{'no_quick_create': True, 'no_create_edit': False}"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="planned_amount" readonly="True"/>
                            <field name="actual_amount" readonly="True"/>
                            <field name="available_to_spend" readonly="True"/>
                        </group>
                        <group string="Seguimiento de aprobación">
                            <field name="approved_through_month" readonly="True"/>
                            <field name="months_pending_approval" readonly="True" placeholder="Sin líneas pendientes"/>
                            <field name="has_lines_to_submit" invisible="True"/>
                        </group>
                    </group>
                    <!-- Fila única de captura. annual_target_ids sigue existiendo
                         internamente para histórico y el prorrateo protegido. -->
                    <div class="o_ebc_quick_budget_capture" groups="expense_budget_control.group_expense_budget_registrar,expense_budget_control.group_expense_budget_manager" invisible="state != 'draft'">
    <div class="o_ebc_quick_budget_title">AGREGAR PROYECCIONES POR MESES</div>
    <field name="quick_available_month_ids" invisible="1"/>
    <div class="o_ebc_quick_budget_row">
        <div class="o_ebc_quick_budget_item">
            <label for="quick_account_id" string="Cuenta controlada"/>
            <field name="quick_account_id" nolabel="1" domain="[('company_id', '=', company_id), ('category_id', '=', category_id)]" options="{'no_create': True, 'no_open': True}"/>
        </div>
        <div class="o_ebc_quick_budget_item">
            <label for="quick_cost_center_id" string="Centro de costo"/>
            <field name="quick_cost_center_id" nolabel="1" domain="[('company_id', '=', company_id)]" options="{'no_create': True, 'no_open': True}"/>
        </div>
        <div class="o_ebc_quick_budget_item o_ebc_quick_budget_months">
            <label for="quick_month_ids" string="Meses"/>
            <field name="quick_month_ids" nolabel="1" widget="many2many_tags" domain="[('id', 'in', quick_available_month_ids)]" options="{'no_create': True, 'no_open': True}" />
        </div>
        <div class="o_ebc_quick_budget_item">
            <label for="quick_annual_amount" string="Presupuesto anual"/>
            <field name="quick_annual_amount" nolabel="1"/>
        </div>
        <div class="o_ebc_quick_budget_item o_ebc_quick_budget_action">
            <div class="o_ebc_quick_budget_actions">
                <button name="action_add_quick_monthly_lines" string="Agregar" type="object" icon="fa-plus" class="btn-primary o_ebc_quick_budget_add" title="Crear las líneas mensuales y limpiar esta fila"/>
                <button name="action_delete_quick_monthly_lines" string="Eliminar" type="object" icon="fa-trash" class="btn-danger o_ebc_quick_budget_delete" title="Eliminar las líneas de la cuenta y centro seleccionados, únicamente de los meses elegidos" confirm="Se eliminarán las proyecciones de esta cuenta y centro. Si no seleccionó meses, se eliminarán todos sus meses. ¿Desea continuar?"/>
            </div>
        </div>
    </div>
</div><notebook>
                        <page string="Proyecciones mensuales">
                            <field name="line_ids" class="o_ebc_lines" readonly="state != 'draft'">
                                <list create="false" editable="bottom" default_order="month_number,account_id,cost_center_id,id" decoration-success="approval_state == 'approved'" decoration-warning="approval_state in ['draft', 'to_approve']" decoration-danger="approval_state == 'rejected'">
                                    <field name="approval_state" string="Estado de aprobación" widget="badge" readonly="True"/>
                                    <field name="company_id" column_invisible="True"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="account_id" readonly="approval_state in ['approved', 'to_approve']" domain="[('company_id', '=', parent.company_id), ('category_id', '=', parent.category_id)]"/>
                                    <field name="erp_account_code" string="Código" readonly="True"/>
                                    <field name="cost_center_id" string="Centro de costo" readonly="approval_state in ['approved', 'to_approve']" domain="[('company_id', '=', parent.company_id)]" options="{'no_create': True}"/>
                                    <field name="available_month_option_ids" column_invisible="True"/>
                                    <field name="annual_amount_readonly" column_invisible="True"/>
                                    <field name="annual_amount" column_invisible="True"/>
                                    <field name="allocation_month_count" column_invisible="True"/>
                                    <field name="month" column_invisible="True"/>
                                    <field name="month_number" column_invisible="True"/>
                                    <field name="month_option_id" string="Mes" required="1" domain="[('id', 'in', available_month_option_ids)]" readonly="approval_state in ['approved', 'to_approve']" options="{'no_create': True, 'no_open': True}" help="Filtra por cuenta controlada y centro de costo: una combinación puede tener una sola proyección por mes. Si Agua/Quito está aprobado hasta mayo, muestra desde junio; Agua de otro centro puede comenzar en enero si aún no tiene proyección."/>
                                    <field name="planned_amount" readonly="approval_state in ['approved', 'to_approve'] or annual_amount &gt; 0" sum="Proyectado"/>
                                    <field name="actual_amount" readonly="True" sum="Consumido"/>
                                    <field name="available_to_spend" readonly="True" sum="Disponible"/>
                                </list>
                            </field>
                        </page>
                        <!-- Los objetivos anuales continúan almacenados en
                             annual_target_ids para el prorrateo y la protección
                             de meses aprobados, pero no se muestran en pestañas. -->
                        <page string="Observaciones"><field name="note" readonly="state != 'draft'"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_expense_budget_search" model="ir.ui.view">
        <field name="name">expense.budget.search</field><field name="model">expense.budget</field>
        <field name="arch" type="xml">
            <search string="Buscar presupuestos">
                <field name="name"/><field name="year"/><field name="category_id"/><field name="company_id"/>
                <filter string="Por aprobar" name="to_approve" domain="[('state', '=', 'to_approve')]"/>
                <filter string="Aprobados" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rechazados" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Año" name="year_group" context="{'group_by': 'year'}"/>
                    <filter string="Rubro" name="rubro_group" context="{'group_by': 'category_id'}"/>
                    <filter string="Empresa" name="company_group" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_expense_budget" model="ir.actions.act_window">
        <field name="name">Presupuestos anuales</field><field name="res_model">expense.budget</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_expense_budget_search"/>
    </record>

    <record id="action_expense_budget_approval" model="ir.actions.act_window"><field name="name">Aprobación de presupuestos</field><field name="res_model">expense.budget</field><field name="view_mode">list,form</field><field name="domain">[('state', 'in', ('to_approve', 'approved', 'rejected'))]</field><field name="search_view_id" ref="view_expense_budget_search"/></record><!-- Comparativo en lista, tabla dinámica y gráfica -->
    <record id="view_expense_budget_line_list" model="ir.ui.view">
        <field name="name">expense.budget.line.list</field><field name="model">expense.budget.line</field>
        <field name="arch" type="xml">
            <list string="Proyectado vs. consumido" create="false" edit="false" delete="false" default_order="budget_id,month_number,account_id,cost_center_id,id" decoration-danger="available_to_spend &lt; 0">
                <header>
                    <button name="%(expense_budget_control.action_expense_budget_comparison_report_wizard)d" type="action" string="Imprimir PDF" icon="fa-print" display="always" groups="expense_budget_control.group_expense_budget_user,expense_budget_control.group_expense_budget_approver,expense_budget_control.group_expense_budget_manager"/>
                </header>
                <field name="budget_id"/><field name="company_id"/>
                <field name="account_id"/><field name="category_id"/><field name="cost_center_id"/>
                <field name="year"/><field name="month" string="Mes"/>
                <field name="month_number" column_invisible="True"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="planned_amount" sum="Proyectado"/>
                <field name="actual_amount" sum="Consumido"/>
                <field name="available_to_spend" sum="Disponible"/>
            </list>
        </field>
    </record>
    <record id="view_expense_budget_line_pivot" model="ir.ui.view">
        <field name="name">expense.budget.line.pivot</field><field name="model">expense.budget.line</field>
        <field name="arch" type="xml">
            <pivot string="Análisis presupuestario">
                <field name="budget_id" type="row"/>
                <field name="category_id" type="row"/>
                <field name="cost_center_id" type="row"/>
                <field name="month" type="col"/>
                <field name="planned_amount" type="measure"/>
                <field name="actual_amount" type="measure"/>
                <field name="available_to_spend" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_expense_budget_line_graph" model="ir.ui.view">
        <field name="name">expense.budget.line.graph</field><field name="model">expense.budget.line</field>
        <field name="arch" type="xml">
            <graph string="Proyectado vs. real" type="bar" stacked="0">
                <field name="month" type="row"/>
                <field name="planned_amount" type="measure"/>
                <field name="actual_amount" type="measure"/>
                <field name="available_to_spend" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_expense_budget_line_search" model="ir.ui.view">
        <field name="name">expense.budget.line.search</field><field name="model">expense.budget.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="budget_id"/><field name="account_id"/><field name="category_id"/>
                <field name="month"/><field name="cost_center_id"/>
                <filter string="Sobregirados" name="over_budget" domain="[('available_to_spend', '&lt;', 0)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Rubro" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Centro de costo" name="group_cost_center" context="{'group_by': 'cost_center_id'}"/>
                    <filter string="Mes" name="group_month" context="{'group_by': 'month'}"/>
                    <filter string="Presupuesto" name="group_budget" context="{'group_by': 'budget_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_expense_budget_comparison" model="ir.actions.act_window">
        <field name="name">Proyectado vs. real</field><field name="res_model">expense.budget.line</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_expense_budget_line_search"/>
    </record>

    <!-- Movimientos reales -->
    <record id="view_expense_budget_expense_list" model="ir.ui.view">
        <field name="name">expense.budget.expense.list</field><field name="model">expense.budget.expense</field>
        <field name="arch" type="xml">
            <list string="Gastos reales">
                <field name="date"/><field name="company_id"/>
                <field name="account_id"/><field name="category_id"/><field name="cost_center_id"/>
                <field name="description"/><field name="reference"/><field name="subcenter_code" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount" sum="Total gastado"/>
                <field name="source"/><field name="budget_line_id" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_expense_budget_expense_form" model="ir.ui.view">
        <field name="name">expense.budget.expense.form</field><field name="model">expense.budget.expense</field>
        <field name="arch" type="xml">
            <form string="Gasto real">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="company_id"/>
                            <field name="account_id" domain="[('company_id', '=', company_id)]"/>
                            <field name="category_id" readonly="True"/>
                            <field name="cost_center_id" domain="[('company_id', '=', company_id)]"/>
                            <field name="budget_line_id" readonly="True"/>
                        </group>
                        <group>
                            <field name="description"/><field name="reference"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount"/>
                            <field name="source" readonly="True"/>
                            <field name="source_key" readonly="True"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_expense_budget_expense_search" model="ir.ui.view">
        <field name="name">expense.budget.expense.search</field><field name="model">expense.budget.expense</field>
        <field name="arch" type="xml">
            <search>
                <field name="description"/><field name="reference"/><field name="account_id"/>
                <field name="category_id"/><field name="date"/>
                <filter string="Sin asignar" name="without_budget" domain="[('budget_line_id', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Rubro" name="category" context="{'group_by': 'category_id'}"/>
                    <filter string="Cuenta" name="account" context="{'group_by': 'account_id'}"/>
                    <filter string="Mes" name="month" context="{'group_by': 'date:month'}"/>
                    <filter string="Origen" name="source" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_expense_budget_expense" model="ir.actions.act_window">
        <field name="name">Gastos reales</field><field name="res_model">expense.budget.expense</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_expense_budget_expense_search"/>
    </record>
</odoo>