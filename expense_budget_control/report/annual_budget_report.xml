<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- Mantener XML ID original: actualizar el formato sin desregistrar reportes existentes. -->
    <record id="paperformat_expense_budget_a4_landscape" model="report.paperformat">
        <field name="name">Presupuesto anual - resumen por año (A4 horizontal)</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="orientation">Landscape</field>
        <field name="page_height">297</field>
        <field name="page_width">210</field>
        <field name="margin_top">52</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">8</field>
        <field name="dpi">90</field>
    </record>

    <template id="report_annual_budget_document">
        <t t-call="web.html_container">
            <t t-foreach="reports" t-as="report_data">
                <t t-set="o" t-value="report_data['budget']"/>
                <t t-call="web.external_layout">
                    <div class="page expense-budget-annual-report">
                        <style type="text/css">
                            .expense-budget-annual-report { font-family: Arial, sans-serif; color: #273244; }
                            .expense-budget-annual-report .report-title { font-size: 22px; line-height: 1.25; font-weight: bold; margin: 0 0 8px 0; }
                            .expense-budget-annual-report .report-meta { font-size: 12px; line-height: 1.45; margin: 0 0 18px 0; }
                            .expense-budget-annual-report .report-table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 12px; }
                            .expense-budget-annual-report .report-table th,
                            .expense-budget-annual-report .report-table td { border: 1px solid #cad2db; padding: 10px 9px; vertical-align: middle; }
                            .expense-budget-annual-report .report-table thead th { background: #24445c; color: #fff; text-align: center; font-weight: bold; }
                            .expense-budget-annual-report .report-table .year-header { background: #2f5877; font-size: 19px; padding-top: 12px; padding-bottom: 12px; }
                            .expense-budget-annual-report .report-table .column-header { font-size: 12px; white-space: nowrap; }
                            .expense-budget-annual-report .report-table .category-row td { background: #dce8f0; font-weight: bold; }
                            .expense-budget-annual-report .report-table .account-name { padding-left: 22px; }
                            .expense-budget-annual-report .report-table .number { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
                            .expense-budget-annual-report .report-table .excess { color: #9f2828; font-weight: bold; }
                            .expense-budget-annual-report .report-table .total-row td { background: #d7e5ef; font-weight: bold; border-top: 2px solid #24445c; }
                            .expense-budget-annual-report .report-table .category-code { font-size: 10px; color: #657480; font-weight: normal; }
                            .expense-budget-annual-report .report-table .category-row .category-code { color: #495d70; }
                            .expense-budget-annual-report .report-note { font-size: 10px; line-height: 1.4; margin-top: 14px; color: #465566; }
                            .expense-budget-annual-report .report-table thead { display: table-header-group; }
                            .expense-budget-annual-report .report-table tr { page-break-inside: avoid; }
                            @media screen and (max-width: 767px) {
                                .expense-budget-annual-report .report-scroll { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
                                .expense-budget-annual-report .report-table { min-width: 650px; }
                            }
                            @media print {
                                .expense-budget-annual-report .report-scroll { overflow: visible; }
                                .expense-budget-annual-report .report-table { min-width: 0; }
                            }
                        </style>
                        <h2 class="report-title">Presupuesto anual de gastos</h2>
                        <div class="report-meta">
                            <strong>Presupuesto:</strong> <span t-esc="report_data['budget_name']"/>
                            <span> | </span><strong>Año:</strong> <span t-esc="o.year"/>
                            <span> | </span><strong>Empresa:</strong> <span t-esc="o.company_id.name"/>
                        </div>
                        <div class="report-scroll">
                            <table class="report-table">
                                <colgroup>
                                    <col style="width: 34%;"/>
                                    <col style="width: 24%;"/>
                                    <col style="width: 14%;"/>
                                    <col style="width: 14%;"/>
                                    <col style="width: 14%;"/>
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th rowspan="2" style="text-align: left;">Rubro / Cuenta controlada</th>
                                        <th rowspan="2" style="text-align: left;">Centro de costo</th>
                                        <th colspan="3" class="year-header" t-esc="o.year"/>
                                    </tr>
                                    <tr>
                                        <th class="column-header">Proyectado</th>
                                        <th class="column-header">Consumido</th>
                                        <th class="column-header">Disponible</th>
                                    </tr>
                                </thead>
                                <t t-if="not report_data['categories']">
                                    <tbody>
                                        <tr><td colspan="5" style="text-align:center; padding:18px;">No hay cuentas presupuestadas para este año.</td></tr>
                                    </tbody>
                                </t>
                                <t t-foreach="report_data['categories']" t-as="group">
                                    <tbody>
                                        <tr class="category-row">
                                            <td>
                                                <span t-esc="group['category'].name"/>
                                                <span t-if="group['category'].code" class="category-code"> (<span t-esc="group['category'].code"/>)</span>
                                            </td>
                                            <td></td>
                                            <td class="number"></td>
                                            <td class="number"></td>
                                            <td class="number"></td>
                                        </tr>
                                        <t t-foreach="group['accounts']" t-as="account_data">
                                            <tr>
                                                <td class="account-name">
                                                    <span t-esc="account_data['account'].name"/>
                                                    <span t-if="account_data['account'].code" class="category-code"> (<span t-esc="account_data['account'].code"/>)</span>
                                                </td>
                                                <td t-esc="account_data['cost_center'].display_name if account_data.get('cost_center') else 'Sin centro'"/>
                                                <td class="number" t-esc="report_data['format_real'](account_data['annual']['planned'], report_data['decimal_digits'])"/>
                                                <td class="number" t-esc="report_data['format_real'](account_data['annual']['actual'], report_data['decimal_digits'])"/>
                                                <td class="number" t-esc="report_data['format_real'](account_data['annual']['available'], report_data['decimal_digits'])"/>
                                            </tr>
                                        </t>
                                    </tbody>
                                </t>
                                <tbody>
                                    <tr class="total-row">
                                        <td>TOTAL GENERAL</td>
                                        <td></td>
                                        <td class="number" t-esc="report_data['format_real'](report_data['annual_total']['planned'], report_data['decimal_digits'])"/>
                                        <td class="number" t-esc="report_data['format_real'](report_data['annual_total']['actual'], report_data['decimal_digits'])"/>
                                        <td class="number" t-esc="report_data['format_real'](report_data['annual_total']['available'], report_data['decimal_digits'])"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="report-note">
                            Valores acumulados de enero a diciembre del año indicado.
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_expense_budget_annual" model="ir.actions.report">
        <field name="name">Presupuesto anual por rubro y cuenta</field>
        <field name="model">expense.budget</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">expense_budget_control.report_annual_budget_document</field>
        <field name="report_file">expense_budget_control.report_annual_budget_document</field>
        <field name="paperformat_id" ref="paperformat_expense_budget_a4_landscape"/>
        <!-- Restaurar el reporte anual en Presupuestos y en su menú Imprimir. -->
        <field name="binding_model_id" ref="model_expense_budget"/>
        <field name="binding_type">report</field>
        <field name="groups_id" eval="[(6, 0, [ref('expense_budget_control.group_expense_budget_read')])]"/>
        <field name="print_report_name">'Presupuesto_%s_%s' % (object.year, object.company_id.name.replace(' ', '_'))</field>
    </record>
    <!-- Mantener exactamente la plantilla anual, ahora también desde el asistente. -->
    <template id="report_annual_budget_wizard_document">
        <t t-call="expense_budget_control.report_annual_budget_document"/>
    </template>
    <record id="action_report_expense_budget_annual_wizard" model="ir.actions.report">
        <field name="name">Presupuesto anual por rubro y cuenta</field>
        <field name="model">expense.budget.comparison.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">expense_budget_control.report_annual_budget_wizard_document</field>
        <field name="report_file">expense_budget_control.report_annual_budget_wizard_document</field>
        <field name="paperformat_id" ref="paperformat_expense_budget_a4_landscape"/>
        <field name="groups_id" eval="[(6, 0, [ref('expense_budget_control.group_expense_budget_user'), ref('expense_budget_control.group_expense_budget_approver'), ref('expense_budget_control.group_expense_budget_manager')])]"/>
        <field name="print_report_name">'Comparativo_Anual_%s_%s' % (object.year, object.company_id.name.replace(' ', '_'))</field>
    </record>
</odoo>
