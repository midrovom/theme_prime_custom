<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- Mantener XML ID original: actualizar el formato sin desregistrar reportes existentes. -->
    <record id="paperformat_expense_budget_a4_landscape" model="report.paperformat">
        <field name="name">Presupuesto anual - 12 meses (formato panorámico ampliado)</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="orientation">Landscape</field>
        <field name="page_height">285</field>
        <field name="page_width">1100</field>
        <field name="margin_top">57</field>
        <field name="margin_bottom">17</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">8</field>
        <field name="dpi">90</field>
    </record>

    <template id="report_annual_budget_document">
        <t t-call="web.html_container">
            <t t-foreach="reports" t-as="report_data">
                <t t-set="o" t-value="report_data['budget']"/>
                <t t-call="web.external_layout">
                    <div class="page expense-budget-annual-report">
                        <style type="text/css">
                            .expense-budget-annual-report { font-family: Arial, sans-serif; color: #273244; }
                            .expense-budget-annual-report .report-title { padding-top: 6px; }
                            .expense-budget-annual-report .report-title { font-size: 30px; line-height: 1.22; font-weight: bold; margin: 0 0 8px 0; }
                            .expense-budget-annual-report .report-meta { font-size: 18px; line-height: 1.35; margin: 0 0 18px 0; }
                            .expense-budget-annual-report .report-table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 15px; }
                            .expense-budget-annual-report .report-table th,
                            .expense-budget-annual-report .report-table td { border: 1px solid #cad2db; padding: 9px 4px; vertical-align: middle; }
                            .expense-budget-annual-report .report-table thead th { background: #24445c; color: white; text-align: center; font-weight: bold; }
                            .expense-budget-annual-report .report-table thead tr:nth-child(2) th { font-size: 13px; line-height: 1.3; overflow-wrap: anywhere; word-wrap: break-word; }
                            .expense-budget-annual-report .report-table thead .month-header { background: #2f5877; font-size: 17px; padding-top: 12px; padding-bottom: 12px; }
                            .expense-budget-annual-report .report-table .category-row td { background: #dce8f0; font-weight: bold; }
                            .expense-budget-annual-report .report-table .account-name { padding-left: 18px; }
                            .expense-budget-annual-report .report-table .number { text-align: right; white-space: nowrap; }
                            .expense-budget-annual-report .report-table .execution { text-align: right; white-space: nowrap; }
                            .expense-budget-annual-report .report-table .total-row td { background: #d7e5ef; font-weight: bold; border-top: 2px solid #24445c; }
                            .expense-budget-annual-report .report-table .category-code { font-size: 13px; color: #657480; font-weight: normal; }
                            .expense-budget-annual-report .report-table .category-row .category-code { color: #495d70; }
                            .expense-budget-annual-report .report-note { font-size: 15px; line-height: 1.4; margin-top: 16px; color: #465566; }
                            .expense-budget-annual-report .report-table thead { display: table-header-group; }
                            .expense-budget-annual-report .report-table tfoot { display: table-row-group; }
                            /* En HTML la tabla se desplaza, sin ocultar meses en pantallas pequeñas. */
                            @media screen and (max-width: 767px) {
                                .expense-budget-annual-report .report-scroll { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
                                .expense-budget-annual-report .report-table { min-width: 3650px; }
                            }
                            @media print {
                                .expense-budget-annual-report .report-scroll { overflow: visible; }
                                .expense-budget-annual-report .report-table { min-width: 0; }
                            }
                        </style>
                        <h2 class="report-title">Presupuesto anual de gastos</h2>
                        <div class="report-meta">
                            <strong>Presupuesto:</strong> <span t-esc="o.name"/>
                            <span> | </span><strong>Año:</strong> <span t-esc="o.year"/>
                            <span> | </span><strong>Empresa:</strong> <span t-esc="o.company_id.name"/>
                            <span> | </span><strong>Moneda:</strong> <span t-esc="o.currency_id.name"/>
                        </div>
                        <div class="report-scroll">
                            <table class="report-table">
                                <colgroup>
                                    <col style="width: 15%;"/>
                                    <t t-foreach="report_data['months']" t-as="month">
                                        <col style="width: 2.25%;"/>
                                        <col style="width: 2.25%;"/>
                                        <col style="width: 2.25%;"/>
                                    </t>
                                    <col style="width: 4%;"/>
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th rowspan="2" style="text-align: left;">Rubro / Cuenta controlada</th>
                                        <t t-foreach="report_data['months']" t-as="month">
                                            <th colspan="3" class="month-header" t-esc="month['name']"/>
                                        </t>
                                        <th rowspan="2">Ejecución anual (%)</th>
                                    </tr>
                                    <tr>
                                        <t t-foreach="report_data['months']" t-as="month">
                                            <th>Presupuesto</th>
                                            <th>Gasto</th>
                                            <!-- Sin título: ejecución porcentual mensual. -->
                                            <th title="Ejecución (%)"/>
                                        </t>
                                    </tr>
                                </thead>
                                <t t-if="not report_data['categories']">
                                    <tbody><tr><td colspan="38" style="text-align:center; padding: 18px;">No hay cuentas presupuestadas para este año.</td></tr></tbody>
                                </t>
                                <t t-foreach="report_data['categories']" t-as="group">
                                    <tbody>
                                        <tr class="category-row">
                                            <td>
                                                <span t-esc="group['category'].name"/>
                                                <span class="category-code"> (<span t-esc="group['category'].code"/>)</span>
                                            </td>
                                            <t t-foreach="report_data['months']" t-as="month">
                                                <t t-set="cell" t-value="group['months'][month['number']]"/>
                                                <td class="number">
                                                    <t t-if="cell['has_line']"><span t-esc="'{:,.2f}'.format(cell['planned'])"/></t>
                                                    <t t-else="">—</t>
                                                </td>
                                                <td class="number">
                                                    <t t-if="cell['has_line']"><span t-esc="'{:,.2f}'.format(cell['actual'])"/></t>
                                                    <t t-else="">—</t>
                                                </td>
                                                <td class="execution" t-att-style="'color: #aa2222;' if cell['execution'] &gt; 100 else ''">
                                                    <t t-if="cell['has_line']"><span t-esc="'{:,.2f}%'.format(cell['execution'])"/></t>
                                                    <t t-else="">—</t>
                                                </td>
                                            </t>
                                            <td class="execution" t-att-style="'color: #aa2222;' if group['annual']['execution'] &gt; 100 else ''" t-esc="'{:,.2f}%'.format(group['annual']['execution'])"/>
                                        </tr>
                                        <t t-foreach="group['accounts']" t-as="account_data">
                                            <tr>
                                                <td class="account-name">
                                                    <span t-esc="account_data['account'].name"/>
                                                    <span class="category-code"> (<span t-esc="account_data['account'].code"/>)</span>
                                                </td>
                                                <t t-foreach="report_data['months']" t-as="month">
                                                    <t t-set="cell" t-value="account_data['months'][month['number']]"/>
                                                    <td class="number">
                                                        <t t-if="cell['has_line']"><span t-esc="'{:,.2f}'.format(cell['planned'])"/></t>
                                                        <t t-else="">—</t>
                                                    </td>
                                                    <td class="number">
                                                        <t t-if="cell['has_line']"><span t-esc="'{:,.2f}'.format(cell['actual'])"/></t>
                                                        <t t-else="">—</t>
                                                    </td>
                                                    <td class="execution" t-att-style="'color: #aa2222; font-weight: bold;' if cell['execution'] &gt; 100 else ''">
                                                        <t t-if="cell['has_line']"><span t-esc="'{:,.2f}%'.format(cell['execution'])"/></t>
                                                        <t t-else="">—</t>
                                                    </td>
                                                </t>
                                                <td class="execution" t-att-style="'color: #aa2222; font-weight: bold;' if account_data['annual']['execution'] &gt; 100 else ''" t-esc="'{:,.2f}%'.format(account_data['annual']['execution'])"/>
                                            </tr>
                                        </t>
                                    </tbody>
                                </t>
                                <tbody>
                                    <tr class="total-row">
                                        <td>TOTAL GENERAL</td>
                                        <t t-foreach="report_data['months']" t-as="month">
                                            <t t-set="cell" t-value="report_data['totals'][month['number']]"/>
                                            <td class="number" t-esc="'{:,.2f}'.format(cell['planned'])"/>
                                            <td class="number" t-esc="'{:,.2f}'.format(cell['actual'])"/>
                                            <td class="execution" t-att-style="'color: #aa2222;' if cell['execution'] &gt; 100 else ''" t-esc="'{:,.2f}%'.format(cell['execution'])"/>
                                        </t>
                                        <td class="execution" t-att-style="'color: #aa2222;' if report_data['annual_total']['execution'] &gt; 100 else ''" t-esc="'{:,.2f}%'.format(report_data['annual_total']['execution'])"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="report-note">
                            La columna sin título muestra el porcentaje de <strong>ejecución</strong>
                            (Gasto / Presupuesto × 100); no representa el saldo restante.
                            El porcentaje anual se calcula como gasto total del año / presupuesto total del año × 100.
                            Los guiones indican meses sin proyección cargada para la cuenta.
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_expense_budget_annual" model="ir.actions.report">
        <field name="name">Presupuesto anual por rubro y cuenta</field>
        <field name="model">expense.budget</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">expense_budget_control.report_annual_budget_document</field>
        <field name="report_file">expense_budget_control.report_annual_budget_document</field>
        <field name="paperformat_id" ref="paperformat_expense_budget_a4_landscape"/>
        <field name="binding_model_id" ref="model_expense_budget"/>
        <field name="binding_type">report</field>
        <field name="groups_id" eval="[(6, 0, [ref('expense_budget_control.group_expense_budget_read')])]"/>
        <field name="print_report_name">'Presupuesto_%s_%s' % (object.year, object.company_id.name.replace(' ', '_'))</field>
    </record>
</odoo>
