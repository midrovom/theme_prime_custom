<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formato propio del comparativo; no altera el PDF anual de 12 meses. -->
    <record id="paperformat_expense_budget_comparison" model="report.paperformat">
        <field name="name">Proyectado vs. real - A4 horizontal</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">45</field>
        <field name="margin_bottom">16</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">18</field>
        <field name="dpi">90</field>
    </record>

    <template id="report_comparison_document">
        <t t-call="web.html_container">
            <t t-foreach="reports" t-as="data">
                <t t-set="o" t-value="data['wizard']"/>
                <t t-call="web.external_layout">
                    <div class="page expense-comparison-report">
                        <style type="text/css">
                            .expense-comparison-report { font-family: Arial, sans-serif; color: #233747; }
                            .expense-comparison-report h2 { font-size: 18px; font-weight: bold; margin: 5px 0 9px; }
                            .expense-comparison-report .meta { font-size: 10px; line-height: 1.5; margin-bottom: 12px; }
                            .expense-comparison-report table {
                                width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 9px;
                            }
                            .expense-comparison-report th, .expense-comparison-report td {
                                border-bottom: 1px solid #dde4e9; padding: 7px 5px;
                                vertical-align: middle; word-wrap: break-word;
                            }
                            .expense-comparison-report thead th {
                                background-color: #24445c; color: white; font-size: 8.8px;
                                font-weight: bold; text-align: left; border-bottom: 1px solid #24445c;
                            }
                            .expense-comparison-report td.amount, .expense-comparison-report th.amount {
                                text-align: right; white-space: nowrap;
                            }
                            .expense-comparison-report .category-row td {
                                background: #dbe9f2; font-weight: bold; border-top: 2px solid #899fac;
                            }
                            .expense-comparison-report .account-row td {
                                background: #edf4f8; font-weight: bold;
                            }
                            .expense-comparison-report .category-name { padding-left: 7px; }
                            .expense-comparison-report .account-name { padding-left: 26px; }
                            .expense-comparison-report .detail-row td { background: white; }
                            .expense-comparison-report .detail-row:nth-child(even) td { background: #fafcfd; }
                            .expense-comparison-report .grand-total td {
                                background: #d1e0eb; font-weight: bold; border-top: 2px solid #24445c;
                            }
                            .expense-comparison-report .empty { padding: 18px; text-align: center; }
                            .expense-comparison-report tr { page-break-inside: avoid; }
                            .expense-comparison-report thead { display: table-header-group; }
                            @media screen { .expense-comparison-report .table-scroll { overflow-x: auto; } }
                        </style>
                        <h2>Proyectado vs. real</h2>
                        <div class="meta">
                            <strong>Empresa:</strong> <span t-esc="o.company_id.name"/>
                            <span> | </span><strong>Año:</strong> <span t-esc="o.year"/>
                            <span> | </span><strong>Moneda:</strong> <span t-esc="o.company_id.currency_id.name"/>
                            <t t-if="o.category_id">
                                <span> | </span><strong>Rubro:</strong> <span t-esc="o.category_id.name"/>
                            </t>
                            <t t-if="o.account_id">
                                <span> | </span><strong>Cuenta:</strong> <span t-esc="o.account_id.name"/>
                            </t>
                        </div>
                        <div class="table-scroll">
                            <table>
                                <colgroup>
                                    <col style="width: 13%;"/>
                                    <col style="width: 12%;"/>
                                    <col style="width: 13%;"/>
                                    <col style="width: 13%;"/>
                                    <col style="width: 8%;"/>
                                    <col style="width: 10%;"/>
                                    <col style="width: 10%;"/>
                                    <col style="width: 10%;"/>
                                    <col style="width: 11%;"/>
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th>Presupuesto</th>
                                        <th>Empresa</th>
                                        <th>Cuenta controlada</th>
                                        <th>Rubro</th>
                                        <th>Año</th>
                                        <th class="amount">Proyectado</th>
                                        <th class="amount">Consumido</th>
                                        <th class="amount">Disponible</th>
                                        <th class="amount">Ejecución (%)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="not data['categories']">
                                        <tr><td colspan="9" class="empty">No existen proyecciones visibles para los filtros seleccionados.</td></tr>
                                    </t>
                                    <t t-foreach="data['categories']" t-as="group">
                                        <tr class="category-row">
                                            <td colspan="5" class="category-name">
                                                <span t-esc="group['category'].name"/>
                                                <span> (</span><span t-esc="group['line_count']"/><span>)</span>
                                            </td>
                                            <td class="amount" t-esc="'{:,.2f}'.format(group['total']['planned'])"/>
                                            <td class="amount" t-esc="'{:,.2f}'.format(group['total']['actual'])"/>
                                            <td class="amount" t-esc="'{:,.2f}'.format(group['total']['available'])"/>
                                            <td class="amount" t-esc="'{:.2f}'.format(group['total']['execution'])"/>
                                        </tr>
                                        <t t-foreach="group['accounts']" t-as="account">
                                            <tr class="account-row">
                                                <td colspan="5" class="account-name">
                                                    <span t-esc="account['account'].name"/>
                                                    <span> (</span><span t-esc="account['line_count']"/><span>)</span>
                                                </td>
                                                <td class="amount" t-esc="'{:,.2f}'.format(account['total']['planned'])"/>
                                                <td class="amount" t-esc="'{:,.2f}'.format(account['total']['actual'])"/>
                                                <td class="amount" t-esc="'{:,.2f}'.format(account['total']['available'])"/>
                                                <td class="amount" t-esc="'{:.2f}'.format(account['total']['execution'])"/>
                                            </tr>
                                            <t t-foreach="account['lines']" t-as="detail">
                                                <tr class="detail-row">
                                                    <td t-esc="detail['line'].budget_id.name"/>
                                                    <td t-esc="detail['line'].company_id.name"/>
                                                    <td t-esc="detail['line'].account_id.name"/>
                                                    <td t-esc="detail['line'].account_id.category_id.name"/>
                                                    <td t-esc="detail['line'].budget_id.year"/>
                                                    <td class="amount" t-esc="'{:,.2f}'.format(detail['line'].planned_amount)"/>
                                                    <td class="amount" t-esc="'{:,.2f}'.format(detail['line'].actual_amount)"/>
                                                    <td class="amount" t-esc="'{:,.2f}'.format(detail['line'].variance_amount)"/>
                                                    <td class="amount" t-esc="'{:.2f}'.format(detail['line'].execution_percentage)"/>
                                                </tr>
                                            </t>
                                        </t>
                                    </t>
                                    <t t-if="data['categories']">
                                        <tr class="grand-total">
                                            <td colspan="5">TOTAL GENERAL</td>
                                            <td class="amount" t-esc="'{:,.2f}'.format(data['grand_total']['planned'])"/>
                                            <td class="amount" t-esc="'{:,.2f}'.format(data['grand_total']['actual'])"/>
                                            <td class="amount" t-esc="'{:,.2f}'.format(data['grand_total']['available'])"/>
                                            <td class="amount" t-esc="'{:.2f}'.format(data['grand_total']['execution'])"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_expense_budget_comparison" model="ir.actions.report">
        <field name="name">Proyectado vs. real por rubro y cuenta</field>
        <field name="model">expense.budget.comparison.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">expense_budget_control.report_comparison_document</field>
        <field name="report_file">expense_budget_control.report_comparison_document</field>
        <field name="paperformat_id" ref="paperformat_expense_budget_comparison"/>
        <field name="groups_id" eval="[(6, 0, [ref('expense_budget_control.group_expense_budget_user'), ref('expense_budget_control.group_expense_budget_approver'), ref('expense_budget_control.group_expense_budget_manager')])]"/>
        <field name="print_report_name">'Comparativo_%s_%s' % (object.year, object.company_id.name.replace(' ', '_'))</field>
    </record>
</odoo>
