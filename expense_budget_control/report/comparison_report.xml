<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tres meses por página A3 para conservar legibilidad con 5 columnas/mes. -->
    <record id="paperformat_expense_budget_comparison" model="report.paperformat">
        <field name="name">Proyectado vs. real - A3 horizontal mensual</field>
        <field name="default" eval="False"/>
        <field name="format">A3</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">45</field>
        <field name="margin_bottom">16</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">18</field>
        <field name="dpi">90</field>
    </record>

    <!-- Fila reutilizable: mes, saldo inicial y saldos acumulados. -->
    <template id="report_comparison_monthly_row">
        <tr t-att-class="row_class">
            <td class="row-name" t-esc="row_name"/>
            <t t-if="page_data['opening']">
                <td class="amount opening" t-esc="'{:,.2f}'.format(row_data['monthly_report']['openings'][page_data['first_month']])"/>
            </t>
            <t t-foreach="page_data['months']" t-as="month_item">
                <t t-set="cell" t-value="row_data['monthly_report']['cells'][month_item['number']]"/>
                <td class="amount" t-esc="'{:,.2f}'.format(cell['planned'])"/>
                <td class="amount" t-esc="'{:,.2f}'.format(cell['actual'])"/>
                <td class="amount" t-esc="'{:,.2f}'.format(cell['available'])"/>
                <td class="amount" t-esc="'{:,.2f}'.format(cell['saldo_actual'])"/>
                <td class="amount balance" t-esc="'{:,.2f}'.format(cell['saldo_disponible'])"/>
            </t>
        </tr>
    </template>

    <template id="report_comparison_document">
        <t t-call="web.html_container">
            <t t-foreach="reports" t-as="data">
                <t t-set="o" t-value="data['wizard']"/>
                <t t-call="web.external_layout">
                    <t t-foreach="data['pages']" t-as="page_data">
                        <div class="page expense-comparison-monthly">
                            <style type="text/css">
                                .expense-comparison-monthly { color: #233747; font-family: Arial, sans-serif; }
                                .expense-comparison-monthly h2 { font-size: 18px; margin: 5px 0 8px; }
                                .expense-comparison-monthly .meta { font-size: 10px; margin: 0 0 12px; }
                                .expense-comparison-monthly table { border-collapse: collapse; table-layout: fixed; width: 100%; font-size: 8px; }
                                .expense-comparison-monthly th, .expense-comparison-monthly td { border: 1px solid #d5e0e8; padding: 6px 4px; overflow-wrap: normal; }
                                .expense-comparison-monthly th { color: white; background: #24445c; font-size: 8px; text-align: center; white-space: nowrap; }
                                .expense-comparison-monthly th.month-head { font-size: 10px; background: #17364b; }
                                .expense-comparison-monthly .row-name { text-align: left; }
                                .expense-comparison-monthly .amount { text-align: right; white-space: nowrap; }
                                .expense-comparison-monthly .opening { background: #f4f0df; }
                                .expense-comparison-monthly .balance { background: #edf5f0; }
                                .expense-comparison-monthly .category-row td { background: #dbe9f2; font-weight: bold; }
                                .expense-comparison-monthly .account-row td { background: #edf4f8; font-weight: bold; }
                                .expense-comparison-monthly .budget-row .row-name { padding-left: 21px; }
                                .expense-comparison-monthly .grand-row td { background: #d1e0eb; font-weight: bold; }
                                .expense-comparison-monthly tr { page-break-inside: avoid; }
                                .expense-comparison-monthly thead { display: table-header-group; }
                                @media screen { .expense-comparison-monthly .table-scroll { overflow-x: auto; } }
                            </style>
                            <h2>Proyectado vs. real — comparativo mensual</h2>
                            <div class="meta">
                                <strong>Empresa:</strong> <span t-esc="o.company_id.name"/>
                                <span> | </span><strong>Año:</strong> <span t-esc="o.year"/>
                                <span> | </span><strong>Moneda:</strong> <span t-esc="o.company_id.currency_id.name"/>
                                <t t-if="o.category_id">
                                    <span> | </span><strong>Rubro:</strong> <span t-esc="o.category_id.name"/>
                                </t>
                                <t t-if="data['selected_accounts']">
                                    <span> | </span><strong>Cuentas:</strong>
                                    <span t-esc="', '.join(data['selected_accounts'].mapped('name'))"/>
                                </t>
                                <span> | </span><strong>Bloque:</strong> <span t-esc="page_data['number']"/> / <span t-esc="len(data['pages'])"/>
                            </div>
                            <div class="table-scroll">
                                <table>
                                    <colgroup>
                                        <col style="width: 17%;"/>
                                        <t t-if="page_data['opening']"><col style="width: 9%;"/></t>
                                        <t t-foreach="page_data['months']" t-as="month_item">
                                            <t t-foreach="range(5)" t-as="cell_idx">
                                                <col t-att-style="'width: %.4f%%;' % ((74.0 if page_data['opening'] else 83.0) / (len(page_data['months']) * 5))"/>
                                            </t>
                                        </t>
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th rowspan="2">Rubro / Cuenta / Presupuesto</th>
                                            <t t-if="page_data['opening']">
                                                <th rowspan="2">Disponible inicial<br/>(hasta <span t-esc="page_data['previous_month_name']"/>)</th>
                                            </t>
                                            <t t-foreach="page_data['months']" t-as="month_item">
                                                <th class="month-head" colspan="5" t-esc="month_item['name']"/>
                                            </t>
                                        </tr>
                                        <tr>
                                            <t t-foreach="page_data['months']" t-as="month_item">
                                                <th>Proyectado</th>
                                                <th>Consumido</th>
                                                <th>Disponible</th>
                                                <th>Saldo actual</th>
                                                <th>Saldo disponible</th>
                                            </t>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-if="not data['categories']">
                                            <tr><td t-att-colspan="1 + (1 if page_data['opening'] else 0) + 5 * len(page_data['months'])">No existen proyecciones para los filtros seleccionados.</td></tr>
                                        </t>
                                        <t t-foreach="data['categories']" t-as="group">
                                            <t t-call="expense_budget_control.report_comparison_monthly_row">
                                                <t t-set="row_data" t-value="group"/>
                                                <t t-set="row_class" t-value="'category-row'"/>
                                                <t t-set="row_name" t-value="group['category'].name or 'Sin rubro'"/>
                                            </t>
                                            <t t-if="not data['summary_by_category_only']">
                                                <t t-foreach="group['accounts']" t-as="account">
                                                    <t t-call="expense_budget_control.report_comparison_monthly_row">
                                                        <t t-set="row_data" t-value="account"/>
                                                        <t t-set="row_class" t-value="'account-row'"/>
                                                        <t t-set="row_name" t-value="'  ' + account['account'].name"/>
                                                    </t>
                                                    <t t-foreach="account['budgets']" t-as="budget_row">
                                                        <t t-call="expense_budget_control.report_comparison_monthly_row">
                                                            <t t-set="row_data" t-value="budget_row"/>
                                                            <t t-set="row_class" t-value="'budget-row'"/>
                                                            <t t-set="row_name" t-value="budget_row['budget'].name"/>
                                                        </t>
                                                    </t>
                                                </t>
                                            </t>
                                        </t>
                                        <t t-if="data['categories'] and not data['summary_by_category_only']">
                                            <t t-call="expense_budget_control.report_comparison_monthly_row">
                                                <t t-set="row_data" t-value="data['grand_row']"/>
                                                <t t-set="row_class" t-value="'grand-row'"/>
                                                <t t-set="row_name" t-value="'TOTAL GENERAL'"/>
                                            </t>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            <p style="font-size: 9px; margin-top: 11px;">
                                Saldo actual: consumido acumulado desde enero hasta el mes mostrado.
                                Saldo disponible: proyectado acumulado menos consumido acumulado.
                                Disponible inicial: saldo de los meses anteriores al primer mes de esta página.
                            </p>
                        </div>
                    </t>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_expense_budget_comparison" model="ir.actions.report">
        <field name="name">Proyectado vs. real por rubro y cuenta</field>
        <field name="model">expense.budget.comparison.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">expense_budget_control.report_comparison_document</field>
        <field name="report_file">expense_budget_control.report_comparison_document</field>
        <field name="paperformat_id" ref="paperformat_expense_budget_comparison"/>
        <field name="groups_id" eval="[(6, 0, [ref('expense_budget_control.group_expense_budget_user'), ref('expense_budget_control.group_expense_budget_approver'), ref('expense_budget_control.group_expense_budget_manager')])]"/>
        <field name="print_report_name">'Comparativo_Mensual_%s_%s' % (object.year, object.company_id.name.replace(' ', '_'))</field>
    </record>
</odoo>
