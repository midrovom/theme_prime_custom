<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="expense_budget_control.Dashboard">
        <div class="o_ebd_root">
            <header class="o_ebd_header">
                <div>
                    <h1>Dashboard de gastos</h1>
                    <p>Compara los consumos por centro de costo y cuenta controlada.</p>
                </div>
                <div class="o_ebd_header_actions">
                    <button type="button" class="btn btn-outline-secondary d-lg-none" t-on-click="() => this.openMobileHome()">
                        <i class="fa fa-th-large me-1"/> Opciones
                    </button>
                    <button type="button" class="btn btn-outline-primary" t-on-click="() => this.load()">
                    <i class="fa fa-refresh me-1"/> Actualizar
                    </button>
                </div>
            </header>

            <div t-if="state.error" class="alert alert-danger" role="alert" t-esc="state.error"/>

            <section class="o_ebd_filters" aria-label="Filtros del dashboard">
                <label>Empresa
                    <select class="form-select" t-att-value="state.companyId" t-on-change="onCompanyChange">
                        <t t-foreach="state.data.companies" t-as="company" t-key="company.id">
                            <option t-att-value="company.id" t-esc="company.name"/>
                        </t>
                    </select>
                </label>
                <label>Año
                    <select class="form-select" t-att-value="state.year" t-on-change="onYearChange">
                        <t t-foreach="state.data.years" t-as="year" t-key="year">
                            <option t-att-value="year" t-esc="year"/>
                        </t>
                    </select>
                </label>
                <label>Mes
                    <select class="form-select" t-att-value="state.selectedMonth" t-on-change="onMonthChange">
                        <option value="-1">Todos los meses</option>
                        <t t-foreach="state.data.month_names" t-as="month_name" t-key="month_name_index">
                            <option t-att-value="month_name_index" t-esc="month_name"/>
                        </t>
                    </select>
                </label>
                <label>Centro de costo
                    <select class="form-select" t-att-value="state.costCenterId" t-on-change="onCostCenterChange">
                        <option value="">Todos los centros</option>
                        <t t-foreach="state.data.cost_centers || []" t-as="center" t-key="center.id">
                            <option t-att-value="center.id" t-esc="center.name"/>
                        </t>
                    </select>
                </label>
                <label>Rubro / línea de servicio
                    <select class="form-select" t-att-value="state.categoryId" t-on-change="onCategoryChange">
                        <option value="">Todos los rubros</option>
                        <t t-foreach="state.data.categories" t-as="category" t-key="category.id">
                            <option t-att-value="category.id" t-esc="category.name"/>
                        </t>
                    </select>
                </label>
                <label>Cuenta controlada
                    <select class="form-select" t-att-value="state.accountId" t-on-change="onAccountChange">
                        <option value="">Todas las cuentas</option>
                        <t t-foreach="this.categoryAccounts" t-as="account" t-key="account.id">
                            <option t-att-value="account.id" t-esc="account.name"/>
                        </t>
                    </select>
                </label>
            </section>

            <div t-if="state.loading" class="o_ebd_loading" role="status">Cargando datos de gastos…</div>
            <t t-else="">
                <section class="o_ebd_kpis">
                    <div class="o_ebd_kpi"><span t-esc="this.totalSpentLabel"/><strong t-esc="this.formatMoney(this.totalSpent)"/></div>
                    <div class="o_ebd_kpi"><span>Mes con mayor gasto del año</span><strong t-esc="this.peak.name"/><small t-esc="this.formatMoney(this.peak.amount)"/></div>
                    <div class="o_ebd_kpi"><span>Vista actual</span><strong t-esc="this.scopeName"/><small t-esc="state.year + ' · ' + this.periodName"/></div>
                </section>

                <section class="o_ebd_charts">
                    <div class="o_ebd_panel">
                        <div class="o_ebd_panel_heading o_ebd_chart_heading">
                            <div>
                                <h2 t-esc="this.chartTitle"/>
                                <p t-esc="this.chartHint"/>
                            </div>
                            <label class="o_ebd_chart_mode">Ver como
                                <select class="form-select" t-att-value="state.chartType" t-on-change="onChartTypeChange">
                                    <option value="bar">Barras</option>
                                    <option value="pie">Pastel</option>
                                </select>
                            </label>
                        </div>
                        <t t-if="state.chartType === 'bar'">
                            <div class="o_ebd_grouped_scroll" role="group" aria-label="Gastos de enero a diciembre, agrupados por centro de costo">
                                <div class="o_ebd_grouped_chart">
                                    <t t-foreach="this.monthlyCenterGroups" t-as="month" t-key="month.index">
                                        <div t-att-class="month.muted ? 'o_ebd_month_group is-dimmed' : (month.active ? 'o_ebd_month_group is-selected' : 'o_ebd_month_group')">
                                            <div class="o_ebd_month_center_bars">
                                                <t t-foreach="month.centers" t-as="center" t-key="center.id">
                                                    <button type="button"
                                                            t-att-class="center.selected ? 'o_ebd_center_bar_item is-selected' : 'o_ebd_center_bar_item'"
                                                            t-att-title="month.name + ' · ' + center.name + ': ' + this.formatMoney(center.amount)"
                                                            t-att-aria-label="month.name + ', centro ' + center.name + ', consumido ' + this.formatMoney(center.amount)"
                                                            t-on-click="() => this.selectMonthCenter(month.index, center.id)">
                                                        <span class="o_ebd_center_bar_name" t-esc="center.name"/>
                                                        <span class="o_ebd_bar_space">
                                                            <span t-att-class="center.negative ? 'o_ebd_bar is-negative' : 'o_ebd_bar'" t-att-style="'height:' + center.height"/>
                                                        </span>
                                                    </button>
                                                </t>
                                            </div>
                                            <button type="button" class="o_ebd_group_month_label" t-on-click="() => this.selectMonth(month.index)"
                                                    t-att-title="'Ver consumos de ' + month.name" t-esc="month.short"/>
                                        </div>
                                    </t>
                                </div>
                            </div>
                            <p t-if="!this.monthlyCenterGroups.some(month => month.centers.length)" class="o_ebd_empty">
                                No hay centros con proyecciones para los filtros seleccionados.
                            </p>
                            <p t-elif="!this.monthlyAmounts.some(amount => amount !== 0)" class="o_ebd_empty">
                                No hay consumo registrado para el período y los filtros elegidos.
                            </p>
                        </t>
                        <t t-else="">
                            <t t-if="this.pieSlices.length">
                                <div class="o_ebd_pie_layout">
                                    <svg viewBox="0 0 100 100" width="220" height="220" preserveAspectRatio="xMidYMid meet" class="o_ebd_pie" role="img"
                                         t-att-aria-label="'Distribución del gasto en ' + this.periodName">
                                        <t t-foreach="this.pieSlices" t-as="slice" t-key="slice.id">
                                            <t t-if="slice.full">
                                                <circle cx="50" cy="50" r="45" t-att-fill="slice.color"
                                                        t-on-click="() => this.selectChartGroup(slice.id)">
                                                    <title t-esc="slice.name + ': ' + this.formatMoney(slice.amount)"/>
                                                </circle>
                                            </t>
                                            <t t-else="">
                                                <path t-att-d="slice.path" t-att-fill="slice.color"
                                                      t-on-click="() => this.selectChartGroup(slice.id)">
                                                    <title t-esc="slice.name + ': ' + this.formatMoney(slice.amount)"/>
                                                </path>
                                            </t>
                                        </t>
                                    </svg>
                                    <div class="o_ebd_pie_legend">
                                        <t t-foreach="this.pieSlices" t-as="slice" t-key="slice.id">
                                            <button type="button"
                                                    t-att-class="slice.active ? 'o_ebd_legend_item is-selected' : 'o_ebd_legend_item'"
                                                    t-on-click="() => this.selectChartGroup(slice.id)">
                                                <span class="o_ebd_dot" t-att-style="'background-color:' + slice.color"/>
                                                <span t-esc="slice.name"/>
                                                <strong t-esc="slice.percentage + '%'"/>
                                            </button>
                                        </t>
                                    </div>
                                </div>
                            </t>
                            <p t-else="" class="o_ebd_empty"><t t-esc="this.pieEmptyMessage"/></p>
                        </t>
                    </div>
                </section>

                <section class="o_ebd_panel o_ebd_detail">
                    <div class="o_ebd_panel_heading">
                        <div>
                            <h2>Detalle por cuenta controlada · <t t-esc="this.periodName"/></h2>
                            <p>Importes correspondientes únicamente a los filtros seleccionados</p>
                        </div>
                    </div>
                    <div class="o_ebd_detail_table">
                        <table class="table table-sm">
                            <thead><tr><th>Cuenta controlada</th><th class="text-end">Consumido</th></tr></thead>
                            <tbody>
                                <t t-foreach="this.accountDetail" t-as="line" t-key="line.id">
                                    <tr><td t-esc="line.name"/><td class="text-end" t-esc="this.formatMoney(line.amount)"/></tr>
                                </t>
                                <tr t-if="!this.accountDetail.length"><td colspan="2">Sin cuentas para este filtro.</td></tr>
                            </tbody>
                            <tfoot>
                                <tr><th>TOTAL</th><th class="text-end" t-esc="this.formatMoney(this.totalSpent)"/></tr>
                            </tfoot>
                        </table>
                    </div>
                </section>
            </t>
        </div>
    </t>
</templates>
