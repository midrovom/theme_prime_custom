<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="module_category_expense_budget" model="ir.module.category">
        <field name="name">Control de presupuestos de gastos</field>
        <field name="description">Acceso al presupuesto de gastos</field>
        <field name="sequence">42</field>
    </record>
    <record id="group_expense_budget_read" model="res.groups">
        <field name="name">Lectura interna de presupuestos</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>
    <record id="group_expense_budget_user" model="res.groups">
        <field name="name">Consulta de presupuestos</field>
        <field name="category_id" ref="module_category_expense_budget"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_expense_budget_read')])]"/>
    </record>
    <record id="group_expense_budget_registrar" model="res.groups">
        <field name="name">Registro de presupuestos</field>
        <field name="category_id" ref="module_category_expense_budget"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_expense_budget_read')])]"/>
    </record>
    <record id="group_expense_budget_approver" model="res.groups">
        <field name="name">Aprobador de presupuestos</field>
        <field name="category_id" ref="module_category_expense_budget"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_expense_budget_read')])]"/>
    </record>
    <record id="group_expense_budget_manager" model="res.groups">
        <field name="name">Administrador de presupuestos</field>
        <field name="category_id" ref="module_category_expense_budget"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_expense_budget_read')])]"/>
    </record>
    <!--El administrador gestiona registros de todas las empresas en este módulo; otros roles conservan su filtro company_ids.--><record id="category_company_rule" model="ir.rule">
        <field name="name">Rubros: empresas autorizadas</field>
        <field name="model_id" ref="model_expense_budget_category"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('expense_budget_control.group_expense_budget_manager') else [('company_id', 'in', company_ids)]</field>
    </record>
    <record id="account_company_rule" model="ir.rule">
        <field name="name">Cuentas: empresas autorizadas</field>
        <field name="model_id" ref="model_expense_budget_account"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('expense_budget_control.group_expense_budget_manager') else [('company_id', 'in', company_ids)]</field>
    </record>
    <record id="cost_center_company_rule" model="ir.rule">
        <field name="name">Centros de costo: empresas autorizadas</field>
        <field name="model_id" ref="model_expense_budget_cost_center"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('expense_budget_control.group_expense_budget_manager') else [('company_id', 'in', company_ids)]</field>
    </record>
    <record id="subcenter_company_rule" model="ir.rule">
        <field name="name">Subcentros ERP: empresas autorizadas</field>
        <field name="model_id" ref="model_expense_budget_subcenter"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('expense_budget_control.group_expense_budget_manager') else [('company_id', 'in', company_ids)]</field>
    </record>
    <record id="cost_center_api_company_rule" model="ir.rule">
        <field name="name">API centros de costo: empresas autorizadas</field>
        <field name="model_id" ref="model_expense_budget_cost_center_api_config"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('expense_budget_control.group_expense_budget_manager') else [('company_id', 'in', company_ids)]</field>
    </record>
    <record id="budget_company_rule" model="ir.rule">
        <field name="name">Presupuestos: empresas autorizadas</field>
        <field name="model_id" ref="model_expense_budget"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('expense_budget_control.group_expense_budget_manager') else [('company_id', 'in', company_ids)]</field>
    </record>
    <record id="line_company_rule" model="ir.rule">
        <field name="name">Líneas: empresas autorizadas</field>
        <field name="model_id" ref="model_expense_budget_line"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('expense_budget_control.group_expense_budget_manager') else [('company_id', 'in', company_ids)]</field>
    </record>
    <!-- El aprobador solo lee presupuestos enviados o aprobados, incluso
         si intenta entrar por URL, búsquedas o el formulario de líneas. -->
    <record id="budget_approver_visible_states_rule" model="ir.rule">
        <field name="name">Presupuestos: aprobador solo pendientes, aprobados o rechazados</field>
        <field name="model_id" ref="model_expense_budget"/>
        <field name="groups" eval="[(4, ref('group_expense_budget_approver'))]"/>
        <field name="domain_force">[('state', 'in', ('to_approve', 'approved', 'rejected'))]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="line_approver_visible_states_rule" model="ir.rule">
        <field name="name">Proyecciones: aprobador solo pendientes, aprobadas o rechazadas</field>
        <field name="model_id" ref="model_expense_budget_line"/>
        <field name="groups" eval="[(4, ref('group_expense_budget_approver'))]"/>
        <field name="domain_force">[('budget_id.state', 'in', ('to_approve', 'approved', 'rejected'))]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <!-- Si un administrador también pertenece al grupo Aprobador, sus
         permisos de lectura completos se conservan. -->
    <record id="budget_manager_full_read_rule" model="ir.rule">
        <field name="name">Presupuestos: administrador lectura completa</field>
        <field name="model_id" ref="model_expense_budget"/>
        <field name="groups" eval="[(4, ref('group_expense_budget_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="line_manager_full_read_rule" model="ir.rule">
        <field name="name">Proyecciones: administrador lectura completa</field>
        <field name="model_id" ref="model_expense_budget_line"/>
        <field name="groups" eval="[(4, ref('group_expense_budget_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="expense_company_rule" model="ir.rule">
        <field name="name">Gastos: empresas autorizadas</field>
        <field name="model_id" ref="model_expense_budget_expense"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('expense_budget_control.group_expense_budget_manager') else [('company_id', 'in', company_ids)]</field>
    </record>
    <record id="api_config_company_rule" model="ir.rule">
        <field name="name">API de gastos: empresas autorizadas</field>
        <field name="model_id" ref="model_expense_budget_api_config"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('expense_budget_control.group_expense_budget_manager') else [('company_id', 'in', company_ids)]</field>
    </record>
    <record id="sync_log_company_rule" model="ir.rule">
        <field name="name">Historial API: empresas autorizadas</field>
        <field name="model_id" ref="model_expense_budget_sync_log"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('expense_budget_control.group_expense_budget_manager') else [('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
