<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_expense_budget" model="ir.module.category">
        <field name="name">Control de presupuestos de gastos</field>
        <field name="description">Acceso al presupuesto de gastos</field>
        <field name="sequence">42</field>
    </record>
    <record id="group_expense_budget_user" model="res.groups">
        <field name="name">Consulta de presupuestos</field>
        <field name="category_id" ref="module_category_expense_budget"/>
    </record>
    <record id="group_expense_budget_registrar" model="res.groups">
        <field name="name">Registro de presupuestos</field>
        <field name="category_id" ref="module_category_expense_budget"/>
        <field name="implied_ids" eval="[(4, ref('group_expense_budget_user'))]"/>
    </record>
    <record id="group_expense_budget_approver" model="res.groups">
        <field name="name">Aprobador de presupuestos</field>
        <field name="category_id" ref="module_category_expense_budget"/>
        <field name="implied_ids" eval="[(4, ref('group_expense_budget_user'))]"/>
    </record>
    <record id="group_expense_budget_manager" model="res.groups">
        <field name="name">Administrador de presupuestos</field>
        <field name="category_id" ref="module_category_expense_budget"/>
        <field name="implied_ids" eval="[(4, ref('group_expense_budget_user'))]"/>
    </record>

    <record id="category_company_rule" model="ir.rule">
        <field name="name">Rubros: empresas autorizadas</field>
        <field name="model_id" ref="model_expense_budget_category"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="account_company_rule" model="ir.rule">
        <field name="name">Cuentas: empresas autorizadas</field>
        <field name="model_id" ref="model_expense_budget_account"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="budget_company_rule" model="ir.rule">
        <field name="name">Presupuestos: empresas autorizadas</field>
        <field name="model_id" ref="model_expense_budget"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="line_company_rule" model="ir.rule">
        <field name="name">Líneas: empresas autorizadas</field>
        <field name="model_id" ref="model_expense_budget_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="expense_company_rule" model="ir.rule">
        <field name="name">Gastos: empresas autorizadas</field>
        <field name="model_id" ref="model_expense_budget_expense"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="api_config_company_rule" model="ir.rule">
        <field name="name">API de gastos: empresas autorizadas</field>
        <field name="model_id" ref="model_expense_budget_api_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="sync_log_company_rule" model="ir.rule">
        <field name="name">Historial API: empresas autorizadas</field>
        <field name="model_id" ref="model_expense_budget_sync_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
