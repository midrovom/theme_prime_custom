<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
    <record id="ir_cron_expense_budget_sync" model="ir.cron">
        <field name="name">Presupuestos: importar gastos desde API</field>
        <field name="model_id" ref="model_expense_budget"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="state">code</field>
        <field name="code">model.cron_sync_all()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="False"/>
    </record>
    <!-- Tarea activa: conserva y actualiza movimientos de todos los años por empresa. -->
    <record id="ir_cron_expense_budget_erp_five_hours" model="ir.cron">
        <field name="name">Presupuestos: cuentas, centros y consumos ERP (5 horas)</field>
        <field name="model_id" ref="model_expense_budget"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="state">code</field>
        <field name="code">model.env['expense.budget.inventory.sync'].cron_sync_every_5h()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
    </data>
</odoo>
