<odoo>
    <record id="view_commission_seller_list" model="ir.ui.view">
        <field name="name">commission.seller.list</field>
        <field name="model">commission.seller</field>
        <field name="arch" type="xml">
            <list string="Vendedores">
                <field name="code"/>
                <field name="name"/>
                <field name="role"/>
                <field name="manager_id"/>
                <field name="default_location_id"/>
                <field name="created_from_sales" optional="hide"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_commission_seller_form" model="ir.ui.view">
        <field name="name">commission.seller.form</field>
        <field name="model">commission.seller</field>
        <field name="arch" type="xml">
            <form string="Vendedor">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="role"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="manager_id"/>
                            <field name="default_location_id"/>
                            <field name="created_from_sales" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_commission_seller" model="ir.actions.act_window">
        <field name="name">Vendedores</field>
        <field name="res_model">commission.seller</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_commission_location_list" model="ir.ui.view">
        <field name="name">commission.location.list</field>
        <field name="model">commission.location</field>
        <field name="arch" type="xml">
            <list string="Localidades">
                <field name="code"/>
                <field name="name"/>
                <field name="created_from_sales" optional="hide"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_commission_location_form" model="ir.ui.view">
        <field name="name">commission.location.form</field>
        <field name="model">commission.location</field>
        <field name="arch" type="xml">
            <form string="Localidad">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="created_from_sales" readonly="1"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_commission_location" model="ir.actions.act_window">
        <field name="name">Localidades</field>
        <field name="res_model">commission.location</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_commission_document_type_list" model="ir.ui.view">
        <field name="name">commission.document.type.list</field>
        <field name="model">commission.document.type</field>
        <field name="arch" type="xml">
            <list string="Tipos de documento">
                <field name="code"/>
                <field name="name"/>
                <field name="sign"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_commission_document_type_form" model="ir.ui.view">
        <field name="name">commission.document.type.form</field>
        <field name="model">commission.document.type</field>
        <field name="arch" type="xml">
            <form string="Tipo de documento">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="sign"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_commission_document_type" model="ir.actions.act_window">
        <field name="name">Tipos de documento</field>
        <field name="res_model">commission.document.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
