<odoo>
    <record id="view_commission_result_list" model="ir.ui.view">
        <field name="name">commission.result.list</field>
        <field name="model">commission.result</field>
        <field name="arch" type="xml">
            <list string="Resultados" create="0" delete="0">
                <field name="seller_id"/>
                <field name="role"/>
                <field name="sale_line_count"/>
                <field name="total_sales" sum="Total"/>
                <field name="target_amount" sum="Total"/>
                <field name="achievement_percent"/>
                <field name="standard_commission" sum="Total"/>
                <field name="project_commission" sum="Total"/>
                <field name="management_commission" sum="Total"/>
                <field name="liquidation_bonus" sum="Total"/>
                <field name="total_commission" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_commission_result_form" model="ir.ui.view">
        <field name="name">commission.result.form</field>
        <field name="model">commission.result</field>
        <field name="arch" type="xml">
            <form string="Resultado de comisión" create="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="seller_id" readonly="1"/>
                            <field name="role" readonly="1"/>
                            <field name="sale_line_count" readonly="1"/>
                            <field name="total_sales" readonly="1"/>
                        </group>
                        <group>
                            <field name="target_amount" readonly="1"/>
                            <field name="standard_sales" readonly="1"/>
                            <field name="achievement_percent" readonly="1"/>
                            <field name="total_commission" readonly="1" class="oe_inline"/>
                        </group>
                    </group>
                    <group string="Componentes">
                        <group>
                            <field name="standard_commission" readonly="1"/>
                            <field name="project_sales" readonly="1"/>
                            <field name="project_commission" readonly="1"/>
                        </group>
                        <group>
                            <field name="management_sales" readonly="1"/>
                            <field name="management_commission" readonly="1"/>
                            <field name="liquidation_sales" readonly="1"/>
                            <field name="liquidation_m2" readonly="1"/>
                            <field name="liquidation_bonus" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Auditoría de cálculo"/>
                    <field name="detail_ids" readonly="1">
                        <list>
                            <field name="detail_type"/>
                            <field name="description"/>
                            <field name="managed_seller_id"/>
                            <field name="location_id"/>
                            <field name="basis_amount"/>
                            <field name="quantity"/>
                            <field name="rate"/>
                            <field name="eligible"/>
                            <field name="amount"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_commission_settlement_list" model="ir.ui.view">
        <field name="name">commission.settlement.list</field>
        <field name="model">commission.settlement</field>
        <field name="arch" type="xml">
            <list string="Liquidaciones" create="0">
                <field name="name"/>
                <field name="period_id"/>
                <field name="state" widget="badge"/>
                <field name="calculated_at"/>
                <field name="sales_count"/>
                <field name="total_sales" sum="Total"/>
                <field name="total_commission" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_commission_settlement_form" model="ir.ui.view">
        <field name="name">commission.settlement.form</field>
        <field name="model">commission.settlement</field>
        <field name="arch" type="xml">
            <form string="Liquidación" create="0" delete="0">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,calculated,approved,paid"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="period_id" readonly="1"/>
                            <field name="calculated_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="sales_count" readonly="1"/>
                            <field name="total_sales" readonly="1"/>
                            <field name="total_commission" readonly="1"/>
                        </group>
                    </group>
                    <field name="result_ids" readonly="1">
                        <list>
                            <field name="seller_id"/>
                            <field name="role"/>
                            <field name="total_sales"/>
                            <field name="target_amount"/>
                            <field name="achievement_percent"/>
                            <field name="standard_commission"/>
                            <field name="project_commission"/>
                            <field name="management_commission"/>
                            <field name="liquidation_bonus"/>
                            <field name="total_commission"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_commission_settlement" model="ir.actions.act_window">
        <field name="name">Liquidaciones</field>
        <field name="res_model">commission.settlement</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_commission_result" model="ir.actions.act_window">
        <field name="name">Resultados por vendedor</field>
        <field name="res_model">commission.result</field>
        <field name="view_mode">list,form,pivot,graph</field>
    </record>
</odoo>
