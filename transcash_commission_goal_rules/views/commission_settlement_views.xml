<odoo>
    <record id="view_commission_settlement_form_goal_rules" model="ir.ui.view">
        <field name="name">commission.settlement.form.goal.rules</field>
        <field name="model">commission.settlement</field>
        <field name="inherit_id" ref="transcash_commission.view_commission_settlement_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header/field[@name='state']" position="before">
                <button name="action_print_settlement"
                        type="object"
                        string="Imprimir liquidación total"
                        class="btn-secondary"
                        invisible="state == 'draft'"/>
            </xpath>
            <xpath expr="//field[@name='result_ids']//field[@name='liquidation_bonus']" position="after">
                <field name="liquidation_penalty" sum="Reducción monetaria total"/>
            </xpath>
        </field>
    </record>

    <record id="view_commission_result_form_goal_rules" model="ir.ui.view">
        <field name="name">commission.result.form.goal.rules</field>
        <field name="model">commission.result</field>
        <field name="inherit_id" ref="transcash_commission.view_commission_result_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="before">
                <header>
                    <button name="action_print_individual"
                            type="object"
                            string="Imprimir liquidación individual"
                            class="btn-secondary"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='liquidation_bonus']" position="after">
                <field name="liquidation_target_met" readonly="1"/>
                <field name="liquidation_penalty_base" readonly="1"/>
                <field name="liquidation_rate_reduction" readonly="1"/>
                <field name="liquidation_penalty" readonly="1"/>
                <field name="liquidation_penalty_applied" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_commission_result_list_goal_rules_penalty" model="ir.ui.view">
        <field name="name">commission.result.list.goal.rules.penalty</field>
        <field name="model">commission.result</field>
        <field name="inherit_id" ref="transcash_commission.view_commission_result_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='liquidation_bonus']" position="after">
                <field name="liquidation_penalty" sum="Reducción monetaria total"/>
            </xpath>
        </field>
    </record>

</odoo>
