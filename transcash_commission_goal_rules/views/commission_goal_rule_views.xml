<odoo>
    <record id="view_commission_seller_target_list_goal_rules" model="ir.ui.view">
        <field name="name">commission.seller.target.list.goal.rules</field>
        <field name="model">commission.seller.target</field>
        <field name="inherit_id" ref="transcash_commission.view_commission_seller_target_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_id']" position="replace"/>
            <xpath expr="//field[@name='target_amount']" position="after">
                <field name="calculation_mode"/>
                <field name="minimum_achievement" optional="show"/>
                <field name="full_commission_percent" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_commission_seller_target_form_goal_rules" model="ir.ui.view">
        <field name="name">commission.seller.target.form.goal.rules</field>
        <field name="model">commission.seller.target</field>
        <field name="inherit_id" ref="transcash_commission.view_commission_seller_target_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="duplicate">false</attribute>
            </xpath>
            <xpath expr="//field[@name='location_id']" position="replace"/>
            <xpath expr="//field[@name='target_amount']" position="after">
                <field name="calculation_mode"/>
                <field name="minimum_achievement" invisible="calculation_mode != 'proportional'"/>
                <field name="full_commission_percent" invisible="calculation_mode != 'proportional'"/>
            </xpath>
            <xpath expr="//separator[@string='Rangos de cumplimiento']" position="attributes">
                <attribute name="invisible">calculation_mode == 'proportional'</attribute>
            </xpath>
            <xpath expr="//field[@name='tier_ids']" position="attributes">
                <attribute name="invisible">calculation_mode == 'proportional'</attribute>
            </xpath>
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_open_copy_wizard" type="object" string="Duplicar a otro período" class="btn-secondary"/>
                </header>
            </xpath>
        </field>
    </record>

    <record id="view_commission_location_target_form_goal_rules" model="ir.ui.view">
        <field name="name">commission.location.target.form.goal.rules</field>
        <field name="model">commission.location.target</field>
        <field name="inherit_id" ref="transcash_commission.view_commission_location_target_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="duplicate">false</attribute>
            </xpath>
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_open_copy_wizard" type="object" string="Duplicar a otro período" class="btn-secondary"/>
                </header>
            </xpath>
        </field>
    </record>

    <record id="view_commission_manager_goal_rule_list" model="ir.ui.view">
        <field name="name">commission.manager.goal.rule.list</field>
        <field name="model">commission.manager.goal.rule</field>
        <field name="arch" type="xml">
            <list string="Gestión de comisiones de administradores">
                <field name="period_id"/>
                <field name="manager_id"/>
                <field name="location_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_commission_manager_goal_rule_form" model="ir.ui.view">
        <field name="name">commission.manager.goal.rule.form</field>
        <field name="model">commission.manager.goal.rule</field>
        <field name="arch" type="xml">
            <form string="Gestión de comisión de administrador" duplicate="false">
                <header>
                    <button name="action_load_related_sellers" type="object" string="Cargar vendedores relacionados" class="btn-secondary" invisible="not manager_id"/>
                    <button name="action_open_copy_wizard" type="object" string="Duplicar a otro período" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <group string="Administrador">
                            <field name="period_id"/>
                            <field name="manager_id"/>
                        </group>
                        <group string="Condición del local">
                            <field name="location_id"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <separator string="Vendedores a cargo"/>
                    <field name="line_ids" context="{'default_management_id': id, 'default_period_id': period_id, 'default_manager_id': manager_id, 'default_location_id': location_id}">
                        <list editable="bottom">
                            <field name="seller_id"/>
                            <field name="minimum_type"/>
                            <field name="minimum_amount" invisible="minimum_type != 'fixed'"/>
                            <field name="minimum_target_percent" invisible="minimum_type != 'target_percent'"/>
                            <field name="seller_target_amount" readonly="1" optional="show"/>
                            <field name="effective_minimum" readonly="1"/>
                            <field name="commission_percent"/>
                            <field name="basis" optional="show"/>
                            <field name="active"/>
                        </list>
                    </field>

                    <div class="alert alert-info mt-2" role="alert">
                        Al seleccionar el administrador se cargan automáticamente los vendedores relacionados en su maestro. Cada vendedor conserva su propio mínimo y porcentaje de comisión. El local seleccionado debe cumplir su meta para habilitar el pago de gestión.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_commission_manager_goal_rule" model="ir.actions.act_window">
        <field name="name">Gestión de comisiones de administradores</field>
        <field name="res_model">commission.manager.goal.rule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>
    <record id="view_commission_project_rule_form_goal_rules" model="ir.ui.view">
        <field name="name">commission.project.rule.form.goal.rules</field>
        <field name="model">commission.project.rule</field>
        <field name="inherit_id" ref="transcash_commission.view_commission_project_rule_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="duplicate">false</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_commission_liquidation_rule_form_goal_rules" model="ir.ui.view">
        <field name="name">commission.liquidation.rule.form.goal.rules</field>
        <field name="model">commission.liquidation.rule</field>
        <field name="inherit_id" ref="transcash_commission.view_commission_liquidation_rule_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="duplicate">false</attribute>
            </xpath>
        </field>
    </record>

</odoo>
