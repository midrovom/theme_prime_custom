<odoo>
    <record id="view_commission_client_search" model="ir.ui.view">
        <field name="name">commission.client.search</field>
        <field name="model">commission.client</field>
        <field name="arch" type="xml">
            <search string="Clientes de comisiones">
                <field name="name"/>
                <filter name="active" string="Activos" domain="[('active', '=', True)]"/>
                <filter name="from_sales" string="Creados desde ventas" domain="[('created_from_sales', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="view_commission_client_list" model="ir.ui.view">
        <field name="name">commission.client.list</field>
        <field name="model">commission.client</field>
        <field name="arch" type="xml">
            <list string="Clientes de comisiones">
                <field name="name"/>
                <field name="created_from_sales"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_commission_client_form" model="ir.ui.view">
        <field name="name">commission.client.form</field>
        <field name="model">commission.client</field>
        <field name="arch" type="xml">
            <form string="Cliente de comisiones">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="normalized_name" readonly="1"/>
                        <field name="created_from_sales" readonly="1"/>
                        <field name="active"/>
                    </group>
                    <field name="notes" placeholder="Observaciones..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_commission_client" model="ir.actions.act_window">
        <field name="name">Clientes</field>
        <field name="res_model">commission.client</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_commission_client_search"/>
    </record>

    <menuitem id="menu_commission_client"
              name="Clientes"
              parent="transcash_commission.menu_commission_configuration"
              action="action_commission_client"
              sequence="25"
              groups="transcash_commission.group_commission_manager"/>
</odoo>
