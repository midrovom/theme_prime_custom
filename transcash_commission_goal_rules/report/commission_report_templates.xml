<odoo>
    <template id="report_commission_settlement_total">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>
                            .tc-title { font-size: 20px; font-weight: 700; margin-bottom: 8px; }
                            .tc-meta { font-size: 11px; margin-bottom: 10px; }
                            .tc-section { font-size: 13px; font-weight: 700; margin: 12px 0 4px 0; padding: 4px 6px; background: #ececec; border-left: 4px solid #777; }
                            .tc-table { width: 100%; border-collapse: collapse; font-size: 8.5px; margin-bottom: 7px; }
                            .tc-table th { background: #eeeeee; font-weight: 700; padding: 5px 3px; border: 1px solid #bdbdbd; }
                            .tc-table td { padding: 4px 3px; border: 1px solid #d5d5d5; }
                            .tc-num { text-align: right; white-space: nowrap; }
                            .tc-total { font-weight: 700; background: #f4f4f4; }
                            .tc-summary { width: 55%; margin: 10px 0 14px auto; border-collapse: collapse; font-size: 10px; }
                            .tc-summary td { border: 1px solid #d5d5d5; padding: 5px; }
                        </style>

                        <div class="tc-title">Liquidación total de comisiones</div>
                        <div class="tc-meta">
                            <strong>Liquidación:</strong> <span t-field="o.name"/>
                            &amp;nbsp;&amp;nbsp; <strong>Período:</strong> <span t-field="o.period_id.name"/>
                            &amp;nbsp;&amp;nbsp; <strong>Desde:</strong> <span t-field="o.period_id.date_start"/>
                            &amp;nbsp;&amp;nbsp; <strong>Hasta:</strong> <span t-field="o.period_id.date_end"/>
                            &amp;nbsp;&amp;nbsp; <strong>Productos promoción:</strong> <span t-esc="o.period_id.promotion_product_count"/>
                            <t t-if="o.calculated_at">
                                &amp;nbsp;&amp;nbsp; <strong>Calculado:</strong> <span t-field="o.calculated_at"/>
                            </t>
                        </div>

                        <table class="tc-summary">
                            <tr>
                                <td><strong>Comisionistas liquidados</strong></td>
                                <td class="tc-num"><span t-esc="len(o.result_ids)"/></td>
                                <td><strong>Líneas de venta</strong></td>
                                <td class="tc-num"><span t-field="o.sales_count"/></td>
                            </tr>
                            <tr>
                                <td><strong>Ventas comisionables</strong></td>
                                <td class="tc-num"><span t-field="o.total_sales" t-options='{"widget": "float", "precision": 2}'/></td>
                                <td><strong>Total comisión</strong></td>
                                <td class="tc-num"><span t-field="o.total_commission" t-options='{"widget": "float", "precision": 2}'/></td>
                            </tr>
                            <tr>
                                <td><strong>Ventas excluidas por cliente</strong></td>
                                <td class="tc-num"><span t-esc="'%.2f' % sum(o.result_ids.mapped('excluded_client_sales'))"/></td>
                                <td><strong>Clientes excluidos configurados</strong></td>
                                <td class="tc-num"><span t-esc="o.period_id.client_exclusion_count"/></td>
                            </tr>
                        </table>

                        <t t-set="sections" t-value="[('retail', 'VENDEDORES RETAIL'), ('project', 'VENDEDORES DE PROYECTOS'), ('corporate_project', 'PROYECTOS CORPORATIVOS'), ('manager', 'ADMINISTRADORES')]"/>
                        <t t-foreach="sections" t-as="section">
                            <t t-set="section_results" t-value="o.result_ids.filtered(lambda r: r.report_group == section[0]).sorted(lambda r: (r.seller_id.code or '', r.seller_id.name or ''))"/>
                            <t t-if="section_results">
                                <div class="tc-section"><span t-esc="section[1]"/></div>
                                <table class="tc-table">
                                    <thead>
                                        <tr>
                                            <th>Código</th>
                                            <th>Vendedor / administrador</th>
                                            <th class="tc-num">Ventas</th>
                                            <th class="tc-num">Meta global</th>
                                            <th class="tc-num">Cumpl. %</th>
                                            <th class="tc-num">Com. propia</th>
                                            <th class="tc-num">Proyectos</th>
                                            <th class="tc-num">Gestión</th>
                                            <th class="tc-num">Bono liq.</th>
                                            <th class="tc-num">Reducc. monet.*</th>
                                            <th class="tc-num">Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="section_results" t-as="r">
                                            <td><span t-field="r.seller_id.code"/></td>
                                            <td><span t-field="r.seller_id.name"/></td>
                                            <td class="tc-num"><span t-field="r.total_sales" t-options='{"widget": "float", "precision": 2}'/></td>
                                            <td class="tc-num"><span t-field="r.target_amount" t-options='{"widget": "float", "precision": 2}'/></td>
                                            <td class="tc-num"><span t-field="r.achievement_percent" t-options='{"widget": "float", "precision": 2}'/></td>
                                            <td class="tc-num"><span t-field="r.standard_commission" t-options='{"widget": "float", "precision": 2}'/></td>
                                            <td class="tc-num"><span t-field="r.project_commission" t-options='{"widget": "float", "precision": 2}'/></td>
                                            <td class="tc-num"><span t-field="r.management_commission" t-options='{"widget": "float", "precision": 2}'/></td>
                                            <td class="tc-num"><span t-field="r.liquidation_bonus" t-options='{"widget": "float", "precision": 2}'/></td>
                                            <td class="tc-num"><span t-field="r.liquidation_penalty" t-options='{"widget": "float", "precision": 2}'/></td>
                                            <td class="tc-num"><strong><span t-field="r.total_commission" t-options='{"widget": "float", "precision": 2}'/></strong></td>
                                        </tr>
                                        <tr class="tc-total">
                                            <td colspan="2">SUBTOTAL <span t-esc="section[1]"/></td>
                                            <td class="tc-num"><span t-esc="'%.2f' % sum(section_results.mapped('total_sales'))"/></td>
                                            <td></td>
                                            <td></td>
                                            <td class="tc-num"><span t-esc="'%.2f' % sum(section_results.mapped('standard_commission'))"/></td>
                                            <td class="tc-num"><span t-esc="'%.2f' % sum(section_results.mapped('project_commission'))"/></td>
                                            <td class="tc-num"><span t-esc="'%.2f' % sum(section_results.mapped('management_commission'))"/></td>
                                            <td class="tc-num"><span t-esc="'%.2f' % sum(section_results.mapped('liquidation_bonus'))"/></td>
                                            <td class="tc-num"><span t-esc="'%.2f' % sum(section_results.mapped('liquidation_penalty'))"/></td>
                                            <td class="tc-num"><span t-esc="'%.2f' % sum(section_results.mapped('total_commission'))"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>
                        </t>

                        <table class="tc-summary">
                            <tr>
                                <td><strong>TOTAL GENERAL DE COMISIONES</strong></td>
                                <td class="tc-num"><strong><span t-field="o.total_commission" t-options='{"widget": "float", "precision": 2}'/></strong></td>
                            </tr>
                        </table>

                        <p style="font-size:9px; margin-top:10px;">
                            El reporte separa retail, proyectos por origen, proyectos corporativos y administradores para facilitar la revisión. Los proyectos por origen usan una meta global y un porcentaje propio por origen. Alcanzado el mínimo global, la tasa de cada origen se multiplica por el cumplimiento real de la meta, con tope en 100%; los proyectos corporativos se liquidan como vendedores normales.<br/>
                            Las ventas de vendedores marcados como excepción de meta local no suman al cumplimiento de la localidad, pero conservan su propia meta y comisión. Las ventas de clientes excluidos nunca generan comisión; según el parámetro del período pueden o no contar para cumplimiento de metas/mínimos.<br/>
                            * La reducción monetaria es informativa: ya está incorporada en las tasas efectivas de comisión y no debe restarse nuevamente del total.
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_commission_result_individual">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>
                            .tc-title { font-size: 20px; font-weight: 700; margin-bottom: 8px; }
                            .tc-block { border: 1px solid #d5d5d5; padding: 8px; margin-bottom: 10px; }
                            .tc-grid { width: 100%; border-collapse: collapse; font-size: 10px; }
                            .tc-grid td { padding: 4px; border-bottom: 1px solid #eeeeee; }
                            .tc-table { width: 100%; border-collapse: collapse; font-size: 9px; }
                            .tc-table th { background: #eeeeee; font-weight: 700; padding: 5px 3px; border: 1px solid #bdbdbd; }
                            .tc-table td { padding: 4px 3px; border: 1px solid #d5d5d5; }
                            .tc-num { text-align: right; white-space: nowrap; }
                            .tc-total { font-size: 15px; font-weight: 700; }
                        </style>

                        <div class="tc-title">Liquidación individual de comisión</div>
                        <div class="tc-block">
                            <table class="tc-grid">
                                <tr>
                                    <td><strong>Vendedor</strong></td>
                                    <td><span t-field="o.seller_id.name"/></td>
                                    <td><strong>Código</strong></td>
                                    <td><span t-field="o.seller_id.code"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Liquidación</strong></td>
                                    <td><span t-field="o.settlement_id.name"/></td>
                                    <td><strong>Período</strong></td>
                                    <td><span t-field="o.settlement_id.period_id.name"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Desde</strong></td>
                                    <td><span t-field="o.settlement_id.period_id.date_start"/></td>
                                    <td><strong>Hasta</strong></td>
                                    <td><span t-field="o.settlement_id.period_id.date_end"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Productos promoción</strong></td>
                                    <td><span t-esc="o.settlement_id.period_id.promotion_product_count"/></td>
                                    <td><strong>Grupo</strong></td>
                                    <td><span t-field="o.report_group"/></td>
                                </tr>
                            </table>
                        </div>

                        <div class="tc-block">
                            <table class="tc-grid">
                                <tr>
                                    <td><strong>Ventas comisionables</strong></td>
                                    <td class="tc-num"><span t-field="o.total_sales" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td><strong>Meta global / referencial</strong></td>
                                    <td class="tc-num"><span t-field="o.target_amount" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td><strong>Cumplimiento meta</strong></td>
                                    <td class="tc-num"><span t-field="o.achievement_percent" t-options='{"widget": "float", "precision": 2}'/>%</td>
                                </tr>
                                <tr t-if="o.excluded_client_sales">
                                    <td>Ventas antes de exclusiones</td>
                                    <td class="tc-num"><span t-field="o.gross_sales_before_client_exclusions" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td>Ventas excluidas por cliente</td>
                                    <td class="tc-num"><span t-field="o.excluded_client_sales" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td>Ventas consideradas para metas</td>
                                    <td class="tc-num"><span t-field="o.qualification_sales" t-options='{"widget": "float", "precision": 2}'/></td>
                                </tr>
                                <tr>
                                    <td>Comisión propia</td>
                                    <td class="tc-num"><span t-field="o.standard_commission" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td>Comisión proyectos</td>
                                    <td class="tc-num"><span t-field="o.project_commission" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td>Comisión gestión</td>
                                    <td class="tc-num"><span t-field="o.management_commission" t-options='{"widget": "float", "precision": 2}'/></td>
                                </tr>
                                <tr>
                                    <td>Bono liquidación</td>
                                    <td class="tc-num"><span t-field="o.liquidation_bonus" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td>Reducción monetaria (ya aplicada)</td>
                                    <td class="tc-num"><span t-field="o.liquidation_penalty" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td><strong>Total comisión</strong></td>
                                    <td class="tc-num tc-total"><span t-field="o.total_commission" t-options='{"widget": "float", "precision": 2}'/></td>
                                </tr>
                                <tr t-if="o.liquidation_penalty_base or not o.liquidation_target_met">
                                    <td>Cumple meta liquidación</td>
                                    <td><span t-esc="'Sí' if o.liquidation_target_met else 'No'"/></td>
                                    <td>Comisión antes del ajuste</td>
                                    <td class="tc-num"><span t-field="o.liquidation_penalty_base" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td>Reducción de tasa</td>
                                    <td class="tc-num"><span t-field="o.liquidation_rate_reduction" t-options='{"widget": "float", "precision": 4}'/> p.p.</td>
                                </tr>
                            </table>
                        </div>

                        <h4>Detalle de cálculo</h4>
                        <table class="tc-table">
                            <thead>
                                <tr>
                                    <th>Tipo</th>
                                    <th>Descripción</th>
                                    <th>Vendedor gestionado</th>
                                    <th>Local</th>
                                    <th class="tc-num">Base</th>
                                    <th class="tc-num">Cant./m²</th>
                                    <th class="tc-num">Tasa efectiva / tarifa</th>
                                    <th>Cumple</th>
                                    <th class="tc-num">Comisión</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.detail_ids" t-as="d">
                                    <td><span t-field="d.detail_type"/></td>
                                    <td><span t-field="d.description"/></td>
                                    <td><span t-if="d.managed_seller_id" t-field="d.managed_seller_id.name"/></td>
                                    <td><span t-if="d.location_id" t-field="d.location_id.name"/></td>
                                    <td class="tc-num"><span t-field="d.basis_amount" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td class="tc-num"><span t-field="d.quantity" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td class="tc-num"><span t-field="d.rate" t-options='{"widget": "float", "precision": 4}'/></td>
                                    <td><span t-esc="'Sí' if d.eligible else 'No'"/></td>
                                    <td class="tc-num"><span t-field="d.amount" t-options='{"widget": "float", "precision": 2}'/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
