<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
  <record id="default_source" model="dispatch.source"><field name="name">Exportador de despachos</field><field name="code">TRANSCASH</field><field name="company_id" ref="base.main_company"/><field name="notes">Cada carga representa un corte completo de esta fuente. Utilice fuentes distintas para universos independientes; no cargue el mismo universo dos veces.</field></record>
  <record id="default_board" model="dispatch.board"><field name="name">Control de despachos</field><field name="owner_id" ref="base.user_admin"/><field name="company_id" ref="base.main_company"/><field name="shared" eval="True"/></record>
  <record id="widget_city" model="dispatch.widget"><field name="board_id" ref="default_board"/><field name="name">Pendientes por ciudad</field><field name="metric">pending</field><field name="dimension">city</field><field name="chart_type">bar</field><field name="sequence">10</field></record>
  <record id="widget_trend" model="dispatch.widget"><field name="board_id" ref="default_board"/><field name="name">Cumplimiento por mes de factura</field><field name="metric">mature_compliance</field><field name="dimension">month</field><field name="chart_type">line</field><field name="top_n">12</field><field name="sequence">20</field></record>
  <record id="widget_delivery" model="dispatch.widget"><field name="board_id" ref="default_board"/><field name="name">Pendientes por modalidad</field><field name="metric">pending</field><field name="dimension">delivery</field><field name="chart_type">donut</field><field name="sequence">30</field></record>
</odoo>
