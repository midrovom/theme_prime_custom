<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="snapshot_list" model="ir.ui.view"><field name="name">dispatch.snapshot.list</field><field name="model">dispatch.snapshot</field><field name="arch" type="xml"><list create="false" decoration-danger="state == 'error'"><field name="name"/><field name="source_id"/><field name="cutoff_date"/><field name="input_type"/><field name="state" widget="badge"/><field name="total_rows"/><field name="total_invoices"/><field name="loaded_invoices"/><field name="duplicate_rows"/><field name="duplicate_updates"/><field name="progress_percent" widget="progressbar"/><field name="last_progress_at"/><button name="action_open_progress" type="object" string="Procesar / ver progreso"/><field name="finished_at"/></list></field></record>
  <record id="snapshot_form" model="ir.ui.view"><field name="name">dispatch.snapshot.form</field><field name="model">dispatch.snapshot</field><field name="arch" type="xml"><form create="false" edit="false"><header><button name="action_open_progress" type="object" string="Procesar / ver progreso" class="oe_highlight"/><button name="action_retry" type="object" string="Reintentar" invisible="state != 'error'" groups="transcash_dispatch_analysis.group_dispatch_operator"/><button name="action_recalculate" type="object" string="Reaplicar parámetros actuales" invisible="state not in ['ready','archived']" groups="transcash_dispatch_analysis.group_dispatch_manager"/><button name="action_open_invoices" type="object" string="Ver facturas" invisible="state not in ['ready','archived']"/><field name="state" widget="statusbar" statusbar_visible="queued,loading,ready"/></header><sheet><group><group><field name="name"/><field name="source_id"/><field name="company_id" groups="base.group_multi_company"/><field name="cutoff_date"/><field name="input_type"/><field name="batch_key"/></group><group><field name="total_rows"/><field name="total_invoices"/><field name="loaded_invoices"/><field name="duplicate_rows"/><field name="duplicate_updates"/><field name="progress_percent" widget="progressbar"/><field name="progress_message"/><field name="last_progress_at"/><field name="started_at"/><field name="finished_at"/><field name="file_name" invisible="1"/><field name="raw_file" filename="file_name" invisible="input_type != 'xlsx'"/></group></group><field name="error_message" invisible="not error_message"/><div class="alert alert-info" invisible="state not in ['queued','loading']">El archivo ya está guardado. Pulse Procesar / ver progreso para iniciar o continuar los bloques con avance en pantalla. Puede usar esa opción aunque el programador de tareas no esté ejecutándose. El corte vigente se mantiene disponible hasta terminar.</div><notebook><page string="Parámetros aplicados"><field name="policy_description"/></page></notebook></sheet></form></field></record>
  <record id="action_snapshots" model="ir.actions.act_window"><field name="name">Importaciones e histórico</field><field name="res_model">dispatch.snapshot</field><field name="view_mode">list,form</field></record>
</odoo>
