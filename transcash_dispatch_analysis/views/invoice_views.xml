<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="invoice_search" model="ir.ui.view"><field name="name">dispatch.invoice.search</field><field name="model">dispatch.invoice</field><field name="arch" type="xml"><search><field name="name"/><field name="external_number"/><field name="customer"/><field name="city"/><field name="seller"/><field name="delivery"/><field name="warehouses"/><filter name="pending" string="Pendientes" domain="[('pending','=',True)]"/><filter name="overdue" string="Vencidas" domain="[('sla_status','=','overdue')]"/><filter name="no_rule" string="Sin plazo" domain="[('sla_configured','=',False)]"/><filter name="quality" string="Revisar datos" domain="[('quality_issue','=',True)]"/><filter name="lead_available" string="Tiempo medible" domain="[('lead_available','=',True)]"/><filter name="adjusted" string="Con ajustes" domain="[('has_adjustment','=',True)]"/><filter name="invoice_date" string="Fecha de factura" date="invoice_date"/><group expand="0" string="Agrupar"><filter name="by_city" string="Ciudad" context="{'group_by':'city'}"/><filter name="by_delivery" string="Condición" context="{'group_by':'delivery'}"/><filter name="by_seller" string="Vendedor" context="{'group_by':'seller'}"/><filter name="by_status" string="Cumplimiento" context="{'group_by':'sla_status'}"/><filter name="by_month" string="Mes" context="{'group_by':'invoice_date:month'}"/></group></search></field></record>
  <record id="invoice_list" model="ir.ui.view"><field name="name">dispatch.invoice.list</field><field name="model">dispatch.invoice</field><field name="arch" type="xml"><list create="false" edit="false" delete="false" decoration-danger="sla_status == 'overdue'" decoration-warning="sla_status == 'due_today'" decoration-muted="quality_issue"><field name="name"/><field name="external_number" optional="hide"/><field name="invoice_date"/><field name="customer"/><field name="city"/><field name="delivery" optional="show"/><field name="state" widget="badge"/><field name="pending_lines"/><field name="pending_weight" sum="Peso pendiente" optional="show"/><field name="deadline"/><field name="sla_status" widget="badge"/><field name="late_days"/><field name="lead_days" optional="hide"/><field name="lead_available" optional="hide"/><field name="quality_issue" optional="hide"/><field name="cutoff_date" optional="show"/></list></field></record>
  <record id="invoice_form" model="ir.ui.view"><field name="name">dispatch.invoice.form</field><field name="model">dispatch.invoice</field><field name="arch" type="xml"><form create="false" edit="false" delete="false"><sheet><h1><field name="name"/></h1><group><group><field name="external_number"/><field name="invoice_date"/><field name="customer"/><field name="city"/><field name="delivery"/><field name="establishment"/><field name="warehouses"/><field name="source_grain"/><field name="seller"/></group><group><field name="state"/><field name="sla_status"/><field name="deadline"/><field name="sla_days"/><field name="sla_day_type"/><field name="completion_date"/><field name="lead_available"/><field name="lead_days" invisible="not lead_available"/><field name="late_days"/><field name="snapshot_id"/><field name="cutoff_date"/></group></group><notebook><page string="Detalle por bodega o producto"><field name="line_ids"><list create="false" edit="false" delete="false"><field name="product_code" optional="hide"/><field name="product" optional="hide"/><field name="warehouse"/><field name="invoiced_qty"/><field name="physical_qty"/><field name="adjustment_qty"/><field name="pending_qty"/><field name="last_dispatch_date"/><field name="pending_weight"/><field name="pending_boxes" optional="hide"/><field name="pending_pallets" optional="hide"/><field name="source_state" optional="hide"/><field name="blocks" optional="hide"/><field name="locations" optional="hide"/></list></field></page><page string="Calidad y trazabilidad"><group><field name="quality_issue"/><field name="quality_details"/><field name="has_adjustment"/><field name="invoice_key"/><field name="rule_details"/><field name="eligible"/><field name="mature"/><field name="on_time"/></group></page></notebook></sheet></form></field></record>
  <record id="invoice_pivot" model="ir.ui.view"><field name="name">dispatch.invoice.pivot</field><field name="model">dispatch.invoice</field><field name="arch" type="xml"><pivot string="Facturas por ciudad y cumplimiento"><field name="city" type="row"/><field name="sla_status" type="col"/><field name="pending_weight" type="measure"/></pivot></field></record>
  <record id="invoice_graph" model="ir.ui.view"><field name="name">dispatch.invoice.graph</field><field name="model">dispatch.invoice</field><field name="arch" type="xml"><graph string="Facturas por ciudad" type="bar"><field name="city"/></graph></field></record>
  <record id="action_invoices" model="ir.actions.act_window"><field name="name">Facturas y detalle</field><field name="res_model">dispatch.invoice</field><field name="view_mode">list,form,pivot,graph</field><field name="domain">[('snapshot_state','=','ready')]</field></record>
  <record id="action_dynamic_analysis" model="ir.actions.act_window"><field name="name">Análisis dinámico</field><field name="res_model">dispatch.invoice</field><field name="view_mode">pivot,graph,list,form</field><field name="domain">[('snapshot_state','=','ready')]</field><field name="help" type="html"><p>Agrupe por ciudad, modalidad, vendedor o mes. Para promedios de tiempo, aplique el filtro “Tiempo medible”. Los porcentajes oficiales ponderados están en el tablero.</p></field></record>
</odoo>
