<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="board_list" model="ir.ui.view"><field name="name">dispatch.board.list</field><field name="model">dispatch.board</field><field name="arch" type="xml"><list><field name="name"/><field name="owner_id"/><field name="shared"/><button name="action_open" type="object" string="Abrir tablero"/></list></field></record>
  <record id="board_form" model="ir.ui.view"><field name="name">dispatch.board.form</field><field name="model">dispatch.board</field><field name="arch" type="xml"><form><header><button name="action_open" type="object" string="Abrir tablero" class="oe_highlight"/></header><sheet><group><field name="name"/><field name="owner_id" readonly="1"/><field name="company_id" groups="base.group_multi_company"/><field name="shared" groups="transcash_dispatch_analysis.group_dispatch_manager"/></group><field name="widget_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="metric"/><field name="dimension"/><field name="chart_type"/><field name="top_n"/></list></field><div class="alert alert-info">Seleccione indicadores y dimensiones para construir el tablero. Los gráficos de línea usan Mes de factura. La distribución circular admite cantidades y peso. En Análisis dinámico puede cambiar agrupaciones, medidas y guardar filtros favoritos.</div></sheet></form></field></record>
  <record id="action_boards" model="ir.actions.act_window"><field name="name">Mis tableros</field><field name="res_model">dispatch.board</field><field name="view_mode">list,form</field></record>
