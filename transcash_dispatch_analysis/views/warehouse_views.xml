<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="warehouse_list" model="ir.ui.view"><field name="name">dispatch.warehouse.list</field><field name="model">dispatch.warehouse</field><field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
  <record id="action_warehouses" model="ir.actions.act_window"><field name="name">Bodegas del origen</field><field name="res_model">dispatch.warehouse</field><field name="view_mode">list,form</field></record>
  <record id="warehouse_analysis_search" model="ir.ui.view">
    <field name="name">dispatch.invoice.line.warehouse.search</field><field name="model">dispatch.invoice.line</field>
    <field name="arch" type="xml"><search>
      <field name="invoice_id"/><field name="warehouse_id"/><field name="city"/><field name="delivery"/>
      <filter name="current" string="Solo registros vigentes" domain="[('invoice_id.is_current','=',True)]"/>
      <filter name="pending" string="Con pendiente" domain="[('pending_qty','&gt;',0.000001)]"/>
      <filter name="missing_weight" string="Pendientes sin peso" domain="[('pending_qty','&gt;',0.000001),('pending_weight','&lt;=',0)]"/>
      <filter name="invoice_date" string="Fecha de factura" date="invoice_date"/>
      <group expand="0" string="Agrupar"><filter name="by_warehouse" string="Bodega" context="{'group_by':'warehouse_id'}"/><filter name="by_city" string="Destino" context="{'group_by':'city'}"/><filter name="by_invoice" string="Factura" context="{'group_by':'invoice_id'}"/><filter name="by_month" string="Mes" context="{'group_by':'invoice_date:month'}"/><filter name="by_delivery" string="Modalidad" context="{'group_by':'delivery'}"/></group>
      <searchpanel><field name="warehouse_id" select="multi" string="Bodegas"/></searchpanel>
    </search></field>
  </record>
  <record id="warehouse_analysis_list" model="ir.ui.view">
    <field name="name">dispatch.invoice.line.warehouse.list</field><field name="model">dispatch.invoice.line</field>
    <field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="invoice_id"/><field name="invoice_date"/><field name="warehouse_id"/><field name="city"/><field name="delivery"/><field name="invoiced_tons" sum="Facturadas conocidas (t)"/><field name="dispatched_tons" sum="Despachadas (t)"/><field name="pending_tons" sum="Pendientes (t)"/><field name="invoiced_pallets" sum="Pallets facturados conocidos"/><field name="pending_pallets" sum="Pallets pendientes"/><field name="invoiced_pallets_available" optional="show"/><field name="pending_pallets_available" optional="hide"/><field name="invoiced_weight_available" optional="show"/><field name="dispatched_weight_available" optional="hide"/><field name="pending_qty" optional="hide"/><field name="snapshot_id" optional="hide"/></list></field>
  </record>
  <record id="warehouse_analysis_pivot" model="ir.ui.view">
    <field name="name">dispatch.invoice.line.warehouse.pivot</field><field name="model">dispatch.invoice.line</field>
    <field name="arch" type="xml"><pivot string="Toneladas por bodega y destino"><field name="warehouse_id" type="row"/><field name="city" type="col"/><field name="invoiced_tons" type="measure"/><field name="dispatched_tons" type="measure"/><field name="pending_tons" type="measure"/><field name="invoiced_pallets" type="measure"/><field name="pending_pallets" type="measure"/></pivot></field>
  </record>
  <record id="warehouse_analysis_graph" model="ir.ui.view">
    <field name="name">dispatch.invoice.line.warehouse.graph</field><field name="model">dispatch.invoice.line</field>
    <field name="arch" type="xml"><graph string="Pendientes por destino" type="bar"><field name="city"/><field name="pending_tons" type="measure"/><field name="invoiced_pallets" type="measure"/><field name="pending_pallets" type="measure"/></graph></field>
  </record>
  <record id="action_warehouse_analysis" model="ir.actions.act_window">
    <field name="name">Toneladas por bodegas y destinos</field><field name="res_model">dispatch.invoice.line</field><field name="view_mode">pivot,graph,list</field>
    <field name="search_view_id" ref="warehouse_analysis_search"/><field name="context">{'search_default_current':1}</field>
    <field name="help" type="html"><p>Seleccione varias bodegas en el panel lateral. Guarde la búsqueda desde Favoritos de Odoo, con filtros, agrupaciones y medidas. Las filas representan detalles por bodega: el conteo de filas no es el número único de facturas. Los pallets facturados requieren PalletsFacturados en el origen; revise su disponibilidad antes de interpretar un cero. El peso facturado muestra solo la parte conocida; los ajustes requieren PesoFacturado o PesoAjusteDevolucion.</p></field>
  </record>
</odoo>
