<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_api_sync_wizard" model="ir.ui.view">
    <field name="name">dispatch.api.sync.wizard.form</field>
    <field name="model">dispatch.api.sync.wizard</field>
    <field name="arch" type="xml">
      <form string="Sincronizar despachos">
        <field name="company_id" invisible="1"/>
        <field name="source_id" invisible="1"/>
        <p>Actualizar la información de despachos desde el ERP.</p>
        <footer>
          <button name="action_sync" type="object" string="Sincronizar" class="btn-primary"/>
          <button string="Cerrar" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
  <record id="action_api_sync" model="ir.actions.act_window">
    <field name="name">Sincronizar</field><field name="res_model">dispatch.api.sync.wizard</field>
    <field name="view_mode">form</field><field name="target">new</field>
  </record>
</odoo>
