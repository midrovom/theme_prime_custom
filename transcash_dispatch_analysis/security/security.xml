<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_dispatch" model="ir.module.category"><field name="name">Análisis de despachos</field><field name="sequence">35</field></record>
  <record id="group_dispatch_user" model="res.groups"><field name="name">Consulta</field><field name="category_id" ref="module_category_dispatch"/><field name="implied_ids" eval="[(4, ref('base.group_user'))]"/></record>
  <record id="group_dispatch_operator" model="res.groups"><field name="name">Operador</field><field name="category_id" ref="module_category_dispatch"/><field name="implied_ids" eval="[(4, ref('group_dispatch_user'))]"/></record>
  <record id="group_dispatch_manager" model="res.groups"><field name="name">Responsable</field><field name="category_id" ref="module_category_dispatch"/><field name="implied_ids" eval="[(4, ref('group_dispatch_operator'))]"/><field name="users" eval="[(4, ref('base.user_admin'))]"/></record>
  <record id="rule_source_company" model="ir.rule"><field name="name">Fuentes por compañía</field><field name="model_id" ref="model_dispatch_source"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
  <record id="rule_sla_company" model="ir.rule"><field name="name">Plazos por compañía</field><field name="model_id" ref="model_dispatch_sla"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
  <record id="rule_vehicle_type_company" model="ir.rule"><field name="name">Vehículos por compañía</field><field name="model_id" ref="model_dispatch_vehicle_type"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
  <record id="rule_transport_settings_company" model="ir.rule"><field name="name">Plan de despacho por compañía</field><field name="model_id" ref="model_dispatch_transport_settings"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
  <record id="rule_transport_route_company" model="ir.rule"><field name="name">Capacidad de destinos por compañía</field><field name="model_id" ref="model_dispatch_transport_route"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
  <record id="rule_holiday_company" model="ir.rule"><field name="name">Feriados por compañía</field><field name="model_id" ref="model_dispatch_holiday"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
  <record id="rule_snapshot_company" model="ir.rule"><field name="name">Cortes por compañía</field><field name="model_id" ref="model_dispatch_snapshot"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
  <record id="rule_chunk_company" model="ir.rule"><field name="name">Bloques por compañía</field><field name="model_id" ref="model_dispatch_chunk"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
  <record id="rule_invoice_company" model="ir.rule"><field name="name">Facturas por compañía</field><field name="model_id" ref="model_dispatch_invoice"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
  <record id="rule_line_company" model="ir.rule"><field name="name">Productos por compañía</field><field name="model_id" ref="model_dispatch_invoice_line"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
  <record id="rule_board_company" model="ir.rule"><field name="name">Tableros por compañía</field><field name="model_id" ref="model_dispatch_board"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
  <record id="rule_widget_company" model="ir.rule"><field name="name">Visuales por compañía</field><field name="model_id" ref="model_dispatch_widget"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
  <record id="rule_board_read" model="ir.rule"><field name="name">Tableros propios o compartidos</field><field name="model_id" ref="model_dispatch_board"/><field name="groups" eval="[(4, ref('group_dispatch_user'))]"/><field name="domain_force">['|', ('owner_id', '=', user.id), ('shared', '=', True)]</field><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/></record>
  <record id="rule_board_write" model="ir.rule"><field name="name">Editar tableros propios</field><field name="model_id" ref="model_dispatch_board"/><field name="groups" eval="[(4, ref('group_dispatch_user'))]"/><field name="domain_force">[('owner_id', '=', user.id)]</field><field name="perm_read" eval="False"/></record>
  <record id="rule_board_manager" model="ir.rule"><field name="name">Responsable de tableros</field><field name="model_id" ref="model_dispatch_board"/><field name="groups" eval="[(4, ref('group_dispatch_manager'))]"/><field name="domain_force">[(1, '=', 1)]</field></record>
  <record id="rule_widget_read" model="ir.rule"><field name="name">Visuales propios o compartidos</field><field name="model_id" ref="model_dispatch_widget"/><field name="groups" eval="[(4, ref('group_dispatch_user'))]"/><field name="domain_force">['|', ('board_id.owner_id', '=', user.id), ('board_id.shared', '=', True)]</field><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/></record>
  <record id="rule_widget_write" model="ir.rule"><field name="name">Editar visuales propios</field><field name="model_id" ref="model_dispatch_widget"/><field name="groups" eval="[(4, ref('group_dispatch_user'))]"/><field name="domain_force">[('board_id.owner_id', '=', user.id)]</field><field name="perm_read" eval="False"/></record>
  <record id="rule_widget_manager" model="ir.rule"><field name="name">Responsable de visuales</field><field name="model_id" ref="model_dispatch_widget"/><field name="groups" eval="[(4, ref('group_dispatch_manager'))]"/><field name="domain_force">[(1, '=', 1)]</field></record>
</odoo>
