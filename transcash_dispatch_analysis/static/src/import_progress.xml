<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="transcash_dispatch_analysis.ImportProgress">
    <div class="td-import-progress" t-att-aria-busy="state.running || state.fetching">
      <section class="td-import-card">
        <div class="td-import-eyebrow">ANÁLISIS DE DESPACHOS</div>
        <h1 t-esc="isERP ? 'Sincronización desde el ERP' : 'Importación del archivo'"/>
        <p class="td-import-subtitle" t-esc="isERP ? 'Actualizando la información de despachos. Aquí puedes ver el avance.' : 'El archivo queda guardado en Odoo. Esta pantalla muestra el avance de la importación.'"/>
        <div t-if="state.reconnecting" class="td-import-reconnecting" role="status">Se interrumpió la conexión. Estamos consultando el último avance guardado.</div>
        <div t-if="state.error" class="td-import-error" role="alert">
          <strong>No se pudo completar la solicitud</strong><p t-esc="state.error"/>
          <p t-if="isERP">Puedes volver a intentar. Las facturas se actualizan sin duplicarse.</p>
          <p t-else="">Consulta el estado y continúa desde el último avance guardado. No necesitas subir otra copia del Excel.</p>
        </div>
        <t t-if="state.fetching || state.progress">
          <div t-if="!isERP &amp;&amp; state.progress" class="td-import-file" t-esc="state.progress.file_name"/>
          <div class="td-import-title">
            <h2 t-esc="phaseTitle"/>
            <strong t-esc="indeterminate ? 'En curso' : state.progress.progress_percent + '%'"/>
          </div>
          <div class="td-import-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" t-att-aria-label="phaseTitle" t-att-aria-valuenow="indeterminate ? undefined : state.progress.progress_percent">
            <div t-att-class="indeterminate ? 'indeterminate' : state.progress.failed ? 'failed' : state.progress.done ? 'done' : ''" t-att-style="indeterminate ? 'width:35%' : 'width:' + state.progress.progress_percent + '%'"/>
          </div>
          <p class="td-import-message" t-esc="state.fetching ? 'Recibiendo y comprobando la información. El total de facturas aparecerá al terminar esta etapa.' : state.progress.progress_message"/>
          <t t-if="state.progress">
            <div class="td-import-counts">
              <div><span t-esc="isERP ? 'Facturas actualizadas' : 'Facturas importadas'"/><strong t-esc="format(state.progress.loaded_invoices)"/></div>
              <div><span>Total de facturas</span><strong t-esc="state.progress.total_invoices || state.progress.done ? format(state.progress.total_invoices) : 'Por confirmar'"/></div>
              <div><span t-esc="isERP ? 'Registros del ERP' : 'Registros del archivo'"/><strong t-esc="state.progress.total_rows || state.progress.done ? format(state.progress.total_rows) : 'Por confirmar'"/></div>
            </div>
            <div t-if="state.progress.failed" class="td-import-error" role="alert"><strong>Detalle del error</strong><p t-esc="state.progress.error_message"/></div>
            <p t-if="state.progress.busy" class="td-import-note">La actualización ya está siendo atendida. El avance se consultará automáticamente.</p>
            <p t-elif="state.progress.state === 'queued' &amp;&amp; state.running" class="td-import-note" t-esc="isERP ? 'Validando los datos recibidos. El porcentaje aparecerá cuando se conozca el total de facturas.' : 'Validando el archivo. El porcentaje aparecerá cuando se conozca el total de facturas.'"/>
            <p t-elif="state.running &amp;&amp; state.background" class="td-import-note">Odoo está procesando la carga en segundo plano. Puedes volver al tablero y consultar el avance después.</p>
            <p t-elif="state.running" class="td-import-note">Mantén abierta esta pantalla para ver el avance. Cada actualización confirmada queda guardada.</p>
            <p t-if="state.progress.done" class="td-import-success"><t t-esc="state.syncMessage || 'La información está disponible en el tablero.'"/> <t t-if="state.progress.state === 'archived'">Se guardó como histórico porque existe un corte más reciente.</t></p>
            <div class="td-import-actions">
              <button t-if="state.progress.can_process &amp;&amp; state.progress.can_continue &amp;&amp; !state.running" class="btn btn-primary" t-on-click="start" t-esc="isERP ? 'Continuar sincronización' : 'Continuar importación'"/>
              <button t-if="state.progress.can_process &amp;&amp; state.progress.failed" class="btn btn-primary" t-on-click="retry" t-esc="isERP ? 'Reintentar actualización' : 'Reintentar importación'"/>
              <button t-if="state.progress.done" class="btn btn-primary" t-on-click="openDashboard">Abrir tablero</button>
              <button t-if="state.progress.done" class="btn btn-secondary" t-on-click="openInvoices">Ver facturas</button>
              <button t-if="!state.running" class="btn btn-secondary" t-on-click="refresh">Consultar estado</button>
              <button class="btn btn-light" t-on-click="openHistory">Historial de cargas</button>
            </div>
          </t>
        </t>
        <div t-if="state.error &amp;&amp; !state.progress" class="td-import-actions">
          <button t-if="sourceId" class="btn btn-primary" t-on-click="syncERP">Reintentar sincronización</button>
          <button t-else="" class="btn btn-primary" t-on-click="refresh">Consultar estado</button>
          <button class="btn btn-light" t-on-click="openDashboard">Volver al tablero</button>
        </div>
        <p t-if="state.progress" class="td-import-footer">Puedes retomar el avance desde Historial de cargas. Las actualizaciones confirmadas quedan guardadas.</p>
      </section>
    </div>
  </t>
</templates>
