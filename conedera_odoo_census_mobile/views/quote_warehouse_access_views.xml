<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Mantener las vistas técnicas de asignación existentes para compatibilidad. -->
  <record id="view_catastro_quote_warehouse_access_list" model="ir.ui.view">
    <field name="name">catastro.quote.warehouse.access.list</field>
    <field name="model">catastro.quote.warehouse.access</field>
    <field name="arch" type="xml"><list string="Bodegas asignadas" create="1" edit="1">
      <field name="user_id"/><field name="warehouse_id"/><field name="company_id" readonly="1"/>
    </list></field>
  </record>
  <record id="view_catastro_quote_warehouse_access_form" model="ir.ui.view">
    <field name="name">catastro.quote.warehouse.access.form</field>
    <field name="model">catastro.quote.warehouse.access</field>
    <field name="arch" type="xml"><form string="Bodega asignada"><sheet><group>
      <field name="user_id"/><field name="warehouse_id"/><field name="company_id" readonly="1"/>
    </group></sheet></form></field>
  </record>

  <!-- El menú administrativo muestra un usuario y su One2many editable. -->
  <record id="view_catastro_quote_user_warehouse_list" model="ir.ui.view">
    <field name="name">res.users.catastro.quote.warehouse.list</field>
    <field name="model">res.users</field>
    <field name="arch" type="xml"><list string="Bodegas para cotizar por usuario" create="0" delete="0">
      <field name="name"/><field name="login"/><field name="company_id"/>
    </list></field>
  </record>
  <record id="view_catastro_quote_user_warehouse_form" model="ir.ui.view">
    <field name="name">res.users.catastro.quote.warehouse.form</field>
    <field name="model">res.users</field>
    <field name="arch" type="xml">
      <form string="Bodegas para cotizar por usuario" create="0" delete="0" duplicate="0">
        <sheet>
          <group string="Usuario">
            <field name="name" readonly="1"/>
            <field name="login" readonly="1"/>
            <field name="company_ids" widget="many2many_tags" readonly="1"/>
          </group>
          <group string="Bodegas donde puede crear proformas">
            <field name="catastro_quote_warehouse_access_ids" nolabel="1">
              <list editable="bottom" create="1" delete="1">
                <field name="warehouse_id" required="1"
                  domain="[('company_id', 'in', parent.company_ids)]"
                  options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="company_id" readonly="1"/>
              </list>
            </field>
          </group>
          <div class="text-muted">Añada tantas bodegas como requiera el usuario y guarde una sola vez. Las asignaciones existentes se mantienen. Tienda puede consultar el stock de otras bodegas de la empresa, pero solo cotizar en las asignadas.</div>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_catastro_quote_warehouse_access" model="ir.actions.act_window">
    <field name="name">Bodegas para cotizar por usuario</field>
    <field name="res_model">res.users</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('share', '=', False)]</field>
    <field name="help" type="html"><p>Seleccione un usuario y agregue todas sus bodegas en la misma ficha.</p></field>
  </record>
  <record id="action_catastro_quote_warehouse_access_list_view" model="ir.actions.act_window.view">
    <field name="sequence" eval="1"/>
    <field name="view_mode">list</field>
    <field name="view_id" ref="view_catastro_quote_user_warehouse_list"/>
    <field name="act_window_id" ref="action_catastro_quote_warehouse_access"/>
  </record>
  <record id="action_catastro_quote_warehouse_access_form_view" model="ir.actions.act_window.view">
    <field name="sequence" eval="2"/>
    <field name="view_mode">form</field>
    <field name="view_id" ref="view_catastro_quote_user_warehouse_form"/>
    <field name="act_window_id" ref="action_catastro_quote_warehouse_access"/>
  </record>
  <menuitem id="menu_catastro_quote_warehouse_access" name="Bodegas para cotizar por usuario"
    parent="conedera_odoo_census.menu_census_configuration" sequence="67"
    action="action_catastro_quote_warehouse_access" groups="base.group_system"/>
</odoo>
