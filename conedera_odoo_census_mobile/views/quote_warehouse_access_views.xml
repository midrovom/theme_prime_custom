<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_catastro_quote_warehouse_access_list" model="ir.ui.view">
    <field name="name">catastro.quote.warehouse.access.list</field>
    <field name="model">catastro.quote.warehouse.access</field>
    <field name="arch" type="xml">
      <list string="Bodegas habilitadas por usuario" create="1" edit="1">
        <field name="user_id"/>
        <field name="warehouse_id"/>
        <field name="company_id" readonly="1"/>
      </list>
    </field>
  </record>
  <record id="view_catastro_quote_warehouse_access_form" model="ir.ui.view">
    <field name="name">catastro.quote.warehouse.access.form</field>
    <field name="model">catastro.quote.warehouse.access</field>
    <field name="arch" type="xml">
      <form string="Bodega permitida para cotizar"><sheet>
        <group><field name="user_id"/><field name="warehouse_id"/><field name="company_id" readonly="1"/></group>
        <div class="text-muted">Asigne una línea por bodega y usuario. Tienda puede consultar otras ubicaciones, pero solo cotizar desde bodegas asignadas.</div>
      </sheet></form>
    </field>
  </record>
  <record id="action_catastro_quote_warehouse_access" model="ir.actions.act_window">
    <field name="name">Bodegas para cotizar por usuario</field>
    <field name="res_model">catastro.quote.warehouse.access</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_catastro_quote_warehouse_access" name="Bodegas para cotizar por usuario"
    parent="conedera_odoo_census.menu_census_configuration" sequence="67"
    action="action_catastro_quote_warehouse_access" groups="base.group_system"/>
</odoo>
