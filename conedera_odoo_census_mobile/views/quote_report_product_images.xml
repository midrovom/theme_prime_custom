<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="catastro_pwa_saleorder_product_thumbnail"
              inherit_id="sale.report_saleorder_document"
              name="Catastro PWA: fotografía de producto en proforma">
        <xpath expr="//td[@name='td_name']" position="inside">
            <img t-if="line.product_id and line.product_id.image_128"
                 t-att-src="image_data_uri(line.product_id.image_128)"
                 alt="Foto del producto"
                 style="max-width:56px;max-height:56px;float:left;margin:0 8px 4px 0;object-fit:contain;"/>
        </xpath>
    </template>
</odoo>
