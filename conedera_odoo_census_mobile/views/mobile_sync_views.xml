<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mobile_sync_log_list" model="ir.ui.view">
        <field name="name">conedera.mobile.sync.log.list</field>
        <field name="model">conedera.mobile.sync.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="create_date desc">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="company_id"/>
                <field name="operation_type"/>
                <field name="state" widget="badge"/>
                <field name="result_model" optional="hide"/>
                <field name="result_id" optional="hide"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_mobile_sync_log_form" model="ir.ui.view">
        <field name="name">conedera.mobile.sync.log.form</field>
        <field name="model">conedera.mobile.sync.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="client_uuid"/>
                            <field name="operation_type"/>
                            <field name="state"/>
                            <field name="synced_at"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="company_id"/>
                            <field name="result_model"/>
                            <field name="result_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="message"/>
                        <field name="payload_json" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mobile_sync_log" model="ir.actions.act_window">
        <field name="name">Sincronizaciones móviles</field>
        <field name="res_model">conedera.mobile.sync.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
