<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="view_catastro_payment_option_list" model="ir.ui.view">
  <field name="name">catastro.quote.payment.option.list</field><field name="model">catastro.quote.payment.option</field>
  <field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="name"/><field name="erp_code"/><field name="company_id"/><field name="surcharge_percent"/><field name="payment_term_id"/><field name="active"/></list></field>
 </record>
 <record id="view_catastro_payment_option_form" model="ir.ui.view">
  <field name="name">catastro.quote.payment.option.form</field><field name="model">catastro.quote.payment.option</field>
  <field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="erp_code"/><field name="company_id"/><field name="active"/><field name="sequence"/></group><group string="Recargo incorporado al precio del producto"><field name="surcharge_percent"/><field name="payment_term_id"/></group><div class="text-muted">El porcentaje se aplica sobre el precio unitario de cada producto. Cada línea conserva el precio base, el porcentaje y el importe de recargo. Loyalty mantiene sus descuentos propios. No es necesario definir un producto de servicio para el recargo.</div><div class="text-muted">El código ERP se envía en la cabecera de la proforma a Radis. Es obligatorio para exportar cotizaciones con esta condición; no modifica los precios.</div></sheet></form></field>
 </record>
 <record id="action_catastro_payment_options" model="ir.actions.act_window">
  <field name="name">Condiciones de pago PWA</field><field name="res_model">catastro.quote.payment.option</field><field name="view_mode">list,form</field>
 </record>
 <menuitem id="menu_catastro_payment_options" name="Condiciones de pago PWA" parent="conedera_odoo_census.menu_census_configuration" sequence="65" action="action_catastro_payment_options" groups="base.group_system"/>
 <!-- Configuración por asistente; nunca crear una nueva res.company desde este menú. -->
 <record id="view_catastro_retail_settings_wizard_form" model="ir.ui.view">
  <field name="name">catastro.retail.settings.wizard.form</field>
  <field name="model">catastro.retail.settings.wizard</field>
  <field name="arch" type="xml">
   <form string="Configurar cliente Consumidor Final">
    <sheet>
     <div class="alert alert-info" role="alert">Seleccione una empresa existente y el contacto que recibirá las cotizaciones de mostrador. No es necesario crear una empresa nueva.</div>
     <group>
      <field name="company_id" options="{'no_create': True, 'no_create_edit': True}"/>
      <field name="retail_partner_id" domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]" options="{'no_quick_create': True}"/>
     </group>
     <div class="text-muted">Puede buscar un contacto existente o usar «Crear y editar» para dar de alta un contacto Consumidor Final. La selección se guardará solo para la empresa indicada.</div>
    </sheet>
    <footer>
     <button string="Guardar Consumidor Final" type="object" name="action_save" class="btn-primary"/>
     <button string="Descartar" special="cancel" class="btn-secondary"/>
    </footer>
   </form>
  </field>
 </record>
 <record id="action_catastro_company_retail" model="ir.actions.act_window">
  <field name="name">Configurar Consumidor Final</field>
  <field name="res_model">catastro.retail.settings.wizard</field>
  <field name="view_mode">form</field>
  <field name="view_id" ref="view_catastro_retail_settings_wizard_form"/>
  <field name="target">new</field>
 </record>
 <menuitem id="menu_catastro_retail_partner" name="Configurar Consumidor Final" parent="conedera_odoo_census.menu_census_configuration" sequence="66" action="action_catastro_company_retail" groups="base.group_system"/>
</odoo>
