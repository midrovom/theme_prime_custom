<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_mobile_sync_own" model="ir.rule">
        <field name="name">App de Campo: sincronizaciones propias</field>
        <field name="model_id" ref="model_conedera_mobile_sync_log"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_mobile_sync_admin_all" model="ir.rule">
        <field name="name">App de Campo: administrador ve todo</field>
        <field name="model_id" ref="model_conedera_mobile_sync_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
